---
import HomeSection from './HomeSection.astro';

const diagram = Object.values(import.meta.glob('../../assets/home/how-it-fits.svg', {
	eager: true,
	query: '?url',
	import: 'default',
}))[0];
const { id, diagramAlt } = Astro.props;
---

<HomeSection id={id}>
	<slot />
	{diagram && <img src={diagram} alt={diagramAlt} />}
</HomeSection>
