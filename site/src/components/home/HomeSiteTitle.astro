---
import DefaultSiteTitle from '@astrojs/starlight/components/SiteTitle.astro';

const logo = Object.values(import.meta.glob('../../assets/brand/sil-logo.svg', {
	eager: true,
	query: '?url',
	import: 'default',
}))[0];
---

<div class="sl-flex">
	<DefaultSiteTitle />
	{logo && <img src={logo} alt={Astro.locals.t('home.silLogoAlt')} />}
</div>
