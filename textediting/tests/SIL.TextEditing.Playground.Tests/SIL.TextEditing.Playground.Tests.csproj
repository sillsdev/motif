<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>SIL.TextEditing.Playground.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <AvaloniaSkipXamlCompilerValidation>true</AvaloniaSkipXamlCompilerValidation>
  </PropertyGroup>
  <!-- Integration tests: they drive the sample playground the way a person would, in a headless Avalonia window.
       net48 resolves the libraries' netstandard2.0 builds (Avalonia 11.3.17); net10.0 their net10.0 builds (Avalonia 12).
       The Fluent theme is loaded so buttons and combo boxes have templates, as they do in the hosts. -->
  <ItemGroup>
    <Compile Include="..\Common\FakeSpelling.cs" Link="FakeSpelling.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <ProjectReference Include="..\..\src\SIL.TextEditing\SIL.TextEditing.csproj" />
    <ProjectReference Include="..\..\src\SIL.TextEditing.Avalonia\SIL.TextEditing.Avalonia.csproj" />
    <ProjectReference Include="..\..\samples\SIL.TextEditing.Playground\SIL.TextEditing.Playground.csproj" />
  </ItemGroup>
</Project>
