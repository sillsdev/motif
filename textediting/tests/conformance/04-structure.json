    "findings": [
      { "id": "fwmd.syntax.unsupported-markup", "line": 1, "column": 1, "endLine": 1, "endColumn": 4 },
      { "id": "fwmd.syntax.unsupported-markup", "line": 1, "column": 5, "endLine": 1, "endColumn": 9 },
      { "id": "fwmd.syntax.unsupported-markup", "line": 3, "column": 1, "endLine": 3, "endColumn": 7 },
      { "id": "fwmd.syntax.unsupported-markup", "line": 5, "column": 1, "endLine": 5, "endColumn": 4 },
