          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string",
          "contentMediaType": "text/x-fieldworks-markdown-inline"
        },
        "type": {
          "type": "string",
          "contentMediaType": "text/x-fieldworks-markdown-inline"
        },
        "date-of-event": {
          "type": "string",
          "contentMediaType": "text/plain"
        },
        "researchers": {
          "type": "array",
          "items": {
            "type": "string",
            "contentMediaType": "text/x-fieldworks-markdown-inline"
          }
        },
        "conclusions": {
          "type": "string",
          "contentMediaType": "text/x-fieldworks-markdown"
        },
        "sub-records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/notebook-record"
          }
        }
      },
      "additionalProperties": false
    },
    "list-item--frame": {
      "type": "object",
      "properties": {
        "guid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "contentMediaType": "text/plain"
          }
        },
        "abbreviation": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "contentMediaType": "text/plain"
          }
        },
        "description": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "contentMediaType": "text/x-fieldworks-markdown-inline"
          }
        },
        "guid-of-source": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    }
  }
