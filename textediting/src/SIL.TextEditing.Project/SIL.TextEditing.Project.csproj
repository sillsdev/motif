    <RootNamespace>SIL.TextEditing.Project</RootNamespace>
    <Description>Project-backed styles and writing systems for SIL.TextEditing hosts.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == ''">
    <TargetDir>$(MSBuildProjectDirectory)\</TargetDir>
