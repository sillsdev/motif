  <ItemGroup>
    <PackageReference Include="SIL.LCModel" />
    <PackageReference Include="SIL.Core.Desktop" />
    <ProjectReference Include="..\SIL.TextEditing.LCModel\SIL.TextEditing.LCModel.csproj" />
    <ProjectReference Include="..\SIL.TextEditing.Markdown\SIL.TextEditing.Markdown.csproj" />
  </ItemGroup>
</Project>
