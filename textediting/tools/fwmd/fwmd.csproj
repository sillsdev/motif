<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- Native AOT is a publish-time choice (-p:FwmdAot=true): setting PublishAot always would restore the ILCompiler
       package, with its audit advisory, for every build of the solution and of the test project that references this tool. -->
  <PropertyGroup Condition="'$(FwmdAot)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SIL.TextEditing.Markdown/SIL.TextEditing.Markdown.csproj" />
    <InternalsVisibleTo Include="SIL.TextEditing.Markdown.Tests" />
  </ItemGroup>
</Project>
