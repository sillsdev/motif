<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Test binaries land under the product's own configuration directory but not in it. Two reasons, and
    either alone is enough: a test host that outlives its run keeps a lock on this directory, and a lock
    on bin/Debug itself would stall the next build rather than fail it; and the product looks beside
    itself for its worker and its parser, so nothing built for the suite may share that directory.
  -->
  <PropertyGroup>
    <OutputPath>$(MotifBinRoot)tests\</OutputPath>
    <MotifTestProject Condition="'$(MSBuildProjectName)' == 'SIL.Motif.Tests.Contract'">true</MotifTestProject>
    <MotifTestProject Condition="'$(MSBuildProjectName)' == 'SIL.Motif.Tests.LibLcm'">true</MotifTestProject>
    <MotifTestProject Condition="'$(MSBuildProjectName)' == 'SIL.Motif.Tests.Commands'">true</MotifTestProject>
    <MotifTestProject Condition="'$(MSBuildProjectName)' == 'SIL.Motif.Tests.Cli'">true</MotifTestProject>
    <MotifTestProject Condition="'$(MSBuildProjectName)' == 'SIL.Motif.Tests.Worker'">true</MotifTestProject>
    <MotifTestProject Condition="'$(MSBuildProjectName)' == 'SIL.Motif.Tests.App'">true</MotifTestProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(MotifTestProject)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared\LcmCacheTestCollection.cs" Link="LcmCacheTestCollection.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared\ProcessWritingSystemRepositoryInitializer.cs" Link="ProcessWritingSystemRepositoryInitializer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared\NoCrashDialogs.cs" Link="NoCrashDialogs.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)FakePanGloss\FakePanGloss.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SIL.Motif.Tests.Commands' or '$(MSBuildProjectName)' == 'SIL.Motif.Tests.Cli' or '$(MSBuildProjectName)' == 'SIL.Motif.Tests.Worker'">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SIL.Motif.Tests.App'">
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
  </ItemGroup>
</Project>
