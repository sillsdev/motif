{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motif.sil.org/schemas/query.schema.json",
  "title": "motif.query.v2",
  "description": "A Motif query: a source, a boolean where over its columns, and the options motif query takes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "from"
  ],
  "properties": {
    "version": {
      "const": "motif.query.v2",
      "description": "The query language version."
    },
    "from": {
      "type": "string",
      "enum": [
        "forms",
        "stems",
        "uses",
        "objects"
      ],
      "description": "The source the rows come from."
    },
    "where": {
      "$ref": "#/$defs/expr",
      "description": "The row filter; omit to select every row."
    },
    "side": {
      "type": "string",
      "description": "Read the forms source as of the Baseline (baseline) or a Proposal's Trial copy (a Proposal id) instead of the latest Trial."
    },
    "sides": {
      "type": "string",
      "enum": [
        "both"
      ],
      "description": "both returns the Baseline and the Proposal named by side, side by side."
    },
    "sort": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "A column, optionally prefixed baseline. or proposal."
          },
          "dir": {
            "enum": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        }
      },
      "description": "Order of an as-of run's rows; one key."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "description": "The most rows, groups or ids returned."
    },
    "group": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Columns to group by."
    },
    "minCount": {
      "type": "integer",
      "minimum": 1,
      "description": "The fewest rows a group needs."
    },
    "examples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "description": "The most examples per group."
    },
    "ids": {
      "type": "boolean",
      "description": "Return canonical ids."
    },
    "rawLetters": {
      "type": "boolean",
      "description": "Use characters instead of the project's graphemes."
    },
    "trial": {
      "type": "string",
      "description": "The Trial id the rows must come from; only the latest Trial has query rows."
    },
    "fold": {
      "type": "string",
      "description": "Fold set of the fold column: comma-separated nfc, case, iy~y, o~u, e~i, c~k, from>to or project."
    },
    "distinct": {
      "type": "string",
      "description": "A column of which a group needs two different values."
    },
    "score": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scorers run over the whole selected universe: tolerance, reliability, control, split, size."
    },
    "unit": {
      "type": "string",
      "enum": [
        "msa",
        "stem"
      ],
      "description": "The unit stem scorers count."
    },
    "evidence": {
      "type": "boolean",
      "description": "Return the one-screen evidence composite for the grouping where or members names."
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Row ids that are the deviants of split and size, or the grouping of evidence."
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      },
      "description": "Predicates that mark a universe row an exception for tolerance; all must hold."
    },
    "context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      },
      "description": "Predicates naming the context size weighs; all must hold."
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dropped",
        "affixes",
        "wordSets"
      ],
      "properties": {
        "dropped": {
          "type": "string"
        },
        "gained": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "enum": [
            "final",
            "initial"
          ]
        },
        "affixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wordSets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discovery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "heldOut": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "controls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "controlLetters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "A hypothesised boundary change over the stems source."
    }
  },
  "$defs": {
    "expr": {
      "description": "One of: and, or, not, a field predicate, or a reserved kind (parsed, refused as not yet available).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "and"
          ],
          "properties": {
            "and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "or"
          ],
          "properties": {
            "or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/expr"
            }
          }
        },
        {
          "$ref": "#/$defs/field"
        },
        {
          "description": "Reserved: morph, seq, phon, env, realizes.",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "enum": [
              "morph",
              "seq",
              "phon",
              "env",
              "realizes"
            ]
          }
        }
      ]
    },
    "field": {
      "description": "A predicate on one column; the op must fit the column's type (x-columns): lt and gt need numeric, has needs set, regex and contains need text or set.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op"
      ],
      "properties": {
        "field": {
          "type": "string",
          "description": "A column of the source."
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "in",
            "nin",
            "lt",
            "gt",
            "has",
            "regex",
            "contains",
            "exists"
          ],
          "description": "regex is anchored at both ends; contains searches anywhere; both are NonBacktracking and at most 256 characters."
        },
        "value": {
          "description": "A string, an integer (lt, gt), a list of strings (in, nin, has) or a boolean (exists, default true)."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "eq",
                  "ne",
                  "regex",
                  "contains"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "in",
                  "nin",
                  "has"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "lt",
                  "gt"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "exists"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    }
  },
