<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <MotifTestDefaultLevel>Unit</MotifTestDefaultLevel>
    <!-- test.ps1 runs this project as this many processes, split by test class; see test.ps1's help. -->
    <MotifTestShards>4</MotifTestShards>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Compiles the token gate as a library here, so its tests call it directly rather than as a process. -->
    <DefineConstants>$(DefineConstants);TOKEN_HYGIENE_UNDER_TEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\tools\TokenHygiene\token-hygiene.cs" Link="TokenHygiene\token-hygiene.cs" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="windows" />
    <ProjectReference Include="..\..\src\SIL.Motif.App\SIL.Motif.App.csproj" />
    <ProjectReference Include="..\..\src\SIL.Motif.Cli\SIL.Motif.Cli.csproj" />
    <ProjectReference Include="..\..\src\SIL.Motif.Commands\SIL.Motif.Commands.csproj" />
    <ProjectReference Include="..\..\src\SIL.Motif.Contract\SIL.Motif.Contract.csproj" />
    <ProjectReference Include="..\..\src\SIL.Motif.Generator\SIL.Motif.Generator.csproj" />
    <ProjectReference Include="..\..\src\SIL.Motif.Host\SIL.Motif.Host.csproj" />
    <ProjectReference Include="..\..\src\SIL.Motif.Worker.Runtime\SIL.Motif.Worker.Runtime.csproj" />
    <ProjectReference Include="..\SIL.Motif.Tests.Support\SIL.Motif.Tests.Support.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
</Project>
