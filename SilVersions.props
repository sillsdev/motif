<Project>
  <PropertyGroup Label="SIL Ecosystem Versions">
    <!-- Core and WritingSystems 18 recover abandoned SLDR mutexes; the local packer overrides this pair. -->
    <SilLibPalasoVersion>18.0.0-beta0043</SilLibPalasoVersion>
    <!-- Core.Desktop 18 selects L10NSharp 10, which ships a netstandard2.0 asset. -->
    <SilCoreDesktopVersion>18.0.0-beta0043</SilCoreDesktopVersion>
    <!-- Keep Lexicon at the same release because LCModel requests the older 17.0.0 package. -->
    <SilLexiconVersion>18.0.0-beta0043</SilLexiconVersion>
    <!-- One shared LibLCM package pin for every Motif project that consumes the model. -->
    <SilLCModelPackageVersion>11.0.0-beta0182</SilLCModelPackageVersion>
    <IcuDotNetPackageVersion>3.0.2</IcuDotNetPackageVersion>
    <!-- The official C# MCP SDK; 2.x is still in preview when this is pinned. -->
    <ModelContextProtocolVersion>1.4.1</ModelContextProtocolVersion>
    <!-- Product apps share output files; keep the MCP SDK's DI contract at one assembly version. -->
    <MicrosoftExtensionsDependencyInjectionAbstractionsVersion>10.0.7</MicrosoftExtensionsDependencyInjectionAbstractionsVersion>
  </PropertyGroup>
</Project>
