<Project Sdk="Microsoft.NET.Sdk">
  <!-- A restore-only stub: test.ps1 -Coverage restores it so the collector is in the shared packages folder. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NuGetAudit>false</NuGetAudit>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../bin/.cache/coverage-restore/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageDownload Include="coverlet.collector" Version="[$(CoverletCollectorVersion)]" />
  </ItemGroup>
</Project>
