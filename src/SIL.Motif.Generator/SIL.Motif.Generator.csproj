<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Exe, not the implicit Library default: `emit` (Program.cs) is the console-command half of the
      "checked-in files, produced by running a console command" emission mechanism, and that file's
      own doc comment records the alternatives considered. Still referenced as a library by
      tests/SIL.Motif.Tests.Contract, which is unaffected by OutputType.
    -->
    <OutputType>Exe</OutputType>
    <!--
      SilVersions.props is the single source of truth for the SIL.LCModel version, read below by both
      the PackageReference and the AssemblyMetadata attribute used by ModelPathResolver.cs.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      This project never calls into SIL.LCModel — it only reads the MasterLCModel.xml the package
      ships under contentFiles/ (see ModelSource/ModelPathResolver.cs). The PackageReference exists
      solely so the pinned version is the one MSBuild actually restores, keeping the AssemblyMetadata
      value below honest rather than a second guess.
    -->
    <PackageReference Include="SIL.LCModel" Version="$(SilLCModelPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SilLCModelPackageVersion" Value="$(SilLCModelPackageVersion)" />
  </ItemGroup>

  <!-- Pins LibPalaso above SIL.LCModel's 17.x requests; only Core and WritingSystems use the local override. -->
  <ItemGroup>
    <PackageReference Include="SIL.WritingSystems" Version="$(SilLibPalasoVersion)" />
    <PackageReference Include="SIL.Core" Version="$(SilLibPalasoVersion)" />
    <PackageReference Include="SIL.Core.Desktop" Version="$(SilCoreDesktopVersion)" />
    <PackageReference Include="SIL.Lexicon" Version="$(SilLexiconVersion)" />
  </ItemGroup>

</Project>
