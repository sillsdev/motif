<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="SIL.Motif.App.App">
  <Application.Styles>
    <semi:SemiTheme />
    <semi:DataGridSemiTheme />
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />

    <!-- Styles cannot change control type; read-only markup names SelectableTextBlock explicitly. -->
    <!-- Button content stays TextBlock so button activation owns pointer and keyboard gestures. -->
    <!-- Component styles map a control's look onto tokens, and come after Semi to win over it. -->
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Text.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Card.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Notice.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/VerdictChip.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/OutcomeBar.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/WordVerdict.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/FilterChip.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/HeatCell.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/MatrixCell.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/TextsPage.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/MorphemeRow.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Shell.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/TopBar.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Menu.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Freshness.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Sidebar.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Badge.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/TabStrip.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Warnings.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/TryWord.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Timing.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Statistics.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Setup.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Selection.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Review.axaml" />
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/Overview.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
        <!-- Raw values first, then what they are for; Intent's aliases resolve against the primitives above them. -->
        <ResourceInclude Source="avares://SIL.Motif.App/Tokens/Primitives.axaml" />
        <ResourceInclude Source="avares://SIL.Motif.App/Tokens/Intent.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
