<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Explicit, as in FieldWorks: the resx manifest name and any later satellite assemblies derive from it. -->
    <RootNamespace>SIL.Motif.App</RootNamespace>
    <ApplicationIcon>Assets\motif.ico</ApplicationIcon>
    <!-- Views take their view model through the constructor and are always built in code, never by URI. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0" />
    <PackageReference Include="Semi.Avalonia.DataGrid" Version="12.1.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiveMarkdown.Avalonia" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- A Linux AppImage copies this beside itself into the desktop icon theme. -->
    <None Include="Assets\motif.png" Link="motif.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\motif.ico;Assets\motif-icon.png;Assets\Fonts\**\*.ttf;Assets\Fonts\**\OFL.txt;Assets\Fonts\NOTICE.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SIL.Motif.Tests.App" />
    <EmbeddedResource Include="CorpusViewer/client.bundle.js" LogicalName="Motif.CorpusViewer.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIL.Motif.Commands\SIL.Motif.Commands.csproj" />
    <ProjectReference Include="..\SIL.Motif.Contract\SIL.Motif.Contract.csproj" />
    <ProjectReference Include="..\SIL.Motif.Help\SIL.Motif.Help.csproj" />
    <!-- Built from textediting/ at net10.0 only; its netstandard2.0 target serves FieldWorks and is never built here (ADR 0092). -->
    <ProjectReference Include="..\..\textediting\src\SIL.TextEditing\SIL.TextEditing.csproj" SetTargetFramework="TargetFramework=net10.0" />
    <ProjectReference Include="..\..\textediting\src\SIL.TextEditing.Avalonia\SIL.TextEditing.Avalonia.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

</Project>
