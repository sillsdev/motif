<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SIL.Motif.App.Views.DiagnosticWindow"
        Title="Motif diagnostic"
        Width="{DynamicResource Component.Shell.DiagnosticWidth}"
        Height="{DynamicResource Component.Shell.DiagnosticHeight}"
        MinWidth="{DynamicResource Component.Shell.DiagnosticMinWidth}"
        MinHeight="{DynamicResource Component.Shell.DiagnosticMinHeight}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SIL.Motif.App/Tokens/Scoped/ControlHeights.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <LayoutTransformControl LayoutTransform="{DynamicResource App.ZoomTransform}">
      <ContentControl x:Name="PanelHost" />
    </LayoutTransformControl>
  </ScrollViewer>
</Window>
