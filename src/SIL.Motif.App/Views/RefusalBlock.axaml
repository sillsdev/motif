<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:contract="clr-namespace:SIL.Motif.Contract.Commands;assembly=SIL.Motif.Contract"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.RefusalBlock"
             x:DataType="vm:WindowRefusal">
  <ScrollViewer Classes="refusalBlockViewport">
    <StackPanel Classes="refusal">
      <StackPanel Classes="refusalRecoveryCopy" IsVisible="{Binding OffersStoreDeletion}">
        <TextBlock Classes="refusalTitle" Text="{Binding Heading}" />
        <views:CopyableTextBlock Classes="error" Text="{Binding Sentence}" TextWrapping="Wrap" />
      </StackPanel>
      <views:CopyableTextBlock Classes="error" Text="{Binding Sentence}" TextWrapping="Wrap"
                               IsVisible="{Binding !OffersStoreDeletion}" />
      <ScrollViewer Classes="refusalViewport" IsVisible="{Binding HasCompileIssues}"
                    HorizontalScrollBarVisibility="Disabled"
                    AutomationProperties.Name="{x:Static app:MotifAppStrings.FatalGrammarIssuesAccessibleName}">
        <ItemsControl x:Name="RefusalBlockCompileIssuesItems" ItemsSource="{Binding CompileIssues}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="contract:ParserCompileIssue">
              <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                <views:CopyableTextBlock Text="{Binding Code}" FontWeight="{DynamicResource Intent.Weight.Strong}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding Kind}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding ObjectKind}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding ObjectGuid}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding Advice}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <HyperlinkButton x:Name="ReportProblemButton" Classes="refusalReport" Content="{x:Static app:MotifAppStrings.ReportProblem}" Click="OnReportProblemClick"
              IsVisible="{Binding OffersProblemReport}"
              AutomationProperties.Name="{x:Static app:MotifAppStrings.ReviewAProblemReportAccessibleName}" HorizontalAlignment="Left" />
      <Button x:Name="DeleteStoreButton"
              Classes="Primary" Theme="{DynamicResource SolidButton}"
              Content="{x:Static app:MotifAppStrings.DeleteMotifsStoreAndReopen}"
              CommandParameter="{Binding}"
              AutomationProperties.Name="{x:Static app:MotifAppStrings.RefusalDeleteStoreAccessibleName}"
              HorizontalAlignment="Left"
              IsVisible="False" />
      <Expander Classes="refusalDetails" Header="{Binding DetailsTitle}" AutomationProperties.Name="{x:Static app:MotifAppStrings.RefusalDetailsAccessibleName}"
                IsExpanded="False" IsVisible="{Binding HasDetails}">
        <ScrollViewer Classes="refusalViewport" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="{x:Static app:MotifAppStrings.OriginalRefusalDetailsAccessibleName}">
          <views:CopyableTextBlock Classes="refusalDetails" Text="{Binding Details}" TextWrapping="Wrap" />
        </ScrollViewer>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
