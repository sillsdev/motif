<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.RefusalBlock"
             x:DataType="vm:WindowRefusal">
  <StackPanel Classes="refusal">
    <views:CopyableTextBlock Classes="error" Text="{Binding Sentence}" TextWrapping="Wrap" />
    <Button x:Name="DeleteStoreButton"
            Content="Delete this file and reopen"
            CommandParameter="{Binding}"
            AutomationProperties.Name="Delete Motif's file for this project and reopen it"
            HorizontalAlignment="Left"
            IsVisible="False" />
    <Expander Classes="refusalDetails" Header="Details" AutomationProperties.Name="Refusal details"
              IsExpanded="False" IsVisible="{Binding HasDetails}">
      <views:CopyableTextBlock Classes="refusalDetails" Text="{Binding Details}" TextWrapping="Wrap" />
    </Expander>
  </StackPanel>
</UserControl>
