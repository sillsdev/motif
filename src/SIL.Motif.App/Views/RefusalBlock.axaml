<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.RefusalBlock"
             x:DataType="vm:WindowRefusal">
  <StackPanel Classes="refusal">
    <views:CopyableTextBlock Classes="error" Text="{Binding Sentence}" TextWrapping="Wrap" />
    <Expander Classes="refusalDetails" Header="Details" IsExpanded="False" IsVisible="{Binding HasDetails}">
      <views:CopyableTextBlock Classes="refusalDetails" Text="{Binding Details}" TextWrapping="Wrap" />
    </Expander>
  </StackPanel>
</UserControl>
