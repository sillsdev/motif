<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             xmlns:req="clr-namespace:SIL.Motif.Contract.Requests;assembly=SIL.Motif.Contract"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:controls="clr-namespace:SIL.Motif.App.Controls"
             x:Class="SIL.Motif.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Classes="settingsPageView" controls:WritingSystemText.Resolver="{Binding WritingSystemTextStyles}">
  <Grid RowDefinitions="Auto,*">
    <Border Classes="settingsHeader">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
        <views:CopyableTextBlock Classes="settingsHeaderTitle" Text="{x:Static app:MotifAppStrings.Settings}" />
        <Button x:Name="SettingsClose" Grid.Column="1" Content="{x:Static app:MotifAppStrings.Back}" Click="OnCloseRequested" AutomationProperties.Name="{x:Static app:MotifAppStrings.LeaveSettingsAccessibleName}" />
      </Grid>
    </Border>
    <ScrollViewer x:Name="SettingsListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnSettingsContentSizeChanged">
      <Border Classes="settingsPageInset">
      <StackPanel Classes="settingsList">
<StackPanel x:Name="SettingsDisplaySection" Classes="settingsPage">
              <views:CopyableTextBlock Classes="settingsGroupHeading" Text="{x:Static app:MotifAppStrings.Display}" />
              <views:CopyableTextBlock Classes="settingsPersistenceRefusal" Text="{Binding PreferenceProblemText}"
                         IsVisible="{Binding HasPreferenceProblem}" TextWrapping="Wrap" />
              <Button Classes="settingsAction" Content="{x:Static app:MotifAppStrings.ResetSavedPreferences}"
                      Command="{Binding ResetPreferencesCommand}" IsVisible="{Binding ShowResetPreferences}"
                      AutomationProperties.Name="{x:Static app:MotifAppStrings.ResetSavedPreferencesAccessibleName}" />
              <Border Classes="settingsRow">
              <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingsLabel">
                  <views:CopyableTextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.Zoom}" />
                  <views:CopyableTextBlock Classes="settingsCaption" Text="{Binding ZoomShortcutHint}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="settingsDisplayControls">
                  <StackPanel Orientation="Horizontal" Classes="settingsStepper">
                    <Button Content="−" Theme="{DynamicResource BorderlessButton}" Classes="settingsStepButton"
                            Command="{Binding ZoomOutCommand}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ZoomOutAccessibleName}" />
                    <views:CopyableTextBlock Classes="settingsZoomValue" Text="{Binding ZoomLabel}" VerticalAlignment="Center" />
                    <Button Content="+" Theme="{DynamicResource BorderlessButton}" Classes="settingsStepButton"
                            Command="{Binding ZoomInCommand}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ZoomInAccessibleName}" />
                  </StackPanel>
                  <Button Classes="settingsLink" Content="{x:Static app:MotifAppStrings.ResetTo100}" Command="{Binding ResetZoomCommand}"
                          IsEnabled="{Binding CanResetZoom}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ResetZoomTo100AccessibleName}" />
                </StackPanel>
              </Grid>
              </Border>
              <Border Classes="settingsRow">
              <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingsLabel">
                  <views:CopyableTextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.Theme}" />
                  <views:CopyableTextBlock Classes="settingsCaption" Text="{x:Static app:MotifAppStrings.ThemeRememberedCaption}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Classes="settingsSegments">
                  <Button x:Name="ThemeLightButton" Content="{x:Static app:MotifAppStrings.Light}" Classes="settingsSegment" Classes.selected="{Binding IsLightThemeSelected}"
                          Command="{Binding SelectThemeCommand}" CommandParameter="{x:Static vm:WindowThemeChoice.Light}"
                          TabIndex="{Binding LightThemeTabIndex}" KeyDown="OnThemeSegmentKeyDown"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.LightThemeAccessibleName}" />
                  <Button x:Name="ThemeDarkButton" Content="{x:Static app:MotifAppStrings.Dark}" Classes="settingsSegment" Classes.selected="{Binding IsDarkThemeSelected}"
                          Command="{Binding SelectThemeCommand}" CommandParameter="{x:Static vm:WindowThemeChoice.Dark}"
                          TabIndex="{Binding DarkThemeTabIndex}" KeyDown="OnThemeSegmentKeyDown"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.DarkThemeAccessibleName}" />
                  <Button x:Name="ThemeSystemButton" Content="{Binding ThemeSystemLabel}" Classes="settingsSegment" Classes.selected="{Binding IsSystemThemeSelected}"
                          Command="{Binding SelectThemeCommand}" CommandParameter="{x:Static vm:WindowThemeChoice.System}"
                          TabIndex="{Binding SystemThemeTabIndex}" KeyDown="OnThemeSegmentKeyDown"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.MatchOperatingSystemThemeAccessibleName}" />
                <Button Content="{x:Static app:MotifAppStrings.Reset}" Classes="settingsLink" Command="{Binding ResetThemeCommand}" IsEnabled="{Binding CanResetTheme}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ResetThemeToMatchOperatingAccessibleName}" />
                </StackPanel>
              </Grid>
              </Border>

            </StackPanel>
<StackPanel x:Name="SettingsKeyboardShortcutsSection" Classes="settingsPage">
  <views:CopyableTextBlock Classes="settingsGroupHeading" Text="{x:Static app:MotifAppStrings.KeyboardShortcuts}" />
  <views:CopyableTextBlock Classes="settingsCaption" Text="{x:Static app:MotifAppStrings.ShortcutsWorkWithoutTextFocusCaption}" TextWrapping="Wrap" />
  <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
    <TextBox x:Name="ShortcutSearchBox" Classes="settingsSearch" Text="{Binding ShortcutSearch}" AutomationProperties.Name="{x:Static app:MotifAppStrings.SearchShortcutsAccessibleName}" />
    <Button Grid.Column="1" Content="×" Classes="settingsClearSearch" Command="{Binding ClearShortcutSearchCommand}" IsVisible="{Binding ShortcutSearchHasText}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ClearShortcutSearchAccessibleName}" />
  </Grid>
  <views:CopyableTextBlock Classes="settingsNoMatch" Text="{Binding NoShortcutMatchesText}" IsVisible="{Binding ShowNoShortcutMatches}" TextWrapping="Wrap" />
  <ItemsControl x:Name="SettingsShortcutsItems" ItemsSource="{Binding ShortcutEntries}" IsVisible="{Binding ShortcutRegistryAvailable}">
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ShortcutEntry">
      <Border Classes="settingsShortcutRow"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
        <views:CopyableTextBlock Text="{Binding ScopedAction}" TextWrapping="Wrap" />
        <Border Grid.Column="1" Classes="settingsKeyCap"><views:CopyableTextBlock Text="{Binding Keys}" TextWrapping="Wrap" /></Border>
      </Grid></Border>
    </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
</StackPanel>
<StackPanel x:Name="SettingsParsingSection" Classes="settingsPage">
              <views:CopyableTextBlock Classes="settingsGroupHeading" Text="{Binding GroupParsingLabel}" />
              <views:CopyableTextBlock Classes="settingsLead" Text="{Binding ParsingLead}" TextWrapping="Wrap"
                         IsVisible="{Binding HasProject}" />
              <views:CopyableTextBlock Classes="settingsPlaceholder" Text="{x:Static app:MotifAppStrings.OpenProjectForParsingLimitsPlaceholder}"
                         IsVisible="{Binding !HasProject}" TextWrapping="Wrap" />
              <views:CopyableTextBlock Classes="settingsPlaceholder" Text="{x:Static app:MotifAppStrings.ChooseWhatToParseForLimitsPlaceholder}"
                         IsVisible="{Binding HasProjectWithoutSelection}"
                         TextWrapping="Wrap" />
              <Button Classes="settingsAction" Content="{x:Static app:MotifAppStrings.ChooseWhatToParse}"
                      IsVisible="{Binding HasProjectWithoutSelection}" Click="OnConfigureRequested"
                      AutomationProperties.Name="{x:Static app:MotifAppStrings.ChooseWhatToParseAccessibleName}" />
              <StackPanel IsVisible="{Binding HasSavedSelection}" Classes="settingsPage">
                <Border Classes="settingsRow">
                <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                  <StackPanel Classes="settingsLabel">
                    <views:CopyableTextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.StepLimitPerWordLabel}" />
                    <views:CopyableTextBlock Classes="settingsCaption" Text="{x:Static app:MotifAppStrings.StepLimitDefaultCaption}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <NumericUpDown Grid.Column="1" Classes="settingsNumber" Classes.refused="{Binding HasStepLimitRefusal}"
                                 Value="{Binding StepLimit}"
                                 Minimum="1" Increment="100000" FormatString="N0"
                                 IsEnabled="{Binding !IsNoStepLimit}" LostFocus="OnParsingLimitLostFocus"
                                 KeyDown="OnParsingLimitKeyDown" AutomationProperties.Name="{x:Static app:MotifAppStrings.StepLimitPerWord}" />
                </Grid>
                </Border>
                <views:CopyableTextBlock Classes="settingsRefusal" Text="{Binding StepLimitRefusal}"
                           IsVisible="{Binding HasStepLimitRefusal}" TextWrapping="Wrap" />
                <Button Classes="settingsLink" Content="{x:Static app:MotifAppStrings.ResetStepLimit}" Command="{Binding ResetStepLimitCommand}" IsEnabled="{Binding CanResetStepLimit}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ResetStepLimitTo200000AccessibleName}" />
                <CheckBox Classes="settingsCheck" Content="{x:Static app:MotifAppStrings.NoStepLimit}" IsChecked="{Binding IsNoStepLimit}"
                          Click="OnNoStepLimitClick"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.NoStepLimitAccessibleName}" />
                <Border Classes="settingsRow">
                <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                  <StackPanel Classes="settingsLabel">
                    <views:CopyableTextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.TimeLimitPerWord}" TextWrapping="Wrap" />
                    <views:CopyableTextBlock Classes="settingsCaption" Text="{x:Static app:MotifAppStrings.TimeLimitFollowsStepLimitCaption}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto"
                        ColumnSpacing="{DynamicResource Intent.Space.Compact}" HorizontalAlignment="Right">
                    <NumericUpDown Classes="settingsNumber" Classes.refused="{Binding HasTimeLimitRefusal}"
                                   Value="{Binding TimeLimitSeconds}"
                                   Minimum="0.001" Maximum="2147483.647" Increment="0.1" FormatString="0.###"
                                   IsEnabled="{Binding IsTimeLimitEnabled}" LostFocus="OnParsingLimitLostFocus"
                                   KeyDown="OnParsingLimitKeyDown" AutomationProperties.Name="{x:Static app:MotifAppStrings.TimeLimitPerWordInAccessibleName}" />
                    <Button Grid.Column="1" Classes="settingsLink" Content="{x:Static app:MotifAppStrings.UseMotifSEstimate}"
                            IsVisible="{Binding ShowUseEstimate}" Click="OnUseEstimateClick"
                            AutomationProperties.Name="{x:Static app:MotifAppStrings.UseMotifEstimateAccessibleName}" />
                  </Grid>
                </Grid>
                </Border>
                <views:CopyableTextBlock Classes="settingsCaption" Text="{Binding StepLimitEstimateText}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Classes="settingsRefusal" Text="{Binding TimeLimitRefusal}"
                           IsVisible="{Binding HasTimeLimitRefusal}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
<Border Classes="settingsFooter">
  <views:CopyableTextBlock Classes="settingsFooterText" Text="{Binding ParsingFooter}" TextWrapping="Wrap" />
</Border>
<StackPanel x:Name="SettingsProposalChecksSection" Classes="settingsPage">
              <views:CopyableTextBlock Classes="settingsGroupHeading" Text="{x:Static app:MotifAppStrings.DefaultProposalChecks}" />
              <views:CopyableTextBlock Classes="settingsLead" Text="{Binding ProposalChecksLead}" TextWrapping="Wrap" />
              <StackPanel Classes="settingsLabel">
                <views:CopyableTextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.CompareStoredAnalyses}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Classes="settingsCaption" TextWrapping="Wrap"
                           Text="{x:Static app:MotifAppStrings.CompareStoredAnalysesCaption}" />
              </StackPanel>
              <StackPanel Classes="settingsChoices">
                <RadioButton GroupName="StoredAnalyses" x:Name="StoredAnalysesBudgetChoice" Classes="settingsChoice" IsChecked="{Binding IsStoredAnalysesBudget, Mode=OneWay}"
                             Command="{Binding ChooseStoredAnalysesCommand}" CommandParameter="{x:Static req:StoredAnalysisComparison.Budget}"
                             AutomationProperties.Name="{x:Static app:MotifAppStrings.StoredAnalysisWorkBudgetChoiceAccessibleName}">
                  <StackPanel Classes="settingsLabel">
                    <TextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.StoredAnalysisWorkBudgetChoice}" TextWrapping="Wrap" />
                    <TextBlock Classes="settingsCaption" TextWrapping="Wrap"
                               Text="{x:Static app:MotifAppStrings.StoredAnalysisWorkBudgetCaption}" />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="StoredAnalyses" x:Name="StoredAnalysesAllChoice" Classes="settingsChoice" IsChecked="{Binding IsStoredAnalysesAll, Mode=OneWay}"
                             Command="{Binding ChooseStoredAnalysesCommand}" CommandParameter="{x:Static req:StoredAnalysisComparison.All}"
                             AutomationProperties.Name="{x:Static app:MotifAppStrings.StoredAnalysisEveryWordChoiceAccessibleName}">
                  <StackPanel Classes="settingsLabel">
                    <TextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.StoredAnalysisEveryWordChoice}" TextWrapping="Wrap" />
                    <TextBlock Classes="settingsCaption" TextWrapping="Wrap"
                               Text="{x:Static app:MotifAppStrings.StoredAnalysisEveryWordCaption}" />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="StoredAnalyses" x:Name="StoredAnalysesOffChoice" Classes="settingsChoice" IsChecked="{Binding IsStoredAnalysesOff, Mode=OneWay}"
                             Command="{Binding ChooseStoredAnalysesCommand}" CommandParameter="{x:Static req:StoredAnalysisComparison.Off}"
                             AutomationProperties.Name="{x:Static app:MotifAppStrings.StoredAnalysisOffChoiceAccessibleName}">
                  <StackPanel Classes="settingsLabel">
                    <TextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.StoredAnalysisOffChoiceAccessibleName}" TextWrapping="Wrap" />
                    <TextBlock Classes="settingsCaption" TextWrapping="Wrap"
                               Text="{x:Static app:MotifAppStrings.StoredAnalysisOffCaption}" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
              <Button Classes="settingsLink" Content="{x:Static app:MotifAppStrings.ResetComparison}" Command="{Binding ResetStoredAnalysesCommand}" IsEnabled="{Binding CanResetStoredAnalyses}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ResetStoredAnalysisComparisonToAccessibleName}" />
              <views:CopyableTextBlock Classes="settingsRefusal" Text="{Binding StoredAnalysesRefusal}"
                         IsVisible="{Binding HasStoredAnalysesRefusal}" TextWrapping="Wrap" />
              <views:CopyableTextBlock Classes="settingsCaption" TextWrapping="Wrap"
                         Text="{x:Static app:MotifAppStrings.ProposalChecksAppliesNextCaption}" />
            </StackPanel>
<StackPanel x:Name="SettingsWritingSystemsSection" Classes="settingsPage settingsWritingSystemsPage">
              <views:CopyableTextBlock Classes="settingsGroupHeading" Text="{Binding WritingSystemsHeading}" />
              <views:CopyableTextBlock Classes="settingsLead" Text="{Binding WritingSystemsLead}" TextWrapping="Wrap"
                         IsVisible="{Binding HasProject}" />
              <views:CopyableTextBlock Classes="settingsPlaceholder" Text="{x:Static app:MotifAppStrings.OpenProjectForWritingSystemsPlaceholder}"
                         IsVisible="{Binding !HasProject}" TextWrapping="Wrap" />
              <views:CopyableTextBlock Classes="settingsPlaceholder" Text="{Binding WritingSystemsEmptyText}"
                         IsVisible="{Binding ShowWritingSystemsEmptyState}" TextWrapping="Wrap" />
              <StackPanel IsVisible="{Binding HasWritingSystems}" Classes="settingsWritingSystemList">
                <views:CopyableTextBlock Classes="settingsWritingSystemSection" Text="{x:Static app:MotifAppStrings.VernacularSectionLabel}"
                           IsVisible="{Binding HasVernacularWritingSystems}" />
                <ItemsControl x:Name="SettingsVernacularWritingSystemsItems"
                              ItemsSource="{Binding VernacularWritingSystems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WritingSystemSettingsRow">
      <StackPanel>
        <Border Classes="settingsRow">
          <Grid Classes="settingsWritingSummary" ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource Intent.Space.Related}"
                SizeChanged="OnWritingSummarySizeChanged">
            <StackPanel Classes="settingsLabel">
              <views:CopyableTextBlock Classes="settingsLabelText" Text="{Binding Name}" TextWrapping="Wrap" />
              <views:CopyableTextBlock Classes="settingsCaption" Text="{Binding Id}" TextWrapping="Wrap" />
            </StackPanel>
            <views:CopyableTextBlock Grid.Column="1" Text="{Binding FontLabel}" FontWeight="{DynamicResource Intent.Weight.Section}" TextWrapping="Wrap" />
            <StackPanel Grid.Column="2" Classes="settingsLabel">
              <views:CopyableTextBlock Classes="settingsCaption" Text="{Binding FontSourceText}" TextWrapping="Wrap" />
              <views:CopyableTextBlock Classes="settingsRefusal" Text="{Binding MissingFontCaption}" IsVisible="{Binding IsFontMissing}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
        <Expander Header="{x:Static app:MotifAppStrings.Details}" AutomationProperties.Name="{Binding DetailsAccessibleName}">

                      <Border Classes="settingsWritingSystemRow">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource Intent.Space.Compact}">
                          <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Compact}">
                            <views:CopyableTextBlock Classes="settingsWritingSystemName" Text="{Binding Name}" TextWrapping="Wrap" />
                            <Border Grid.Column="1" Classes="settingsWritingSystemAbbreviation"
                                    IsVisible="{Binding HasAbbreviation}">
                              <views:CopyableTextBlock Text="{Binding Abbreviation}" />
                            </Border>
                            <views:CopyableTextBlock Grid.Column="2" Classes="settingsWritingSystemTag" Text="{Binding Id}"
                                       IsVisible="{Binding HasTag}" TextWrapping="Wrap" />
                            <views:CopyableTextBlock Grid.Column="3" Classes="settingsWritingSystemDefault" Text="{x:Static app:MotifAppStrings.Default}"
                                       IsVisible="{Binding ShowDefault}" />
                          </Grid>
                          <StackPanel Grid.Row="1" Classes="settingsLabel">
                            <Border Classes="settingsWritingSystemSampleBox"
                                    IsVisible="{Binding !IsAlsoInVernacular}">
                              <StackPanel>
                                <views:CopyableTextBlock Classes="settingsWritingSystemSample" Text="Aa"
                                           controls:WritingSystemText.Id="{Binding Id}"
                                           controls:WritingSystemText.StyleName="Normal"
                                           controls:WritingSystemText.SuppressMissingFontNotice="True"
                                           TextAlignment="{Binding PreviewTextAlignment}" />
                                <views:CopyableTextBlock Classes="settingsWritingSystemSampleCaption" Text="{x:Static app:MotifAppStrings.WritingSystemFontPreviewCaption}" />
                              </StackPanel>
                            </Border>
                            <views:CopyableTextBlock Grid.Column="1" Classes="settingsWritingSystemDuplicate"
                                       Text="{Binding AlsoInVernacularText}"
                                       IsVisible="{Binding IsAlsoInVernacular}" TextWrapping="Wrap" />
                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*"
                                  RowSpacing="{DynamicResource Intent.Space.Compact}"
                                  IsVisible="{Binding !IsAlsoInVernacular}">
                              <views:CopyableTextBlock Classes="settingsWritingSystemFactLabel" Text="{x:Static app:MotifAppStrings.Font}" />
                              <StackPanel Grid.Column="1">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Compact}">
                                  <views:CopyableTextBlock Classes="settingsWritingSystemFactValue" Text="{Binding FontLabel}"
                                             TextWrapping="Wrap" />
                                  <views:MarkGlyph Grid.Column="1" Classes="inline"
                                                   Mark="{x:Static vm:Mark.Warning}"
                                                   IsVisible="{Binding IsFontMissing}"
                                                   AutomationProperties.Name="{x:Static app:MotifAppStrings.FontIsMissingAccessibleName}" />
                                </Grid>
                                <views:CopyableTextBlock Classes="settingsWritingSystemFactCaption"
                                           Text="{Binding MissingFontCaption}"
                                           IsVisible="{Binding IsFontMissing}" TextWrapping="Wrap" />
                              </StackPanel>
                              <views:CopyableTextBlock Grid.Row="1" Classes="settingsWritingSystemFactLabel" Text="{x:Static app:MotifAppStrings.Features}" />
                              <views:CopyableTextBlock Grid.Row="1" Grid.Column="1" Classes="settingsWritingSystemFactValue"
                                         Text="{Binding Features}" TextWrapping="Wrap" />
                              <views:CopyableTextBlock Grid.Row="2" Classes="settingsWritingSystemFactLabel" Text="{x:Static app:MotifAppStrings.Direction}" />
                              <views:CopyableTextBlock Grid.Row="2" Grid.Column="1" Classes="settingsWritingSystemFactValue"
                                         Text="{Binding Direction}" TextWrapping="Wrap" />
                              <views:CopyableTextBlock Grid.Row="3" Classes="settingsWritingSystemFactLabel" Text="{x:Static app:MotifAppStrings.Size}" />
                              <views:CopyableTextBlock Grid.Row="3" Grid.Column="1" Classes="settingsWritingSystemFactValue"
                                         Text="{Binding StyleSizes}" IsVisible="{Binding HasStyleSizes}"
                                         TextWrapping="Wrap" />
                            </Grid>
                          </StackPanel>
                        </Grid>
                      </Border>

        </Expander>
      </StackPanel>
    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <views:CopyableTextBlock Classes="settingsWritingSystemSection" Text="{x:Static app:MotifAppStrings.AnalysisSectionLabel}"
                           IsVisible="{Binding HasAnalysisWritingSystems}" />
                <ItemsControl x:Name="SettingsAnalysisWritingSystemsItems"
                              ItemsSource="{Binding AnalysisWritingSystems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WritingSystemSettingsRow">
      <StackPanel>
        <Border Classes="settingsRow">
          <Grid Classes="settingsWritingSummary" ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource Intent.Space.Related}"
                SizeChanged="OnWritingSummarySizeChanged">
            <StackPanel Classes="settingsLabel">
              <views:CopyableTextBlock Classes="settingsLabelText" Text="{Binding Name}" TextWrapping="Wrap" />
              <views:CopyableTextBlock Classes="settingsCaption" Text="{Binding Id}" TextWrapping="Wrap" />
            </StackPanel>
            <views:CopyableTextBlock Grid.Column="1" Text="{Binding FontLabel}" FontWeight="{DynamicResource Intent.Weight.Section}" TextWrapping="Wrap" />
            <StackPanel Grid.Column="2" Classes="settingsLabel">
              <views:CopyableTextBlock Classes="settingsCaption" Text="{Binding FontSourceText}" TextWrapping="Wrap" />
              <views:CopyableTextBlock Classes="settingsRefusal" Text="{Binding MissingFontCaption}" IsVisible="{Binding IsFontMissing}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
        <Expander Header="{x:Static app:MotifAppStrings.Details}" AutomationProperties.Name="{Binding DetailsAccessibleName}">

                      <Border Classes="settingsWritingSystemRow">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource Intent.Space.Compact}">
                          <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Compact}">
                            <views:CopyableTextBlock Classes="settingsWritingSystemName" Text="{Binding Name}" TextWrapping="Wrap" />
                            <Border Grid.Column="1" Classes="settingsWritingSystemAbbreviation"
                                    IsVisible="{Binding HasAbbreviation}">
                              <views:CopyableTextBlock Text="{Binding Abbreviation}" />
                            </Border>
                            <views:CopyableTextBlock Grid.Column="2" Classes="settingsWritingSystemTag" Text="{Binding Id}"
                                       IsVisible="{Binding HasTag}" TextWrapping="Wrap" />
                            <views:CopyableTextBlock Grid.Column="3" Classes="settingsWritingSystemDefault" Text="{x:Static app:MotifAppStrings.Default}"
                                       IsVisible="{Binding ShowDefault}" />
                          </Grid>
                          <StackPanel Grid.Row="1" Classes="settingsLabel">
                            <Border Classes="settingsWritingSystemSampleBox"
                                    IsVisible="{Binding !IsAlsoInVernacular}">
                              <StackPanel>
                                <views:CopyableTextBlock Classes="settingsWritingSystemSample" Text="Aa"
                                           controls:WritingSystemText.Id="{Binding Id}"
                                           controls:WritingSystemText.StyleName="Normal"
                                           controls:WritingSystemText.SuppressMissingFontNotice="True"
                                           TextAlignment="{Binding PreviewTextAlignment}" />
                                <views:CopyableTextBlock Classes="settingsWritingSystemSampleCaption" Text="{x:Static app:MotifAppStrings.WritingSystemFontPreviewCaption}" />
                              </StackPanel>
                            </Border>
                            <views:CopyableTextBlock Grid.Column="1" Classes="settingsWritingSystemDuplicate"
                                       Text="{Binding AlsoInVernacularText}"
                                       IsVisible="{Binding IsAlsoInVernacular}" TextWrapping="Wrap" />
                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*"
                                  RowSpacing="{DynamicResource Intent.Space.Compact}"
                                  IsVisible="{Binding !IsAlsoInVernacular}">
                              <views:CopyableTextBlock Classes="settingsWritingSystemFactLabel" Text="{x:Static app:MotifAppStrings.Font}" />
                              <StackPanel Grid.Column="1">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Compact}">
                                  <views:CopyableTextBlock Classes="settingsWritingSystemFactValue" Text="{Binding FontLabel}"
                                             TextWrapping="Wrap" />
                                  <views:MarkGlyph Grid.Column="1" Classes="inline"
                                                   Mark="{x:Static vm:Mark.Warning}"
                                                   IsVisible="{Binding IsFontMissing}"
                                                   AutomationProperties.Name="{x:Static app:MotifAppStrings.FontIsMissingAccessibleName}" />
                                </Grid>
                                <views:CopyableTextBlock Classes="settingsWritingSystemFactCaption"
                                           Text="{Binding MissingFontCaption}"
                                           IsVisible="{Binding IsFontMissing}" TextWrapping="Wrap" />
                              </StackPanel>
                              <views:CopyableTextBlock Grid.Row="1" Classes="settingsWritingSystemFactLabel" Text="{x:Static app:MotifAppStrings.Features}" />
                              <views:CopyableTextBlock Grid.Row="1" Grid.Column="1" Classes="settingsWritingSystemFactValue"
                                         Text="{Binding Features}" TextWrapping="Wrap" />
                              <views:CopyableTextBlock Grid.Row="2" Classes="settingsWritingSystemFactLabel" Text="{x:Static app:MotifAppStrings.Direction}" />
                              <views:CopyableTextBlock Grid.Row="2" Grid.Column="1" Classes="settingsWritingSystemFactValue"
                                         Text="{Binding Direction}" TextWrapping="Wrap" />
                              <views:CopyableTextBlock Grid.Row="3" Classes="settingsWritingSystemFactLabel" Text="{x:Static app:MotifAppStrings.Size}" />
                              <views:CopyableTextBlock Grid.Row="3" Grid.Column="1" Classes="settingsWritingSystemFactValue"
                                         Text="{Binding StyleSizes}" IsVisible="{Binding HasStyleSizes}"
                                         TextWrapping="Wrap" />
                            </Grid>
                          </StackPanel>
                        </Grid>
                      </Border>

        </Expander>
      </StackPanel>
    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <views:CopyableTextBlock Classes="settingsWritingSystemFootnote"
                           Text="{x:Static app:MotifAppStrings.WritingSystemLimitsFootnote}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
<Border Classes="settingsFooter" IsVisible="{Binding HasProject}">
  <StackPanel>
    <views:CopyableTextBlock Classes="settingsFooterText" Text="{x:Static app:MotifAppStrings.ChangeInFieldWorksHeading}" />
    <views:CopyableTextBlock Classes="settingsFooterText" Text="{x:Static app:MotifAppStrings.WritingSystemSetupFieldWorksPath}" TextWrapping="Wrap" />
    <views:CopyableTextBlock Classes="settingsFooterText" Text="{x:Static app:MotifAppStrings.WritingSystemSizeFieldWorksPath}" TextWrapping="Wrap" />
    <views:CopyableTextBlock Classes="settingsFooterText" Text="{x:Static app:MotifAppStrings.WritingSystemRefreshHint}" TextWrapping="Wrap" />
  </StackPanel>
</Border>
<StackPanel x:Name="SettingsTextsSection" Classes="settingsPage">
  <views:CopyableTextBlock Classes="settingsGroupHeading" Text="{x:Static app:MotifAppStrings.Texts}" />
  <StackPanel IsVisible="{Binding HasSavedSelection}">                <Border Classes="settingsRow">
                  <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                    <StackPanel Classes="settingsLabel">
                      <views:CopyableTextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.TextsToParseLabel}" />
                      <views:CopyableTextBlock Classes="settingsCaption" Text="{Binding TextSelectionSummary}" />
                    </StackPanel>
                    <Button x:Name="UseAllTextsButton" Grid.Column="1" Classes="settingsLink"
                            Content="{x:Static app:MotifAppStrings.UseAllTexts}"
                            Command="{Binding UseAllTextsCommand}"
                            IsEnabled="{Binding CanUseAllTexts}"
                            AutomationProperties.Name="{x:Static app:MotifAppStrings.UseAllTextsAccessibleName}" />
                  </Grid>
                </Border>
                <views:CopyableTextBlock Classes="settingsRefusal" Text="{Binding TextSelectionRefusal}"
                           IsVisible="{Binding HasTextSelectionRefusal}" TextWrapping="Wrap" />
</StackPanel>
  <views:CopyableTextBlock Classes="settingsCaption" Text="{x:Static app:MotifAppStrings.OpenProjectForTextsPlaceholder}" IsVisible="{Binding !HasSavedSelection}" TextWrapping="Wrap" />
</StackPanel>
<StackPanel x:Name="SettingsHelpAndReportsSection" Classes="settingsPage">
              <views:CopyableTextBlock Classes="settingsGroupHeading" Text="{x:Static app:MotifAppStrings.HelpAndProblemReports}" />
              <Border Classes="settingsRow">
              <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingsLabel">
                  <views:CopyableTextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.Help}" />
                  <views:CopyableTextBlock Classes="settingsCaption" Text="{Binding HelpCaption}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="{x:Static app:MotifAppStrings.OpenHelp}" Classes="settingsAction" Click="OnOpenHelpRequested"
                        AutomationProperties.Name="{x:Static app:MotifAppStrings.OpenHelp}" />
              </Grid>
              </Border>
              <Border Classes="settingsRow">
              <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                <views:CopyableTextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.GuideAndCommandPagesOnline}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Classes="settingsLink" Content="{x:Static app:MotifAppStrings.OpenMotifSite}"
                        Click="OnOpenSiteRequested" AutomationProperties.Name="{x:Static app:MotifAppStrings.OpenMotifSiteAccessibleName}" />
              </Grid>
              </Border>
              <Border Classes="settingsRow">
              <StackPanel Classes="settingsRow">
                <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                  <StackPanel Classes="settingsLabel">
                    <views:CopyableTextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.ReportProblem}" />
                    <views:CopyableTextBlock Classes="settingsCaption" Text="{Binding ReportCaption}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{x:Static app:MotifAppStrings.ReportProblem}" Classes="settingsAction"
                          Click="OnReportProblemRequested" AutomationProperties.Name="{x:Static app:MotifAppStrings.ReportProblemAccessibleName}" />
                </Grid>
                <Expander Header="{x:Static app:MotifAppStrings.WhatReportIncludes}" IsExpanded="{Binding ReportIncludesExpanded}"
                          Classes="settingsReportDetails" AutomationProperties.Name="{x:Static app:MotifAppStrings.WhatReportIncludesAccessibleName}">
                  <views:CopyableTextBlock Classes="settingsReportList" TextWrapping="Wrap"
                             Text="{x:Static app:MotifAppStrings.ReportIncludesList}" />
                </Expander>
              </StackPanel>
              </Border>
            </StackPanel>
<StackPanel x:Name="SettingsAboutSection" Classes="settingsPage">
              <views:CopyableTextBlock Classes="settingsGroupHeading" Text="{x:Static app:MotifAppStrings.AboutMotif}" />
              <Border Classes="settingsAboutRow"><Grid Classes="settingsAboutRow" ColumnDefinitions="Auto,*"
                    RowSpacing="{DynamicResource Intent.Space.Compact}">
                <views:CopyableTextBlock Classes="settingsAboutLabel" Text="{x:Static app:MotifAppStrings.Motif}" />
                <views:CopyableTextBlock Grid.Column="1" Classes="settingsAboutValue" Text="{Binding MotifVersion}" />
              </Grid></Border>
              <Border Classes="settingsAboutRow"><Grid Classes="settingsAboutRow" ColumnDefinitions="Auto,*"
                    RowSpacing="{DynamicResource Intent.Space.Compact}">
                <views:CopyableTextBlock Classes="settingsAboutLabel" Text="{x:Static app:MotifAppStrings.PanGloss}" />
                <StackPanel Grid.Column="1">
                  <views:CopyableTextBlock Classes="settingsAboutValue" Classes.warning="{Binding PanGlossNotFound}"
                             Text="{Binding PanGlossVersion}" TextWrapping="Wrap" />
                  <views:CopyableTextBlock Classes="settingsCaption" Text="{x:Static app:MotifAppStrings.PanGlossMissingCaption}"
                             IsVisible="{Binding PanGlossNotFound}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid></Border>
              <Border Classes="settingsAboutRow"><Grid Classes="settingsAboutRow" ColumnDefinitions="Auto,*"
                    RowSpacing="{DynamicResource Intent.Space.Compact}">
                <views:CopyableTextBlock Classes="settingsAboutLabel" Text="{x:Static app:MotifAppStrings.OperatingSystem}" />
                <views:CopyableTextBlock Grid.Column="1" Classes="settingsAboutValue" Text="{Binding OperatingSystemText}"
                           TextWrapping="Wrap" />
              </Grid></Border>
              <Border Classes="settingsAboutRow"><Grid Classes="settingsAboutRow" RowDefinitions="Auto,Auto"
                    RowSpacing="{DynamicResource Intent.Space.Compact}">
                <views:CopyableTextBlock Classes="settingsAboutLabel" Text="{x:Static app:MotifAppStrings.WhereMotifKeepsItsData}" />
                <Grid x:Name="SettingsAboutDataRow" Classes="settingsAboutDataRow" Grid.Row="1"
                      ColumnDefinitions="*,Auto" RowSpacing="{DynamicResource Intent.Space.Compact}"
                      ColumnSpacing="{DynamicResource Intent.Space.Compact}">
                  <views:CopyableTextBlock Classes="settingsAboutValue" Text="{Binding DataRootDisplay}" TextWrapping="Wrap"
                                           AutomationProperties.Name="{Binding DataRoot}" />
                  <Button Grid.Column="1" Classes="settingsLink" Content="{Binding DataFolderActionText}"
                          Click="OnOpenDataFolderRequested" AutomationProperties.Name="{x:Static app:MotifAppStrings.OpenMotifDataFolderAccessibleName}" />
                </Grid>
              </Grid></Border>
              <views:CopyableTextBlock Classes="settingsCaption" Text="{x:Static app:MotifAppStrings.MotifDataFolderCaption}"
                         TextWrapping="Wrap" />
              <Button Classes="settingsAction" Content="{Binding CopyVersionsText}" Click="OnCopyVersionsRequested"
                      AutomationProperties.Name="{x:Static app:MotifAppStrings.CopyVersionsAccessibleName}" />
              <views:CopyableTextBlock Classes="settingsCaption" Text="{x:Static app:MotifAppStrings.MotifWritesNothingUntilApplyCaption}"
                         TextWrapping="Wrap" />
            </StackPanel>
      </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
