<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.RetirementProposalReviewPanel"
             x:DataType="vm:RetirementProposalReviewViewModel"
             AutomationProperties.Name="{x:Static app:MotifAppStrings.SoundRuleReplacementReviewAccessibleName}">
  <Border Classes="card">
    <StackPanel Classes="reviewCompact">
      <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.ReviewSoundChanges}" />
      <views:CopyableTextBlock Classes="reviewSmall" IsVisible="{Binding HasPendingEvidence}"
                               Text="{Binding PendingEvidenceText}" TextWrapping="Wrap" />
      <views:CopyableTextBlock Classes="reviewSmall" IsVisible="{Binding HasDryRun}"
                               Text="{Binding DryRunSummaryText}" TextWrapping="Wrap" />
      <StackPanel IsVisible="{Binding HasCompleteReview}" Classes="reviewCompact">
      <WrapPanel>
        <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding AffectedWordsText}" FontWeight="{DynamicResource Intent.Weight.Strong}" />
        <views:CopyableTextBlock Classes="reviewSmall reviewGap" Text="{Binding AffectedFormCasesText}" />
      </WrapPanel>
      <ItemsControl x:Name="RetirementReviewStatisticsRows" ItemsSource="{Binding StatisticsRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl x:Name="RetirementReviewParts" ItemsSource="{Binding Parts}"
                    AutomationProperties.Name="{x:Static app:MotifAppStrings.SoundChangesAndAffectedFormsAccessibleName}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RetirementReviewPartViewModel">
            <Border Classes="reviewGroup">
              <StackPanel Classes="reviewCompact">
                <views:CopyableTextBlock Classes="reviewGroupTitle" Text="{Binding Title}" />
                <views:ProgressiveItemsControl x:Name="RetirementReviewPartSummaries" FullItemsSource="{Binding Summaries}"
                                               IsVisible="{Binding HasSummaries}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <views:CopyableTextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </views:ProgressiveItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="reviewAnalysis">
        <StackPanel Classes="reviewCompact">
          <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.TestedReadings}" />
          <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding ReadingResultsText}" TextWrapping="Wrap" />
          <views:ProgressiveItemsControl x:Name="RetirementAffectedReadings"
                                         FullItemsSource="{Binding AffectedReadings}"
                                         AutomationProperties.Name="{x:Static app:MotifAppStrings.BeforeAndAfterEvidenceForEachAccessibleName}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RetirementAffectedReadingViewModel">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Snug}">
                    <views:CopyableTextBlock Text="{Binding OpinionGlyph}" AutomationProperties.Name="{Binding Opinion}" />
                    <views:CopyableTextBlock Text="{Binding Opinion}" FontWeight="{DynamicResource Intent.Weight.Strong}" />
                    <views:CopyableTextBlock Text="{Binding Word}" />
                  </StackPanel>
                  <views:CopyableTextBlock Grid.Column="1" Text="{Binding Verification}" FontWeight="{DynamicResource Intent.Weight.Strong}" />
                  <views:CopyableTextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SurfaceText}" TextWrapping="Wrap"
                                           Classes="reviewSmall" />
                  <views:CopyableTextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding RuleAttribution}"
                                           Classes="reviewSmall" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </views:ProgressiveItemsControl>
          <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding FindingCountsText}" TextWrapping="Wrap" />
          <views:CopyableTextBlock Text="{Binding FindingLineText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="reviewGroup" IsVisible="{Binding HasUnlinkedEffects}">
        <StackPanel Classes="reviewCompact">
          <views:CopyableTextBlock Classes="reviewGroupTitle" Text="{x:Static app:MotifAppStrings.OtherChanges}" />
          <views:CopyableTextBlock Classes="reviewSmall" Text="{x:Static app:MotifAppStrings.SomeObservedChangesCouldNotBe}"
                                   TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="reviewGroup" IsVisible="{Binding HasUnlinkedOperations}">
        <StackPanel Classes="reviewCompact">
          <views:CopyableTextBlock Classes="reviewGroupTitle" Text="{x:Static app:MotifAppStrings.OtherChanges}" />
          <views:CopyableTextBlock Classes="reviewSmall" Text="{x:Static app:MotifAppStrings.SomeChangesNeedFurtherReview}"
                                   TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="reviewGroup uncertain" IsVisible="{Binding HasUnresolved}">
        <StackPanel Classes="reviewCompact">
          <views:CopyableTextBlock Classes="reviewGroupTitle" Text="{x:Static app:MotifAppStrings.DestinationNeeded}" />
          <views:CopyableTextBlock Text="{Binding UnresolvedText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <views:CopyableTextBlock Classes="muted" IsVisible="{Binding HasUnavailable}"
                               Text="{x:Static app:MotifAppStrings.SomeReviewDetailsCouldNotBe}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
