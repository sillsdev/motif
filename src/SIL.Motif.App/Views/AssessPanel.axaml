<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.AssessPanel"
             x:DataType="views:AssessPanel">
  <UserControl.Styles>
    <!-- Every section is an Expander headed by a title and a quiet count beside it. -->
    <Style Selector="Expander.section">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.section-count">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="TextBlock.result">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
    <Style Selector="TextBlock.result.parsed">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorSuccess}" />
    </Style>
    <Style Selector="TextBlock.result.failed">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
    </Style>
    <Style Selector="TextBlock.result.incomplete">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorWarning}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="16,12,16,16" RowSpacing="8">

    <Expander Classes="section" IsExpanded="True" AutomationProperties.Name="Run section">
      <Expander.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="Assess.IsActive" />
          <Binding Path="Assess.Refusal" Converter="{x:Static conv:ObjectConverters.IsNotNull}" />
        </MultiBinding>
      </Expander.IsVisible>
      <Expander.Header>
        <StackPanel Orientation="Horizontal">
          <TextBlock Classes="section-title" Text="Run" />
          <TextBlock Classes="section-count" Text="{Binding Assess.Progress.Message}"
                     IsVisible="{Binding Assess.IsActive}" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="8">
        <Button Content="Cancel"
                Command="{Binding Assess.CancelCommand}"
                IsVisible="{Binding Assess.IsActive}"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Cancel the running Assessment" />
        <ProgressBar IsVisible="{Binding Assess.IsActive}"
                     IsIndeterminate="{Binding Assess.IsIndeterminate}"
                     Minimum="0"
                     Maximum="1"
                     Value="{Binding Assess.ProgressFraction}"
                     AutomationProperties.Name="Assessment progress" />
        <TextBlock Text="{Binding Assess.Progress.Message}"
                   IsVisible="{Binding Assess.IsActive}" />
        <TextBlock Classes="error" Text="{Binding Assess.Refusal.Message}"
                   IsVisible="{Binding Assess.Refusal, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
        <Expander Header="Details"
                  IsExpanded="False"
                  IsVisible="{Binding Assess.Refusal, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <ItemsControl ItemsSource="{Binding Assess.RefusalFacts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </StackPanel>
    </Expander>

    <TextBlock Grid.Row="1" Classes="muted"
               Text="{Binding Assess.Result.CorrectnessStatus}"
               IsVisible="{Binding Assess.Words.HasAny}"
               TextWrapping="Wrap" />

    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="8"
          IsVisible="{Binding Assess.Words.HasAny}">
      <TextBlock Classes="muted"
                 Text="Select a word to see its readings. Try a Word opens it in FieldWorks' Word Analyses; then choose Parser &#9656; Try a Word and the word is already entered."
                 TextWrapping="Wrap" />
        <Grid Grid.Row="1" ColumnDefinitions="*,*,2*" ColumnSpacing="6">
          <TextBox Grid.Column="0" Text="{Binding Assess.Words.WordFilter}"
                   PlaceholderText="Word..." AutomationProperties.Name="Filter words by word" />
          <TextBox Grid.Column="1" Text="{Binding Assess.Words.ResultFilter}"
                   PlaceholderText="Result..." AutomationProperties.Name="Filter words by result" />
          <TextBox Grid.Column="2" Text="{Binding Assess.Words.ReadingFilter}"
                   PlaceholderText="Reading (form or gloss)..." AutomationProperties.Name="Filter words by reading" />
        </Grid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Assess.Words.Rows}"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal"
                  ClipboardCopyMode="IncludeHeader"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  AutomationProperties.Name="Words">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Word" Width="*" SortMemberPath="Word"
                                    ClipboardContentBinding="{ReflectionBinding Word}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:AssessWordRowViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,4">
                    <SelectableTextBlock Text="{Binding Word}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <HyperlinkButton Content="Try a Word"
                                     NavigateUri="{Binding TryWordLink}"
                                     IsVisible="{Binding HasTryWordLink}"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="Open this word in FieldWorks' Word Analyses, then choose Parser ▸ Try a Word"
                                     AutomationProperties.Name="Try this word in FieldWorks" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Result" Width="110" SortMemberPath="Result"
                                    ClipboardContentBinding="{ReflectionBinding Result}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:AssessWordRowViewModel">
                  <TextBlock Classes="result"
                             Classes.parsed="{Binding IsParsed}"
                             Classes.failed="{Binding IsFailed}"
                             Classes.incomplete="{Binding IsIncomplete}"
                             Text="{Binding Result}" Margin="6,4" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding Detail}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="#" Width="60" Binding="{ReflectionBinding ReadingCount}" />
            <DataGridTextColumn Header="Readings (forms = glosses)" Width="2*" Binding="{ReflectionBinding ReadingText}" />
            <DataGridTextColumn Header="Approved" Width="110" Binding="{ReflectionBinding Correctness}" />
            <DataGridTextColumn Header="Time (ms)" Width="90" Binding="{ReflectionBinding ElapsedMs}" />
          </DataGrid.Columns>
          <DataGrid.RowDetailsTemplate>
            <DataTemplate x:DataType="vm:AssessWordRowViewModel">
              <StackPanel Spacing="8" Margin="24,6,6,10">
                <TextBlock Classes="muted" Text="{Binding Detail}" />
                <ItemsControl ItemsSource="{Binding Readings}" AutomationProperties.Name="Parser readings">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ParserReadingViewModel">
                      <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                        <TextBlock Classes="muted" Text="{Binding Number, StringFormat='{}{0}.'}"
                                   VerticalAlignment="Top" />
                        <ItemsControl ItemsSource="{Binding Morphs}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ParserReadingMorphViewModel">
                              <StackPanel Spacing="1" Margin="0,0,18,0">
                                <HyperlinkButton Content="{Binding Form}" NavigateUri="{Binding Link}"
                                                 IsVisible="{Binding HasLink}" Padding="0" FontWeight="SemiBold"
                                                 ToolTip.Tip="Open this morpheme's entry in FieldWorks" />
                                <TextBlock Text="{Binding Form}" IsVisible="{Binding HasNoLink}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Gloss}" />
                                <TextBlock Classes="muted" Text="{Binding Category}" FontSize="12" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" Text="No readings: the parser found no way to build this word."
                           IsVisible="{Binding !HasReadings}" />
                <ItemsControl ItemsSource="{Binding Unavailable}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="error" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>
  </Grid>
</UserControl>
