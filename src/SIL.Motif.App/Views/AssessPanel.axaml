<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.AssessPanel"
             x:DataType="views:AssessPanel">
  <UserControl.Styles>
    <Style Selector="Expander.section">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.section-count">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="TextBlock.result, Border.chip TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
    <Style Selector="Border.chip.parsed, Border.chip.approved">
      <Setter Property="Background" Value="{DynamicResource SemiColorSuccessLight}" />
    </Style>
    <Style Selector="Border.chip.parsed TextBlock, Border.chip.approved TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorSuccess}" />
    </Style>
    <Style Selector="Border.chip.failed, Border.chip.disapproved">
      <Setter Property="Background" Value="{DynamicResource SemiColorDangerLight}" />
    </Style>
    <Style Selector="Border.chip.failed TextBlock, Border.chip.disapproved TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
    </Style>
    <Style Selector="Border.chip.incomplete, Border.chip.missed">
      <Setter Property="Background" Value="{DynamicResource SemiColorWarningLight}" />
    </Style>
    <Style Selector="Border.chip.incomplete TextBlock, Border.chip.missed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorWarning}" />
    </Style>
    <Style Selector="Button.filterChip">
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.filterChip.active">
      <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
    </Style>
    <Style Selector="Button.viewChip">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.viewChip.active">
      <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.deepest">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="16,12,16,16" RowSpacing="8">

    <Expander Classes="section" IsExpanded="True" AutomationProperties.Name="Run section">
      <Expander.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="Assess.IsActive" />
          <Binding Path="Assess.Refusal" Converter="{x:Static conv:ObjectConverters.IsNotNull}" />
        </MultiBinding>
      </Expander.IsVisible>
      <Expander.Header>
        <StackPanel Orientation="Horizontal">
          <TextBlock Classes="section-title" Text="Run" />
          <TextBlock Classes="section-count" Text="{Binding Assess.Progress.Message}"
                     IsVisible="{Binding Assess.IsActive}" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="8">
        <Button Content="Cancel"
                Command="{Binding Assess.CancelCommand}"
                IsVisible="{Binding Assess.IsActive}"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Cancel the running Assessment" />
        <ProgressBar IsVisible="{Binding Assess.IsActive}"
                     IsIndeterminate="{Binding Assess.IsIndeterminate}"
                     Minimum="0"
                     Maximum="1"
                     Value="{Binding Assess.ProgressFraction}"
                     AutomationProperties.Name="Assessment progress" />
        <TextBlock Text="{Binding Assess.Progress.Message}"
                   IsVisible="{Binding Assess.IsActive}" />
        <TextBlock Classes="error" Text="{Binding Assess.Refusal.Message}"
                   IsVisible="{Binding Assess.Refusal, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
        <Expander Header="Details"
                  IsExpanded="False"
                  IsVisible="{Binding Assess.Refusal, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <ItemsControl ItemsSource="{Binding Assess.RefusalFacts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </StackPanel>
    </Expander>

    <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="12" IsVisible="{Binding Assess.Words.HasAny}">

      <!-- Left: the word list, searched and filtered by chip. -->
      <Grid ColumnDefinitions="1*" RowDefinitions="Auto,Auto,*" RowSpacing="6">
        <TextBox Grid.Row="0" Text="{Binding Assess.Words.WordFilter}"
                 PlaceholderText="Search words..." AutomationProperties.Name="Filter words by word" />
        <WrapPanel Grid.Row="1">
          <Button Classes="filterChip" Content="{Binding Assess.Words.AllCount, StringFormat='All {0}'}"
                  Classes.active="{Binding Assess.Words.SelectedFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsWordFilter.All}}"
                  Command="{Binding Assess.Words.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsWordFilter.All}"
                  AutomationProperties.Name="Show all results" Margin="0,0,4,4" />
          <Button Classes="filterChip" Content="{Binding Assess.Words.MissedCount, StringFormat='Missed {0}'}"
                  Classes.active="{Binding Assess.Words.SelectedFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsWordFilter.Missed}}"
                  Command="{Binding Assess.Words.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsWordFilter.Missed}"
                  AutomationProperties.Name="Show missed results" Margin="0,0,4,4" />
          <Button Classes="filterChip" Content="{Binding Assess.Words.DisapprovedCount, StringFormat='Disapproved {0}'}"
                  Classes.active="{Binding Assess.Words.SelectedFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsWordFilter.Disapproved}}"
                  Command="{Binding Assess.Words.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsWordFilter.Disapproved}"
                  AutomationProperties.Name="Show disapproved results" Margin="0,0,4,4" />
          <Button Classes="filterChip" Content="{Binding Assess.Words.NoOpinionCount, StringFormat='No opinion {0}'}"
                  Classes.active="{Binding Assess.Words.SelectedFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsWordFilter.NoOpinion}}"
                  Command="{Binding Assess.Words.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsWordFilter.NoOpinion}"
                  AutomationProperties.Name="Show no-opinion results" Margin="0,0,4,4" />
          <Button Classes="filterChip" Content="{Binding Assess.Words.NoParseCount, StringFormat='No parse {0}'}"
                  Classes.active="{Binding Assess.Words.SelectedFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsWordFilter.NoParse}}"
                  Command="{Binding Assess.Words.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsWordFilter.NoParse}"
                  AutomationProperties.Name="Show no-parse results" Margin="0,0,4,4" />
          <Button Classes="filterChip" Content="{Binding Assess.Words.LimitCount, StringFormat='Limit {0}'}"
                  Classes.active="{Binding Assess.Words.SelectedFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsWordFilter.Limit}}"
                  Command="{Binding Assess.Words.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsWordFilter.Limit}"
                  AutomationProperties.Name="Show limited results" Margin="0,0,4,4" />
        </WrapPanel>
        <ListBox Grid.Row="2" ItemsSource="{Binding Assess.Words.Rows}"
                 SelectedItem="{Binding Assess.Words.SelectedRow}"
                 AutomationProperties.Name="Words">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AssessWordRowViewModel">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Word}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="{Binding OccurrenceCount, StringFormat='×{0}'}"
                             IsVisible="{Binding HasOccurrenceCount}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
                  <Border Classes="chip" Classes.parsed="{Binding IsParsed}" Classes.failed="{Binding IsFailed}"
                          Classes.incomplete="{Binding IsIncomplete}">
                    <TextBlock Text="{Binding Result}" />
                  </Border>
                  <Border Classes="chip" Classes.approved="{Binding VsProject, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Approved'}"
                          Classes.disapproved="{Binding VsProject, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Disapproved'}"
                          Classes.missed="{Binding VsProject, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Missed'}">
                    <TextBlock Text="{Binding VsProject}" />
                  </Border>
                  <TextBlock Grid.Column="1" Classes="muted" Text="{Binding ElapsedMs, StringFormat='{}{0} ms'}"
                             HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- Right: the selected word's story, then Analyses and Try a Word side by side. -->
      <ScrollViewer Grid.Column="1" IsVisible="{Binding Assess.Words.SelectedRow, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="12" DataContext="{Binding Assess.Words.SelectedRow}" x:DataType="vm:AssessWordRowViewModel">

          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Word}" Classes="section-title" />
            <HyperlinkButton Content="Open in FieldWorks"
                             NavigateUri="{Binding TryWordLink}"
                             IsVisible="{Binding HasTryWordLink}"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="Open the selected word in FieldWorks" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="chip" Classes.parsed="{Binding IsParsed}" Classes.failed="{Binding IsFailed}"
                    Classes.incomplete="{Binding IsIncomplete}">
              <TextBlock Text="{Binding Result}" />
            </Border>
            <TextBlock Classes="muted" Text="{Binding ReadingCount, StringFormat='{}{0} reading(s)'}" VerticalAlignment="Center" />
            <Border Classes="chip" Classes.approved="{Binding VsProject, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Approved'}"
                    Classes.disapproved="{Binding VsProject, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Disapproved'}"
                    Classes.missed="{Binding VsProject, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter='Missed'}">
              <TextBlock Text="{Binding VsProject}" />
            </Border>
            <TextBlock Classes="muted" Text="{Binding ElapsedMs, StringFormat='{}{0} ms'}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding Attempts, StringFormat='{}{0} attempts'}" VerticalAlignment="Center"
                       IsVisible="{Binding Attempts, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="muted" Text="{Binding Passes, StringFormat='{}{0} passes'}" VerticalAlignment="Center"
                       IsVisible="{Binding Passes, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
          </StackPanel>

          <TextBlock Classes="muted" Text="No readings: the parser found no way to build this word."
                     IsVisible="{Binding !HasReadings}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Analyses: the parser's readings and the project's missed approved analyses, graded. -->
            <StackPanel Grid.Column="0" Spacing="8"
                        IsVisible="{Binding $parent[views:AssessPanel].Assess.Trace.IsFocused, Converter={x:Static BoolConverters.Not}}">
              <TextBlock Classes="section-title" Text="Analyses" FontSize="14" />
              <ItemsControl ItemsSource="{Binding Readings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ParserReadingViewModel">
                    <Border Classes="card" Margin="0,0,0,6" Padding="10">
                      <StackPanel Spacing="4">
                        <ItemsControl ItemsSource="{Binding Morphs}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ParserReadingMorphViewModel">
                              <StackPanel Spacing="1" Margin="0,0,14,0">
                                <HyperlinkButton Content="{Binding Form}" NavigateUri="{Binding Link}"
                                                 IsVisible="{Binding HasLink}" Padding="0" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Form}" IsVisible="{Binding HasNoLink}" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" Text="{Binding Gloss}" FontSize="12" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="muted" Text="Parser ✓" FontSize="11" IsVisible="{Binding ShowParserProduced}" />
                          <TextBlock Classes="muted" Text="Project ✓" FontSize="11" IsVisible="{Binding ShowProjectApproved}" />
                          <Border Classes="chip" Classes.disapproved="{Binding IsDisapproved}" Classes.missed="{Binding IsMissed}"
                                  Classes.approved="{Binding IsApproved}">
                            <TextBlock Text="{Binding GradeLabel}" />
                          </Border>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding MissedApproved}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ParserReadingViewModel">
                    <Border Classes="card" Margin="0,0,0,6" Padding="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        <Border Classes="chip missed" HorizontalAlignment="Left">
                          <TextBlock Text="Missed" />
                        </Border>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                         Text="Compared by form, entry, grammatical category and inflection type. Sense is not compared." />
            </StackPanel>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"
                          IsVisible="{Binding $parent[views:AssessPanel].Assess.Trace.IsFocused, Converter={x:Static BoolConverters.Not}}" />

            <!-- Try a Word: trace any word on demand against the current Baseline's grammar. Focus mode
                 widens this to the full row for an in-depth look at one path's steps. -->
            <StackPanel Grid.Column="{Binding $parent[views:AssessPanel].Assess.Trace.IsFocused, Converter={x:Static views:AssessPanel.FocusedColumn}}"
                        Grid.ColumnSpan="{Binding $parent[views:AssessPanel].Assess.Trace.IsFocused, Converter={x:Static views:AssessPanel.FocusedSpan}}"
                        Spacing="8" DataContext="{Binding $parent[views:AssessPanel].Assess.Trace}"
                        x:DataType="vm:TraceWordViewModel">
              <DockPanel LastChildFill="True">
                <ToggleButton DockPanel.Dock="Right" Content="{Binding FocusToggleLabel}" IsChecked="{Binding IsFocused}"
                              AutomationProperties.Name="Toggle focusing Try a Word" />
                <TextBlock Classes="section-title" Text="Try a Word" FontSize="14" VerticalAlignment="Center" />
              </DockPanel>
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Try it" Command="{Binding TryCommand}"
                        AutomationProperties.Name="Try the word" Margin="6,0,0,0" />
                <TextBox Text="{Binding WordToTry}" PlaceholderText="Try another word..."
                         AutomationProperties.Name="Word to try" />
              </DockPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="viewChip" Content="Candidates" Classes.active="{Binding ShowCandidates}"
                        Command="{Binding SetViewCommand}" CommandParameter="{x:Static vm:TraceView.Candidates}"
                        AutomationProperties.Name="Show trace candidates" />
                <Button Classes="viewChip" Content="Full derivation" Classes.active="{Binding ShowFullDerivation}"
                        Command="{Binding SetViewCommand}" CommandParameter="{x:Static vm:TraceView.FullDerivation}"
                        AutomationProperties.Name="Show the full derivation" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoading}">
                <TextBlock Classes="muted" Text="Tracing... this can take up to two minutes." VerticalAlignment="Center" />
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        AutomationProperties.Name="Cancel the trace" />
              </StackPanel>
              <TextBlock Classes="error" Text="{Binding Refusal.Message}"
                         IsVisible="{Binding Refusal, Converter={x:Static conv:ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />

              <!-- Every candidate expands into its own full, ordered step list — root first, not just the
                   final failure — so each path the parser tried can be read in depth, not only its outcome. -->
              <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                       IsVisible="{Binding ShowCandidates}" AutomationProperties.Name="Trace candidates">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TraceCandidateViewModel">
                    <Expander Margin="0,0,0,6">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Text}" FontWeight="SemiBold" />
                          <TextBlock Classes="muted" Text="{Binding Gloss}" />
                          <TextBlock Text="✓" Foreground="{DynamicResource SemiColorSuccess}" IsVisible="{Binding Succeeded}" />
                          <TextBlock Text="✗" Foreground="{DynamicResource SemiColorDanger}" IsVisible="{Binding !Succeeded}" />
                        </StackPanel>
                      </Expander.Header>
                      <StackPanel Spacing="4">
                        <TextBlock Classes="muted" Text="{Binding Explanation}" TextWrapping="Wrap"
                                   IsVisible="{Binding Explanation, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        <ItemsControl ItemsSource="{Binding Steps}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TraceStepViewModel">
                              <Button Background="Transparent" BorderThickness="0" Padding="4,2" HorizontalContentAlignment="Left"
                                      HorizontalAlignment="Stretch" Click="OnTraceStepClick" Tag="{Binding}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                  <TextBlock Grid.Column="0" Text="✓" Foreground="{DynamicResource SemiColorSuccess}" IsVisible="{Binding Passed}" />
                                  <TextBlock Grid.Column="0" Text="✗" Foreground="{DynamicResource SemiColorDanger}" IsVisible="{Binding !Passed}" />
                                  <StackPanel Grid.Column="1" Spacing="0">
                                    <TextBlock FontSize="12" Classes.deepest="{Binding IsDeepest}">
                                      <Run Text="{Binding Type}" FontWeight="SemiBold" />
                                      <Run Text=" " />
                                      <Run Text="{Binding Source}" Foreground="{DynamicResource SemiColorLink}"
                                           FontFamily="Cascadia Mono, Consolas, monospace" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Classes="muted"
                                               Text="{Binding Input, StringFormat='{}{0} →'}"
                                               IsVisible="{Binding Input, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="2" FontSize="11" Text="{Binding Output}" />
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Expander>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Grid IsVisible="{Binding ShowFullDerivation}" MinHeight="200">
                <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedStep}">
                  <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                      <Setter Property="IsExpanded" Value="True" />
                    </Style>
                  </TreeView.Styles>
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:TraceStepViewModel" ItemsSource="{Binding Children}">
                      <TextBlock Text="{Binding Label}" FontSize="12" Classes.deepest="{Binding IsDeepest}" />
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </Grid>

              <!-- Shared by both views: whichever step was last selected, from a candidate's path or the tree. -->
              <Border Classes="card" Padding="10" IsVisible="{Binding SelectedStep, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="4" DataContext="{Binding SelectedStep}" x:DataType="vm:TraceStepViewModel">
                  <TextBlock Classes="section-title" Text="Selected step" FontSize="13" />
                  <TextBlock Text="{Binding Type}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Source, StringFormat='Rule: {0}'}"
                             IsVisible="{Binding Source, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Input, StringFormat='Input: {0}'}"
                             IsVisible="{Binding Input, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Output, StringFormat='Output: {0}'}"
                             IsVisible="{Binding Output, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                  <TextBlock Text="Passed" Foreground="{DynamicResource SemiColorSuccess}" FontWeight="SemiBold"
                             IsVisible="{Binding Passed}" />
                  <TextBlock Classes="error" Text="{Binding FailureReason}" IsVisible="{Binding HasFailureReason}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
