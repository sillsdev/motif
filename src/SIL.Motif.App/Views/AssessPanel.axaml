<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.AssessPanel"
             x:DataType="views:AssessPanel">
  <UserControl.Styles>
    <Style Selector="Expander.section">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector=":is(TextBlock).section-count">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="Button.viewChip">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.viewChip.active">
      <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(TextBlock).deepest">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="16,12,16,16" RowSpacing="8">

    <Expander Classes="section" IsExpanded="True" AutomationProperties.Name="Run section">
      <Expander.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="Assess.IsActive" />
          <Binding Path="Assess.Refusal" Converter="{x:Static conv:ObjectConverters.IsNotNull}" />
        </MultiBinding>
      </Expander.IsVisible>
      <Expander.Header>
        <StackPanel Orientation="Horizontal">
          <views:CopyableTextBlock Classes="section-title" Text="Run" />
          <views:CopyableTextBlock Classes="section-count" Text="{Binding Assess.Progress.Message}"
                     IsVisible="{Binding Assess.IsActive}" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="8">
        <Button Content="Cancel"
                Command="{Binding Assess.CancelCommand}"
                IsVisible="{Binding Assess.IsActive}"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Cancel the running Assessment" />
        <ProgressBar IsVisible="{Binding Assess.IsActive}"
                     IsIndeterminate="{Binding Assess.IsIndeterminate}"
                     Minimum="0"
                     Maximum="1"
                     Value="{Binding Assess.ProgressFraction}"
                     AutomationProperties.Name="Assessment progress" />
        <views:CopyableTextBlock Text="{Binding Assess.Progress.Message}"
                   IsVisible="{Binding Assess.IsActive}" />
        <views:CopyableTextBlock Classes="error" Text="{Binding Assess.Refusal.Message}"
                   IsVisible="{Binding Assess.Refusal, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
        <Expander Header="Details"
                  IsExpanded="False"
                  IsVisible="{Binding Assess.Refusal, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <ItemsControl ItemsSource="{Binding Assess.RefusalFacts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <views:CopyableTextBlock Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </StackPanel>
    </Expander>

    <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="12" IsVisible="{Binding Assess.Words.HasAny}">

      <!-- Left: the word list, searched and filtered by chip. -->
      <Grid ColumnDefinitions="1*" RowDefinitions="Auto,Auto,*" RowSpacing="6">
        <TextBox Grid.Row="0" Text="{Binding Assess.Words.WordFilter}"
                 PlaceholderText="Search words..." AutomationProperties.Name="Filter words by word" />
        <!-- Two questions, two rows of chips: what the parser came to, and how that compares with the project. -->
        <StackPanel Grid.Row="1" Spacing="4">
          <views:CopyableTextBlock Classes="muted" FontSize="11" Text="Parser result" />
          <WrapPanel>
            <views:FilterChip Label="All" Count="{Binding Assess.Words.AllCount}"
                            IsActive="{Binding Assess.Words.SelectedFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsWordFilter.All}}"
                            Command="{Binding Assess.Words.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsWordFilter.All}" />
            <views:FilterChip Label="No parse" Count="{Binding Assess.Words.NoParseCount}" Verdict="NoResult"
                            IsActive="{Binding Assess.Words.SelectedFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsWordFilter.NoParse}}"
                            Command="{Binding Assess.Words.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsWordFilter.NoParse}" />
            <views:FilterChip Label="Limit" Count="{Binding Assess.Words.LimitCount}" Verdict="Limit"
                            IsActive="{Binding Assess.Words.SelectedFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsWordFilter.Limit}}"
                            Command="{Binding Assess.Words.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsWordFilter.Limit}" />
          </WrapPanel>
          <views:CopyableTextBlock Classes="muted" FontSize="11" Text="Against the project (a word can be in both rows)" />
          <WrapPanel>
            <views:FilterChip Label="Missed" Count="{Binding Assess.Words.MissedCount}" Verdict="NoResult"
                            IsActive="{Binding Assess.Words.SelectedFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsWordFilter.Missed}}"
                            Command="{Binding Assess.Words.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsWordFilter.Missed}" />
            <views:FilterChip Label="Disapproved" Count="{Binding Assess.Words.DisapprovedCount}" Verdict="Differs"
                            IsActive="{Binding Assess.Words.SelectedFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsWordFilter.Disapproved}}"
                            Command="{Binding Assess.Words.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsWordFilter.Disapproved}" />
            <views:FilterChip Label="No opinion" Count="{Binding Assess.Words.NoOpinionCount}" Verdict="New"
                            IsActive="{Binding Assess.Words.SelectedFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsWordFilter.NoOpinion}}"
                            Command="{Binding Assess.Words.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsWordFilter.NoOpinion}" />
          </WrapPanel>
        </StackPanel>
        <ListBox Grid.Row="2" ItemsSource="{Binding Assess.Words.Rows}"
                 SelectedItem="{Binding Assess.Words.SelectedRow}"
                 AutomationProperties.Name="Words">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AssessWordRowViewModel">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                  <views:CopyableTextBlock Text="{Binding Word}" FontWeight="SemiBold" />
                  <views:CopyableTextBlock Classes="muted" Text="{Binding OccurrenceCount, StringFormat='×{0}'}"
                             IsVisible="{Binding HasOccurrenceCount}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
                  <views:VerdictChip Verdict="{Binding ResultMeaning}" Text="{Binding Result}" Compact="True" />
                  <views:VerdictChip Verdict="{Binding Meaning}" Text="{Binding VsProject}" IsVisible="{Binding HasVsProject}" />
                  <views:CopyableTextBlock Grid.Column="1" Classes="muted" Text="{Binding ElapsedText}"
                             HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- Right: the selected word's story, then Analyses and Try a Word side by side. -->
      <ScrollViewer Grid.Column="1" IsVisible="{Binding Assess.Words.SelectedRow, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="12" DataContext="{Binding Assess.Words.SelectedRow}" x:DataType="vm:AssessWordRowViewModel">

          <StackPanel Orientation="Horizontal" Spacing="10">
            <views:CopyableTextBlock Text="{Binding Word}" Classes="section-title" />
            <HyperlinkButton Content="Open in FieldWorks"
                             NavigateUri="{Binding TryWordLink}"
                             IsVisible="{Binding HasTryWordLink}"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="Open the selected word in FieldWorks" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <views:VerdictChip Verdict="{Binding ResultMeaning}" Text="{Binding Result}" />
            <views:CopyableTextBlock Classes="muted" Text="{Binding ReadingCountText}" VerticalAlignment="Center" />
            <views:VerdictChip Verdict="{Binding Meaning}" Text="{Binding VsProject}" IsVisible="{Binding HasVsProject}" />
            <views:CopyableTextBlock Classes="muted" Text="{Binding ElapsedText}" VerticalAlignment="Center" />
            <views:CopyableTextBlock Classes="muted" Text="{Binding Attempts, StringFormat='{}{0:N0} attempts'}" VerticalAlignment="Center"
                       IsVisible="{Binding Attempts, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <views:CopyableTextBlock Classes="muted" Text="{Binding Passes, StringFormat='{}{0:N0} passes'}" VerticalAlignment="Center"
                       IsVisible="{Binding HasPasses}" />
            <views:CopyableTextBlock Classes="muted" Text="{Binding Correctness}" VerticalAlignment="Center"
                       IsVisible="{Binding Correctness, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       ToolTip.Tip="How many of the analyses the project approves the parser produced" />
          </StackPanel>

          <views:CopyableTextBlock Classes="muted" Text="{Binding NoReadingsText}"
                     IsVisible="{Binding !HasReadings}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Analyses: the parser's readings and the project's missed approved analyses, graded. -->
            <StackPanel Grid.Column="0" Spacing="8"
                        IsVisible="{Binding $parent[views:AssessPanel].Assess.Trace.IsFocused, Converter={x:Static BoolConverters.Not}}">
              <views:CopyableTextBlock Classes="section-title" Text="Analyses" FontSize="14" />
              <ItemsControl ItemsSource="{Binding Readings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ParserReadingViewModel">
                    <Border Classes="card" Margin="0,0,0,6" Padding="10">
                      <StackPanel Spacing="4">
                        <views:MorphemeRow Morphs="{Binding Morphs}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <views:CopyableTextBlock Classes="muted" Text="Parser ✓" FontSize="11" IsVisible="{Binding ShowParserProduced}" />
                          <views:CopyableTextBlock Classes="muted" Text="Project ✓" FontSize="11" IsVisible="{Binding ShowProjectApproved}" />
                          <views:VerdictChip Verdict="{Binding Meaning}" Text="{Binding GradeLabel}" Compact="True"
                                             IsVisible="{Binding GradeLabel, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding MissedApproved}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ParserReadingViewModel">
                    <Border Classes="card" Margin="0,0,0,6" Padding="10">
                      <StackPanel Spacing="4">
                        <views:MorphemeRow Morphs="{Binding Morphs}" />
                        <DockPanel>
                          <views:VerdictChip DockPanel.Dock="Left" Verdict="{Binding Meaning}" Text="{Binding GradeLabel}"
                                             Compact="True" VerticalAlignment="Top" Margin="0,0,8,0" />
                          <views:CopyableTextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Text="{Binding MissedExplanation}" />
                        </DockPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                         Text="Compared by form, entry, grammatical category and inflection type. Sense is not compared." />
            </StackPanel>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"
                          IsVisible="{Binding $parent[views:AssessPanel].Assess.Trace.IsFocused, Converter={x:Static BoolConverters.Not}}" />

            <!-- Try a Word: trace any word on demand against the current Baseline's grammar. Focus mode
                 widens this to the full row for an in-depth look at one path's steps. -->
            <StackPanel Grid.Column="{Binding $parent[views:AssessPanel].Assess.Trace.IsFocused, Converter={x:Static views:AssessPanel.FocusedColumn}}"
                        Grid.ColumnSpan="{Binding $parent[views:AssessPanel].Assess.Trace.IsFocused, Converter={x:Static views:AssessPanel.FocusedSpan}}"
                        Spacing="8" DataContext="{Binding $parent[views:AssessPanel].Assess.Trace}"
                        x:DataType="vm:TraceWordViewModel">
              <DockPanel LastChildFill="True">
                <ToggleButton DockPanel.Dock="Right" Content="{Binding FocusToggleLabel}" IsChecked="{Binding IsFocused}"
                              AutomationProperties.Name="Toggle focusing Try a Word" />
                <views:CopyableTextBlock Classes="section-title" Text="Try a Word" FontSize="14" VerticalAlignment="Center" />
              </DockPanel>
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Try it" Command="{Binding TryCommand}"
                        AutomationProperties.Name="Try the word" Margin="6,0,0,0" />
                <TextBox Text="{Binding WordToTry}" PlaceholderText="Try another word..."
                         AutomationProperties.Name="Word to try" />
              </DockPanel>

              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoading}">
                <views:CopyableTextBlock Classes="muted" Text="Tracing... this can take up to two minutes." VerticalAlignment="Center" />
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        AutomationProperties.Name="Cancel the trace" />
              </StackPanel>
              <views:CopyableTextBlock Classes="error" Text="{Binding Refusal.Message}"
                         IsVisible="{Binding Refusal, Converter={x:Static conv:ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />

              <ContentControl x:Name="RichDiagnosticHost"
                              IsVisible="{Binding HasResult}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
