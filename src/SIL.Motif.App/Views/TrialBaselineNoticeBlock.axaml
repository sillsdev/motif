<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             x:Class="SIL.Motif.App.Views.TrialBaselineNoticeBlock"
             x:DataType="x:String">
  <Border x:Name="TrialBaselineNotice" Classes="notice"
          IsVisible="{Binding Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
          AutomationProperties.Name="Trial not compared against a Baseline">
    <views:CopyableTextBlock x:Name="TrialBaselineNoticeText" Text="{Binding}" TextWrapping="Wrap" />
  </Border>
</UserControl>
