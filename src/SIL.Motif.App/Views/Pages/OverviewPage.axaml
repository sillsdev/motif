<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:queries="clr-namespace:SIL.Motif.Commands.Queries;assembly=SIL.Motif.Commands"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.OverviewPage"
             x:DataType="vm:OverviewPageModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Classes="overviewPage">
      <Border Classes="card overviewHeader" AutomationProperties.Name="Project summary">
        <StackPanel Classes="overviewHeaderContent">
          <StackPanel Classes="overviewProject">
            <views:CopyableTextBlock Classes="overviewProjectName" Text="{Binding ProjectTitle}" />
            <views:CopyableTextBlock Classes="overviewMuted" Text="{Binding ProjectFileName}" />
          </StackPanel>
          <Border Classes="notice" IsVisible="{Binding HasOverviewRefusal}"
                  AutomationProperties.Name="The Overview could not be read">
            <DockPanel LastChildFill="True">
              <StackPanel Classes="overviewRefusalActions" DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Try again" Command="{Binding RetryOverviewCommand}"
                        AutomationProperties.Name="Read the Overview again" />
                <HyperlinkButton Classes="reviewLink" Content="Report a problem" NavigateUri="{Binding ReportProblemUri}"
                                 AutomationProperties.Name="Report a problem with the Overview" />
              </StackPanel>
              <views:CopyableTextBlock Text="{Binding OverviewRefusalLine}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <UniformGrid Classes="overviewCounts" Rows="1" Columns="5" IsVisible="{Binding ShowNumbers}">
            <StackPanel Classes="overviewCount">
              <views:CopyableTextBlock Classes="overviewCountValue" Text="{Binding SelectionWordCountText}"
                                       AutomationProperties.AutomationId="{x:Static app:AutomationIds.OverviewSelectionWordCount}" />
              <views:CopyableTextBlock Classes="overviewMuted" Text="words in Selection" />
            </StackPanel>
            <StackPanel Classes="overviewCount">
              <views:CopyableTextBlock Classes="overviewCountValue" Text="{Binding TextOccurrenceCountText}" />
              <views:CopyableTextBlock Classes="overviewMuted" Text="occurrences" />
            </StackPanel>
            <StackPanel Classes="overviewCount">
              <views:CopyableTextBlock Classes="overviewCountValue" Text="{Binding WordformCountText}" />
              <views:CopyableTextBlock Classes="overviewMuted" Text="wordforms" />
            </StackPanel>
            <StackPanel Classes="overviewCount">
              <views:CopyableTextBlock Classes="overviewCountValue" Text="{Binding RuleCountText}" />
              <views:CopyableTextBlock Classes="overviewMuted" Text="rules" />
            </StackPanel>
            <StackPanel Classes="overviewCount">
              <views:CopyableTextBlock Classes="overviewCountValue" Text="{Binding LexemeCountText}" />
              <views:CopyableTextBlock Classes="overviewMuted" Text="lexemes" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Border Classes="notice" IsVisible="{Binding SelectionIsUnresolved}">
        <views:CopyableTextBlock Text="The default Selection could not be resolved against the current Baseline; its word and occurrence counts are unavailable."
                                 TextWrapping="Wrap" />
      </Border>
      <Border Classes="card" IsVisible="{Binding Context.NeedsAssessment}">
        <views:ParsePrompt DataContext="{Binding Context}" />
      </Border>

      <Border Classes="card overviewLookFirst" IsVisible="{Binding HasLookFirstRows}"
              AutomationProperties.Name="Look first">
        <StackPanel Classes="overviewLookFirstContent">
          <TextBlock Classes="overviewTileTitle" Text="Look first" />
          <ItemsControl ItemsSource="{Binding LookFirstRows}" AutomationProperties.Name="Stored results to look at first">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OverviewLookFirstRow">
                <Border Classes="hoverReveal">
                  <Button Classes="overviewLookFirstRow" Command="{Binding OpenCommand}"
                          AutomationProperties.Name="{Binding LinkText}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
                      <TextBlock Classes="overviewLookFirstNumber" Text="{Binding Number}" />
                      <StackPanel Grid.Column="1" Classes="overviewLookFirstWords">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                        <TextBlock Classes="overviewMuted" Text="{Binding Detail}" TextWrapping="Wrap"
                                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="overviewLookFirstAction revealOnHover" Text="{Binding LinkText}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <UniformGrid Classes="overviewTiles" Rows="2" Columns="2" IsVisible="{Binding ShowWarningsTile}">
        <Border Classes="overviewTile hoverReveal" IsVisible="{Binding ShowTiles}"
                AutomationProperties.Name="Speed">
          <StackPanel Classes="overviewTileContent">
            <DockPanel LastChildFill="False">
              <TextBlock Classes="overviewTileTitle" Text="Speed" DockPanel.Dock="Left" />
              <HyperlinkButton Classes="overviewTileLink revealControl revealLink revealOnHover" Content="Timing →" DockPanel.Dock="Right"
                               Command="{Binding OpenTimingCommand}" AutomationProperties.Name="Open Speed in Timing" />
            </DockPanel>
            <TextBlock Classes="overviewTileValue" Text="{Binding SpeedMain}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="{x:Static app:AutomationIds.OverviewSpeed}" />
            <TextBlock Classes="overviewMuted" Text="{Binding SpeedMedian}" TextWrapping="Wrap" />
            <TextBlock Classes="overviewTileDetail" Text="{Binding SpeedDetails}" TextWrapping="Wrap"
                       IsVisible="{Binding SpeedDetails, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Grid.IsSharedSizeScope="True" IsVisible="{Binding HasSlowestWordRows}">
              <TextBlock Classes="overviewTileDetail" Text="Slowest words" />
              <ItemsControl ItemsSource="{Binding SlowestWordRows}" AutomationProperties.Name="Slowest words"
                            KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ListedWordViewModel">
                    <views:WordRow Row="{Binding Row}" List="overview-slowest" IsOpen="{Binding IsOpen}"
                                   Columns="{x:Static views:WordRowColumnSets.Overview}" TimeText="{Binding TimeText}">
                      <views:WordRow.Card>
                        <views:ListedWordCard />
                      </views:WordRow.Card>
                    </views:WordRow>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Classes="overviewTileDetail" Text="Time by kind"
                       IsVisible="{Binding HasTimingKindShares}" />
            <views:TimingKindBar x:Name="OverviewKindBar" Rows="{Binding TimingKindShares}"
                                 Height="{DynamicResource Component.Overview.KindBarHeight}"
                                 IsVisible="{Binding HasTimingKindShares}" />
            <ItemsControl ItemsSource="{Binding #OverviewKindBar.Legend}" IsVisible="{Binding HasTimingKindShares}"
                          AutomationProperties.Name="Overview time by kind">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="views:TimingKindLegendEntry">
                  <StackPanel Classes="outcomeLegendEntry" Orientation="Horizontal">
                    <Border Classes="outcomeSegment swatch" Background="{Binding Brush}" />
                    <TextBlock Classes="outcomeLegendText" Text="{Binding Row.Label}" />
                    <TextBlock Classes="outcomeLegendText" FontWeight="SemiBold" Text="{Binding Row.ShareText}" />
                    <TextBlock Classes="overviewMuted" Text="{Binding Row.TimeText, StringFormat='{}{0}'}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="overviewTileDetail" Text="{Binding TimingAttributionNote}" TextWrapping="Wrap"
                       IsVisible="{Binding TimingAttributionNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <Border Classes="overviewTile hoverReveal" IsVisible="{Binding ShowTiles}"
                AutomationProperties.Name="Text coverage">
          <StackPanel Classes="overviewTileContent">
            <DockPanel LastChildFill="False">
              <TextBlock Classes="overviewTileTitle" Text="Text coverage" DockPanel.Dock="Left" />
              <HyperlinkButton Classes="overviewTileLink revealControl revealLink revealOnHover" Content="Texts →" DockPanel.Dock="Right"
                               Command="{Binding OpenTextCoverageCommand}"
                               AutomationProperties.Name="Open Text coverage in Texts" />
            </DockPanel>
            <TextBlock Classes="overviewTileValue" Text="{Binding TextCoverageMain}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="{x:Static app:AutomationIds.OverviewTextCoverage}" />
            <TextBlock Classes="overviewMuted" Text="{Binding TextCoverageWords}" TextWrapping="Wrap" />
            <views:OutcomeBar Classes="overviewOutcomeBar" Segments="{Binding TextCoverageSegments}" ShowShares="False"
                              AutomationProperties.Name="Text coverage outcomes" />
          </StackPanel>
        </Border>

        <Border Classes="overviewTile hoverReveal" IsVisible="{Binding ShowTiles}"
                AutomationProperties.Name="Approved analyses kept">
          <StackPanel Classes="overviewTileContent">
            <DockPanel LastChildFill="False">
              <TextBlock Classes="overviewTileTitle" Text="Approved analyses kept" DockPanel.Dock="Left" />
              <HyperlinkButton Classes="overviewTileLink revealControl revealLink revealOnHover" Content="Matrix →" DockPanel.Dock="Right"
                               Command="{Binding OpenAccuracyCommand}"
                               AutomationProperties.Name="Open Approved analyses kept in the Matrix" />
            </DockPanel>
            <TextBlock Classes="overviewTileValue" Text="{Binding AccuracyMain}" TextWrapping="Wrap" />
            <TextBlock Classes="overviewMuted" Text="{Binding AccuracyCaption}" TextWrapping="Wrap" />
            <views:OutcomeBar Classes="overviewOutcomeBar" Segments="{Binding AccuracySegments}" ShowShares="False"
                              AutomationProperties.Name="Approved analyses kept outcomes" />
            <TextBlock Classes="overviewTileDetail" Text="{Binding AccuracyBreakdown}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="overviewTile hoverReveal" AutomationProperties.Name="Grammar warnings">
          <StackPanel Classes="overviewTileContent">
            <DockPanel LastChildFill="False">
              <TextBlock Classes="overviewTileTitle" Text="Grammar warnings" DockPanel.Dock="Left" />
              <HyperlinkButton Classes="overviewTileLink revealControl revealLink revealOnHover" Content="Warnings →" DockPanel.Dock="Right"
                               Command="{Binding OpenWarningsCommand}"
                               AutomationProperties.Name="Open Grammar warnings in Warnings" />
            </DockPanel>
            <TextBlock Classes="overviewTileValue" Text="{Binding WarningsCount}" TextWrapping="Wrap" />
            <TextBlock Classes="overviewMuted" Text="{Binding WarningsYourWordsText}"
                       IsVisible="{Binding HasWarningsWordSummary}" TextWrapping="Wrap" />
            <TextBlock Classes="overviewTileDetail" Text="{Binding WarningsSpellingCandidatesText}"
                       IsVisible="{Binding WarningsSpellingCandidatesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding WarningKindRows}" AutomationProperties.Name="Warning kinds and words">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OverviewWarningKindRow">
                  <StackPanel Classes="overviewWarningKindRow">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding WarningCount}" />
                      <TextBlock Grid.Column="2" Classes="overviewMuted" Text="{Binding IdentityMatchedWords}" />
                    </Grid>
                    <TextBlock Classes="overviewTileDetail" Text="{Binding SpellingCandidates}"
                               IsVisible="{Binding SpellingCandidates, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Classes="card overviewHandoff">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Component.Overview.HandoffGap}">
          <PathIcon Classes="overviewHandoffIcon" Data="M12 3l1.8 4.8L18 9.5l-4.2 1.7L12 16l-1.8-4.8L6 9.5l4.2-1.7z M18 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" />
          <views:CopyableTextBlock Grid.Column="1" Classes="overviewHandoffText"
                                   Text="Ask a chat model about anything on this page. AI Handoff writes the files and the question."
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="Start an AI Handoff" Command="{Binding OpenAiHandoffCommand}"
                  AutomationProperties.Name="Start an AI Handoff" />
        </Grid>
      </Border>

      <Expander Classes="overviewHistory" Header="Project history" AutomationProperties.Name="Project history">
        <StackPanel Classes="overviewHistoryContent">
          <views:CopyableTextBlock Classes="overviewMuted" Text="Loading history..." IsVisible="{Binding History.IsLoading}" />
          <views:RefusalBlock DataContext="{Binding History.ShownRefusal}" />
          <views:CopyableTextBlock Classes="overviewMuted" Text="Nothing recorded for this project yet."
                                   IsVisible="{Binding !History.HasEntries}" />
          <ItemsControl ItemsSource="{Binding History.Entries}" AutomationProperties.Name="Project history entries">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectHistoryRow">
                <Border Classes="overviewHistoryEntry">
                  <StackPanel Classes="overviewHistoryRow">
                    <DockPanel LastChildFill="False">
                      <views:CopyableTextBlock DockPanel.Dock="Left" Classes="overviewHistoryKind" Text="{Binding Title}" />
                      <views:CopyableTextBlock DockPanel.Dock="Right" Classes="overviewMuted"
                                               Text="{Binding At.LocalDateTime, StringFormat='{}{0:ddd d MMM, h:mm tt}'}" />
                    </DockPanel>
                    <views:CopyableTextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
