<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SIL.Motif.App.Controls"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:queries="clr-namespace:SIL.Motif.Commands.Queries;assembly=SIL.Motif.Commands"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.OverviewPage"
             x:DataType="vm:OverviewPageModel" controls:WritingSystemText.Resolver="{Binding Context.TextStyles}" SizeChanged="OnOverviewSizeChanged">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Classes="overviewPageFrame">
    <StackPanel Classes="overviewPage">
      <Border Classes="overviewHeader" AutomationProperties.Name="{x:Static app:MotifAppStrings.ProjectSummaryAccessibleName}">
        <StackPanel Classes="overviewHeaderContent">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Related}">
            <views:CopyableTextBlock Classes="overviewProjectName" Text="{x:Static app:MotifAppStrings.Overview}" />
            <views:CopyableTextBlock Grid.Column="1" Classes="overviewMuted" TextWrapping="Wrap"
                                     Text="{Binding ProjectFileName}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="notice" IsVisible="{Binding HasOverviewRefusal}"
                  AutomationProperties.Name="{x:Static app:MotifAppStrings.TheOverviewCouldNotBeReadAccessibleName}">
            <DockPanel LastChildFill="True">
              <StackPanel Classes="overviewRefusalActions" DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static app:MotifAppStrings.TryAgain}" Command="{Binding RetryOverviewCommand}"
                        AutomationProperties.Name="{x:Static app:MotifAppStrings.ReadTheOverviewAgainAccessibleName}" />
              </StackPanel>
              <views:RefusalBlock DataContext="{Binding OverviewRefusal}" />
            </DockPanel>
          </Border>
          <Border Classes="notice" IsVisible="{Binding HasLastParseRefusal}"
                  AutomationProperties.Name="{x:Static app:MotifAppStrings.TheLatestParseWasRefusedAccessibleName}">
            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
              <views:CopyableTextBlock Text="{Binding LastParseRefusal.Sentence}" TextWrapping="Wrap" />
              <Expander Header="{x:Static app:MotifAppStrings.ParseFailureDetails}" AutomationProperties.Name="{x:Static app:MotifAppStrings.LatestParseFailureDetailsAccessibleName}">
                <views:RefusalBlock DataContext="{Binding LastParseRefusal}" />
              </Expander>
            </StackPanel>
          </Border>
          <UniformGrid x:Name="OverviewFigures" Classes="overviewCounts" Rows="1" Columns="5" IsVisible="{Binding ShowNumbers}">
            <StackPanel Classes="overviewCount">
              <views:CopyableTextBlock Classes="overviewCountValue" Text="{Binding SelectionWordCountText}"
                                       AutomationProperties.AutomationId="{x:Static app:AutomationIds.OverviewSelectionWordCount}" />
              <views:CopyableTextBlock Classes="overviewMuted" TextWrapping="Wrap" Text="{x:Static app:MotifAppStrings.WordsInSelection}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.OverviewSelectionLabel}" />
            </StackPanel>
            <StackPanel Classes="overviewCount">
              <views:CopyableTextBlock Classes="overviewCountValue" Text="{Binding TextOccurrenceCountText}" />
              <views:CopyableTextBlock Classes="overviewMuted" TextWrapping="Wrap" Text="{x:Static app:MotifAppStrings.Places}" />
            </StackPanel>
            <StackPanel Classes="overviewCount">
              <views:CopyableTextBlock Classes="overviewCountValue" Text="{Binding WordformCountText}" />
              <views:CopyableTextBlock Classes="overviewMuted" TextWrapping="Wrap" Text="{x:Static app:MotifAppStrings.Wordforms}" />
            </StackPanel>
            <StackPanel Classes="overviewCount">
              <views:CopyableTextBlock Classes="overviewCountValue" Text="{Binding RuleCountText}" />
              <views:CopyableTextBlock Classes="overviewMuted" TextWrapping="Wrap" Text="{x:Static app:MotifAppStrings.Rules}" />
            </StackPanel>
            <StackPanel Classes="overviewCount">
              <views:CopyableTextBlock Classes="overviewCountValue" Text="{Binding LexemeCountText}" />
              <views:CopyableTextBlock Classes="overviewMuted" TextWrapping="Wrap" Text="{x:Static app:MotifAppStrings.Lexemes}" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding ShowChooseProject}"
              AutomationProperties.Name="{x:Static app:MotifAppStrings.ChooseAProjectAccessibleName}">
        <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
          <views:CopyableTextBlock Classes="overviewTileTitle" Text="{x:Static app:MotifAppStrings.OpenARecentProject}" />
          <views:CopyableTextBlock Classes="overviewMuted" Text="{Binding NoKnownProjectsText}"
                                   IsVisible="{Binding ShowNoKnownProjects}" />
          <ItemsControl x:Name="OverviewPageChooseProjectRowsItems" ItemsSource="{Binding ChooseProjectRows}" AutomationProperties.Name="{x:Static app:MotifAppStrings.RecentProjectsAccessibleName}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecentProjectViewModel">
                <Border Classes="overviewRecentRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
                    <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                      <Button Classes="overviewRecentProject" Content="{Binding Name}"
                              Command="{Binding $parent[views:OverviewPage].Page.Context.OpenProjectCommand}"
                              CommandParameter="{Binding FullFwDataPath}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              AutomationProperties.Name="{Binding AutomationName}" />
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}"
                                  IsVisible="{Binding HasRecentDetails}">
                        <views:CopyableTextBlock Classes="overviewMuted" Text="{Binding StateText}"
                                                 IsVisible="{Binding HasStateText}" />
                        <views:CopyableTextBlock Classes="overviewMuted" Text="{Binding WordformCountText}"
                                                 IsVisible="{Binding HasWordformCount}" />
                      </StackPanel>
                    </StackPanel>
                    <HyperlinkButton Grid.Column="1" Classes="overviewTileLink" Content="{x:Static app:MotifAppStrings.OpenFolder}"
                                     Command="{Binding $parent[views:OverviewPage].Page.Context.OpenProjectFolderCommand}"
                                     CommandParameter="{Binding FolderPath}" IsEnabled="{Binding CanOpenFolder}"
                                     AutomationProperties.Name="{x:Static app:MotifAppStrings.OpenProjectFolderAccessibleName}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{x:Static app:MotifAppStrings.SelectANewProject}" Command="{Binding Context.BrowseForProjectCommand}"
                  AutomationProperties.Name="{x:Static app:MotifAppStrings.SelectANewProjectAccessibleName}" />
        </StackPanel>
      </Border>
      <Border Classes="notice" IsVisible="{Binding SelectionIsUnresolved}">
        <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.TheDefaultSelectionCouldNotBe}"
                                 TextWrapping="Wrap" />
      </Border>
      <Border Classes="card" IsVisible="{Binding Context.NeedsAssessment}">
        <views:ParsePrompt DataContext="{Binding Context}" />
      </Border>

      <Grid x:Name="OverviewDetailsGrid" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Intent.Space.Group}">
        <StackPanel x:Name="OverviewLeftColumn" Spacing="{DynamicResource Component.Overview.SectionGap}">
          <Border Classes="overviewLookFirst" IsVisible="{Binding HasLookFirstRows}"
              AutomationProperties.Name="{x:Static app:MotifAppStrings.LookFirstAccessibleName}">
        <StackPanel Classes="overviewLookFirstContent">
          <TextBlock Classes="overviewTileTitle" Text="{x:Static app:MotifAppStrings.LookFirst}" />
          <ItemsControl x:Name="OverviewPageLookFirstRowsItems" ItemsSource="{Binding LookFirstRows}" AutomationProperties.Name="{x:Static app:MotifAppStrings.StoredResultsToLookAtFirstAccessibleName}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OverviewLookFirstRow">
                <Border Classes="hoverReveal">
                  <Button Classes="overviewLookFirstRow" Command="{Binding OpenCommand}"
                          AutomationProperties.Name="{Binding LinkText}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
                      <TextBlock Classes="overviewLookFirstNumber" Text="{Binding Number}" />
                      <StackPanel Grid.Column="1" Classes="overviewLookFirstWords">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                        <TextBlock Classes="overviewMuted" Text="{Binding Detail}" TextWrapping="Wrap"
                                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="overviewLookFirstAction" Text="{Binding LinkText}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
          <Border Classes="overviewTile hoverReveal" IsVisible="{Binding ShowTiles}"
                AutomationProperties.Name="{x:Static app:MotifAppStrings.TextCoverageAccessibleName}">
          <StackPanel Classes="overviewTileContent">
            <DockPanel LastChildFill="False">
              <TextBlock Classes="overviewTileTitle" Text="{x:Static app:MotifAppStrings.TextCoverage}" DockPanel.Dock="Left" />
              <HyperlinkButton Classes="overviewTileLink" Content="{x:Static app:MotifAppStrings.TextsArrow}" DockPanel.Dock="Right"
                               Command="{Binding OpenTextCoverageCommand}"
                               AutomationProperties.Name="{x:Static app:MotifAppStrings.OpenTextCoverageInTextsAccessibleName}" />
            </DockPanel>
            <TextBlock Classes="overviewTileValue" Text="{Binding TextCoverageMain}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="{x:Static app:AutomationIds.OverviewTextCoverage}" />
            <TextBlock Classes="overviewMuted" Text="{Binding TextCoverageWords}" TextWrapping="Wrap" />
            <ItemsControl x:Name="OverviewCoverageRows" Grid.IsSharedSizeScope="True" ItemsSource="{Binding TextCoverageSegments}" AutomationProperties.Name="{x:Static app:MotifAppStrings.TextCoverageOutcomesAccessibleName}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OutcomeSegment">
                  <Button Classes="overviewTableRow" Command="{Binding Command}" AutomationProperties.Name="{Binding ActionName}">
                    <Grid ColumnSpacing="{DynamicResource Intent.Space.Compact}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="OutcomeMark" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="OutcomeCount" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <views:MarkGlyph Mark="{Binding Mark}" Classes="inline" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Text="{Binding CountText}" FontWeight="{DynamicResource Intent.Weight.Section}" HorizontalAlignment="Right" />
                      <views:OverviewShareBar Grid.Column="3" Value="{Binding Count}" Total="{Binding $parent[views:OverviewPage].Page.Overview.SelectionWordCount}" Mark="{Binding Mark}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
          <Border Classes="overviewTile hoverReveal" IsVisible="{Binding ShowTiles}"
                AutomationProperties.Name="{x:Static app:MotifAppStrings.ApprovedAnalysesKeptAccessibleName}">
          <StackPanel Classes="overviewTileContent">
            <DockPanel LastChildFill="False">
              <TextBlock Classes="overviewTileTitle" Text="{x:Static app:MotifAppStrings.ApprovedAnalysesKept}" DockPanel.Dock="Left" />
              <HyperlinkButton Classes="overviewTileLink" Content="{x:Static app:MotifAppStrings.MatrixArrow}" DockPanel.Dock="Right"
                               Command="{Binding OpenAccuracyCommand}"
                               AutomationProperties.Name="{x:Static app:MotifAppStrings.OpenApprovedAnalysesKeptInTheAccessibleName}" />
            </DockPanel>
            <TextBlock Classes="overviewTileValue" Text="{Binding AccuracyMain}" TextWrapping="Wrap" />
            <TextBlock Classes="overviewMuted" Text="{Binding AccuracyCaption}" TextWrapping="Wrap" />
            <ItemsControl x:Name="OverviewAccuracyRows" Grid.IsSharedSizeScope="True" ItemsSource="{Binding AccuracySegments}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ApprovedAnalysesKeptOutcomesAccessibleName}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OutcomeSegment">
                  <Button Classes="overviewTableRow" Command="{Binding Command}" AutomationProperties.Name="{Binding ActionName}">
                    <Grid ColumnSpacing="{DynamicResource Intent.Space.Compact}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="OutcomeMark" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="OutcomeCount" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <views:MarkGlyph Mark="{Binding Mark}" Classes="inline" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Text="{Binding CountText}" FontWeight="{DynamicResource Intent.Weight.Section}" HorizontalAlignment="Right" />
                      <views:OverviewShareBar Grid.Column="3" Value="{Binding Count}" Total="{Binding $parent[views:OverviewPage].Page.Overview.Accuracy.ApprovedWordCount}" Mark="{Binding Mark}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="overviewTileDetail" Text="{Binding AccuracyBreakdown}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        </StackPanel>
        <StackPanel x:Name="OverviewRightColumn" Grid.Column="1" Spacing="{DynamicResource Component.Overview.SectionGap}">
          <Border Classes="overviewTile" IsVisible="{Binding ShowTiles}" AutomationProperties.Name="{x:Static app:MotifAppStrings.SpeedAccessibleName}">
          <StackPanel Classes="overviewTileContent">
            <DockPanel LastChildFill="True">
              <HyperlinkButton DockPanel.Dock="Right" Classes="overviewTileLink" Content="{x:Static app:MotifAppStrings.SlowestWordsArrow}" Command="{Binding OpenTimingCommand}" AutomationProperties.Name="{x:Static app:MotifAppStrings.OpenSlowestWordsInTimingAccessibleName}" />
              <TextBlock Classes="overviewTileTitle" Text="{x:Static app:MotifAppStrings.Speed}" />
            </DockPanel>
            <TextBlock Classes="overviewTileDetail" Text="{Binding SpeedMain}" TextWrapping="Wrap" AutomationProperties.AutomationId="{x:Static app:AutomationIds.OverviewSpeed}" />
            <TextBlock Classes="overviewMuted" Text="{Binding SpeedMedian}" TextWrapping="Wrap" />
            <TextBlock Classes="overviewMuted" Text="{Binding SpeedDetails}" TextWrapping="Wrap" IsVisible="{Binding SpeedDetails, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <views:ProgressiveItemsControl x:Name="OverviewTimingRows" Grid.IsSharedSizeScope="True" FullItemsSource="{Binding TimingKindShares}" AutomationProperties.Name="{x:Static app:MotifAppStrings.OverviewTimeByKindAccessibleName}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TimingShare">
                  <Border Classes="overviewTableRow">
                    <Grid ColumnSpacing="{DynamicResource Intent.Space.Compact}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="TimingShare" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="TimingDuration" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding ShareText}" FontWeight="{DynamicResource Intent.Weight.Section}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="{Binding TimeText}" Classes="overviewMuted" HorizontalAlignment="Right" />
                      <views:OverviewShareBar Grid.Column="3" Value="{Binding Share}" Total="1" Kind="{Binding Kind}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </views:ProgressiveItemsControl>
            <TextBlock Classes="overviewMuted" Text="{Binding TimingAttributionNote}" TextWrapping="Wrap" IsVisible="{Binding TimingAttributionNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
        <Border Classes="overviewTile" IsVisible="{Binding HasSlowestWordRows}" AutomationProperties.Name="{x:Static app:MotifAppStrings.SlowestWordsAccessibleName}">
          <StackPanel Classes="overviewTileContent">
            <TextBlock Classes="overviewTileTitle" Text="{x:Static app:MotifAppStrings.SlowestWords}" />
            <views:ProgressiveItemsControl x:Name="OverviewSlowestRows" FullItemsSource="{Binding SlowestTableRows}" AutomationProperties.Name="{x:Static app:MotifAppStrings.SlowestWordsAndRecordedTimesAccessibleName}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OverviewSlowWord">
                  <Border Classes="overviewTableRow">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Intent.Space.Compact}">
                      <HyperlinkButton Classes="overviewTileLink" Command="{Binding $parent[views:OverviewPage].Page.OpenWordCommand}" CommandParameter="{Binding Word}" HorizontalAlignment="Left"
                                       AutomationProperties.Name="{Binding Word}">
                        <views:CopyableTextBlock Text="{Binding Word}" FontWeight="{DynamicResource Intent.Weight.Section}" TextWrapping="Wrap" controls:WritingSystemText.Id="{Binding $parent[views:OverviewPage].Page.Context.TextStyles.DefaultVernacularId}" controls:WritingSystemText.StyleName="Normal" />
                      </HyperlinkButton>
                      <views:MarkChip Grid.Column="1" Mark="{Binding Outcome}" Text="{Binding Outcome.Word}" IsVisible="{Binding HasOutcome}" />
                      <TextBlock Grid.Column="2" Text="{Binding TimeText}" Classes="overviewMuted" HorizontalAlignment="Right" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </views:ProgressiveItemsControl>
          </StackPanel>
        </Border>
          <Border Classes="overviewTile hoverReveal" IsVisible="{Binding ShowWarningsTile}" AutomationProperties.Name="{x:Static app:MotifAppStrings.GrammarWarningsAccessibleName}">
          <StackPanel Classes="overviewTileContent">
            <DockPanel LastChildFill="False">
              <TextBlock Classes="overviewTileTitle" Text="{x:Static app:MotifAppStrings.GrammarWarnings}" DockPanel.Dock="Left" />
              <HyperlinkButton Classes="overviewTileLink" Content="{x:Static app:MotifAppStrings.WarningsArrow}" DockPanel.Dock="Right"
                               Command="{Binding OpenWarningsCommand}"
                               AutomationProperties.Name="{x:Static app:MotifAppStrings.OpenGrammarWarningsInWarningsAccessibleName}" />
            </DockPanel>
            <TextBlock Classes="overviewTileValue" Text="{Binding WarningsCount}" TextWrapping="NoWrap" />
            <TextBlock Classes="overviewMuted" Text="{Binding WarningsYourWordsText}"
                       IsVisible="{Binding HasWarningsWordSummary}" TextWrapping="Wrap" />
            <ItemsControl x:Name="OverviewPageWarningKindRowsItems" ItemsSource="{Binding WarningKindRows}" AutomationProperties.Name="{x:Static app:MotifAppStrings.WarningKindsAndWordsAccessibleName}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OverviewWarningKindRow">
                  <StackPanel Classes="overviewWarningKindRow">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding WarningCount}" />
                      <TextBlock Grid.Column="2" Classes="overviewMuted" Text="{Binding IdentityMatchedWords}" />
                    </Grid>
                    <TextBlock Classes="overviewTileDetail" Text="{Binding SpellingCandidates}"
                               IsVisible="{Binding SpellingCandidates, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        </StackPanel>
      </Grid>
      <Border Classes="overviewHandoff" IsVisible="{Binding HasAssessment}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Component.Overview.HandoffGap}">
          <PathIcon Classes="overviewHandoffIcon" Data="M12 3l1.8 4.8L18 9.5l-4.2 1.7L12 16l-1.8-4.8L6 9.5l4.2-1.7z M18 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" />
          <views:CopyableTextBlock Grid.Column="1" Classes="overviewHandoffText"
                                   Text="{x:Static app:MotifAppStrings.AskAChatModelAboutAnything}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="{x:Static app:MotifAppStrings.StartAnAIHandoff}" Command="{Binding OpenAiHandoffCommand}"
                  AutomationProperties.Name="{x:Static app:MotifAppStrings.StartAnAIHandoffAccessibleName}" />
        </Grid>
      </Border>

      <Expander Classes="overviewHistory" Header="{x:Static app:MotifAppStrings.ProjectHistory}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ProjectHistoryAccessibleName}">
        <StackPanel Classes="overviewHistoryContent">
          <views:CopyableTextBlock Classes="overviewMuted" Text="{x:Static app:MotifAppStrings.LoadingHistory}" IsVisible="{Binding History.IsLoading}" />
          <views:RefusalBlock DataContext="{Binding History.ShownRefusal}" />
          <views:CopyableTextBlock Classes="overviewMuted" Text="{x:Static app:MotifAppStrings.NothingRecordedForThisProjectYet}"
                                   IsVisible="{Binding !History.HasEntries}" />
          <ItemsControl x:Name="OverviewPageEntriesItems" ItemsSource="{Binding History.Entries}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ProjectHistoryEntriesAccessibleName}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectHistoryRow">
                <Border Classes="overviewHistoryEntry">
                  <StackPanel Classes="overviewHistoryRow">
                    <DockPanel LastChildFill="False">
                      <views:CopyableTextBlock DockPanel.Dock="Left" Classes="overviewHistoryKind" Text="{Binding Title}" />
                      <views:CopyableTextBlock DockPanel.Dock="Right" Classes="overviewMuted"
                                               Text="{Binding At.LocalDateTime, StringFormat='{}{0:ddd d MMM, h:mm tt}'}" />
                    </DockPanel>
                    <views:CopyableTextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
