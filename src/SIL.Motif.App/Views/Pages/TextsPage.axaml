<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.TextsPage"
             x:DataType="vm:TextsPageModel">
  <Grid RowDefinitions="Auto,*">
    <Border BorderBrush="{DynamicResource Intent.Border}" BorderThickness="{DynamicResource Intent.Stroke.DividerBottom}"
            Padding="{DynamicResource Intent.Inset.None}">
      <StackPanel>
        <Grid x:Name="TextsPageHeader" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
              ColumnSpacing="{DynamicResource Intent.Space.Related}"
              RowSpacing="{DynamicResource Intent.Space.Compact}">
          <WrapPanel x:Name="TextsHeaderTabs">
            <Button Content="{x:Static app:MotifAppStrings.Matrix}" Classes="tab" Classes.active="{Binding ShowMatrix}"
                  Theme="{DynamicResource BorderlessButton}" Command="{Binding ShowTabCommand}"
                  CommandParameter="{x:Static vm:TextsTab.Matrix}" AutomationProperties.Name="{x:Static app:MotifAppStrings.MatrixTabAccessibleName}" />
            <Button Content="{x:Static app:MotifAppStrings.AnalyzeTexts}" Classes="tab" Classes.active="{Binding ShowAnalyzeTexts}"
                  Theme="{DynamicResource BorderlessButton}" Command="{Binding ShowTabCommand}"
                  CommandParameter="{x:Static vm:TextsTab.AnalyzeTexts}" AutomationProperties.Name="{x:Static app:MotifAppStrings.AnalyzeTextsTabAccessibleName}"
                  AutomationProperties.AutomationId="{x:Static app:AutomationIds.AnalyzeTextsTab}" />
            <Button Content="{x:Static app:MotifAppStrings.Lists}" Classes="tab" Classes.active="{Binding ShowLists}"
                  Theme="{DynamicResource BorderlessButton}" Command="{Binding ShowTabCommand}"
                  CommandParameter="{x:Static vm:TextsTab.Lists}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ListsTabAccessibleName}" />
            <Button Content="{x:Static app:MotifAppStrings.WhatChanged}" Classes="tab" Classes.active="{Binding ShowWhatChanged}"
                  Theme="{DynamicResource BorderlessButton}" Command="{Binding ShowTabCommand}"
                  CommandParameter="{x:Static vm:TextsTab.WhatChanged}" AutomationProperties.Name="{x:Static app:MotifAppStrings.WhatChangedTabAccessibleName}" />
          </WrapPanel>
          <StackPanel x:Name="TextsHeaderActions" Grid.Column="1" Orientation="Horizontal"
                      HorizontalAlignment="Right">
            <Button Classes="pendingStrip" Margin="{DynamicResource Intent.Gap.AfterGroup}"
                    VerticalAlignment="Center" IsVisible="{Binding Changes.HasItems}"
                    Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:WorkspacePage.Review}"
                    AutomationProperties.Name="{x:Static app:MotifAppStrings.ReviewTheChangesNotAppliedYetAccessibleName}"
                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewChanges}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Snug}">
                <Ellipse Width="{DynamicResource Component.MatrixCell.MarkerSize}"
                         Height="{DynamicResource Component.MatrixCell.MarkerSize}"
                         Fill="{DynamicResource Intent.Warning.Text}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Changes.CountText}" FontWeight="{DynamicResource Intent.Weight.Strong}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{x:Static app:MotifAppStrings.ReviewChanges}" Foreground="{DynamicResource Intent.Accent}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Content="{x:Static app:MotifAppStrings.ParseAllWords}" Command="{Binding Assess.RunCommand}"
                    VerticalAlignment="Center" Margin="{DynamicResource Intent.Gap.AfterGroup}"
                    IsVisible="{Binding !Context.NeedsAssessment}"
                    AutomationProperties.Name="{x:Static app:MotifAppStrings.ParseAllWordsInTheSelectionAccessibleName}"
                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.RunAssessment}" />
          </StackPanel>
        </Grid>
        <!-- The status bar carries the run's one progress bar and Cancel; this line says what the page still shows. -->
        <ScrollViewer x:Name="TextsParseStatusScroll" IsVisible="{Binding ShowAssessStatus}"
                      MaxHeight="{DynamicResource Component.TextsPage.AssessmentStatusMaxHeight}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="{x:Static app:MotifAppStrings.ParseStatusAccessibleName}">
          <StackPanel Spacing="{DynamicResource Intent.Space.Compact}"
                      Margin="{DynamicResource Component.TextsPage.AssessmentStatusPadding}">
            <views:CopyableTextBlock Classes="muted" Text="{Binding Assess.EarlierResultsNote}" TextWrapping="Wrap"
                                     IsVisible="{Binding Assess.ShowsEarlierResults}"
                                     AutomationProperties.AutomationId="{x:Static app:AutomationIds.EarlierResultsNote}" />
            <views:RefusalBlock DataContext="{Binding Assess.ShownRefusal}" />
          </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <Panel Grid.Row="1">
      <Panel IsVisible="{Binding ShowMatrixContent}" Classes.waiting="{Binding Assess.IsActive}">
        <views:LazyContent x:Name="CompareHost" />
        <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.NoResultsYetChooseTheWords}"
            IsVisible="{Binding ShowEmptyResults}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>
      <ScrollViewer x:Name="AnalyzeTextsScroll" IsVisible="{Binding ShowAnalyzeTextsContent}"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid x:Name="AnalyzeTextsHost" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Group}">
        <ContentControl x:Name="SelectionHost" Width="{DynamicResource Component.TextsPage.SelectionPanelWidth}"
                        IsVisible="{Binding ShowSelectionPanel}"
                        IsEnabled="{Binding Context.ProjectAndSelectionEnabled}" />
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource Intent.Space.Related}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}">
            <Button Content="{x:Static app:MotifAppStrings.ReadText}" Classes="tab" Classes.active="{Binding ShowTextReader}"
                    Command="{Binding ShowAnalyzeViewCommand}"
                    CommandParameter="{x:Static vm:AnalyzeTextsView.TextReader}"
                    AutomationProperties.Name="{x:Static app:MotifAppStrings.ShowTheTextReaderAccessibleName}"
                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.AnalyzeTextReaderView}" />
            <Button Content="{x:Static app:MotifAppStrings.WordList}" Classes="tab" Classes.active="{Binding ShowWordList}"
                    Command="{Binding ShowAnalyzeViewCommand}"
                    CommandParameter="{x:Static vm:AnalyzeTextsView.WordList}"
                    AutomationProperties.Name="{x:Static app:MotifAppStrings.ShowTheWordListAccessibleName}"
                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.AnalyzeWordListView}" />
          </StackPanel>
          <ContentControl x:Name="AnalyzeParsePromptHost" Grid.Row="1" IsVisible="{Binding ShowAnalyzeParsePrompt}"
                          HorizontalAlignment="Left" />
          <ContentControl x:Name="AnalyzeReaderHost" Grid.Row="2" IsVisible="{Binding ShowTextReader}" />
          <views:LazyContent x:Name="WordListHost" Grid.Row="2" IsVisible="{Binding ShowWordList}" />
        </Grid>
      </Grid>
      </ScrollViewer>
      <views:LazyContent x:Name="ListsHost" IsVisible="{Binding ShowLists}" Classes.waiting="{Binding Assess.IsActive}" />
      <views:LazyContent x:Name="DifferenceHost" IsVisible="{Binding ShowWhatChanged}" />
      <ContentControl x:Name="CentredParsePromptHost" IsVisible="{Binding ShowCentredParsePrompt}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>
  </Grid>
</UserControl>
