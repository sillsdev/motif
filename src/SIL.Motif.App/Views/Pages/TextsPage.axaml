<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.TextsPage"
             x:DataType="vm:TextsPageModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource Intent.Space.Related}">
    <Border IsVisible="{Binding ShowParsePrompt}">
      <views:ParsePrompt DataContext="{Binding Context}" />
    </Border>
    <Border Grid.Row="1" IsVisible="{Binding ShowAssessRefusal}">
      <views:RefusalBlock DataContext="{Binding Assess.ShownRefusal}" />
    </Border>
    <ContentControl Grid.Row="2" x:Name="ReaderHost" AutomationProperties.AutomationId="{x:Static app:AutomationIds.Passage}" />
  </Grid>
</UserControl>
