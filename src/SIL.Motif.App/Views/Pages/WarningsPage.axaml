<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.WarningsPage"
             x:DataType="vm:WarningsPageModel">
  <Grid RowDefinitions="Auto,*">
    <!-- Opening a project never checks the grammar; until someone asks, the page says so and offers the check. -->
    <Border Classes="card warningEmpty" IsVisible="{Binding IsGrammarNotChecked}"
            AutomationProperties.Name="{x:Static app:MotifAppStrings.GrammarNotCheckedYetAccessibleName}">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="{x:Static app:MotifAppStrings.CheckTheGrammar}" VerticalAlignment="Center" Classes="warningAction Primary"
                Theme="{DynamicResource SolidButton}"
                Command="{Binding CheckGrammarCommand}" AutomationProperties.Name="{x:Static app:MotifAppStrings.CheckTheGrammarAccessibleName}" />
        <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
          <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.NotCheckedYet}" FontWeight="{DynamicResource Intent.Weight.Section}" />
          <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="{x:Static app:MotifAppStrings.WarningsCheckExplanation}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <ContentControl Grid.Row="1" x:Name="GrammarHost" />
  </Grid>
</UserControl>
