<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.AssistantConnectionsPage"
             x:DataType="vm:AssistantConnectionsPageModel">
  <Grid RowDefinitions="Auto,*">
    <Border Classes="handoffHeader">
      <views:CopyableTextBlock TextWrapping="Wrap" Classes="section-title" Text="{x:Static app:MotifAppStrings.AiAssistantsTitle}" />
    </Border>
    <ScrollViewer Grid.Row="1">
      <StackPanel>
        <Border Classes="card">
          <StackPanel>
            <views:CopyableTextBlock TextWrapping="Wrap" Classes="section-title" Text="{x:Static app:MotifAppStrings.AdvancedAiModeTitle}" />
            <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.AdvancedAiModeExplanation}"
                                      TextWrapping="Wrap" />
            <CheckBox Content="{x:Static app:MotifAppStrings.TurnOnAdvancedAiMode}" IsChecked="{Binding IsEnabled}" />
          </StackPanel>
        </Border>

        <Border Classes="notice" IsVisible="{Binding HasVersionWarning}">
          <views:CopyableTextBlock Text="{Binding VersionWarning}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="card" IsVisible="{Binding ShowsAssistantList}">
          <StackPanel>
            <views:CopyableTextBlock TextWrapping="Wrap" Classes="section-title" Text="{x:Static app:MotifAppStrings.ChooseAssistantsTitle}" />
            <views:CopyableTextBlock TextWrapping="Wrap" Text="{x:Static app:MotifAppStrings.ChooseAssistantsExplanation}" />
            <views:CopyableTextBlock TextWrapping="Wrap" Text="{Binding EmptyAssistantText}" IsVisible="{Binding HasNoAssistants}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.AssistantsEmptyText}" />
            <ItemsControl x:Name="AssistantConnectionsItems" ItemsSource="{Binding Assistants}" IsVisible="{Binding HasAssistants}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AssistantChoiceViewModel">
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{x:Static app:MotifAppStrings.ConnectSelectedAssistants}"
                    Classes="Primary" Theme="{DynamicResource SolidButton}"
                    Command="{Binding ConnectSelectedCommand}"
                    IsEnabled="{Binding CanConnectSelected}" />
            <views:CopyableTextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowsDesktopUpload}">
              <Button Content="{x:Static app:MotifAppStrings.OpenPluginFolder}" Command="{Binding OpenPluginZipCommand}"
                      Theme="{DynamicResource OutlineButton}" Classes="Tertiary" />
              <Button Content="{x:Static app:MotifAppStrings.OpenClaudePlugins}" Command="{Binding OpenClaudePluginsCommand}"
                      Theme="{DynamicResource OutlineButton}" Classes="Tertiary" />
            </StackPanel>
          </StackPanel>
        </Border>
        <ContentControl x:Name="HandoffSection" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
