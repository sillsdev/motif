<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             x:Class="SIL.Motif.App.Views.WordsPage">
  <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Intent.Space.Group}">
    <views:CopyableTextBlock Classes="displayTitle" Margin="{DynamicResource Intent.Inset.Page}" Text="{x:Static app:MotifAppStrings.BoardWords}" />
    <ContentControl Grid.Row="1" x:Name="WordsHost" AutomationProperties.AutomationId="{x:Static app:AutomationIds.WordOccurrences}" />
  </Grid>
</UserControl>
