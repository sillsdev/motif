<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ProposalsPage"
             x:DataType="vm:ProposalsPageModel">
  <UserControl.Styles><StyleInclude Source="/Tokens/Components/ProposalsScoped.axaml" /></UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="ProposalListPane" x:DataType="vm:ProposalsPageModel">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource Intent.Space.Related}">
        <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.BoardOpenProposals}" />
        <ListBox Grid.Row="1" x:Name="ProposalsRowsItems" ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedProposal, Mode=OneWay}"
                 AutomationProperties.Name="{x:Static app:MotifAppStrings.ProposalsAccessibleName}"
                 AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalsList}">
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:DenseTableGroup" x:DataType="vm:DenseTableGroup">
              <views:CopyableTextBlock Classes="muted" Text="{Binding Label}" TextWrapping="Wrap" />
            </DataTemplate>
            <DataTemplate DataType="vm:ProposalCardViewModel" x:DataType="vm:ProposalCardViewModel">
              <StackPanel AutomationProperties.AutomationId="{Binding RowAutomationId}"
                          AutomationProperties.Name="{Binding AccessibleRowName}">
                <CheckBox IsChecked="{Binding IsCheckedForComparison, Mode=TwoWay}" Click="OnComparisonClick"
                          AutomationProperties.Name="{Binding ComparisonAccessibleName}" />
                <views:CopyableTextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Classes="muted" Text="{Binding StatusWord}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
        <Button Grid.Row="2" IsVisible="{Binding HasSetAsideLink}"
                Command="{Binding ShowSetAsideCommand}" AutomationProperties.Name="{Binding SetAsideLinkText}"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalsSetAside}">
          <TextBlock Text="{Binding SetAsideLinkText}" />
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{DynamicResource Intent.Inset.Page}" Spacing="{DynamicResource Intent.Space.Group}">
      <views:CopyableTextBlock Classes="displayTitle" Text="{x:Static app:MotifAppStrings.BoardProposals}" TextWrapping="Wrap" />
      <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.ReadingProposals}" IsVisible="{Binding IsLoading}" />
      <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.NoProposalsYet}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" />
      <StackPanel IsVisible="{Binding HasUnreadable}" Spacing="{DynamicResource Intent.Space.Related}">
        <views:CopyableTextBlock Text="{Binding UnreadableText}" TextWrapping="Wrap" />
        <views:CopyableTextBlock Text="{Binding UnreadableNamesText}" TextWrapping="Wrap" />
      </StackPanel>
      <views:RefusalBlock DataContext="{Binding ShownRefusal}" />
      <views:ProgressiveItemsControl x:Name="OpenProposalTabs" FullItemsSource="{Binding Documents.Items}"
                                     AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalDocuments}">
        <views:ProgressiveItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></views:ProgressiveItemsControl.ItemsPanel>
        <views:ProgressiveItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProposalDocumentViewModel">
            <StackPanel Classes="proposalTitleRow">
              <Button HorizontalAlignment="Stretch"
                      IsVisible="{Binding $parent[ItemsControl].((vm:ProposalsPageModel)DataContext).Documents.HasSeveral}"
                      Command="{Binding $parent[ItemsControl].((vm:ProposalsPageModel)DataContext).SelectDocumentCommand}"
                      CommandParameter="{Binding}">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
              </Button>
              <Button Content="{x:Static app:MotifAppStrings.ProposalCloseDocument}"
                      Command="{Binding $parent[ItemsControl].((vm:ProposalsPageModel)DataContext).CloseDocumentCommand}"
                      CommandParameter="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </views:ProgressiveItemsControl.ItemTemplate>
      </views:ProgressiveItemsControl>
      <Button AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalComparePair}"
              AutomationProperties.Name="{x:Static app:MotifAppStrings.BoardCompareProposals}"
              Command="{Binding CompareCommand}" IsVisible="{Binding HasComparisonHost}"
              HorizontalAlignment="Left">
        <TextBlock Text="{x:Static app:MotifAppStrings.BoardCompareProposals}" TextWrapping="Wrap" />
      </Button>
      <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.ProposalComparisonHint}" TextWrapping="Wrap" />
      <views:CopyableTextBlock Text="{Binding ComparisonNotice}" TextWrapping="Wrap" />
      <ContentControl x:Name="ProposalCompareSlot" Content="{Binding ComparisonContent}" />
      <ContentControl Content="{Binding SelectedDocument}" IsVisible="{Binding !IsComparing}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:ProposalDocumentViewModel"><views:ProposalDocument /></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
      <StackPanel IsVisible="{Binding HasSelectedProposal}" Spacing="{DynamicResource Intent.Space.Related}">
        <WrapPanel IsVisible="{Binding !IsConfirmingDecline}" IsEnabled="{Binding !IsConfirmingDelete}">
          <Button Content="{x:Static app:MotifAppStrings.Reopen}" IsVisible="{Binding SelectedProposal.CanReopen}"
                  Command="{Binding ReopenCommand}" CommandParameter="{Binding SelectedProposal}" />
          <Button Content="{x:Static app:MotifAppStrings.DeclineProposalPrompt}" IsVisible="{Binding SelectedProposal.CanDecide}"
                  Command="{Binding AskToDeclineCommand}" CommandParameter="{Binding SelectedProposal}" />
          <Button Content="{x:Static app:MotifAppStrings.DecideLater}" IsVisible="{Binding SelectedProposal.CanDecideLater}"
                  Command="{Binding DecideLaterCommand}" CommandParameter="{Binding SelectedProposal}" />
          <Button Content="{x:Static app:MotifAppStrings.Delete}" IsVisible="{Binding SelectedProposal.CanDelete}"
                  AutomationProperties.AutomationId="{Binding SelectedDeleteAutomationId}"
                  Command="{Binding AskToDeleteCommand}" CommandParameter="{Binding SelectedProposal}" />
        </WrapPanel>
        <StackPanel IsVisible="{Binding IsConfirmingDecline}" Spacing="{DynamicResource Intent.Space.Related}">
          <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.ProposalDeclineReason}" />
          <TextBox Text="{Binding DeclineReason, Mode=TwoWay}" AcceptsReturn="True" />
          <WrapPanel>
            <Button Content="{x:Static app:MotifAppStrings.Decline}" Command="{Binding DeclineCommand}"
                    CommandParameter="{Binding SelectedProposal}" />
            <Button Content="{x:Static app:MotifAppStrings.Cancel}" Command="{Binding CancelDeclineCommand}" />
          </WrapPanel>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsConfirmingDelete}" Spacing="{DynamicResource Intent.Space.Related}">
          <views:CopyableTextBlock Text="{Binding DeleteQuestion}" TextWrapping="Wrap" />
          <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.DeleteProposalWarning}" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Content="{x:Static app:MotifAppStrings.DeleteProposal}" Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding SelectedProposal}"
                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalsConfirmDelete}" />
            <Button Content="{x:Static app:MotifAppStrings.KeepProposal}" Command="{Binding KeepProposalCommand}"
                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalsKeep}" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
