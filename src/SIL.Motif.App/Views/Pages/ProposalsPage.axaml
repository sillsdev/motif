<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:controls="clr-namespace:SIL.Motif.App.Controls"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ProposalsPage"
             x:DataType="vm:ProposalsPageModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/ProposalsScoped.axaml" />
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="ProposalGroupFilterTemplate" x:DataType="vm:ProposalsPageModel">
      <StackPanel Classes="proposalFilterPane" Spacing="{DynamicResource Intent.Space.Compact}"
                  IsVisible="{Binding IsListed}">
        <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.Show}" />
        <ItemsControl x:Name="ProposalsGroupFilterItems" ItemsSource="{Binding GroupFilters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Classes="proposalFilters" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProposalGroupFilterViewModel">
              <views:FilterChip Label="{Binding Label}" Count="{Binding Count}"
                                IsActive="{Binding IsActive}" Command="{Binding SelectCommand}"
                                IsEnabled="{Binding CanSelect}"
                                CommandParameter="{Binding Filter}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ProposalInspectorTemplate" x:DataType="vm:ProposalsPageModel">
      <Border Classes="inspector">
        <Border.Styles>
          <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/ProposalsScoped.axaml" />
        </Border.Styles>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Border Classes="inspectorBodyFrame">
          <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
            <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.ReadingProposals}"
                                     IsVisible="{Binding IsLoading}" TextWrapping="Wrap" />
            <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.NoProposalsYet}"
                                     IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" />
            <StackPanel IsVisible="{Binding IsFilteredEmpty}"
                        Spacing="{DynamicResource Intent.Space.Compact}">
              <views:CopyableTextBlock Classes="muted" Text="{Binding FilterEmptyText}" TextWrapping="Wrap" />
              <Button x:Name="ClearProposalFilter" Content="{x:Static app:MotifAppStrings.ShowAllProposals}"
                      Command="{Binding ClearGroupFilterCommand}"
                      AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalsClearFilter}" />
            </StackPanel>
            <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.NoProposalsToShow}"
                                     IsVisible="{Binding IsNoProposalsToShow}" TextWrapping="Wrap" />
            <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.SelectAProposal}"
                                     IsVisible="{Binding ShowSelectProposalPrompt}" TextWrapping="Wrap" />
            <views:CopyableTextBlock Classes="inspectorTitle" Text="{Binding SelectedProposal.Label}"
                                     IsVisible="{Binding HasSelectedProposal}"
                                     TextWrapping="Wrap" />
            <StackPanel IsVisible="{Binding HasSelectedProposal}"
                        Spacing="{DynamicResource Intent.Space.Related}">
              <Grid Classes="inspectorFact" ColumnDefinitions="Auto,*">
                <TextBlock Classes="inspectorFactLabel" Text="{x:Static app:MotifAppStrings.Status}" />
                <views:CopyableTextBlock Grid.Column="1" Text="{Binding SelectedProposal.DetailsStatusText}"
                                         TextWrapping="Wrap" />
              </Grid>
              <Grid Classes="inspectorFact" ColumnDefinitions="Auto,*">
                <TextBlock Classes="inspectorFactLabel" Text="{x:Static app:MotifAppStrings.BuiltBy}" />
                <views:CopyableTextBlock Grid.Column="1" Text="{Binding SelectedProposal.AuthorText}"
                                         TextWrapping="Wrap" />
              </Grid>
              <Border Classes="inspectorSection">
                <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                  <TextBlock Classes="inspectorSectionTitle" Text="{x:Static app:MotifAppStrings.ItsChanges}" />
                  <views:CopyableTextBlock Text="{Binding SelectedProposal.ChangeCountText}" />
                  <views:CopyableTextBlock Classes="muted" Text="{Binding SelectedProposal.KindsText}"
                                           TextWrapping="Wrap" />
                  <views:CopyableTextBlock Classes="inspectorMeaning problem"
                                           Text="{Binding SelectedProposal.LostChip}"
                                           IsVisible="{Binding SelectedProposal.HasLostChip}" />
                  <views:CopyableTextBlock Classes="inspectorMeaning problem"
                                           Text="{Binding SelectedProposal.FitChip}"
                                           IsVisible="{Binding SelectedProposal.HasFitChip}" />
                  <views:CopyableTextBlock Classes="muted" Text="{Binding SelectedProposal.AlsoChip}"
                                           IsVisible="{Binding SelectedProposal.HasAlsoChip}"
                                           TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Classes="inspectorSection" IsVisible="{Binding SelectedProposal.HasNumbers}">
                <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                  <TextBlock Classes="inspectorSectionTitle" Text="{x:Static app:MotifAppStrings.ProposalNumbersHeading}" />
                  <ItemsControl x:Name="ProposalsNumberItems" ItemsSource="{Binding SelectedProposal.Numbers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProposalNumber">
                        <Grid Classes="inspectorFact" ColumnDefinitions="*,Auto">
                          <views:CopyableTextBlock Text="{Binding Label}" />
                          <views:CopyableTextBlock Grid.Column="1" Classes="proposalNumber"
                                                   Classes.moved="{Binding Moved}" Text="{Binding Value}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <views:CopyableTextBlock Classes="muted" Text="{Binding SelectedProposal.StatusText}"
                                           IsVisible="{Binding SelectedProposal.HasStatus}"
                                           TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <views:RefusalBlock DataContext="{Binding SelectedProposal.ShownRefusal}" />
              <views:TrialBaselineNoticeBlock DataContext="{Binding SelectedProposal.BaselineNotice}" />
              <views:TrialWorkNoticeBlock DataContext="{Binding SelectedProposal.WorkNotice}" />
              <StackPanel Classes="proposalInspectorActions" Spacing="{DynamicResource Intent.Space.Compact}">
                <Button Content="{x:Static app:MotifAppStrings.OpenInReviewChanges}" Classes="Primary" Theme="{DynamicResource SolidButton}"
                        Command="{Binding OpenInReviewCommand}" CommandParameter="{Binding SelectedProposal}"
                        Click="OnRequestPageInspector"
                        AutomationProperties.AutomationId="{Binding SelectedOpenAutomationId}" />
                <WrapPanel Classes="proposalInspectorActions">
                  <Button Content="{Binding SelectedProposal.TryText}"
                          IsVisible="{Binding SelectedProposal.CanTry}"
                          Command="{Binding TryAgainCommand}" CommandParameter="{Binding SelectedProposal}"
                          AutomationProperties.AutomationId="{Binding SelectedTryAgainAutomationId}" />
                  <Button Content="{x:Static app:MotifAppStrings.Reopen}" IsVisible="{Binding SelectedProposal.CanReopen}"
                          Command="{Binding ReopenCommand}" CommandParameter="{Binding SelectedProposal}"
                          AutomationProperties.AutomationId="{Binding SelectedReopenAutomationId}" />
                  <Button Content="{x:Static app:MotifAppStrings.Delete}" IsVisible="{Binding SelectedProposal.CanDelete}"
                          Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedProposal}"
                          AutomationProperties.AutomationId="{Binding SelectedDeleteAutomationId}" />
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
          </Border>
        </ScrollViewer>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid x:Name="ProposalsTableHost" RowDefinitions="Auto,Auto,*,Auto"
        controls:DenseTable.IsWidthHost="True">
    <StackPanel Grid.Row="0" Grid.Column="0" Classes="proposalsPage">
      <StackPanel Classes="proposalsHeading">
        <StackPanel Classes="proposalTitleRow">
          <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.Proposals}" />
          <views:CopyableTextBlock Classes="muted" Text="{Binding TotalProposalCountText}"
                                   IsVisible="{Binding IsListed}" />
        </StackPanel>
        <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="{x:Static app:MotifAppStrings.EachOneIsTriedOnA}" />
      </StackPanel>
      <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsLoading}"
                               Text="{x:Static app:MotifAppStrings.ReadingProposals}" />
      <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
                               Text="{x:Static app:MotifAppStrings.NoProposalsYetChangesYouCollect}" />
      <views:RefusalBlock DataContext="{Binding ShownRefusal}" />
    </StackPanel>
    <Border Grid.Row="1" Grid.Column="0" Classes="denseTableColumnHeader" IsVisible="{Binding IsListed}">
      <Grid ColumnSpacing="{DynamicResource Intent.Space.Group}"
            controls:DenseTable.Columns="3* Narrow Narrow * * * * Actions"
            controls:DenseTable.CompactColumns="* 0 Narrow 0 0 0 0 Actions">
        <views:CopyableTextBlock Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.Proposal}" VerticalAlignment="Center" />
        <Border Grid.Column="1" controls:DenseTable.Secondary="True">
          <views:CopyableTextBlock Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.BuiltBy}" VerticalAlignment="Center" />
        </Border>
        <views:CopyableTextBlock Grid.Column="2" Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.Status}" VerticalAlignment="Center" />
        <Border Grid.Column="3" controls:DenseTable.Secondary="True">
          <views:CopyableTextBlock Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.ApprovedKept}" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Column="4" controls:DenseTable.Secondary="True">
          <views:CopyableTextBlock Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.Coverage}" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Column="5" controls:DenseTable.Secondary="True">
          <views:CopyableTextBlock Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.Warnings}" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Column="6" controls:DenseTable.Secondary="True">
          <views:CopyableTextBlock Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.WordTime}" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Column="7" />
      </Grid>
    </Border>
    <ListBox x:Name="ProposalsRowsItems" Grid.Row="2" Grid.Column="0" Classes="denseTable"
             ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedProposal, Mode=TwoWay}"
             IsVisible="{Binding IsListed}" Focusable="True" IsTabStop="True"
             KeyboardNavigation.TabNavigation="Once"
             AutomationProperties.Name="{x:Static app:MotifAppStrings.ProposalsAccessibleName}"
             AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalsTable}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.DataTemplates>
        <DataTemplate DataType="vm:DenseTableGroup" x:DataType="vm:DenseTableGroup">
          <Border Classes="denseTableGroupHeader">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Group}">
              <TextBlock Classes="denseTableGroupName" Text="{Binding Label}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="denseTableCount" Text="{Binding CountText}"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:ProposalCardViewModel" x:DataType="vm:ProposalCardViewModel">
          <Grid>
            <Border Classes="denseTableRow" AutomationProperties.AutomationId="{Binding RowAutomationId}"
                    AutomationProperties.Name="{Binding AccessibleRowName}">
              <Grid ColumnSpacing="{DynamicResource Intent.Space.Group}"
                    controls:DenseTable.Columns="3* Narrow Narrow * * * * Actions"
                    controls:DenseTable.CompactColumns="* 0 Narrow 0 0 0 0 Actions">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Compact}"
                      VerticalAlignment="Center">
                  <TextBlock Classes="denseTableCell denseTableItem" Text="{Binding Label}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Label}" />
                  <Border Grid.Column="1" controls:DenseTable.Secondary="True">
                    <TextBlock Classes="denseTableCell" Text="{Binding ChangeCountText}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </Border>
                </Grid>
                <Border Grid.Column="1" controls:DenseTable.Secondary="True">
                  <TextBlock Classes="denseTableCell" Text="{Binding AuthorText}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="2" Classes="meaningMark"
                        Classes.look="{Binding TableStatusIsLook}"
                        Classes.problem="{Binding TableStatusIsProblem}"
                        IsVisible="{Binding HasTableStatus}">
                  <TextBlock Text="{Binding TableStatusText}" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                </Border>
                <Border Grid.Column="3" controls:DenseTable.Secondary="True">
                  <TextBlock Classes="denseTableCell proposalNumber" Classes.moved="{Binding ApprovedKept.Moved}"
                             Text="{Binding TableApprovedKeptText}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="4" controls:DenseTable.Secondary="True">
                  <TextBlock Classes="denseTableCell proposalNumber" Classes.moved="{Binding Coverage.Moved}"
                             Text="{Binding TableCoverageText}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="5" controls:DenseTable.Secondary="True">
                  <TextBlock Classes="denseTableCell proposalNumber" Classes.moved="{Binding Warnings.Moved}"
                             Text="{Binding TableWarningsText}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="6" controls:DenseTable.Secondary="True">
                  <TextBlock Classes="denseTableCell proposalNumber" Classes.moved="{Binding WordTime.Moved}"
                             Text="{Binding TableWordTimeText}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="7" Orientation="Horizontal"
                            Spacing="{DynamicResource Intent.Space.Minimal}" VerticalAlignment="Center">
                  <Button Classes="denseTableAction" Content="{Binding TryText}" IsVisible="{Binding CanTry}"
                          Command="{Binding $parent[UserControl].((vm:ProposalsPageModel)DataContext).TryAgainCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.AutomationId="{Binding TryAgainAutomationId}" />
                  <Button Classes="denseTableAction" Content="{x:Static app:MotifAppStrings.Reopen}" IsVisible="{Binding CanReopen}"
                          Command="{Binding $parent[UserControl].((vm:ProposalsPageModel)DataContext).ReopenCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.AutomationId="{Binding ReopenAutomationId}" />
                  <Button Classes="denseTableAction" Content="{x:Static app:MotifAppStrings.Open}" IsVisible="{Binding ShowsOpenAction}"
                          Command="{Binding $parent[UserControl].((vm:ProposalsPageModel)DataContext).OpenCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.AutomationId="{Binding OpenAutomationId}" />
                  <Button Classes="denseTableMenu" Content="⋯"
                          AutomationProperties.Name="{Binding Label, StringFormat='Actions for {0}'}"
                          AutomationProperties.AutomationId="{Binding ActionsAutomationId}">
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Classes="menu">
                          <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                  Content="{Binding TryText}" IsVisible="{Binding CanTry}"
                                  Command="{Binding $parent[UserControl].((vm:ProposalsPageModel)DataContext).TryAgainCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                  Content="{x:Static app:MotifAppStrings.Reopen}" IsVisible="{Binding CanReopen}"
                                  Command="{Binding $parent[UserControl].((vm:ProposalsPageModel)DataContext).ReopenCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                  Content="{x:Static app:MotifAppStrings.Details}"
                                  Command="{Binding $parent[UserControl].((vm:ProposalsPageModel)DataContext).SelectProposalCommand}"
                                  CommandParameter="{Binding}" Click="OnRequestPageInspector"
                                  AutomationProperties.AutomationId="{Binding DetailsAutomationId}" />
                          <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                  Content="{x:Static app:MotifAppStrings.Open}" IsVisible="{Binding ShowsOpenAction}"
                                  Command="{Binding $parent[UserControl].((vm:ProposalsPageModel)DataContext).OpenCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                  Content="{x:Static app:MotifAppStrings.Delete}" IsVisible="{Binding CanDelete}"
                                  Command="{Binding $parent[UserControl].((vm:ProposalsPageModel)DataContext).DeleteCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="denseTableFocusRing" />
          </Grid>
        </DataTemplate>
      </ListBox.DataTemplates>
    </ListBox>
    <Button Grid.Row="3" Grid.Column="0" Content="{Binding SetAsideLinkText}"
            IsVisible="{Binding HasSetAsideLink}" Command="{Binding ShowSetAsideCommand}"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalsSetAside}" />
  </Grid>
</UserControl>
