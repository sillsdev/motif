<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             xmlns:word="clr-namespace:SIL.Motif.App.Controls.WordPresentation"
             x:Class="SIL.Motif.App.Views.TimingPage"
             x:DataType="vm:TimingPageModel">
  <Grid>
    <ScrollViewer IsVisible="{Binding !Context.NeedsAssessment}">
      <StackPanel Spacing="{DynamicResource Intent.Space.Group}">
      <Border Classes="timingPage">
        <StackPanel Spacing="{DynamicResource Intent.Space.Group}">
          <Border Classes="card" IsVisible="{Binding HasHeadline}" AutomationProperties.Name="{x:Static app:MotifAppStrings.TotalWordTimeAccessibleName}">
            <StackPanel Classes="timingHeadline" Orientation="Horizontal">
              <StackPanel>
                <views:CopyableTextBlock Classes="timingHeadlineCaption" Text="{x:Static app:MotifAppStrings.TotalWordTime}" />
                <views:CopyableTextBlock Classes="timingHeadlineValue" Text="{Binding HeadlineTotal}" />
                <views:CopyableTextBlock Classes="timingHeadlineCaption" Text="{Binding HeadlineTotalCaption}" />
                <views:CopyableTextBlock Classes="muted" Text="{Binding RerunMeasurementsText}"
                                         IsVisible="{Binding HasRerunMeasurements}" />
              </StackPanel>
              <StackPanel>
                <views:CopyableTextBlock Classes="timingHeadlineValue" Text="{Binding HeadlineMedian}" />
                <views:CopyableTextBlock Classes="timingHeadlineCaption" Text="{x:Static app:MotifAppStrings.MedianWordTime}" />
              </StackPanel>
              <StackPanel>
                <views:CopyableTextBlock Classes="timingHeadlineValue" Text="{Binding HeadlineStopped}" />
                <views:CopyableTextBlock Classes="timingHeadlineCaption" Text="{Binding HeadlineStoppedCaption}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <WrapPanel ItemSpacing="{DynamicResource Intent.Space.Compact}"
                     LineSpacing="{DynamicResource Intent.Space.Compact}"
                     AutomationProperties.Name="{x:Static app:MotifAppStrings.TimingControlsAccessibleName}">
            <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.Words}" VerticalAlignment="Center" />
            <Button Classes="filterChip" Classes.active="{Binding IsAllSelected}"
                    Content="{Binding AllWordsButtonText}" Command="{Binding SelectWordSetCommand}"
                    CommandParameter="all" AutomationProperties.Name="{x:Static app:MotifAppStrings.AllTimedWordsAccessibleName}" />
            <Button Classes="filterChip" Classes.active="{Binding IsStepLimitSelected}"
                    Content="{Binding StoppedWordsButtonText}" Command="{Binding SelectWordSetCommand}"
                    CommandParameter="step-limit"
                    AutomationProperties.HelpText="Words stopped at a search limit." />
            <Button Classes="filterChip" Classes.active="{Binding IsSlowestSelected}"
                    Content="{x:Static app:MotifAppStrings.Slowest}" Command="{Binding SelectWordSetCommand}"
                    CommandParameter="slowest" />
            <NumericUpDown Value="{Binding SlowestCount}" Minimum="1" Increment="1"
                           Width="{DynamicResource Component.Timing.SlowestCountWidth}"
                           AutomationProperties.Name="{x:Static app:MotifAppStrings.NumberOfSlowestWordsAccessibleName}" />
            <Button x:Name="MatrixWordsButton" Content="{x:Static app:MotifAppStrings.AMatrixCell}" AutomationProperties.Name="{x:Static app:MotifAppStrings.WordsFromAMatrixCellAccessibleName}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                    <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.TimingMatrixCellHeading}" />
                    <ComboBox x:Name="TimingPageMatrixCellsItems" ItemsSource="{Binding MatrixCells}" SelectedItem="{Binding SelectedMatrixCell}"
                              Width="{DynamicResource Component.Timing.SourcePickerWidth}"
                              PlaceholderText="Choose a cell" AutomationProperties.Name="{x:Static app:MotifAppStrings.MatrixCellFromTextsAccessibleName}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CompareCellViewModel">
                          <TextBlock Text="{Binding AccessibleName}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{x:Static app:MotifAppStrings.UseCell}" Command="{Binding UseMatrixCellCommand}" Click="CloseWordSourceFlyouts"
                            AutomationProperties.Name="{x:Static app:MotifAppStrings.UseCellAccessibleName}"
                            AutomationProperties.HelpText="{Binding UseMatrixCellDisabledReason}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="ListWordsButton" Content="{x:Static app:MotifAppStrings.AList}" AutomationProperties.Name="{x:Static app:MotifAppStrings.WordsFromAListAccessibleName}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                    <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.ListFromTexts}" />
                    <ComboBox x:Name="TimingPageTextsListsItems" ItemsSource="{Binding TextsLists}" SelectedItem="{Binding SelectedTextsList}"
                              Width="{DynamicResource Component.Timing.SourcePickerWidth}"
                              PlaceholderText="Choose a list" AutomationProperties.Name="{x:Static app:MotifAppStrings.ListFromTextsAccessibleName}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComparePresetViewModel">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{x:Static app:MotifAppStrings.UseList}" Command="{Binding UseTextsListCommand}" Click="CloseWordSourceFlyouts"
                            AutomationProperties.Name="{x:Static app:MotifAppStrings.UseListAccessibleName}"
                            AutomationProperties.HelpText="{Binding UseTextsListDisabledReason}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Content="{x:Static app:MotifAppStrings.AIHandoffForTheseWords}" Command="{Binding HandOffWordsCommand}"
                    AutomationProperties.Name="{x:Static app:MotifAppStrings.AIHandoffForTheseWordsAccessibleName}" />
            <Button x:Name="MoreWordsButton" Content="{x:Static app:MotifAppStrings.More}" AutomationProperties.Name="{x:Static app:MotifAppStrings.MoreWaysToChooseWordsAccessibleName}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                    <Button Classes="filterChip" Content="{x:Static app:MotifAppStrings.ChosenInTexts}" Command="{Binding UseCheckedWordsCommand}"
                            Click="CloseWordSourceFlyouts"
                            HorizontalAlignment="Left" AutomationProperties.Name="{x:Static app:MotifAppStrings.ChosenInTextsAccessibleName}"
                            AutomationProperties.HelpText="{Binding UseCheckedWordsDisabledReason}" />
                    <TextBox Text="{Binding PickedWords}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="{DynamicResource Component.Timing.PickerHeight}"
                             PlaceholderText="Type or paste words, one per line"
                             AutomationProperties.Name="{x:Static app:MotifAppStrings.WordsPickedByHandAccessibleName}" />
                    <Button Content="{x:Static app:MotifAppStrings.PickWords}" Command="{Binding UsePickedWordsCommand}" Click="CloseWordSourceFlyouts"
                            AutomationProperties.Name="{x:Static app:MotifAppStrings.PickWordsAccessibleName}"
                            AutomationProperties.HelpText="{Binding UsePickedWordsDisabledReason}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Content="{x:Static app:MotifAppStrings.ReRun}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ReRunWordsWithNewLimitsAccessibleName}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Snug}">
                      <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.SecondsPerWord}" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding RerunSeconds}" Minimum="1" Increment="1"
                                     AutomationProperties.Name="{x:Static app:MotifAppStrings.SecondsPerWordAccessibleName}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Snug}">
                      <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.AnalysisAttemptLimit}" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding RerunSteps}" Minimum="1" Increment="100000"
                                     AutomationProperties.Name="{x:Static app:MotifAppStrings.PerWordAnalysisAttemptLimitAccessibleName}" />
                    </StackPanel>
                    <Button Content="{x:Static app:MotifAppStrings.ReRunChosenWords}" Command="{Binding RerunWordsCommand}"
                            AutomationProperties.Name="{x:Static app:MotifAppStrings.ReRunChosenWordsAccessibleName}" />
                    <views:CopyableTextBlock Text="{Binding RerunProgressText}" IsVisible="{Binding IsRerunning}" />
                    <ProgressBar Minimum="0" Maximum="{Binding RerunTotal}" Value="{Binding RerunCompleted}"
                                 IsVisible="{Binding IsRerunning}" />
                    <Button Content="{x:Static app:MotifAppStrings.Cancel}" Command="{Binding CancelRerunCommand}"
                            IsVisible="{Binding IsRerunning}" />
                    <views:CopyableTextBlock Classes="muted" Text="{Binding RerunMessage}" TextWrapping="Wrap" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </WrapPanel>

          <views:RefusalBlock DataContext="{Binding TimingRefusal}" />
          <Border Classes="card" IsVisible="{Binding IsLoadingTiming}">
            <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.ReadingTheParseTimes}" />
          </Border>
          <Border Classes="card" IsVisible="{Binding ShowNoTimingRecorded}">
            <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
              <views:CopyableTextBlock Text="{x:Static vm:TimingPageModel.NoTimingRecordedText}" TextWrapping="Wrap" />
              <Button Content="{x:Static app:MotifAppStrings.ParseAgain}" Command="{Binding Context.Assess.RunCommand}"
                      IsVisible="{Binding $self.IsEffectivelyEnabled}"
                      HorizontalAlignment="Left" AutomationProperties.Name="{x:Static app:MotifAppStrings.ParseTheseWordsAgainToMeasureThemAccessibleName}" />
            </StackPanel>
          </Border>
          <Border Classes="notice" IsVisible="{Binding ShowStaleTiming}">
            <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.TimingBaselineStaleNotice}"
                                     TextWrapping="Wrap" />
          </Border>
          <Border Classes="card" IsVisible="{Binding ShowEmptySelection}">
            <WrapPanel>
              <views:CopyableTextBlock Text="{Binding EmptySelectionText}" TextWrapping="Wrap" />
              <Button Content="{x:Static app:MotifAppStrings.ShowAllWords}" Command="{Binding SelectWordSetCommand}" CommandParameter="all"
                      IsVisible="{Binding CanShowAllWords}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ShowAllWordsInTimingAccessibleName}" />
            </WrapPanel>
          </Border>

          <Grid x:Name="TimingShareLayout" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                ColumnSpacing="{DynamicResource Intent.Space.Group}"
                IsVisible="{Binding HasSelectedWords}">
            <StackPanel Grid.Column="0" Spacing="{DynamicResource Intent.Space.Group}">
              <Border Classes="card">
                <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
                  <views:CopyableTextBlock Classes="section-title" Text="{Binding ScopeLabel}" TextWrapping="Wrap" />
                  <views:CopyableTextBlock Classes="muted" Text="{Binding ShareDenominatorText}" TextWrapping="Wrap"
                                           AutomationProperties.Name="{x:Static app:MotifAppStrings.WhatEveryShareIsOfAccessibleName}" />
                  <views:TimingKindBar x:Name="KindBar" Rows="{Binding KindShares}"
                                       Height="{DynamicResource Component.Timing.BarHeight}"
                                       AutomationProperties.Name="{x:Static app:MotifAppStrings.ShareOfTotalWordTimeByKindAccessibleName}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Compact}">
                    <ItemsControl x:Name="TimingPageLegendItems" Grid.Column="0" ItemsSource="{Binding #KindBar.Legend}"
                                  AutomationProperties.Name="{x:Static app:MotifAppStrings.TimingByKindAccessibleName}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:TimingKindLegendEntry">
                          <StackPanel Classes="outcomeLegendEntry" Orientation="Horizontal"
                                      Spacing="{DynamicResource Intent.Space.Compact}">
                            <Border Classes="outcomeSegment swatch" Background="{Binding Brush}" />
                            <views:CopyableTextBlock Text="{Binding Row.Label}" />
                            <views:CopyableTextBlock Text="{Binding Row.ShareText}" FontWeight="{DynamicResource Intent.Weight.Strong}" />
                            <views:CopyableTextBlock Classes="muted" Text="{Binding Row.TimeText, StringFormat='{}· {0}'}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="1" Content="{Binding KindCallsButtonText}"
                            Command="{Binding ToggleKindCallsCommand}" IsVisible="{Binding HasKindCalls}"
                            AutomationProperties.Name="{Binding KindCallsButtonName}" />
                  </Grid>
                  <ItemsControl x:Name="TimingPageKindCallSharesItems" ItemsSource="{Binding KindCallShares}" IsVisible="{Binding ShowKindCalls}"
                                AutomationProperties.Name="{x:Static app:MotifAppStrings.CallsByKindAccessibleName}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TimingShare">
                        <StackPanel Classes="outcomeLegendEntry" Orientation="Horizontal"
                                    Spacing="{DynamicResource Intent.Space.Compact}">
                          <views:CopyableTextBlock Text="{Binding Label}" />
                          <views:CopyableTextBlock Classes="muted" Text="{Binding CallsText}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                    <views:CopyableTextBlock Classes="muted" Text="{Binding OverrunText}"
                                             IsVisible="{Binding HasOverrun}"
                                             AutomationProperties.Name="{x:Static app:MotifAppStrings.TimingOverrunAccessibleName}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <Grid Classes="timingTableHeader timingColumns">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2*" />
                      <ColumnDefinition Width="{Binding Context.Inspector, Converter={x:Static views:TimingPage.InspectorKindColumnWidth}}" />
                      <ColumnDefinition Width="0.9*" MinWidth="{DynamicResource Component.Timing.NarrowColumnMinWidth}" />
                      <ColumnDefinition Width="1.3*" MinWidth="{DynamicResource Component.Timing.NarrowColumnMinWidth}" />
                      <ColumnDefinition Width="0.7*" MinWidth="{DynamicResource Component.Timing.WordsColumnMinWidth}" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <views:CopyableTextBlock Grid.Column="0" Text="{x:Static app:MotifAppStrings.TimingRuleColumnHeading}" TextWrapping="Wrap" />
                    <views:CopyableTextBlock Grid.Column="1" Text="{x:Static app:MotifAppStrings.TimingKindColumnHeading}" TextWrapping="Wrap"
                                             IsVisible="{Binding Context.Inspector, Converter={x:Static ObjectConverters.IsNull}}" />
                    <views:CopyableTextBlock Grid.Column="2" Text="{x:Static app:MotifAppStrings.TimingTimeColumnHeading}" TextWrapping="Wrap" />
                    <views:CopyableTextBlock Grid.Column="3" Text="{Binding RuleShareHeader}" TextWrapping="Wrap" />
                    <views:CopyableTextBlock Grid.Column="4" Text="{x:Static app:MotifAppStrings.TimingWordsColumnHeading}" TextWrapping="Wrap"
                                             ToolTip.Tip="{x:Static app:MotifAppStrings.TimingRuleWordsColumnTip}"
                                             views:ClearTipPlacement.IsEnabled="True"
                                             Background="{DynamicResource Intent.Clear}" />
                  </Grid>
                  <views:ProgressiveItemsControl x:Name="TimingPageRuleRowsItems" FullItemsSource="{Binding RuleRows}"
                                AutomationProperties.Name="{x:Static app:MotifAppStrings.TimingByRuleAccessibleName}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TimingRuleRow">
                        <Border Classes="hoverReveal">
                          <Grid Classes="timingColumns">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="2*" />
                              <ColumnDefinition Width="{Binding $parent[views:TimingPage].Page.Context.Inspector, Converter={x:Static views:TimingPage.InspectorKindColumnWidth}}" />
                              <ColumnDefinition Width="0.9*" MinWidth="{DynamicResource Component.Timing.NarrowColumnMinWidth}" />
                              <ColumnDefinition Width="1.3*" MinWidth="{DynamicResource Component.Timing.NarrowColumnMinWidth}" />
                              <ColumnDefinition Width="0.7*" MinWidth="{DynamicResource Component.Timing.WordsColumnMinWidth}" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.ColumnSpan="5" Classes="timingRuleRow" Classes.chosen="{Binding IsChosen}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[views:TimingPage].Page.ChooseRuleCommand}"
                                    CommandParameter="{Binding Row}"
                                    AutomationProperties.Name="{Binding Share.Label, StringFormat='Show words timed under {0}'}">
                              <Grid Classes="timingColumns">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="{Binding $parent[views:TimingPage].Page.Context.Inspector, Converter={x:Static views:TimingPage.InspectorKindColumnWidth}}" />
                                <ColumnDefinition Width="0.9*" MinWidth="{DynamicResource Component.Timing.NarrowColumnMinWidth}" />
                                <ColumnDefinition Width="1.3*" MinWidth="{DynamicResource Component.Timing.NarrowColumnMinWidth}" />
                                <ColumnDefinition Width="0.7*" MinWidth="{DynamicResource Component.Timing.WordsColumnMinWidth}" />
                              </Grid.ColumnDefinitions>
                              <Grid Grid.Column="0" ColumnDefinitions="*,Auto"
                                    ColumnSpacing="{DynamicResource Intent.Space.Compact}">
                                <views:CopyableTextBlock Grid.Column="0" Text="{Binding Share.Label}" FontWeight="{DynamicResource Intent.Weight.Strong}"
                                                         TextTrimming="CharacterEllipsis" />
                                <views:InspectLink Grid.Column="1" Subject="{Binding InspectSubject}"
                                                   Classes="revealControl revealLink revealOnHover"
                                                   VerticalAlignment="Center">
                                  <TextBlock Text="{x:Static app:MotifAppStrings.Inspect}" />
                                </views:InspectLink>
                              </Grid>
                              <views:CopyableTextBlock Grid.Column="1" Classes="muted" Text="{Binding Share.KindLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding $parent[views:TimingPage].Page.Context.Inspector, Converter={x:Static ObjectConverters.IsNull}}" />
                              <views:CopyableTextBlock Grid.Column="2" Classes="muted" Text="{Binding Share.TimeText}"
                                                       TextTrimming="CharacterEllipsis" />
                              <views:CopyableTextBlock Grid.Column="3" Text="{Binding Share.ShareText}"
                                                       TextTrimming="CharacterEllipsis" />
                              <views:CopyableTextBlock Grid.Column="4" Text="{Binding Share.WordsText}"
                                                       TextTrimming="CharacterEllipsis" />
                              </Grid>
                            </Button>
                            <Button Grid.Column="5" Classes="timingGrammarWarning"
                                    IsVisible="{Binding HasGrammarWarning}"
                                    ToolTip.Tip="{x:Static vm:TimingRuleRow.GrammarWarningTooltip}"
                                    AutomationProperties.Name="{x:Static app:MotifAppStrings.OpenTheGrammarWarningAccessibleName}"
                                    AutomationProperties.HelpText="{x:Static vm:TimingRuleRow.GrammarWarningTooltip}"
                                    Command="{Binding $parent[views:TimingPage].Page.OpenGrammarWarningCommand}"
                                    CommandParameter="{Binding}">
                              <views:MarkGlyph Mark="{x:Static vm:Mark.Warning}" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </views:ProgressiveItemsControl>
                </StackPanel>
              </Border>

            </StackPanel>

            <StackPanel x:Name="TimingSidePanel" Classes="timingSidePanel" Grid.Column="1"
                        Spacing="{DynamicResource Intent.Space.Group}">
              <Border Classes="card" IsVisible="{Binding HasRule}">
                <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
                  <views:CopyableTextBlock Classes="section-title" Text="{Binding SelectedRuleName}"
                                            TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedRuleName}" />
                  <views:CopyableTextBlock Text="{Binding RuleSummary}" TextWrapping="Wrap" />
                  <Button Content="{x:Static app:MotifAppStrings.AIHandoffForThisRule}" Command="{Binding HandOffRuleCommand}" />
                </StackPanel>
              </Border>

            </StackPanel>
          </Grid>

          <!-- The word lists take the page's full width, so each row keeps its columns while the column minimums fit and stacks beneath that. -->
          <Border Classes="card" IsVisible="{Binding HasRule}">
            <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
              <views:CopyableTextBlock Classes="section-title" Text="{Binding RuleWordsTitle}" TextWrapping="Wrap" />
              <views:WordListSlot Schema="{x:Static word:WordListSchemas.Timing}">
                <Grid RowDefinitions="Auto,Auto" AutomationProperties.AutomationId="{x:Static app:AutomationIds.TimingWordsGrid}">
                  <word:WordRowHeader />
                  <ItemsControl Grid.Row="1" x:Name="TimingPageCostliestRuleWordRowsItems"
                                ItemsSource="{Binding CostliestRuleWordRows}"
                                AutomationProperties.Name="{x:Static app:MotifAppStrings.WordsUnderThisRuleAccessibleName}"
                                KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ListedWordViewModel">
                        <word:WordRow Data="{Binding TimingPresentation}"
                                      State="{Binding PresentationState, Mode=TwoWay}"
                                      Host="{Binding $parent[views:TimingPage].WordPresentationHost}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </views:WordListSlot>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding HasSelectedWords}">
            <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
              <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.HowLongTheWordsTook}" />
              <views:CopyableTextBlock Text="{Binding PercentileSummary}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
      <Expander Header="{x:Static app:MotifAppStrings.HeaderDetailedStatistics}" IsVisible="{Binding ShowStatistics}"
                Expanded="OnStatisticsExpanded">
        <ContentControl x:Name="StatisticsHost" />
      </Expander>
      </StackPanel>
    </ScrollViewer>

    <Border Classes="card" IsVisible="{Binding Context.NeedsAssessment}"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <views:ParsePrompt DataContext="{Binding Context}" />
    </Border>
  </Grid>
</UserControl>
