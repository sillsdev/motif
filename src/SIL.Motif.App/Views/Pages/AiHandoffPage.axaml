<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.AiHandoffPage"
             x:DataType="vm:AiHandoffPageModel">
  <Grid RowDefinitions="Auto,*">
    <Border Classes="handoffHeader">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding HandoffActionText}"
                Classes="Primary" Theme="{DynamicResource SolidButton}"
                Command="{Binding Handoff.RunCommand}"
                AutomationProperties.Name="{x:Static app:MotifAppStrings.WriteTheAIHandoffFolderAccessibleName}"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.WriteHandoff}" />
        <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.AiHandoffHeading}" />
      </DockPanel>
    </Border>
    <ContentControl x:Name="HandoffHost" Grid.Row="1" />
  </Grid>
</UserControl>
