<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ProgressPage"
             x:DataType="vm:ProgressPageModel">
  <UserControl.Styles>
    <StyleInclude Source="/Tokens/Components/ProgressScoped.axaml" />
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{DynamicResource Intent.Inset.Page}" Spacing="{DynamicResource Intent.Space.Section}">
      <views:CopyableTextBlock Classes="displayTitle" Text="{x:Static app:MotifAppStrings.Progress}" TextWrapping="Wrap"
                 AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProgressHeading}" />
      <views:CopyableTextBlock Text="{Binding Context.ProjectName}" IsVisible="{Binding Context.HasProject}" TextWrapping="Wrap" />
      <views:CopyableTextBlock Text="{Binding Health.SelectionSummary}" IsVisible="{Binding Health.HasSelectionSummary}" TextWrapping="Wrap" />
      <Border Classes="progressNextList" IsVisible="{Binding ShowReadingParse}">
        <StackPanel Classes="progressNextNotice" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProgressReadingParse}">
          <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.ProgressReadingParse}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="progressNextList" IsVisible="{Binding ShowNothingParsed}">
        <StackPanel Classes="progressNextNotice" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProgressNothingParsed}" Spacing="{DynamicResource Intent.Space.Related}">
          <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.ProgressNothingParsedHeading}" TextWrapping="Wrap" />
          <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.ProgressNothingParsedNext}" TextWrapping="Wrap" />
          <Button Command="{Binding OpenTextsCommand}" Content="{x:Static app:MotifAppStrings.ProgressChooseTexts}"
                  HorizontalAlignment="Left" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProgressChooseTexts}" />
        </StackPanel>
      </Border>
      <Border Classes="progressNextList" IsVisible="{Binding HasParse}">
        <StackPanel Classes="progressNextNotice" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProgressParsed}" Spacing="{DynamicResource Intent.Space.Related}">
          <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.ProgressParsedHeading}" TextWrapping="Wrap" />
          <views:CopyableTextBlock Text="{Binding ParseSummaryText}" TextWrapping="Wrap" />
          <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.ProgressParseIsNotApproval}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
            <Button Command="{Binding OpenWordsCommand}" Content="{x:Static app:MotifAppStrings.ProgressReviewWords}"
                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProgressReviewWords}" />
            <Button Command="{Binding OpenTextsCommand}" Content="{x:Static app:MotifAppStrings.ProgressReadTexts}"
                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProgressReadTexts}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="progressNextList" IsVisible="{Binding ShowRefreshToUpgrade}">
        <StackPanel Classes="progressNextNotice" Spacing="{DynamicResource Intent.Space.Related}">
          <Button Command="{Binding RefreshProjectCommand}" Content="{x:Static app:MotifAppStrings.ProgressRefreshToUpgrade}"
                  HorizontalAlignment="Left" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProgressRefreshToUpgrade}" />
        </StackPanel>
      </Border>
      <Border Classes="progressNextList" IsVisible="{Binding ShowOverviewUnavailable}">
        <StackPanel Classes="progressNextNotice" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProgressUnavailable}" Spacing="{DynamicResource Intent.Space.Related}">
          <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.ProgressParseUnavailable}" TextWrapping="Wrap" />
          <Button Command="{Binding TryAgainCommand}" Content="{x:Static app:MotifAppStrings.TryAgain}" HorizontalAlignment="Left"
                  IsVisible="{Binding CanOfferTryAgain}" />
        </StackPanel>
      </Border>
      <Border Classes="progressNextList" IsVisible="{Binding HasNextSection}"
              AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProgressNext}">
        <StackPanel>
          <views:CopyableTextBlock Classes="section-title progressNextHeading" Text="{x:Static app:MotifAppStrings.ProgressNext}" />
          <views:CopyableTextBlock Classes="muted progressNextHeading" Text="{x:Static app:MotifAppStrings.ProgressReadingNext}"
                                  IsVisible="{Binding IsReading}" TextWrapping="Wrap" />
          <ItemsControl x:Name="ProgressNextRows" ItemsSource="{Binding NextRows}" IsVisible="{Binding HasNextRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProgressNextRow">
                <Button Classes="progressNextRow" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Text}"
                        AutomationProperties.AutomationId="{Binding AutomationId}">
                  <Grid ColumnDefinitions="*,3*" ColumnSpacing="{DynamicResource Intent.Space.Group}">
                    <TextBlock Classes="progressNextCategory" Text="{Binding Category}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Classes="progressNextNotice" IsVisible="{Binding HasUnavailableNext}"
                      Spacing="{DynamicResource Intent.Space.Related}">
            <views:CopyableTextBlock Text="{Binding UnavailableNextText}" TextWrapping="Wrap" />
            <Button IsVisible="{Binding CanOfferNextTryAgain}" Command="{Binding TryAgainCommand}" Content="{x:Static app:MotifAppStrings.TryAgain}"
                    HorizontalAlignment="Left" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProgressNextRetry}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
