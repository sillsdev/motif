<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             xmlns:responses="clr-namespace:SIL.Motif.Contract.Responses;assembly=SIL.Motif.Contract"
             x:Class="SIL.Motif.App.Views.GrammarGuidePage"
             x:DataType="vm:GrammarGuidePageModel">
  <Grid Margin="{DynamicResource Intent.Inset.Page}" RowDefinitions="Auto,*" ColumnDefinitions="*,2*" RowSpacing="{DynamicResource Intent.Space.Group}">
    <views:CopyableTextBlock Grid.ColumnSpan="2" Classes="displayTitle" Text="{x:Static app:MotifAppStrings.GrammarGuide}" />
    <ListBox Grid.Row="1" x:Name="GrammarGuideRecords" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"
             AutomationProperties.AutomationId="{x:Static app:AutomationIds.GrammarGuideSections}"
             AutomationProperties.Name="{x:Static app:MotifAppStrings.GrammarGuide}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="responses:GdrSummary">
          <views:CopyableTextBlock Text="{Binding Title}" TextWrapping="Wrap" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <StackPanel>
        <views:CopyableTextBlock Classes="section-title" Text="{Binding SelectedRecord.Title}" TextWrapping="Wrap" />
        <ContentControl x:Name="DiscussionHost" AutomationProperties.AutomationId="{x:Static app:AutomationIds.GrammarGuideDiscussion}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
