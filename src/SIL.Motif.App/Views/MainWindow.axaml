<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SIL.Motif.App.Views"
        xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
        x:Class="SIL.Motif.App.Views.MainWindow"
        x:DataType="vm:HandoffWorkspaceViewModel"
        Title="Motif"
        Icon="avares://SIL.Motif.App/Assets/motif.ico"
        Width="1240"
        Height="780"
        MinWidth="820"
        MinHeight="600">
  <Window.Styles>
    <!-- The sidebar: icon and label per page, the label hidden and offered as a tooltip when collapsed. -->
    <Style Selector="Border.sidebar">
      <Setter Property="Background" Value="{DynamicResource MotifSidebarFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Width" Value="190" />
    </Style>
    <Style Selector="Border.sidebar.collapsed">
      <Setter Property="Width" Value="52" />
    </Style>
    <Style Selector="ListBox.sidebar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,12" />
    </Style>
    <Style Selector="ListBox.sidebar.collapsed">
      <Setter Property="Padding" Value="0,12" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="{DynamicResource MotifSidebarInk}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource MotifSidebarInk}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MotifSidebarSelectedFill}" />
      <Setter Property="Foreground" Value="{DynamicResource MotifSidebarSelectedInk}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource MotifSidebarSelectedInk}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.sidebar.collapsed ListBoxItem">
      <Setter Property="Padding" Value="0,10" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.sidebar.collapsed ListBoxItem:selected">
      <Setter Property="BorderBrush" Value="{DynamicResource MotifCountFill}" />
    </Style>
    <Style Selector="ListBox.sidebar.collapsed ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Path.pageIcon">
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Viewbox.pageIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="ListBox.collapsed Viewbox.pageIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="ListBox.collapsed :is(TextBlock).pageLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.pageBadge">
      <Setter Property="Background" Value="{DynamicResource MotifBadgeFill}" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.pageBadge :is(TextBlock)">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MotifBadgeInk}" />
    </Style>
    <Style Selector="ListBox.collapsed Border.pageBadge">
      <Setter Property="Background" Value="{DynamicResource MotifCountFill}" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,-6,-8,0" />
    </Style>
    <Style Selector="ListBox.collapsed Border.pageBadge :is(TextBlock)">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource MotifCountInk}" />
    </Style>

    <!-- The freshness line: green when current, amber when FieldWorks has saved since, blue while refreshing. -->
    <Style Selector="Ellipse.freshDot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource SemiColorText3}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.freshDot.current">
      <Setter Property="Fill" Value="{DynamicResource MotifFreshCurrent}" />
    </Style>
    <Style Selector="Ellipse.freshDot.stale">
      <Setter Property="Fill" Value="{DynamicResource MotifFreshStale}" />
    </Style>
    <Style Selector="Ellipse.freshDot.busy">
      <Setter Property="Fill" Value="{DynamicResource MotifFreshBusy}" />
    </Style>
    <Style Selector=":is(TextBlock).freshLabel">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(TextBlock).freshLabel.current">
      <Setter Property="Foreground" Value="{DynamicResource MotifFreshCurrent}" />
    </Style>
    <Style Selector=":is(TextBlock).freshLabel.stale">
      <Setter Property="Foreground" Value="{DynamicResource MotifFreshStale}" />
    </Style>
    <Style Selector=":is(TextBlock).freshLabel.busy">
      <Setter Property="Foreground" Value="{DynamicResource MotifFreshBusy}" />
    </Style>

    <!-- Tabs on a page: the active one underlined in the accent colour. -->
    <Style Selector="Button.tab">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
      <Setter Property="Padding" Value="0,8" />
      <Setter Property="Margin" Value="0,0,20,0" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MotifTabActive}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MotifTabActive}" />
    </Style>
    <Style Selector="Button.pendingStrip">
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Background" Value="{DynamicResource MotifCandidateFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MotifCandidateAccent}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.menuEntry">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Top bar: the project menu, how fresh the numbers are, and Refresh. -->
    <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1" Padding="18,0" Height="52">
      <DockPanel LastChildFill="True" VerticalAlignment="Center">

        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
          <Image Source="avares://SIL.Motif.App/Assets/motif-icon.png" Width="22" Height="22" />
          <views:CopyableTextBlock Text="Motif" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <Button x:Name="ProjectMenuButton" DockPanel.Dock="Left" MaxWidth="240" VerticalAlignment="Center"
                Margin="0,0,12,0" AutomationProperties.Name="Project menu">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding ProjectName}" MaxWidth="190" TextTrimming="CharacterEllipsis" FontSize="13" />
            <TextBlock Text="&#x25BE;" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Width="280" Spacing="2">
                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Click="OnProjectMenuEntryClick"
                        Command="{Binding SelectNewProjectCommand}" AutomationProperties.Name="Select a new project">
                  <StackPanel>
                    <TextBlock Text="Select new&#x2026;" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock Text="Choose another .fwdata file" FontSize="11.5" Foreground="{DynamicResource SemiColorText2}" />
                  </StackPanel>
                </Button>
                <Button x:Name="OpenRecentButton" Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                        IsEnabled="{Binding HasRecentProjects}" AutomationProperties.Name="Open a recent project">
                  <StackPanel>
                    <TextBlock Text="Open recent" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RecentProjectsText, StringFormat='{}{0} &#x203A;'}" FontSize="11.5"
                               Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedTop" />
                  </Button.Flyout>
                </Button>
                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Click="OnProjectMenuEntryClick"
                        Command="{Binding ConfigureCommand}" IsEnabled="{Binding HasProject}"
                        AutomationProperties.Name="Configure the project">
                  <StackPanel>
                    <TextBlock Text="Configure&#x2026;" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock Text="Texts, added words and limits" FontSize="11.5" Foreground="{DynamicResource SemiColorText2}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="See what changed" Command="{Binding SeeWhatChangedCommand}"
                  IsVisible="{Binding ShowsSeeWhatChanged}" AutomationProperties.Name="See what the refresh changed" />
          <Button Content="Cancel" Command="{Binding CancelRefreshCommand}"
                  IsVisible="{Binding FreshnessIsBusy}" AutomationProperties.Name="Cancel the refresh" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}"
                  IsVisible="{Binding !FreshnessIsBusy}" AutomationProperties.Name="Refresh the project"
                  ToolTip.Tip="Capture a new Baseline from FieldWorks' last save, then assess the Selection against it." />
        </StackPanel>

        <StackPanel x:Name="FreshnessLine" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    IsVisible="{Binding HasFreshness}">
          <Ellipse Classes="freshDot" Classes.current="{Binding FreshnessIsCurrent}"
                   Classes.stale="{Binding FreshnessIsStale}" Classes.busy="{Binding FreshnessIsBusy}" />
          <views:CopyableTextBlock Classes="freshLabel" Text="{Binding FreshnessLabel}"
                                   Classes.current="{Binding FreshnessIsCurrent}"
                                   Classes.stale="{Binding FreshnessIsStale}" Classes.busy="{Binding FreshnessIsBusy}" />
          <views:CopyableTextBlock Classes="muted" FontSize="12.5" Text="{Binding FreshnessDetail}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1"
            IsVisible="{Binding RerunOffered}"
            Margin="16,12,16,0"
            Classes="card">
      <DockPanel LastChildFill="True">
        <Button Content="Run again"
                Command="{Binding AcceptRerunCommand}"
                AutomationProperties.Name="Run the Assessment again"
                DockPanel.Dock="Right" />
        <Button Content="Dismiss"
                Command="{Binding DismissRerunCommand}"
                AutomationProperties.Name="Dismiss the rerun offer"
                DockPanel.Dock="Right"
                Margin="0,0,8,0" />
        <views:CopyableTextBlock Text="A new Baseline was captured; the previous Assessment may be out of date."
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*">

      <Border x:Name="Sidebar" Classes="sidebar" Classes.collapsed="{Binding IsSidebarCollapsed}">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom" Margin="18,8,8,14" Spacing="2" IsVisible="{Binding IsSidebarExpanded}">
            <views:CopyableTextBlock Classes="muted" FontSize="11" Text="Selection" />
            <views:CopyableTextBlock FontSize="11" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Selection.SummaryText}" />
          </StackPanel>
          <ListBox x:Name="PageList"
                   Classes="sidebar" Classes.collapsed="{Binding IsSidebarCollapsed}"
                   ItemsSource="{Binding Pages}"
                   SelectedItem="{Binding SelectedPage}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Pages">
            <ListBox.Styles>
              <Style Selector="ListBoxItem" x:DataType="vm:PageViewModel">
                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
              </Style>
              <Style Selector="ListBox.collapsed ListBoxItem" x:DataType="vm:PageViewModel">
                <Setter Property="ToolTip.Tip" Value="{Binding Title}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PageViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Viewbox Classes="pageIcon" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Classes="pageIcon" Data="{Binding Page, Converter={x:Static views:PageIcons.Geometry}}"
                            Stroke="{Binding $parent[ListBoxItem].Foreground}" />
                    </Canvas>
                  </Viewbox>
                  <views:CopyableTextBlock Grid.Column="1" Classes="pageLabel" Text="{Binding Title}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="2" Classes="pageBadge" IsVisible="{Binding HasBadge}">
                    <views:CopyableTextBlock Text="{Binding Badge}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Panel Grid.Column="1">

        <ScrollViewer x:Name="OverviewPage" IsVisible="{Binding IsOverviewPage}">
          <ContentControl x:Name="ProjectHost" IsEnabled="{Binding ProjectAndSelectionEnabled}" />
        </ScrollViewer>

        <Grid x:Name="TextsPage" IsVisible="{Binding IsTextsPage}" RowDefinitions="Auto,*">
          <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1" Padding="20,4,20,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="pendingStrip" Margin="0,0,10,4" VerticalAlignment="Center"
                      IsVisible="{Binding Changes.HasItems}"
                      Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:WorkspacePage.Review}"
                      AutomationProperties.Name="Review the changes not applied yet">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource MotifFreshStale}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Changes.CountText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Text="&#183; Review changes" Foreground="{DynamicResource MotifTabActive}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button DockPanel.Dock="Right"
                      Content="Run assessment"
                      Command="{Binding Assess.RunCommand}"
                      VerticalAlignment="Center" Margin="0,0,0,4"
                      AutomationProperties.Name="Run the Assessment" />
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Matrix"
                        Classes="tab" Classes.active="{Binding ShowMatrixTab}"
                        Theme="{DynamicResource BorderlessButton}"
                        Command="{Binding ShowTextsTabCommand}"
                        CommandParameter="{x:Static vm:TextsTab.Matrix}"
                        AutomationProperties.Name="Matrix tab" />
                <Button Content="What changed"
                        Classes="tab" Classes.active="{Binding ShowWhatChangedTab}"
                        Theme="{DynamicResource BorderlessButton}"
                        IsVisible="{Binding Assess.Difference.HasDifference}"
                        Command="{Binding ShowTextsTabCommand}"
                        CommandParameter="{x:Static vm:TextsTab.WhatChanged}"
                        AutomationProperties.Name="What changed tab" />
                <Button Content="Words"
                        Classes="tab" Classes.active="{Binding ShowWordsTab}"
                        Theme="{DynamicResource BorderlessButton}"
                        Command="{Binding ShowTextsTabCommand}"
                        CommandParameter="{x:Static vm:TextsTab.Words}"
                        AutomationProperties.Name="Words tab" />
                <Button Content="Texts"
                        Classes="tab" Classes.active="{Binding ShowTextsReaderTab}"
                        Theme="{DynamicResource BorderlessButton}"
                        Command="{Binding ShowTextsTabCommand}"
                        CommandParameter="{x:Static vm:TextsTab.Texts}"
                        AutomationProperties.Name="Texts tab" />
                <Button Content="In text"
                        Classes="tab" Classes.active="{Binding ShowInTextTab}"
                        Theme="{DynamicResource BorderlessButton}"
                        Command="{Binding ShowTextsTabCommand}"
                        CommandParameter="{x:Static vm:TextsTab.InText}"
                        AutomationProperties.Name="In text tab" />
              </StackPanel>
              <views:CopyableTextBlock Classes="muted"
                         Text="{Binding Assess.Words.OutcomeSummary}"
                         Margin="16,0"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>

          <Panel Grid.Row="1">
            <Panel IsVisible="{Binding ShowMatrixTab}">
              <ContentControl x:Name="CompareHost" />
              <views:CopyableTextBlock Classes="muted"
                         Text="No results yet. Choose what to assess on the Texts tab, then run."
                         IsVisible="{Binding ShowEmptyResults}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Panel>
            <ContentControl x:Name="DifferenceHost" IsVisible="{Binding ShowWhatChangedTab}" />
            <Panel IsVisible="{Binding ShowWordsTab}">
              <ContentControl x:Name="AssessHost" />
              <views:CopyableTextBlock Classes="muted"
                         Text="No results yet. Choose what to assess on the Texts tab, then run."
                         IsVisible="{Binding ShowEmptyResults}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Panel>
            <ScrollViewer x:Name="TextsReader" IsVisible="{Binding ShowTextsReaderTab}">
              <ContentControl x:Name="SelectionHost" IsEnabled="{Binding ProjectAndSelectionEnabled}" />
            </ScrollViewer>
            <ContentControl x:Name="ResultsInTextHost" IsVisible="{Binding ShowInTextTab}" />
          </Panel>
        </Grid>

        <Grid x:Name="TryAWordPage" IsVisible="{Binding IsTryAWordPage}">
          <ContentControl x:Name="TryWordHost" />
        </Grid>

        <Panel x:Name="TimingPage" IsVisible="{Binding IsTimingPage}">
          <views:CopyableTextBlock Classes="muted"
                     Text="Run an Assessment to see where the parse time went."
                     IsVisible="{Binding NotYetAssessed}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
          <ContentControl x:Name="StatisticsHost" IsVisible="{Binding HasEverAssessed}" />
        </Panel>

        <Grid x:Name="WarningsPage" IsVisible="{Binding IsWarningsPage}">
          <ContentControl x:Name="GrammarHost" />
        </Grid>

        <Grid x:Name="ReviewPage" IsVisible="{Binding IsReviewPage}">
          <ContentControl x:Name="ReviewHost" />
        </Grid>

        <Grid x:Name="AiHandoffPage" IsVisible="{Binding IsAiHandoffPage}" RowDefinitions="Auto,*">
          <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1" Padding="20,8">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{Binding HandoffActionText}"
                      Classes="Primary" Theme="{DynamicResource SolidButton}"
                      Command="{Binding Handoff.RunCommand}"
                      AutomationProperties.Name="Write the Handoff folder" />
              <views:CopyableTextBlock Classes="section-title" Text="AI Handoff" />
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Row="1">
            <ContentControl x:Name="HandoffHost" />
          </ScrollViewer>
        </Grid>

      </Panel>
    </Grid>
  </Grid>
</Window>
