<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SIL.Motif.App"
        xmlns:views="clr-namespace:SIL.Motif.App.Views"
        xmlns:controls="using:SIL.Motif.App.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:services="clr-namespace:SIL.Motif.App.Services"
        xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
        x:Class="SIL.Motif.App.Views.MainWindow"
        x:DataType="vm:WorkspaceShellViewModel"
        Title="Motif (tech demo)"
        Icon="avares://SIL.Motif.App/Assets/motif.ico"
        Width="{DynamicResource Component.Shell.Width}"
        Height="{DynamicResource Component.Shell.Height}"
        MinWidth="{DynamicResource Component.Shell.MinWidth}"
        MinHeight="{DynamicResource Component.Shell.MinHeight}"
        WindowDecorations="Full">
  <LayoutTransformControl x:Name="RootLayoutTransform" ClipToBounds="True">
  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Top bar: the project menu, how fresh the numbers are, and Refresh. -->
    <Border x:Name="TopBar" Classes="topBar"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <DockPanel LastChildFill="True" VerticalAlignment="Center">

        <StackPanel Classes="topBarGroup brand" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Classes="brandLogo" Source="avares://SIL.Motif.App/Assets/motif-icon.png" />
          <views:CopyableTextBlock Classes="brandName" Text="Motif" VerticalAlignment="Center" />
        </StackPanel>

        <Button x:Name="ProjectMenuButton" DockPanel.Dock="Left" VerticalAlignment="Center"
                Theme="{DynamicResource OutlineButton}" Classes="Tertiary projectMenu"
                chrome:WindowDecorationProperties.ElementRole="User"
                IsEnabled="{Binding ProjectSwitchEnabled}"
                AutomationProperties.Name="Project menu"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProjectMenu}">
          <StackPanel Classes="topBarGroup" Orientation="Horizontal">
            <TextBlock Classes="projectName" Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding ProjectName}" />
            <TextBlock Classes="disclosure" Text="&#x25BE;" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Classes="menu">
                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Click="OnProjectMenuEntryClick"
                        Command="{Binding SelectNewProjectCommand}" AutomationProperties.Name="Select a new project"
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.SelectNewProject}">
                  <StackPanel>
                    <TextBlock Classes="menuTitle" Text="Select new&#x2026;" />
                    <TextBlock Classes="menuDetail" Text="Choose another .fwdata file" />
                  </StackPanel>
                </Button>
                <Button x:Name="OpenRecentButton" Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                        IsEnabled="{Binding HasRecentProjects}" AutomationProperties.Name="Open a recent project">
                  <StackPanel>
                    <TextBlock Classes="menuTitle" Text="Open recent" />
                    <TextBlock Classes="menuDetail" Text="{Binding RecentProjectsText, StringFormat='{}{0} &#x203A;'}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedTop" />
                  </Button.Flyout>
                </Button>
                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Click="OnProjectMenuEntryClick"
                        Command="{Binding ConfigureCommand}"
                        AutomationProperties.Name="Configure the project">
                  <StackPanel>
                    <TextBlock Classes="menuTitle" Text="Configure&#x2026;" />
                    <TextBlock Classes="menuDetail" Text="{Binding ConfigureDetailText}" />
                  </StackPanel>
                </Button>
                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Click="OnWritingSystemsGuideClick"
                        AutomationProperties.Name="Writing system fonts and direction">
                  <StackPanel>
                    <TextBlock Classes="menuTitle" Text="Writing systems and fonts" />
                    <TextBlock Classes="menuDetail" Text="How Motif displays project language text" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <StackPanel x:Name="TopBarActions" Classes="topBarGroup" DockPanel.Dock="Right" Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button Content="See what changed" Command="{Binding SeeWhatChangedCommand}"
                  Theme="{DynamicResource OutlineButton}" Classes="Tertiary"
                  chrome:WindowDecorationProperties.ElementRole="User"
                  IsVisible="{Binding ShowsSeeWhatChanged}" AutomationProperties.Name="See what the refresh changed" />
          <Button Content="Parse all words" Command="{Binding ParseAllWordsCommand}"
                  Theme="{DynamicResource OutlineButton}" Classes="Tertiary"
                  chrome:WindowDecorationProperties.ElementRole="User"
                  IsVisible="{Binding ShowsParseAllWordsAction}"
                  AutomationProperties.Name="Parse all words"
                  AutomationProperties.AutomationId="{x:Static app:AutomationIds.ParseAllWords}"
                  ToolTip.Tip="Parse the words you chose." />
          <Button x:Name="ChooseWhatToParseButton" Content="Choose what to parse" Command="{Binding ConfigureCommand}"
                  Theme="{DynamicResource OutlineButton}" Classes="Tertiary"
                  chrome:WindowDecorationProperties.ElementRole="User"
                  IsVisible="{Binding ShowsChooseWhatToParseAction}"
                  AutomationProperties.Name="Choose what to parse" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}"
                  Theme="{DynamicResource OutlineButton}" Classes="Tertiary"
                  chrome:WindowDecorationProperties.ElementRole="User"
                  IsVisible="{Binding ShowsRefreshAction}" AutomationProperties.Name="Refresh the project"
                  AutomationProperties.AutomationId="{x:Static app:AutomationIds.RefreshProject}"
                  ToolTip.Tip="Capture a new Baseline from FieldWorks' last save." />
        </StackPanel>

        <DockPanel x:Name="FreshnessLine" Classes="freshness" VerticalAlignment="Center"
                   IsVisible="{Binding HasFreshness}">
          <Ellipse DockPanel.Dock="Left" Classes="freshDot" Classes.current="{Binding FreshnessIsCurrent}"
                   Classes.stale="{Binding FreshnessIsStale}" Classes.busy="{Binding FreshnessIsBusy}"
                   Classes.refused="{Binding HasRefreshRefusal}" />
          <views:CopyableTextBlock DockPanel.Dock="Left" Classes="freshLabel" Text="{Binding FreshnessLabel}"
                                   TextTrimming="CharacterEllipsis"
                                   Classes.current="{Binding FreshnessIsCurrent}"
                                   Classes.stale="{Binding FreshnessIsStale}" Classes.busy="{Binding FreshnessIsBusy}"
                                   Classes.refused="{Binding HasRefreshRefusal}"
                                   AutomationProperties.AutomationId="{x:Static app:AutomationIds.FreshnessLabel}" />
          <views:CopyableTextBlock Classes="muted freshDetail" Text="{Binding FreshnessDetail}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="{x:Static app:AutomationIds.FreshnessDetail}" />
        </DockPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
      <Border x:Name="TechDemoNotice" Grid.Row="0" IsVisible="{Binding TechDemoNotice.IsVisible}" Classes="notice">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
            <HyperlinkButton Classes="reviewLink" Content="Report a problem"
                             Command="{Binding TechDemoNotice.ReportProblemCommand}"
                             AutomationProperties.Name="Report a problem" />
            <Button Content="Got it" Command="{Binding TechDemoNotice.GotItCommand}"
                    AutomationProperties.Name="Acknowledge the tech demo notice" />
          </StackPanel>
          <views:CopyableTextBlock Text="{x:Static vm:TechDemoNoticeViewModel.NoticeText}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
      </Border>
      <Border Grid.Row="1" IsVisible="{Binding HasRefreshRefusal}" Classes="notice">
        <StackPanel>
          <views:RefusalBlock DataContext="{Binding Baseline.ShownRefusal}"
                              StoreDeletionCommand="{Binding $parent[Border].((vm:WorkspaceShellViewModel)DataContext).DeleteRefusedStoreCommand}"
                              AutomationProperties.Name="Refresh refusal" />
          <StackPanel x:Name="StoreDeletionQuestion" Classes="refusal" IsVisible="{Binding IsConfirmingStoreDeletion}">
            <views:CopyableTextBlock Text="{x:Static vm:WorkspaceShellViewModel.StoreDeletionWarning}" TextWrapping="Wrap" />
            <StackPanel Classes="refusalActions" Orientation="Horizontal">
              <Button Content="Delete and reopen"
                      Command="{Binding ConfirmStoreDeletionCommand}"
                      AutomationProperties.Name="Delete Motif's file and reopen the project" />
              <Button Content="Cancel"
                      Command="{Binding CancelStoreDeletionCommand}"
                      AutomationProperties.Name="Keep Motif's file" />
            </StackPanel>
          </StackPanel>
          <views:CopyableTextBlock Classes="muted" Text="{Binding Baseline.HeldStatusText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Grid.Row="2" IsVisible="{Binding HasOpenRefusal}" Classes="notice">
        <StackPanel>
          <views:RefusalBlock DataContext="{Binding OpenRefusal}" />
        </StackPanel>
      </Border>
      <Border Grid.Row="3" IsVisible="{Binding Project.HasMachineStoreRecovery}" Classes="notice">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="Report a problem" Click="OnMachineStoreReportProblemClick"
                  AutomationProperties.Name="Review a machine store problem report" />
          <views:CopyableTextBlock Text="{Binding Project.MachineStoreRecoveryMessage}" TextWrapping="Wrap"
                                   AutomationProperties.Name="Machine store recovery instructions" />
        </DockPanel>
      </Border>
      <TextBlock x:Name="KeyboardShortcutStatusLine" Grid.Row="4" Classes="muted noticeText"
                 IsVisible="False" AutomationProperties.LiveSetting="Polite"
                 AutomationProperties.Name="Keyboard shortcut status" />
      <ItemsControl x:Name="MainWindowWritingSystemNoticesItems" Grid.Row="5"
                    ItemsSource="{Binding Context.TextStyles.MissingFontNotices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="services:WritingSystemFontNotice">
            <Border Classes="quietWritingSystemNotice">
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Classes="reviewLink" Content="See Writing systems"
                        Click="OnWritingSystemsSettingsClick" AutomationProperties.Name="See writing systems" />
                <views:CopyableTextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,*">

      <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Classes="notice"
              IsVisible="{Binding ShowsParseAllWordsProgress}"
              IsHitTestVisible="{Binding ShowsParseAllWordsProgress}">
        <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
            <views:CopyableTextBlock Text="{Binding ActiveParseProgress.StatusText}"
                                     AutomationProperties.Name="Parse progress details"
                                     AutomationProperties.AutomationId="{x:Static app:AutomationIds.ParseProgressDetails}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Column="1" Classes="topBarParseProgress" Minimum="0" Maximum="1"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Value="{Binding ActiveParseProgress.Fraction}"
                         IsIndeterminate="{Binding ActiveParseProgress.IsIndeterminate}"
                         AutomationProperties.Name="Parse all words progress"
                         AutomationProperties.AutomationId="{x:Static app:AutomationIds.ParseAllWordsProgress}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
              <Button Content="Cancel" Command="{Binding CancelParsingCommand}"
                      ToolTip.Tip="Cancel keeps the previous results."
                      AutomationProperties.Name="Cancel parsing all words"
                      AutomationProperties.AutomationId="{x:Static app:AutomationIds.CancelAssessment}" />
              <Button Content="Report a problem" Click="OnParseReportProblemClick"
                      IsVisible="{Binding ActiveParseProgress.IsStalled}"
                      AutomationProperties.Name="Report a problem with parsing"
                      AutomationProperties.AutomationId="{x:Static app:AutomationIds.ParseReportProblem}" />
            </StackPanel>
          </Grid>
          <views:CopyableTextBlock Text="{Binding ActiveParseProgress.StoppedText}" TextWrapping="Wrap"
                                   IsVisible="{Binding ActiveParseProgress.HasStoppedWords}" />
          <Expander Header="See stopped words" IsVisible="{Binding ActiveParseProgress.HasStoppedWords}"
                    AutomationProperties.Name="See stopped words while parsing"
                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.ParseStoppedWords}">
            <ScrollViewer MaxHeight="{DynamicResource Component.Shell.ParseStoppedMaxHeight}">
              <ItemsControl x:Name="MainWindowStoppedWordsItems" ItemsSource="{Binding ActiveParseProgress.StoppedWords}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StoppedParseWordViewModel">
                    <views:CopyableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Expander>
          <views:CopyableTextBlock Text="{Binding ActiveParseProgress.StalledText}" TextWrapping="Wrap"
                                   IsVisible="{Binding ActiveParseProgress.IsStalled}"
                                   AutomationProperties.AutomationId="{x:Static app:AutomationIds.ParseNoProgress}" />
        </StackPanel>
      </Border>

      <Border x:Name="Sidebar" Grid.RowSpan="2" Classes="sidebar" Classes.collapsed="{Binding IsSidebarCollapsed}">
        <Grid RowDefinitions="*,Auto">
          <ListBox x:Name="PageList"
                   Classes="sidebar" Classes.collapsed="{Binding IsSidebarCollapsed}"
                   ItemsSource="{Binding VisiblePages}"
                   SelectedItem="{Binding SelectedPage}"
                   ScrollViewer.VerticalScrollBarVisibility="Visible"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Pages"
                   AutomationProperties.AutomationId="{x:Static app:AutomationIds.Pages}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem" x:DataType="vm:PageViewModel">
                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
              </Style>
              <Style Selector="ListBox.collapsed ListBoxItem" x:DataType="vm:PageViewModel">
                <Setter Property="ToolTip.Tip" Value="{Binding Title}" />
                <Setter Property="views:ClearTipPlacement.IsEnabled" Value="True" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PageViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Viewbox Classes="pageIcon" VerticalAlignment="Center">
                    <Canvas Width="{DynamicResource Component.Sidebar.IconCanvasSize}"
                            Height="{DynamicResource Component.Sidebar.IconCanvasSize}">
                      <Path Classes="pageIcon" Data="{Binding Icon, Converter={x:Static views:PageIcons.Geometry}}"
                            Stroke="{Binding $parent[ListBoxItem].Foreground}" />
                    </Canvas>
                  </Viewbox>
                  <views:CopyableTextBlock Grid.Column="1" Classes="pageLabel" Text="{Binding Title}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="2" Classes="pageBadge" IsVisible="{Binding HasBadge}">
                    <views:CopyableTextBlock Text="{Binding Badge}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="SidebarFooter" Grid.Row="1" Classes="sidebarFooter"
                      Classes.collapsed="{Binding IsSidebarCollapsed}">
            <StackPanel x:Name="SidebarUtilities" Classes="sidebarUtilities"
                        Classes.collapsed="{Binding IsSidebarCollapsed}">
              <Button x:Name="HelpButton" Theme="{DynamicResource OutlineButton}"
                      Classes="Tertiary sidebarUtility"
                      AutomationProperties.Name="Help for the current page"
                      AutomationProperties.AutomationId="{x:Static app:AutomationIds.HelpButton}"
                      ToolTip.Tip="Help for the current page (F1)" ToolTip.Placement="Right">
                <StackPanel Classes="sidebarUtilityContent" Orientation="Horizontal">
                  <TextBlock Classes="sidebarUtilityGlyph" Text="?" />
                  <TextBlock x:Name="SidebarHelpLabel" Classes="sidebarUtilityLabel" Text="Help" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="RightEdgeAlignedBottom" FlyoutPresenterClasses="help"
                          Opened="OnHelpFlyoutOpened">
                    <views:HelpPopupView x:Name="HelpPopupView" />
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button x:Name="SettingsButton" Theme="{DynamicResource OutlineButton}"
                      Classes="Tertiary settingsGear sidebarUtility"
                      AutomationProperties.Name="Settings"
                      AutomationProperties.AutomationId="{x:Static app:AutomationIds.SettingsButton}"
                      ToolTip.Tip="Settings (Ctrl+,)" ToolTip.Placement="Right">
                <Path Classes="settingsGearGlyph"
                      Data="M12 8.25a3.75 3.75 0 1 0 0 7.5 3.75 3.75 0 0 0 0-7.5zm8.1 3.75a8.2 8.2 0 0 0-.1-1.25l2-1.56-2-3.46-2.39.96a8.7 8.7 0 0 0-2.16-1.25L15.1 2h-4.2l-.35 2.44a8.7 8.7 0 0 0-2.16 1.25L6 4.73 4 8.19l2 1.56a8.2 8.2 0 0 0 0 2.5l-2 1.56 2 3.46 2.39-.96a8.7 8.7 0 0 0 2.16 1.25L10.9 22h4.2l.35-2.44a8.7 8.7 0 0 0 2.16-1.25l2.39.96 2-3.46-2-1.56c.07-.41.1-.83.1-1.25z" />
                <Button.Flyout>
                  <Flyout Placement="RightEdgeAlignedBottom" FlyoutPresenterClasses="settings"
                          Opened="OnSettingsFlyoutOpened" Closed="OnSettingsFlyoutClosed">
                    <views:SettingsPopupView x:Name="SettingsPopupView" />
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
            <views:CopyableTextBlock Classes="muted sidebarSelectionSummary" Text="Selection"
                                     IsVisible="{Binding IsSidebarExpanded}" />
            <views:CopyableTextBlock Classes="sidebarSelectionSummary" FontWeight="Bold" TextWrapping="Wrap"
                                     Text="{Binding SelectionSummaryText}" IsVisible="{Binding IsSidebarExpanded}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Every page's own view, built from the page registry; only the current one shows. -->
      <Panel x:Name="PageHost" Grid.Row="1" Grid.Column="1" />

      <!-- The inspector sits beside the page rather than over it, so the page stays where it is. -->
      <views:Inspector x:Name="Inspector" Grid.Row="1" Grid.Column="2" DataContext="{Binding Inspector}" />
    </Grid>

    <views:SetupDialog x:Name="SetupDialogView" Grid.RowSpan="3" DataContext="{Binding Context.Setup}" />
  </Grid>
  </LayoutTransformControl>
</Window>
