<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
        x:Class="SIL.Motif.App.Views.MainWindow"
        x:DataType="vm:HandoffWorkspaceViewModel"
        Title="Motif"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600">
  <Window.Styles>
    <Style Selector="Border.marker">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorText3}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.marker.current">
      <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
    </Style>
    <Style Selector="Border.marker.done">
      <Setter Property="Background" Value="{DynamicResource SemiColorSuccess}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorSuccess}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="248,*">

    <Border Grid.ColumnSpan="2"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0,0,0,1"
            Padding="20,10">
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Right"
                Content="Change project"
                Command="{Binding ShowStageCommand}"
                CommandParameter="{x:Static vm:WorkflowStage.Project}"
                AutomationProperties.Name="Change the project" />
        <TextBlock Text="Motif" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ProjectName}" Margin="20,0,0,0" VerticalAlignment="Center" />
        <TextBlock Classes="muted" Text="{Binding BaselineHeaderText}" Margin="16,0,0,0"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border Grid.Row="1"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0,0,1,0"
            Padding="12,16">
      <ListBox ItemsSource="{Binding Stages}"
               SelectedItem="{Binding SelectedStage}"
               AutomationProperties.Name="Stages">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:StageViewModel">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:StageViewModel">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Classes="marker" Classes.current="{Binding IsCurrent}" Classes.done="{Binding ShowsCheck}">
                <Panel>
                  <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding !ShowsCheck}" />
                  <TextBlock Text="&#x2713;" FontSize="13" FontWeight="Bold" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding ShowsCheck}" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto">

      <Border IsVisible="{Binding RerunOffered}"
              Margin="20,16,20,0"
              Classes="card">
        <DockPanel LastChildFill="True">
          <Button Content="Run again"
                  Command="{Binding AcceptRerunCommand}"
                  AutomationProperties.Name="Run the Assessment again"
                  DockPanel.Dock="Right" />
          <Button Content="Dismiss"
                  Command="{Binding DismissRerunCommand}"
                  AutomationProperties.Name="Dismiss the rerun offer"
                  DockPanel.Dock="Right"
                  Margin="0,0,8,0" />
          <TextBlock Text="A new Baseline was captured; the previous Assessment may be out of date."
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <Panel Grid.Row="1">
        <ScrollViewer x:Name="ProjectStage" IsVisible="{Binding IsProjectStage}">
          <ContentControl x:Name="ProjectHost" IsEnabled="{Binding ProjectAndSelectionEnabled}" />
        </ScrollViewer>
        <ScrollViewer x:Name="SelectionStage" IsVisible="{Binding IsSelectionStage}">
          <ContentControl x:Name="SelectionHost" IsEnabled="{Binding ProjectAndSelectionEnabled}" />
        </ScrollViewer>
        <ScrollViewer x:Name="ResultsStage" IsVisible="{Binding IsResultsStage}">
          <StackPanel Spacing="0">
            <ContentControl x:Name="AssessHost" />
            <TextBlock Classes="muted"
                       Text="Run an Assessment to see statistics here."
                       IsVisible="{Binding NotYetAssessed}"
                       Margin="24,12"
                       FontStyle="Italic" />
            <ContentControl x:Name="StatisticsHost"
                            IsVisible="{Binding HasEverAssessed}"
                            MinHeight="320" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="HandoffStage" IsVisible="{Binding IsHandoffStage}">
          <ContentControl x:Name="HandoffHost" />
        </ScrollViewer>
      </Panel>

      <Border Grid.Row="2"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="0,1,0,0"
              Padding="24,12">
        <Panel>

          <DockPanel x:Name="ProjectActions" IsVisible="{Binding IsProjectStage}">
            <Button DockPanel.Dock="Right"
                    Content="Continue to Selection"
                    Classes="Primary" Theme="{DynamicResource SolidButton}"
                    Command="{Binding ShowStageCommand}"
                    CommandParameter="{x:Static vm:WorkflowStage.Selection}"
                    IsEnabled="{Binding HasProject}"
                    AutomationProperties.Name="Continue to Selection" />
            <TextBlock Classes="muted" Text="Choose a project, then capture its Baseline to list its Texts."
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>

          <DockPanel x:Name="SelectionActions" IsVisible="{Binding IsSelectionStage}">
            <Button DockPanel.Dock="Right"
                    Content="Run assessment"
                    Classes="Primary" Theme="{DynamicResource SolidButton}"
                    Command="{Binding Assess.RunCommand}"
                    AutomationProperties.Name="Run the Assessment" />
            <TextBlock Text="{Binding Selection.SummaryText}" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextWrapping="Wrap" />
          </DockPanel>

          <DockPanel x:Name="ResultsActions" IsVisible="{Binding IsResultsStage}">
            <Button DockPanel.Dock="Right"
                    Content="Continue to Handoff"
                    Classes="Primary" Theme="{DynamicResource SolidButton}"
                    Command="{Binding ShowStageCommand}"
                    CommandParameter="{x:Static vm:WorkflowStage.Handoff}"
                    IsEnabled="{Binding HasEverAssessed}"
                    AutomationProperties.Name="Continue to Handoff" />
            <Button DockPanel.Dock="Right"
                    Content="Run again"
                    Command="{Binding Assess.RunCommand}"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Run the Assessment from Results" />
            <TextBlock Text="{Binding Assess.Result.CompletionSummary, FallbackValue='Not run yet'}"
                       FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>

          <DockPanel x:Name="HandoffActions" IsVisible="{Binding IsHandoffStage}">
            <Button DockPanel.Dock="Right"
                    Content="{Binding HandoffActionText}"
                    Classes="Primary" Theme="{DynamicResource SolidButton}"
                    Command="{Binding Handoff.RunCommand}"
                    AutomationProperties.Name="Write the Handoff folder" />
            <TextBlock Text="{Binding HandoffStatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>

        </Panel>
      </Border>
    </Grid>
  </Grid>
</Window>
