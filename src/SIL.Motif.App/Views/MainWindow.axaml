<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SIL.Motif.App"
        xmlns:views="clr-namespace:SIL.Motif.App.Views"
        xmlns:controls="using:SIL.Motif.App.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
        x:Class="SIL.Motif.App.Views.MainWindow"
        x:DataType="vm:WorkspaceShellViewModel"
        Title="Motif (tech demo)"
        Icon="avares://SIL.Motif.App/Assets/motif.ico"
        Width="{DynamicResource Component.Shell.Width}"
        Height="{DynamicResource Component.Shell.Height}"
        MinWidth="{DynamicResource Component.Shell.MinWidth}"
        MinHeight="{DynamicResource Component.Shell.MinHeight}"
        WindowDecorations="Full">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SIL.Motif.App/Tokens/Scoped/ControlHeights.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <LayoutTransformControl x:Name="RootLayoutTransform" ClipToBounds="True">
  <Grid RowDefinitions="Auto,*">

    <!-- Top bar, one row: the icon, the menus (behind a ≡ when narrow), and the project chip and Refresh. -->
    <Border x:Name="TopBar" Classes="topBar"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid x:Name="TopBarRow" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
        <Image Classes="brandLogo" Source="avares://SIL.Motif.App/Assets/motif-icon.png" />

        <Menu x:Name="MainMenu" Grid.Column="1" Classes="mainMenu" VerticalAlignment="Center"
              chrome:WindowDecorationProperties.ElementRole="User"
              AutomationProperties.Name="{x:Static app:MotifAppStrings.MainMenuAccessibleName}"
              AutomationProperties.AutomationId="{x:Static app:AutomationIds.MainMenu}">
          <MenuItem x:Name="FileMenu" Header="{x:Static app:MotifAppStrings.MenuFile}"
                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProjectMenu}">
            <MenuItem x:Name="SelectNewMenuItem" Header="{x:Static app:MotifAppStrings.MenuSelectNew}"
                      IsEnabled="{Binding ProjectSwitchEnabled}" Command="{Binding SelectNewProjectCommand}"
                      AutomationProperties.AutomationId="{x:Static app:AutomationIds.SelectNewProject}" />
            <MenuItem x:Name="OpenRecentMenuItem" Header="{x:Static app:MotifAppStrings.MenuOpenRecent}">
              <MenuItem.IsEnabled>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="ProjectSwitchEnabled" />
                  <Binding Path="HasRecentProjects" />
                </MultiBinding>
              </MenuItem.IsEnabled>
            </MenuItem>
            <MenuItem x:Name="RefreshMenuItem" Header="{x:Static app:MotifAppStrings.MenuRefresh}"
                      Command="{Binding RefreshCommand}" />
            <MenuItem x:Name="ConfigureMenuItem" Header="{x:Static app:MotifAppStrings.MenuConfigure}"
                      Command="{Binding ConfigureCommand}" ToolTip.ShowOnDisabled="True"
                      ToolTip.Tip="{Binding ConfigureDetailText}"
                      AutomationProperties.HelpText="{Binding ConfigureDetailText}" />
            <Separator />
            <MenuItem x:Name="ExitMenuItem" Header="{x:Static app:MotifAppStrings.MenuExit}" Click="OnExitClick" />
          </MenuItem>
          <MenuItem x:Name="EditMenu" Header="{x:Static app:MotifAppStrings.MenuEdit}">
            <MenuItem x:Name="UndoMenuItem" Header="{x:Static app:MotifAppStrings.MenuUndo}" Tag="Undo" Click="OnEditMenuClick" />
            <MenuItem x:Name="RedoMenuItem" Header="{x:Static app:MotifAppStrings.MenuRedo}" Tag="Redo" Click="OnEditMenuClick" />
            <Separator />
            <MenuItem x:Name="CopyMenuItem" Header="{x:Static app:MotifAppStrings.MenuCopy}" Tag="Copy" Click="OnEditMenuClick" />
          </MenuItem>
          <MenuItem x:Name="ViewMenu" Header="{x:Static app:MotifAppStrings.MenuView}">
            <MenuItem x:Name="ZoomInMenuItem" Header="{x:Static app:MotifAppStrings.MenuZoomIn}" Tag="ZoomIn" Click="OnViewMenuClick" />
            <MenuItem x:Name="ZoomOutMenuItem" Header="{x:Static app:MotifAppStrings.MenuZoomOut}" Tag="ZoomOut" Click="OnViewMenuClick" />
            <MenuItem x:Name="ResetZoomMenuItem" Header="{x:Static app:MotifAppStrings.MenuResetZoom}" Tag="ResetZoom" Click="OnViewMenuClick" />
          </MenuItem>
          <MenuItem x:Name="ToolsMenu" Header="{x:Static app:MotifAppStrings.MenuTools}">
            <MenuItem x:Name="OptionsMenuItem" Header="{x:Static app:MotifAppStrings.MenuOptions}" Tag="OpenSettings" Click="OnSettingsClick" />
            <MenuItem x:Name="WritingSystemsMenuItem" Header="{x:Static app:MotifAppStrings.MenuWritingSystems}" Click="OnWritingSystemsGuideClick" />
          </MenuItem>
          <MenuItem x:Name="HelpMenu" Header="{x:Static app:MotifAppStrings.MenuHelp}">
            <MenuItem x:Name="HelpTopicsMenuItem" Header="{x:Static app:MotifAppStrings.MenuHelpTopics}" Tag="ShowHelp" Click="OnHelpTopicsClick" />
            <MenuItem x:Name="KeyboardShortcutsMenuItem" Header="{x:Static app:MotifAppStrings.MenuKeyboardShortcuts}" Tag="ShowShortcuts" Click="OnKeyboardShortcutsClick" />
            <Separator />
            <MenuItem x:Name="ReportProblemMenuItem" Header="{x:Static app:MotifAppStrings.MenuReportProblem}" Click="OnStatusReportProblemClick" />
          </MenuItem>
        </Menu>

        <Border x:Name="TopBarSeparator" Grid.Column="2" Classes="topBarSeparator" />

        <!-- The chip shortens its words before it pushes Refresh out of the row; Refresh stays beside it. -->
        <DockPanel x:Name="ProjectChipRow" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Button x:Name="RefreshIconButton" DockPanel.Dock="Right" Classes="Tertiary refreshIcon"
                  Theme="{DynamicResource BorderlessButton}"
                  Content="{x:Static app:MotifAppStrings.RefreshIconGlyph}" Command="{Binding RefreshCommand}"
                  chrome:WindowDecorationProperties.ElementRole="User"
                  AutomationProperties.Name="{x:Static app:MotifAppStrings.RefreshAccessibleName}"
                  AutomationProperties.AutomationId="{x:Static app:AutomationIds.RefreshProject}"
                  ToolTip.Tip="{x:Static app:MotifAppStrings.Refresh}" views:ClearTipPlacement.IsEnabled="True" />
          <Button x:Name="ProjectChip" Classes="Tertiary projectChip" Theme="{DynamicResource BorderlessButton}"
                  chrome:WindowDecorationProperties.ElementRole="User"
                  AutomationProperties.Name="{Binding ProjectChipAccessibleName}"
                  AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProjectChip}"
                  ToolTip.Tip="{Binding ProjectChipAccessibleName}">
            <DockPanel>
              <Ellipse DockPanel.Dock="Left" Classes="freshDot" IsVisible="{Binding HasFreshness}"
                       Classes.current="{Binding FreshnessIsCurrent}" Classes.stale="{Binding FreshnessIsStale}"
                       Classes.busy="{Binding FreshnessIsBusy}" Classes.refused="{Binding HasRefreshRefusal}" />
              <TextBlock DockPanel.Dock="Right" Classes="chipCaret" VerticalAlignment="Center"
                         Text="{x:Static app:MotifAppStrings.ProjectChipCaret}" />
              <TextBlock x:Name="ProjectNameLabel" DockPanel.Dock="Left" Classes="projectName" VerticalAlignment="Center"
                         Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ProjectChipDetail" Classes="chipDetail" VerticalAlignment="Center"
                         Text="{Binding ProjectChipDetailText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="projectCard">
                <views:ProjectCardView x:Name="ProjectCardView" />
              </Flyout>
            </Button.Flyout>
          </Button>
        </DockPanel>
      </Grid>
    </Border>

    <views:MotifWorkspaceView x:Name="WorkspaceView" Grid.Row="1" />

    <views:SetupDialog x:Name="SetupDialogView" Grid.RowSpan="2" DataContext="{Binding Context.Setup}" />
  </Grid>
  </LayoutTransformControl>
</Window>
