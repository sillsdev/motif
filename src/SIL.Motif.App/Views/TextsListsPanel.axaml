<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:word="clr-namespace:SIL.Motif.App.Controls.WordPresentation"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.TextsListsPanel"
             x:DataType="views:TextsListsPanel">
  <UserControl.Styles>
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/TextsListsScoped.axaml" />
  </UserControl.Styles>
  <ScrollViewer x:Name="TextsListsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <Grid x:Name="TextsListsHost" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource Intent.Space.Related}"
        Margin="{DynamicResource Component.TextsPage.PageInset}">
    <ItemsControl x:Name="TextsListsPanelListsItems" ItemsSource="{Binding Lists.Lists}" AutomationProperties.Name="{x:Static app:MotifAppStrings.WordListsAccessibleName}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TextsListDefinitionViewModel">
          <Button Classes="filterChip" Classes.active="{Binding IsSelected}" IsVisible="{Binding HasWords}"
                  Command="{Binding $parent[views:TextsListsPanel].Lists.SelectListCommand}" CommandParameter="{Binding}"
                  AutomationProperties.Name="{Binding Name, StringFormat='Open the {0} word list'}">
            <StackPanel Classes="filterChipRow" Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" />
              <TextBlock Classes="chipCount" Text="{Binding WordCount}" FontWeight="{DynamicResource Intent.Weight.Strong}" />
              <Ellipse Classes="freshDot" IsVisible="{Binding HasPendingChanges}" VerticalAlignment="Center"
                       ToolTip.Tip="{Binding PendingChangeStatus}" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <DockPanel Grid.Row="1" x:Name="ListHeader" IsVisible="{Binding Lists.HasSelectedList}">
      <views:CopyableTextBlock DockPanel.Dock="Left" Classes="section-title" Text="{Binding Lists.SelectedList.Name}"
                               VerticalAlignment="Center" Margin="{DynamicResource Intent.Gap.AfterRelated}" />
      <views:CopyableTextBlock DockPanel.Dock="Left" Classes="muted" Text="{Binding Lists.SelectedList.CountText}"
                               VerticalAlignment="Center" Margin="{DynamicResource Intent.Gap.AfterRelated}" />
      <views:CopyableTextBlock Classes="muted" Text="{Binding Lists.SelectedList.Sentence}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Lists.SelectedList.Sentence}" />
    </DockPanel>

    <WrapPanel Grid.Row="2" x:Name="ListControls" IsVisible="{Binding Lists.HasSelectedList}"
               ItemSpacing="{DynamicResource Intent.Space.Related}" LineSpacing="{DynamicResource Intent.Space.Related}">
      <ComboBox x:Name="TextsListsPanelSortChoicesItems" ItemsSource="{Binding Lists.Compare.SortChoices}"
                SelectedItem="{Binding Lists.Compare.Sort}"
                MinWidth="{DynamicResource Component.TextsPage.CompareSortMinWidth}"
                AutomationProperties.Name="{x:Static app:MotifAppStrings.OrderTheWordsInTheSelectedAccessibleName}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CompareSort">
            <TextBlock Text="{Binding Converter={x:Static views:ComparePanel.SortLabel}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBox x:Name="ListsWordSearch" Text="{Binding Lists.Compare.SearchText}"
               PlaceholderText="Search words..." Width="{DynamicResource Component.TextsPage.CompareSearchWidth}"
               AutomationProperties.Name="{x:Static app:MotifAppStrings.SearchWordsInListsAccessibleName}" />
        <Button Content="{Binding Lists.ParseAgainLabel}" Command="{Binding Lists.ParseAgainCommand}"
                IsVisible="{Binding Lists.CanParseAgain}"
                AutomationProperties.Name="{x:Static app:MotifAppStrings.ParseTheSelectedListSStoppedAccessibleName}"
                AutomationProperties.HelpText="{Binding Lists.ParseAgainHelpText}"
                ToolTip.Tip="{Binding Lists.ParseAgainHelpText}" views:ClearTipPlacement.IsEnabled="True" />
        <Button Content="{Binding Lists.HandOffCheckedWordsLabel}"
                Command="{Binding Lists.HandOffCheckedWordsCommand}"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.HandOffCheckedWords}"
                AutomationProperties.Name="{x:Static vm:WindowCopy.AiHandoffForTickedWordsInThisList}"
                AutomationProperties.HelpText="{Binding Lists.HandOffCheckedWordsHelpText}"
                ToolTip.Tip="{Binding Lists.HandOffCheckedWordsHelpText}" views:ClearTipPlacement.IsEnabled="True" ToolTip.ShowOnDisabled="True" />
        <Button Content="{Binding Lists.HandOffListLabel}" Command="{Binding Lists.HandOffListCommand}"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.HandOffList}"
                AutomationProperties.Name="{Binding Lists.HandOffListLabel}"
                AutomationProperties.HelpText="{Binding Lists.HandOffListDisabledReason}"
                ToolTip.Tip="{Binding Lists.HandOffListDisabledReason}" views:ClearTipPlacement.IsEnabled="True" ToolTip.ShowOnDisabled="True" />
    </WrapPanel>

    <views:WordListSlot Grid.Row="3" Classes="textsListsWords" Schema="{x:Static word:WordListSchemas.All}"
                        ShowsMeaning="{Binding Lists.ShowsMeaning}" IsVisible="{Binding Lists.HasSelectedList}"
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.ListsWordsSlot}">
      <Grid RowDefinitions="Auto,*" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ListsWordsGrid}">
      <word:WordRowHeader />
      <ListBox x:Name="TextsListsPanelWordsItems" Grid.Row="1" Classes="wordRows" ItemsSource="{Binding Lists.Compare.Words}"
               KeyboardNavigation.TabNavigation="Continue"
               AutomationProperties.Name="{x:Static app:MotifAppStrings.WordsInTheSelectedListAccessibleName}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CompareWordViewModel">
            <word:WordRow Data="{Binding ListsPresentation}" State="{Binding PresentationState, Mode=TwoWay}"
                          Host="{Binding $parent[views:TextsListsPanel].PresentationHost}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      </Grid>
    </views:WordListSlot>
    <views:CopyableTextBlock Grid.Row="3" Classes="muted" Text="{x:Static app:MotifAppStrings.ChooseAListAboveToSee}"
                             IsVisible="{Binding !Lists.HasSelectedList}"
                             VerticalAlignment="Center" HorizontalAlignment="Center" />
  </Grid>
  </ScrollViewer>
</UserControl>
