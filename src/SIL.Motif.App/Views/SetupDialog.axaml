<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.SetupDialog"
             x:DataType="vm:SetupViewModel"
             IsVisible="{Binding IsOpen}">
  <Grid Classes="setupOverlay">
    <Border Classes="setupScrim" />
    <Border x:Name="DialogSurface" Classes="setupDialog" HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{DynamicResource Intent.Space.Group}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Group}">
          <TextBlock Classes="setupCaption" Text="{Binding StepCaption}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <ItemsControl x:Name="SetupDialogIndicatorsItems" Grid.Column="1" ItemsSource="{Binding Indicators}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SetupStepIndicator">
                <Border Classes="setupStepMarker" Classes.current="{Binding IsCurrent}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="{DynamicResource Intent.Space.Snug}">
          <TextBlock Classes="setupTitle" IsVisible="{Binding IsProjectStep}" Text="{x:Static app:MotifAppStrings.SetupFoundProjectTitle}" />
          <TextBlock Classes="setupTitle" IsVisible="{Binding IsSelectionStep}" Text="{x:Static app:MotifAppStrings.SetupSelectionTitle}" />
          <TextBlock Classes="setupTitle" IsVisible="{Binding IsLimitsStep}" Text="{x:Static app:MotifAppStrings.SetupLimitsTitle}" />
          <TextBlock Classes="setupTitle" IsVisible="{Binding IsFirstRunStep}" Text="{Binding FinishTitle}" />

        </StackPanel>

        <ScrollViewer x:Name="SetupBodyScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
          <views:RefusalBlock DataContext="{Binding ShownRefusal}" />
          <TextBlock Classes="setupDescription" IsVisible="{Binding IsProjectStep}"
                     Text="{x:Static app:MotifAppStrings.SetupFoundProjectDescription}" TextWrapping="Wrap" />
          <TextBlock Classes="setupDescription" IsVisible="{Binding IsSelectionStep}"
                     Text="{x:Static app:MotifAppStrings.SetupSelectionDescription}"
                     TextWrapping="Wrap" />
          <TextBlock Classes="setupDescription" IsVisible="{Binding IsLimitsStep}"
                     Text="{x:Static app:MotifAppStrings.SetupLimitsDescription}" TextWrapping="Wrap" />
          <TextBlock Classes="setupDescription" IsVisible="{Binding IsFirstRunStep}"
                     Text="{Binding FinishDescription}" TextWrapping="Wrap" />

          <Grid>
          <StackPanel IsVisible="{Binding IsProjectStep}" Spacing="{DynamicResource Intent.Space.Related}" VerticalAlignment="Center">
            <TextBlock Classes="setupProjectName" Text="{Binding ProjectName}" />
            <TextBlock Classes="setupMuted" Text="{x:Static app:MotifAppStrings.SetupChoicesKeptCaption}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel IsVisible="{Binding IsSelectionStep}" Spacing="{DynamicResource Intent.Space.Related}">
            <TextBlock Classes="setupMuted" Text="{x:Static app:MotifAppStrings.SetupTextsOrderCaption}" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}"
                        IsVisible="{Binding Selection.HasTexts}">
              <Button Content="{x:Static app:MotifAppStrings.SelectAllTexts}" Command="{Binding Selection.SelectAllTextsCommand}"
                      Theme="{DynamicResource BorderlessButton}" Foreground="{DynamicResource Intent.Accent}"
                      AutomationProperties.Name="{x:Static app:MotifAppStrings.SelectAllTextsAccessibleName}"
                      AutomationProperties.AutomationId="{x:Static app:AutomationIds.SetupSelectAllTexts}" />
              <Button Content="{x:Static app:MotifAppStrings.Clear}" Command="{Binding Selection.ClearTextsCommand}"
                      IsVisible="{Binding Selection.ShowClearTexts}"
                      Theme="{DynamicResource BorderlessButton}" Foreground="{DynamicResource Intent.Accent}"
                      AutomationProperties.Name="{x:Static app:MotifAppStrings.Clear}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.SetupClearTexts}" />
            </StackPanel>
            <Border Classes="setupTextList">
              <ItemsControl x:Name="SetupDialogTextsItems" ItemsSource="{Binding Selection.Texts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TextChoiceViewModel">
                    <Border Classes="setupTextRow">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Title}" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="{DynamicResource Intent.Weight.Section}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="setupMuted" Text="{Binding DistinctCountText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Classes="setupCoverage" Text="{Binding InterlinearizedText}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <TextBlock Classes="setupMuted" Text="{Binding Selection.TextsEmptyMessage}"
                       IsVisible="{Binding Selection.TextsEmptyMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                       TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Related}">
              <TextBlock Text="{x:Static app:MotifAppStrings.SetupAddWordsLabel}" FontWeight="{DynamicResource Intent.Weight.Section}" VerticalAlignment="Top" />
              <TextBox Grid.Column="1" Text="{Binding Selection.PastedWords}" AcceptsReturn="True"
                       TextWrapping="Wrap" MinHeight="{DynamicResource Component.Setup.AddedWordsHeight}"
                       MaxHeight="{DynamicResource Component.Setup.AddedWordsMaxHeight}"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       PlaceholderText="{x:Static app:MotifAppStrings.OneWordPerLinePlaceholder}" AutomationProperties.Name="{x:Static app:MotifAppStrings.WordsToAddAccessibleName}"
                       AutomationProperties.AutomationId="{x:Static app:AutomationIds.SetupAddWords}" />
            </Grid>
            <Border Classes="setupSummary">
              <TextBlock Classes="setupSummaryText" Text="{Binding RunSummary}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsLimitsStep}" Spacing="{DynamicResource Intent.Space.Group}" VerticalAlignment="Center">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Group}">
              <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                <TextBlock Text="{x:Static app:MotifAppStrings.SetupAttemptLimitPerWord}" FontWeight="{DynamicResource Intent.Weight.Section}" />
                <TextBlock Classes="setupMuted" Text="{x:Static app:MotifAppStrings.SetupAttemptLimitDefaultCaption}" TextWrapping="Wrap" />
              </StackPanel>
              <NumericUpDown Grid.Column="1" Classes="setupNumber" Value="{Binding StepLimitSteps}"
                             Minimum="1" Increment="200000" FormatString="N0"
                             IsEnabled="{Binding !IsStepLimitUnbounded}"
                             AutomationProperties.Name="{x:Static app:MotifAppStrings.SetupAttemptLimitPerWordAccessibleName}"
                             AutomationProperties.AutomationId="{x:Static app:AutomationIds.SetupStepLimit}" />
            </Grid>
            <CheckBox Content="{x:Static app:MotifAppStrings.NoAttemptLimit}" IsChecked="{Binding IsStepLimitUnbounded}" />
            <TextBlock Classes="setupError" Text="{Binding StepLimitValidationMessage}"
                       IsVisible="{Binding StepLimitValidationMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="setupMuted" Text="{Binding StepLimitEstimateText}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel IsVisible="{Binding IsFirstRunStep}" Spacing="{DynamicResource Intent.Space.Related}" VerticalAlignment="Center">
            <TextBlock Classes="setupProjectName" Text="{Binding FinishButtonText}" />
            <TextBlock Classes="setupMuted" Text="{Binding AddedWordsText}" TextWrapping="Wrap" />
            <Border Classes="setupSummary">
              <TextBlock Classes="setupSummaryText" Text="{Binding RunSummary}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
          </Grid>
        </StackPanel>
        </ScrollViewer>

        <!-- FieldWorks dialog buttons: Skip for Now is an optional step that sits bottom left; Back, the confirming Next or
             Finish, then Cancel form the bottom-right group. Enter confirms and Esc cancels while the dialog is open. -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
          <Button Classes="setupSkip" HorizontalAlignment="Left" Content="{x:Static app:MotifAppStrings.SkipForNow}" Command="{Binding SkipCommand}"
                  AutomationProperties.Name="{x:Static app:MotifAppStrings.SkipSetupForNowAccessibleName}"
                  AutomationProperties.AutomationId="{x:Static app:AutomationIds.SkipSetup}" />
          <Button Grid.Column="1" Classes="setupSecondary" Content="{x:Static app:MotifAppStrings.Back}" Command="{Binding BackCommand}"
                  IsVisible="{Binding IsBackVisible}"
                  AutomationProperties.AutomationId="{x:Static app:AutomationIds.SetupBack}" />
          <Button Grid.Column="2" Classes="setupPrimary" Content="{Binding NextButtonText}" Command="{Binding NextCommand}"
                  IsVisible="{Binding IsNextVisible}" IsDefault="{Binding IsOpen}"
                  AutomationProperties.AutomationId="{x:Static app:AutomationIds.SetupNext}" />
          <Button Grid.Column="2" Classes="setupPrimary" Content="{Binding FinishButtonText}"
                  Command="{Binding FinishCommand}" IsVisible="{Binding IsFirstRunStep}" IsDefault="{Binding IsOpen}"
                  AutomationProperties.Name="{Binding FinishButtonText}"
                  AutomationProperties.AutomationId="{x:Static app:AutomationIds.SetupFinish}" />
          <Button Grid.Column="3" Classes="setupSecondary" Content="{x:Static app:MotifAppStrings.Cancel}"
                  Command="{Binding CancelCommand}" IsCancel="{Binding IsOpen}"
                  AutomationProperties.Name="{x:Static app:MotifAppStrings.CancelSetupAccessibleName}"
                  AutomationProperties.AutomationId="{x:Static app:AutomationIds.SetupCancel}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
