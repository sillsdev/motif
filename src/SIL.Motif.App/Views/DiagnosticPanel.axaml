<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.DiagnosticPanel"
             x:DataType="vm:TraceWordViewModel"
             SizeChanged="OnPanelSizeChanged">
  <Border>
    <StackPanel Classes="diagnosticBody" Spacing="{DynamicResource Intent.Space.Group}">
      <!-- The answer first: did it parse, then how hard the parser worked. Tools sit behind one menu. -->
      <StackPanel Spacing="{DynamicResource Intent.Space.Snug}" IsVisible="{Binding $parent[views:DiagnosticPanel].ShowResultSummary}">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}"
                      IsVisible="{Binding $parent[views:DiagnosticPanel].ShowResultSummary}">
            <views:CopyableTextBlock Text="{Binding Result.Word}" FontSize="{DynamicResource Intent.Type.Title}" FontWeight="SemiBold"
                                     IsVisible="{Binding ShowsOtherWord}" AutomationProperties.Name="Diagnostic word" />
            <views:MarkChip Mark="{Binding AnswerMark}" Text="{Binding AnswerText}"
                               IsVisible="{Binding HasResult}" />
          </StackPanel>
          <Button DockPanel.Dock="Right" Content="&#x22ef;" FontSize="{DynamicResource Intent.Type.Section}" Padding="{DynamicResource Component.TryWord.ToolButtonInset}"
                  IsVisible="{Binding $parent[views:DiagnosticPanel].ShowResultSummary}"
                  AutomationProperties.Name="Diagnostic tools">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="{DynamicResource Intent.Space.Compact}" MinWidth="{DynamicResource Component.TryWord.SidebarWidth}">
                  <Button Theme="{DynamicResource BorderlessButton}" Classes="menuEntry" Content="Copy for a chat model" Click="OnCopyInstructionsClick"
                          AutomationProperties.Name="Copy AI diagnostic instructions" />
                  <Button Theme="{DynamicResource BorderlessButton}" Classes="menuEntry" Content="Save diagnostic JSON..." Click="OnSaveClick" IsEnabled="{Binding HasDiagnosticJson}"
                          AutomationProperties.Name="Save full diagnostic JSON" />
                  <Button Theme="{DynamicResource BorderlessButton}" Classes="menuEntry" Content="Copy diagnostic JSON" Click="OnCopyJsonClick" IsEnabled="{Binding HasDiagnosticJson}"
                          AutomationProperties.Name="Copy full diagnostic JSON" />
                  <Button Theme="{DynamicResource BorderlessButton}" Classes="menuEntry" Content="Open a saved diagnostic..." Click="OnOpenClick"
                          AutomationProperties.Name="Open a diagnostic JSON file" />
                  <views:CopyableTextBlock Text="{Binding CaptureDetails}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource Intent.Type.Label}"
                             IsVisible="{Binding HasCaptureDetails}" AutomationProperties.Name="Diagnostic capture details" />
                  <views:CopyableTextBlock Text="{Binding WritingSystemSummary}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource Intent.Type.Label}"
                             IsVisible="{Binding HasResult}" AutomationProperties.Name="Writing system direction and font" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </DockPanel>
        <StackPanel Spacing="{DynamicResource Intent.Space.Snug}"
                    IsVisible="{Binding $parent[views:DiagnosticPanel].ShowResultSummary}">
          <views:CopyableTextBlock Text="{Binding SummaryText}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding HasResult}" AutomationProperties.Name="Diagnostic result" />
          <views:CopyableTextBlock Text="{Binding SearchStatusText}" Classes="status" TextWrapping="Wrap"
                     IsVisible="{Binding !Result.Complete}" AutomationProperties.Name="Search completeness" />
          <views:CopyableTextBlock Text="{Binding ProvenanceWarning}" Classes="failed" TextWrapping="Wrap"
                     IsVisible="{Binding HasProvenanceWarning}" AutomationProperties.Name="Diagnostic provenance warning" />
          <views:CopyableTextBlock Text="Standalone diagnostic: recorded evidence only; live FieldWorks navigation is unavailable."
                     Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsStandalone}" />
        </StackPanel>
      </StackPanel>

      <StackPanel IsVisible="{Binding $parent[views:DiagnosticPanel].ShowAttemptSummaries}">
      <Border Classes="notice" IsVisible="{Binding NoAttemptRecorded}">
        <views:CopyableTextBlock TextWrapping="Wrap"
                                 Text="{Binding NoAttemptNotice}" />
      </Border>
      </StackPanel>

      <ContentControl x:Name="AnalysesHost" />

      <Border Classes="card" IsVisible="{Binding HasNoParseReasons}" AutomationProperties.Name="Why it did not parse">
        <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
          <views:CopyableTextBlock Text="{Binding StopGroupsHeading}" FontWeight="SemiBold" />
          <ItemsControl x:Name="DiagnosticPanelNoParseReasonsItems" ItemsSource="{Binding NoParseReasons}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <views:CopyableTextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <StackPanel Spacing="{DynamicResource Intent.Space.Group}"
                  IsVisible="{Binding $parent[views:DiagnosticPanel].ShowAttemptSummaries}">
      <!-- A parsed word's stopped attempts wait folded under their count. -->
      <Expander Header="{Binding DroppedPathsText}" IsExpanded="{Binding ShowDroppedPaths, Mode=TwoWay}"
                IsVisible="{Binding HasDroppedPaths}" AutomationProperties.Name="Paths the parser dropped" />

      <!-- Recorded terminal outcomes retain attribution only where the producer supplied it. -->
      <Border Classes="card" IsVisible="{Binding ShowsStopGroups}" AutomationProperties.Name="Why it did not parse">
        <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
          <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
            <views:CopyableTextBlock Text="{Binding StopGroupsHeading}" FontSize="{DynamicResource Intent.Type.Section}" FontWeight="SemiBold" />
            <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Small}" TextWrapping="Wrap" Text="{Binding StopGroupsSummary}" />
          </StackPanel>
          <ItemsControl x:Name="DiagnosticPanelStopGroupsItems" ItemsSource="{Binding StopGroups}" AutomationProperties.Name="Recorded stopped attempts">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TraceStopGroupViewModel">
                <Button Classes="stopGroup" Classes.chosen="{Binding IsSelected}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Margin="{DynamicResource Component.TryWord.SmallRowInset}"
                        Command="{Binding $parent[UserControl].((vm:TraceWordViewModel)DataContext).SelectStopGroupCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding RuleText}">
                  <!-- Rule and count on one line, the reason under it, so the row reads in any column width. -->
                  <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Snug}" VerticalAlignment="Center">
                        <ProgressBar Width="{DynamicResource Component.TryWord.ProgressWidth}" MinWidth="{DynamicResource Component.TryWord.ProgressWidth}" Height="{DynamicResource Intent.Space.Snug}" Minimum="0" Maximum="1" Value="{Binding Share}"
                                     IsHitTestVisible="False" IsVisible="{Binding ShowsShare}" />
                        <TextBlock Text="{Binding CountText}" FontWeight="SemiBold" TextAlignment="Right" />
                      </StackPanel>
                      <TextBlock Text="{Binding RuleText}" IsVisible="{Binding HasRule}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Classes="stopReason" Text="{Binding ReasonText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReasonCode}" Classes="traceNotation" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- The attempts that came closest, each as its own story. -->
      <StackPanel Spacing="{DynamicResource Intent.Space.Snug}" IsVisible="{Binding ShowsClosestAttempts}">
        <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
          <views:CopyableTextBlock Text="{Binding ClosestAttemptsHeading}" FontSize="{DynamicResource Intent.Type.Section}" FontWeight="SemiBold" />
          <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Small}" Text="Sorted by how many morphemes they built before the attempt ended." />
        </StackPanel>
        <ItemsControl x:Name="DiagnosticPanelClosestAttemptsItems" ItemsSource="{Binding ClosestAttempts}" AutomationProperties.Name="Attempts that got furthest">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TraceCandidateViewModel">
              <Border Classes="card" Margin="{DynamicResource Component.TryWord.SmallBottomInset}">
                <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                    <views:MarkChip Mark="{Binding StepMark}" Text="{Binding Surface}" IsVisible="{Binding HasSurface}" />
                  </StackPanel>
                  <views:MorphemeRow Morphs="{Binding Morphs}" IsVisible="{Binding HasMorphs}" Separators="True" />
                  <views:CopyableTextBlock Classes="muted" Text="The parser recorded no morphemes for this attempt."
                             IsVisible="{Binding !HasMorphs}" FontSize="{DynamicResource Intent.Type.Small}" />
                  <views:CopyableTextBlock Text="{Binding StopHeadline}" Classes="failed" FontWeight="SemiBold"
                             TextWrapping="Wrap" AutomationProperties.Name="What stopped the attempt" />
                  <views:CopyableTextBlock Text="{Binding StopReason}" TextWrapping="Wrap" FontSize="{DynamicResource Intent.Type.Small}"
                                           AutomationProperties.Name="Why the attempt stopped" />
                  <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Small}" Text="{Binding FailureRequired, StringFormat='Required: {0}'}"
                             IsVisible="{Binding FailureRequired, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                  <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Small}" Text="{Binding FailureActual, StringFormat='Actual: {0}'}"
                             IsVisible="{Binding FailureActual, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                  <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Small}" Text="{Binding FailureEnvironment, StringFormat='Environment: {0}'}"
                             IsVisible="{Binding FailureEnvironment, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                  <Expander Header="Steps on this path" IsExpanded="False" IsVisible="{Binding Steps.Count}">
                    <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                    <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Label}" TextWrapping="Wrap"
                                             Text="{Binding ParserCode, StringFormat='Code from the parser: {0}'}"
                                             IsVisible="{Binding HasParserCode}" AutomationProperties.Name="The parser's code" />
                    <ItemsControl x:Name="DiagnosticPanelStepsItems" ItemsSource="{Binding Steps}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TraceStepViewModel">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Related}"
                                Margin="{DynamicResource Component.TryWord.SmallRowInset}">
                            <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Label}"
                                                    Text="{Binding StatusText}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="{DynamicResource Intent.Space.Minimal}">
                              <views:CopyableTextBlock Text="{Binding Label}" FontSize="{DynamicResource Intent.Type.Small}" TextWrapping="Wrap" />
                              <views:CopyableTextBlock Text="{Binding ProducerSourceText}" Classes="traceNotation" TextWrapping="Wrap"
                                                      IsVisible="{Binding ProducerSourceText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                              <views:CopyableTextBlock Text="{Binding CapturedSourceText}" Classes="traceNotation" TextWrapping="Wrap"
                                                      IsVisible="{Binding CapturedSourceText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                  </Expander>
                  <Expander Header="Recorded tree context" IsExpanded="{Binding IsTreeContextExpanded, Mode=TwoWay}" IsVisible="{Binding HasTreeContext}">
                    <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                      <views:CopyableTextBlock Classes="muted" Text="Membership in this derivation is not recorded." TextWrapping="Wrap" />
                      <ItemsControl x:Name="DiagnosticPanelRecordedTreeContextItems" ItemsSource="{Binding RecordedTreeContext}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TraceStepViewModel">
                            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}"
                                        Margin="{DynamicResource Component.TryWord.SmallRowInset}">
                              <views:CopyableTextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                              <views:CopyableTextBlock Text="{Binding ProducerSourceText}" Classes="traceNotation" TextWrapping="Wrap"
                                                      IsVisible="{Binding ProducerSourceText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                              <views:CopyableTextBlock Text="{Binding CapturedSourceText}" Classes="traceNotation" TextWrapping="Wrap"
                                                      IsVisible="{Binding CapturedSourceText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                              <views:CopyableTextBlock Text="{Binding RecordedEventAddress}" Classes="traceNotation" TextWrapping="Wrap" />
                              <views:CopyableTextBlock Text="{Binding RecordedProducerEventAddress}" Classes="traceNotation" TextWrapping="Wrap" />
                              <views:CopyableTextBlock Text="{Binding Notation}" Classes="traceNotation"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Notation}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="{Binding MoreAttemptsText}" IsVisible="{Binding HasMoreAttempts}"
                Command="{Binding ShowEveryAttemptCommand}" HorizontalAlignment="Left"
                AutomationProperties.Name="Show every attempt" />
      </StackPanel>

      </StackPanel>
      <views:RefusalBlock x:Name="ErrorRefusal" DataContext="{Binding $parent[views:DiagnosticPanel].Tools.Error}"
                          AutomationProperties.Name="Diagnostic file error" />

      <Expander Header="Full derivation" IsVisible="{Binding $parent[views:DiagnosticPanel].ShowFullDerivation}" IsExpanded="False" AutomationProperties.Name="Full derivation tree">
        <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
          <Grid ColumnDefinitions="2*,*,*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Snug}">
            <TextBox Text="{Binding SearchText}" PlaceholderText="Search all recorded steps..."
                     AutomationProperties.Name="Search diagnostic trace" />
            <TextBox Grid.Column="1" Text="{Binding RuleFilter}" PlaceholderText="Rule"
                     AutomationProperties.Name="Filter diagnostic trace by rule" />
            <TextBox Grid.Column="2" Text="{Binding MorphFilter}" PlaceholderText="Morph or form"
                     AutomationProperties.Name="Filter diagnostic trace by morph" />
            <ComboBox x:Name="DiagnosticPanelOutcomeFiltersItems" Grid.Column="3" ItemsSource="{Binding OutcomeFilters}" SelectedItem="{Binding OutcomeFilter}"
                      AutomationProperties.Name="Filter diagnostic trace by outcome" />
          </Grid>
          <views:CopyableTextBlock Classes="muted" Text="{Binding SelectedFilterDescription}"
                     AutomationProperties.Name="Hidden trace count" />
          <Expander Header="Aggregate parser effort by category" IsExpanded="False" IsVisible="{Binding HasEffort}"
                    AutomationProperties.Name="Aggregate parser effort">
            <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
              <views:CopyableTextBlock Classes="muted" Text="Category totals are aggregate counts and time, not timing assigned to individual rule steps."
                                        TextWrapping="Wrap" />
              <!-- The header and every row share one set of fixed widths, so the columns line up; each number
                   cell is shaded by how large it is against the rest of its column. -->
              <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Intent.Space.Compact}">
              <Grid ColumnDefinitions="2*,*,*,*,*,3*,*" ColumnSpacing="{DynamicResource Intent.Space.Compact}" Margin="{DynamicResource Component.TryWord.SmallBottomInset}">
                <views:CopyableTextBlock Classes="muted" Text="Kind" />
                <views:CopyableTextBlock Grid.Column="1" Classes="muted number" Text="Work" Margin="{DynamicResource Intent.Gap.AfterRelated}" />
                <views:CopyableTextBlock Grid.Column="2" Classes="muted number" Text="Uses" Margin="{DynamicResource Intent.Gap.AfterRelated}" />
                <views:CopyableTextBlock Grid.Column="3" Classes="muted number" Text="Tried" Margin="{DynamicResource Intent.Gap.AfterRelated}" />
                <views:CopyableTextBlock Grid.Column="4" Classes="muted number" Text="Produced" Margin="{DynamicResource Intent.Gap.AfterRelated}" />
                <views:CopyableTextBlock Grid.Column="5" Classes="muted" Text="Did not succeed" Margin="{DynamicResource Component.TryWord.SmallInset}" />
                <views:CopyableTextBlock Grid.Column="6" Classes="muted number" Text="Time" Margin="{DynamicResource Intent.Gap.AfterRelated}" />
              </Grid>
              <ItemsControl x:Name="DiagnosticPanelEffortItems" Grid.Row="1" ItemsSource="{Binding Effort}" AutomationProperties.Name="Parser effort rows">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TraceEffortViewModel">
                    <Grid ColumnDefinitions="2*,*,*,*,*,3*,*" ColumnSpacing="{DynamicResource Intent.Space.Compact}" Margin="{DynamicResource Component.TryWord.SmallRowInset}">
                      <views:CopyableTextBlock Text="{Binding Kind}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <views:HeatCell Grid.Column="1" Text="{Binding Work}" Intensity="{Binding WorkHeat}" />
                      <views:HeatCell Grid.Column="2" Text="{Binding Uses}" Intensity="{Binding UsesHeat}" />
                      <views:HeatCell Grid.Column="3" Text="{Binding Tried}" Intensity="{Binding TriedHeat}" />
                      <views:HeatCell Grid.Column="4" Text="{Binding Produced}" Intensity="{Binding ProducedHeat}" />
                      <views:HeatCell Grid.Column="5" Text="{Binding Missed}" Intensity="{Binding MissedHeat}" TextAlignment="Left" />
                      <views:HeatCell Grid.Column="6" Text="{Binding Time}" Intensity="{Binding TimeHeat}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </Grid>
            </StackPanel>
          </Expander>
          <Grid x:Name="DetailGrid" ColumnDefinitions="2*,1*" RowDefinitions="*"
                ColumnSpacing="{DynamicResource Intent.Space.Group}">
            <TreeView x:Name="TreeHost" ItemsSource="{Binding FilteredRoots}" SelectedItem="{Binding SelectedStep}"
                      AutomationProperties.Name="Filtered full derivation tree" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <TreeView.Template>
                <ControlTemplate><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" /></ControlTemplate>
              </TreeView.Template>
              <TreeView.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></TreeView.ItemsPanel>
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:TraceStepViewModel">
                  <Setter Property="ItemsPanel"><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter>
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:TraceStepViewModel" ItemsSource="{Binding Children}">

                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="{DynamicResource Intent.Space.Snug}">
                      <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                        <views:CopyableTextBlock Text="{Binding RecordedOutcomeText}" Classes="muted" TextWrapping="WrapWithOverflow" />
                        <views:CopyableTextBlock Text="{Binding RecordedLabel}" TextWrapping="Wrap" />
                        <views:CopyableTextBlock Text="{Binding SourceLabel}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="{DynamicResource Intent.Space.Minimal}">
                        <views:CopyableTextBlock Text="{Binding Notation}" Classes="traceNotation"
                                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Notation}" />
                        <views:CopyableTextBlock Text="{Binding ProducerSourceText}" Classes="traceNotation" TextWrapping="Wrap"
                                                 IsVisible="{Binding ProducerSourceText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Grid>

                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
            <Border x:Name="DetailHost" Grid.Column="1" Classes="card"
                    IsVisible="{Binding SelectedStep, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="{DynamicResource Intent.Space.Snug}" DataContext="{Binding SelectedStep}">
                <views:CopyableTextBlock Text="Selected step" FontSize="{DynamicResource Intent.Type.Section}" FontWeight="SemiBold" />
                <views:CopyableTextBlock Text="{Binding RecordedOutcomeText}" Classes="status" TextWrapping="WrapWithOverflow" />
                <views:CopyableTextBlock Text="{Binding Type}" FontWeight="SemiBold" />
                <views:CopyableTextBlock Text="{Binding ProducerSourceText}" Classes="traceNotation"
                           IsVisible="{Binding ProducerSourceText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding CapturedSourceText}"
                           IsVisible="{Binding CapturedSourceText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding Input, StringFormat='Input: {0}'}"
                           IsVisible="{Binding Input, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding Output, StringFormat='Output: {0}'}"
                           IsVisible="{Binding Output, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding SubruleText}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding OutcomeStatus, StringFormat='Outcome: {0}'}"
                           IsVisible="{Binding OutcomeStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding OutcomeEventType, StringFormat='Event: {0}'}"
                           IsVisible="{Binding OutcomeEventType, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding RecordedReasonText}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding RecordedExplanationText}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding RecordedRejectionText}" TextWrapping="Wrap" />
                <ItemsControl x:Name="DiagnosticPanelAttemptedMorphsItems" ItemsSource="{Binding AttemptedMorphs}" IsVisible="{Binding HasAttemptedMorphs}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TraceMorphViewModel">
                      <Border Classes="card" Margin="{DynamicResource Component.TryWord.SmallRowInset}">
                        <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                          <views:CopyableTextBlock Text="{Binding Form}" FlowDirection="{Binding FormDirection}" FontFamily="{Binding FormFont}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <views:CopyableTextBlock Text="{Binding Headword}" FlowDirection="{Binding HeadwordDirection}" FontFamily="{Binding HeadwordFont}" Classes="muted" TextWrapping="Wrap" />
                          <views:CopyableTextBlock Text="{Binding Gloss}" FlowDirection="{Binding GlossDirection}" FontFamily="{Binding GlossFont}" TextWrapping="Wrap" />
                          <views:CopyableTextBlock Text="{Binding Category}" Classes="muted" TextWrapping="Wrap" />
                          <Expander Header="Full morph details" IsExpanded="False">
                            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                              <views:CopyableTextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                              <views:CopyableTextBlock Text="{Binding MsaDetails}" TextWrapping="Wrap" />
                              <views:CopyableTextBlock Text="{Binding RawDetails}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                          </Expander>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <views:CopyableTextBlock Text="{Binding SourceIdentity}"
                           IsVisible="{Binding SourceIdentityId, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />
                <views:CopyableTextBlock Classes="muted"
                           Text="Category statistics are aggregate parser statistics; they are not time for this step."
                           TextWrapping="Wrap" />

              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Expander>
    </StackPanel>
  </Border>
</UserControl>
