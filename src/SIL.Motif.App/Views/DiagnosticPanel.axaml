<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.DiagnosticPanel"
             x:DataType="vm:TraceWordViewModel"
             FontFamily="Noto Sans, Segoe UI, Arial"
             SizeChanged="OnPanelSizeChanged">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector=":is(TextBlock).muted">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
    <Style Selector=":is(TextBlock).status">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(TextBlock).failed">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
    </Style>
    <Style Selector=":is(TextBlock).succeeded">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorSuccess}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="12">
      <StackPanel Spacing="8">
        <StackPanel Spacing="3">
          <views:CopyableTextBlock Text="{Binding Result.Word}" FontSize="20" FontWeight="SemiBold"
                     IsVisible="{Binding HasResult}" AutomationProperties.Name="Diagnostic word" />
          <views:CopyableTextBlock Text="{Binding SummaryText}" Classes="status" TextWrapping="Wrap"
                     IsVisible="{Binding HasResult}" AutomationProperties.Name="Diagnostic result" />
          <views:CopyableTextBlock Text="{Binding SearchStatusText}" Classes="status" TextWrapping="Wrap"
                     IsVisible="{Binding HasResult}" AutomationProperties.Name="Search completeness" />
          <views:CopyableTextBlock Text="{Binding WritingSystemSummary}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding HasResult}" AutomationProperties.Name="Writing system direction and font" />
          <Expander Header="Capture details" IsExpanded="False" IsVisible="{Binding HasCaptureDetails}"
                    AutomationProperties.Name="Diagnostic capture details">
            <views:CopyableTextBlock Text="{Binding CaptureDetails}" Classes="muted" TextWrapping="Wrap" />
          </Expander>
          <views:CopyableTextBlock Text="{Binding ProvenanceWarning}" Classes="failed" TextWrapping="Wrap"
                     IsVisible="{Binding HasProvenanceWarning}" AutomationProperties.Name="Diagnostic provenance warning" />
          <views:CopyableTextBlock Text="Standalone diagnostic: recorded evidence only; live FieldWorks navigation is unavailable."
                     Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsStandalone}" />
        </StackPanel>
        <WrapPanel Orientation="Horizontal">
          <Button Content="Copy JSON" Click="OnCopyJsonClick" IsEnabled="{Binding HasDiagnosticJson}" AutomationProperties.Name="Copy full diagnostic JSON" />
          <Button Content="Save JSON..." Click="OnSaveClick" IsEnabled="{Binding HasDiagnosticJson}" AutomationProperties.Name="Save full diagnostic JSON" />
          <Button Content="Copy AI instructions" Click="OnCopyInstructionsClick"
                  AutomationProperties.Name="Copy AI diagnostic instructions" />
          <Button Content="Open..." Click="OnOpenClick" AutomationProperties.Name="Open a diagnostic JSON file" />
        </WrapPanel>
      </StackPanel>

      <views:CopyableTextBlock x:Name="ErrorText" Classes="failed" IsVisible="False" TextWrapping="Wrap"
                 AutomationProperties.Name="Diagnostic file error" />

      <StackPanel Spacing="6" IsVisible="{Binding HasResult}">
        <views:CopyableTextBlock Text="Analyses" FontSize="16" FontWeight="SemiBold" />
        <views:CopyableTextBlock Classes="muted"
                   Text="Recorded analyses appear first, in parser order. Values marked not recorded were unavailable in the producer document."
                   TextWrapping="Wrap" />
        <views:CopyableTextBlock Classes="muted" Text="No analyses were recorded." IsVisible="{Binding HasAnalyses, Converter={x:Static conv:BoolConverters.Not}}" />
        <ItemsControl ItemsSource="{Binding Analyses}" AutomationProperties.Name="Recorded analyses">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TraceAnalysisViewModel">
              <Border Classes="card" Margin="0,0,0,6">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <views:CopyableTextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <views:CopyableTextBlock Grid.Column="1" Text="{Binding Surface}" />
                    <views:CopyableTextBlock Grid.Column="2" Text="{Binding Availability}" Classes="muted" />
                  </Grid>
                  <views:CopyableTextBlock Text="{Binding ProjectionError, StringFormat='Projection: {0}'}"
                             IsVisible="{Binding HasProjectionError}" Classes="failed" TextWrapping="Wrap" />
                  <views:CopyableTextBlock Text="{Binding LegacyMorphemes, StringFormat='Parser morphology: {0}'}"
                             IsVisible="{Binding HasLegacyMorphemes}" Classes="muted" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Morphs}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TraceMorphViewModel">
                        <Border Classes="card" Margin="0,0,8,0" Padding="8">
                          <StackPanel Spacing="2">
                            <views:CopyableTextBlock Text="{Binding Form}" FlowDirection="{Binding FormDirection}" FontFamily="{Binding FormFont}" FontWeight="SemiBold" />
                            <views:CopyableTextBlock Text="{Binding Headword}" FlowDirection="{Binding HeadwordDirection}" FontFamily="{Binding HeadwordFont}" Classes="muted" />
                            <views:CopyableTextBlock Text="{Binding Gloss}" FlowDirection="{Binding GlossDirection}" FontFamily="{Binding GlossFont}" />
                            <views:CopyableTextBlock Text="{Binding Category}" Classes="muted" />
                            <Expander Header="Full morph details" IsExpanded="False">
                              <StackPanel Spacing="2">
                                <views:CopyableTextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                                <views:CopyableTextBlock Text="{Binding MsaDetails}" TextWrapping="Wrap" />
                                <Expander Header="Raw morph record">
                                  <views:CopyableTextBlock Text="{Binding RawDetails}" Classes="muted" TextWrapping="Wrap" />
                                </Expander>
                                <views:CopyableTextBlock Text="{Binding Identity}" Classes="muted" TextWrapping="Wrap" />
                                <HyperlinkButton Content="Open compatible FieldWorks entry"
                                                 NavigateUri="{Binding Link}"
                                                 IsVisible="{Binding HasLink}"
                                                 Padding="0"
                                                 AutomationProperties.Name="{Binding LinkName}" />
                                <views:CopyableTextBlock Classes="muted"
                                           Text="Live FieldWorks navigation is unavailable for this recorded morph."
                                           IsVisible="{Binding HasNoLink}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Expander>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Expander Header="{Binding FailedAttemptCount, StringFormat='Failed attempts ({0})'}"
                IsExpanded="{Binding HasAnalyses, Converter={x:Static conv:BoolConverters.Not}}" AutomationProperties.Name="Failed trace attempts">
        <ItemsControl ItemsSource="{Binding Candidates}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TraceCandidateViewModel">
              <Border Classes="card" Margin="0,0,0,6" IsVisible="{Binding IsFailure}">
                <StackPanel Spacing="6">
                  <!-- One failed attempt as a story: what it had built, from which morphemes, and what stopped it. -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <views:CopyableTextBlock Text="✗" Classes="failed" FontWeight="Bold" VerticalAlignment="Center" />
                    <views:CopyableTextBlock Text="{Binding Surface}" IsVisible="{Binding HasSurface}" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" AutomationProperties.Name="Form the attempt had built" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Morphs}" IsVisible="{Binding HasMorphs}"
                                AutomationProperties.Name="Morphemes the attempt had">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ParserReadingMorphViewModel">
                        <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,1,0"
                                Padding="0,0,10,0" Margin="0,0,10,4">
                          <StackPanel Spacing="0">
                            <HyperlinkButton Content="{Binding Form}" NavigateUri="{Binding Link}" IsVisible="{Binding HasLink}"
                                             Padding="0" FontWeight="SemiBold" AutomationProperties.Name="{Binding LinkName}" />
                            <views:CopyableTextBlock Text="{Binding Form}" IsVisible="{Binding HasNoLink}" FontWeight="SemiBold" />
                            <views:CopyableTextBlock Text="{Binding GlossOrPlaceholder}" />
                            <views:CopyableTextBlock Text="{Binding Category}" Classes="muted" FontSize="11" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <views:CopyableTextBlock Classes="muted" Text="The parser recorded no morphemes for this attempt."
                             IsVisible="{Binding !HasMorphs}" />
                  <views:CopyableTextBlock Text="{Binding StopHeadline}" Classes="failed" FontWeight="SemiBold" TextWrapping="Wrap"
                             AutomationProperties.Name="What stopped the attempt" />
                  <views:CopyableTextBlock Text="{Binding StopReason}" TextWrapping="Wrap" />
                  <views:CopyableTextBlock Text="{Binding FailureRequired, StringFormat='Required: {0}'}"
                             IsVisible="{Binding FailureRequired, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                  <views:CopyableTextBlock Text="{Binding FailureActual, StringFormat='Actual: {0}'}"
                             IsVisible="{Binding FailureActual, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                  <views:CopyableTextBlock Text="{Binding FailureEnvironment, StringFormat='Environment: {0}'}"
                             IsVisible="{Binding FailureEnvironment, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                  <views:CopyableTextBlock Text="{Binding SourceIdentity}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>

      <Expander Header="Full derivation" IsExpanded="True" AutomationProperties.Name="Full derivation tree">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="2*,*,*,Auto" ColumnSpacing="6">
            <TextBox Text="{Binding SearchText}" PlaceholderText="Search all recorded steps..."
                     AutomationProperties.Name="Search diagnostic trace" />
            <TextBox Grid.Column="1" Text="{Binding RuleFilter}" PlaceholderText="Rule"
                     AutomationProperties.Name="Filter diagnostic trace by rule" />
            <TextBox Grid.Column="2" Text="{Binding MorphFilter}" PlaceholderText="Morph or form"
                     AutomationProperties.Name="Filter diagnostic trace by morph" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding OutcomeFilters}" SelectedItem="{Binding OutcomeFilter}" Width="120"
                      AutomationProperties.Name="Filter diagnostic trace by outcome" />
          </Grid>
          <views:CopyableTextBlock Classes="muted" Text="{Binding SelectedFilterDescription}"
                     AutomationProperties.Name="Hidden trace count" />
          <Expander Header="Parser effort" IsExpanded="False" IsVisible="{Binding HasEffort}"
                    AutomationProperties.Name="Aggregate parser effort">
            <!-- The header and every row share one set of fixed widths, so the columns line up; each number
                 cell is shaded by how large it is against the rest of its column. -->
            <Grid RowDefinitions="Auto,*">
              <Grid.Styles>
                <Style Selector="Border.heat">
                  <Setter Property="Background" Value="#F08C28" />
                  <Setter Property="CornerRadius" Value="3" />
                </Style>
                <Style Selector="Panel.cell > :is(TextBlock)">
                  <Setter Property="Margin" Value="6,3" />
                  <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
                <Style Selector=":is(TextBlock).number">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
              </Grid.Styles>
              <Grid ColumnDefinitions="180,70,70,70,70,*,80" ColumnSpacing="4" Margin="0,0,0,4">
                <views:CopyableTextBlock Classes="muted" Text="Kind" />
                <views:CopyableTextBlock Grid.Column="1" Classes="muted number" Text="Work" Margin="0,0,6,0" />
                <views:CopyableTextBlock Grid.Column="2" Classes="muted number" Text="Uses" Margin="0,0,6,0" />
                <views:CopyableTextBlock Grid.Column="3" Classes="muted number" Text="Tried" Margin="0,0,6,0" />
                <views:CopyableTextBlock Grid.Column="4" Classes="muted number" Text="Produced" Margin="0,0,6,0" />
                <views:CopyableTextBlock Grid.Column="5" Classes="muted" Text="Did not succeed" Margin="6,0,0,0" />
                <views:CopyableTextBlock Grid.Column="6" Classes="muted number" Text="Time" Margin="0,0,6,0" />
              </Grid>
              <ItemsControl Grid.Row="1" ItemsSource="{Binding Effort}" AutomationProperties.Name="Parser effort rows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TraceEffortViewModel">
                    <Grid ColumnDefinitions="180,70,70,70,70,*,80" ColumnSpacing="4" Margin="0,1">
                      <views:CopyableTextBlock Text="{Binding Kind}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Panel Grid.Column="1" Classes="cell"><Border Classes="heat" Opacity="{Binding WorkHeat}" /><views:CopyableTextBlock Text="{Binding Work}" /></Panel>
                      <Panel Grid.Column="2" Classes="cell"><Border Classes="heat" Opacity="{Binding UsesHeat}" /><views:CopyableTextBlock Text="{Binding Uses}" /></Panel>
                      <Panel Grid.Column="3" Classes="cell"><Border Classes="heat" Opacity="{Binding TriedHeat}" /><views:CopyableTextBlock Text="{Binding Tried}" /></Panel>
                      <Panel Grid.Column="4" Classes="cell"><Border Classes="heat" Opacity="{Binding ProducedHeat}" /><views:CopyableTextBlock Text="{Binding Produced}" /></Panel>
                      <Panel Grid.Column="5" Classes="cell">
                        <Border Classes="heat" Opacity="{Binding MissedHeat}" />
                        <views:CopyableTextBlock Text="{Binding Missed}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                      </Panel>
                      <Panel Grid.Column="6" Classes="cell"><Border Classes="heat" Opacity="{Binding TimeHeat}" /><views:CopyableTextBlock Text="{Binding Time}" /></Panel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Expander>
          <Grid x:Name="DetailGrid" ColumnDefinitions="2*,12,1*" RowDefinitions="*" MinHeight="320">
            <TreeView x:Name="TreeHost" ItemsSource="{Binding FilteredRoots}" SelectedItem="{Binding SelectedStep}"
                      AutomationProperties.Name="Filtered full derivation tree">
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:TraceStepViewModel">
                  <Setter Property="IsExpanded" Value="{Binding ExpandForFilter}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:TraceStepViewModel" ItemsSource="{Binding Children}">

                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <views:CopyableTextBlock Text="{Binding StatusText}" Classes="muted" />
                      <views:CopyableTextBlock Text="{Binding Label}" />
                    </StackPanel>

                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
            <Border x:Name="DetailHost" Grid.Column="2" Classes="card"
                    IsVisible="{Binding SelectedStep, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="5" DataContext="{Binding SelectedStep}">
                <views:CopyableTextBlock Text="Selected step" FontSize="15" FontWeight="SemiBold" />
                <views:CopyableTextBlock Text="{Binding StatusText}" Classes="status" />
                <views:CopyableTextBlock Text="{Binding Type}" FontWeight="SemiBold" />
                <views:CopyableTextBlock Text="{Binding Source, StringFormat='Rule: {0}'}"
                           IsVisible="{Binding Source, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding Input, StringFormat='Input: {0}'}"
                           IsVisible="{Binding Input, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding Output, StringFormat='Output: {0}'}"
                           IsVisible="{Binding Output, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding SubruleText}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding OutcomeStatus, StringFormat='Outcome: {0}'}"
                           IsVisible="{Binding OutcomeStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding OutcomeEventType, StringFormat='Event: {0}'}"
                           IsVisible="{Binding OutcomeEventType, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding FailureReason, StringFormat='Failure: {0}'}"
                           IsVisible="{Binding HasFailureReason}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Text="{Binding ContextText}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding AttemptedMorphs}" IsVisible="{Binding HasAttemptedMorphs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TraceMorphViewModel">
                      <Border Classes="card" Margin="0,2" Padding="8">
                        <StackPanel Spacing="2">
                          <views:CopyableTextBlock Text="{Binding Form}" FlowDirection="{Binding FormDirection}" FontFamily="{Binding FormFont}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <views:CopyableTextBlock Text="{Binding Headword}" FlowDirection="{Binding HeadwordDirection}" FontFamily="{Binding HeadwordFont}" Classes="muted" TextWrapping="Wrap" />
                          <views:CopyableTextBlock Text="{Binding Gloss}" FlowDirection="{Binding GlossDirection}" FontFamily="{Binding GlossFont}" TextWrapping="Wrap" />
                          <views:CopyableTextBlock Text="{Binding Category}" Classes="muted" TextWrapping="Wrap" />
                          <Expander Header="Full morph details" IsExpanded="False">
                            <StackPanel Spacing="2">
                              <views:CopyableTextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                              <views:CopyableTextBlock Text="{Binding MsaDetails}" TextWrapping="Wrap" />
                              <views:CopyableTextBlock Text="{Binding RawDetails}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                          </Expander>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <views:CopyableTextBlock Text="{Binding SourceIdentity}"
                           IsVisible="{Binding SourceIdentityId, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />
                <views:CopyableTextBlock Classes="muted"
                           Text="Category statistics are aggregate parser statistics; they are not time for this step."
                           TextWrapping="Wrap" />

              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
