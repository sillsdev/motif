<StackPanel xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
            xmlns:views="clr-namespace:SIL.Motif.App.Views"
            x:Class="SIL.Motif.App.Views.WordDispositionButtons"
            x:DataType="vm:ResultsTokenViewModel"
            Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}" VerticalAlignment="Center">
  <Button Classes="dispositionButton" Theme="{DynamicResource BorderlessButton}" VerticalAlignment="Center"
          AutomationProperties.Name="{x:Static views:WordDispositionButtons.MarkButtonName}"
          AutomationProperties.AutomationId="{Binding FixAutomationId}"
          ToolTip.Tip="{Binding Disposition.MarkTip}">
    <Border Classes="dispositionFace"
            Classes.approved="{Binding Disposition.IsMarkApproved}" Classes.unknown="{Binding Disposition.IsMarkUnknown}"
            Classes.disapproved="{Binding Disposition.IsMarkDisapproved}" Classes.absent="{Binding Disposition.IsMarkAbsent}"
            Classes.changed="{Binding Disposition.IsChanged}"
            AutomationProperties.AutomationId="{Binding OpinionMarkAutomationId}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Minimal}">
        <TextBlock x:Name="MarkLetter" Text="{Binding Disposition.MarkLetter}" />
        <Path Classes="dispositionCaret" Data="M0 1 L5 6 L10 1 Z" Fill="{Binding #MarkLetter.Foreground}" />
      </StackPanel>
    </Border>
    <Button.Flyout>
      <Flyout Placement="BottomEdgeAlignedLeft" Content="{Binding}">
        <Flyout.ContentTemplate>
          <DataTemplate x:DataType="vm:ResultsTokenViewModel">
            <StackPanel x:Name="DispositionMenu" Classes="menu" Spacing="{DynamicResource Intent.Space.Related}"
                        AutomationProperties.Name="What FieldWorks holds for this word">
              <TextBlock Classes="menuDetail" Text="FieldWorks holds no analysis for this word."
                         IsVisible="{Binding !Disposition.HasStoredRows}" />
              <ItemsControl x:Name="WordDispositionStoredRowsItems" ItemsSource="{Binding Disposition.StoredRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WordDispositionRow">
                    <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                      <TextBlock Classes="menuDetail" Text="{Binding Note}" />
                      <TextBlock Classes="menuTitle" Text="{Binding Morphs}" />
                      <TextBlock Classes="menuDetail" Text="{Binding Glosses}" />
                      <ItemsControl x:Name="WordDispositionTilesItems" ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:WordDispositionTile">
                            <Button Classes="dispositionButton" Classes.unavailable="{Binding !IsAvailable}"
                                    Theme="{DynamicResource BorderlessButton}"
                                    Command="{Binding #DispositionMenu.((vm:ResultsTokenViewModel)DataContext).StageMarkingChoiceForTokenCommand}"
                                    CommandParameter="{Binding Choice}"
                                    ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                              <Border Classes="dispositionFace tile"
                                      Classes.approved="{Binding IsApproved}" Classes.unknown="{Binding IsUnknown}"
                                      Classes.disapproved="{Binding IsDisapproved}" Classes.absent="{Binding IsAbsent}"
                                      Classes.current="{Binding IsCurrent}" Classes.staged="{Binding IsStaged}">
                                <TextBlock Text="{Binding Letter}" />
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                      Command="{Binding AddChangeForTokenCommand}" CommandParameter="incorrect-spelling"
                      AutomationProperties.Name="Mark this spelling Incorrect" ToolTip.Tip="Incorrect spelling: FieldWorks stops treating it as a word (S)">
                <TextBlock Classes="menuTitle" Text="Incorrect spelling" />
              </Button>
              <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                      IsVisible="{Binding Disposition.KeepFieldWorks, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Command="{Binding StageMarkingChoiceForTokenCommand}" CommandParameter="{Binding Disposition.KeepFieldWorks}"
                      AutomationProperties.Name="Keep FieldWorks">
                <TextBlock Classes="menuTitle" Text="Keep FieldWorks as it is" />
              </Button>
            </StackPanel>
          </DataTemplate>
        </Flyout.ContentTemplate>
      </Flyout>
    </Button.Flyout>
  </Button>

  <Button Classes="dispositionButton" Theme="{DynamicResource BorderlessButton}" VerticalAlignment="Center"
          IsVisible="{Binding Disposition.HasReadings}"
          AutomationProperties.Name="{x:Static views:WordDispositionButtons.AddButtonName}"
          AutomationProperties.AutomationId="{Binding AddAutomationId}"
          ToolTip.Tip="{Binding Disposition.AddTip}">
    <Border Classes="dispositionFace add" Classes.picked="{Binding Disposition.ChosenReading, Converter={x:Static ObjectConverters.IsNotNull}}"
            Classes.approved="{Binding Disposition.IsChosenApproved}" Classes.unknown="{Binding Disposition.IsChosenUnknown}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Minimal}">
        <TextBlock x:Name="AddLabel" Text="{Binding Disposition.AddLabel}" />
        <Path Classes="dispositionCaret" Data="M0 1 L5 6 L10 1 Z" Fill="{Binding #AddLabel.Foreground}" />
      </StackPanel>
    </Border>
    <Button.Flyout>
      <Flyout Placement="BottomEdgeAlignedLeft" Content="{Binding}">
        <Flyout.ContentTemplate>
          <DataTemplate x:DataType="vm:ResultsTokenViewModel">
            <StackPanel x:Name="AddMenu" Classes="menu" Spacing="{DynamicResource Intent.Space.Related}"
                        AutomationProperties.Name="PanGloss analyses to add to FieldWorks">
              <TextBlock Classes="menuDetail" Text="Add to FieldWorks" />
              <ItemsControl x:Name="WordDispositionReadingsItems" ItemsSource="{Binding Disposition.Readings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WordDispositionRow">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                      <TextBlock Classes="menuTitle" Text="{Binding Number}" VerticalAlignment="Center" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="menuTitle" Text="{Binding Morphs}" />
                        <TextBlock Classes="menuDetail" Text="{Binding Glosses}" />
                      </StackPanel>
                      <ItemsControl x:Name="WordDispositionReadingTilesItems" ItemsSource="{Binding Tiles}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:WordDispositionTile">
                            <Button Classes="dispositionButton" Theme="{DynamicResource BorderlessButton}"
                                    Command="{Binding #AddMenu.((vm:ResultsTokenViewModel)DataContext).StageMarkingChoiceForTokenCommand}"
                                    CommandParameter="{Binding Choice}"
                                    ToolTip.Tip="{Binding Choice.Label}" AutomationProperties.Name="{Binding Choice.Label}">
                              <Border Classes="dispositionFace tile"
                                      Classes.approved="{Binding IsApproved}" Classes.unknown="{Binding IsUnknown}"
                                      Classes.staged="{Binding IsStaged}">
                                <TextBlock Text="{Binding Letter}" />
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                      IsVisible="{Binding Disposition.AddAllAsUnknown, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Command="{Binding StageMarkingChoiceForTokenCommand}" CommandParameter="{Binding Disposition.AddAllAsUnknown}"
                      AutomationProperties.Name="Add every PanGloss analysis as Unknown">
                <TextBlock Classes="menuTitle" Text="Add them all as Unknown" />
              </Button>
            </StackPanel>
          </DataTemplate>
        </Flyout.ContentTemplate>
      </Flyout>
    </Button.Flyout>
  </Button>
</StackPanel>
