<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:controls="clr-namespace:SIL.Motif.App.Controls"
             xmlns:word="clr-namespace:SIL.Motif.App.Controls.WordPresentation"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ComparePanel"
             x:DataType="views:ComparePanel">
  <UserControl.Styles>
    <Style Selector=":is(TextBlock).columnHeader">
      <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
    </Style>
    <Style Selector="Button.header">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="{DynamicResource Component.TextsPage.HeaderButtonPadding}" />
    </Style>
    <Style Selector=":is(Control).matrixRowLabel">
      <Setter Property="Width" Value="{DynamicResource Component.TextsPage.MatrixRowLabelWidth}" />
    </Style>
    <Style Selector="Grid.matrixLayout">
      <Setter Property="Margin" Value="{DynamicResource Component.TextsPage.PageInset}" />
      <Setter Property="RowSpacing" Value="{DynamicResource Component.MatrixCell.MatrixSpacing}" />
    </Style>
    <Style Selector="StackPanel.matrixRows">
      <Setter Property="Spacing" Value="{DynamicResource Component.MatrixCell.MatrixSpacing}" />
    </Style>
    <Style Selector=":is(UserControl).wideMatrix :is(Control).matrixRowLabel">
      <Setter Property="Width" Value="{DynamicResource Component.TextsPage.WideMatrixRowLabelWidth}" />
    </Style>
    <Style Selector=":is(UserControl).shortMatrix StackPanel.matrixRows">
      <Setter Property="Spacing" Value="{DynamicResource Component.MatrixCell.ShortSpacing}" />
    </Style>
    <Style Selector=":is(UserControl).shortMatrix StackPanel.matrixPanel">
      <Setter Property="Spacing" Value="{DynamicResource Component.TextsPage.ShortRowSpacing}" />
    </Style>
    <Style Selector=":is(UserControl) Grid.matrixChosenLayout">
      <Setter Property="RowSpacing" Value="{DynamicResource Intent.Space.Compact}" />
    </Style>
    <Style Selector=":is(UserControl).shortMatrix Grid.matrixLayout">
      <Setter Property="Margin" Value="{DynamicResource Component.TextsPage.ShortPageInset}" />
      <Setter Property="RowSpacing" Value="{DynamicResource Component.TextsPage.ShortRowSpacing}" />
    </Style>
    <Style Selector=":is(UserControl).shortMatrix Grid.matrixChosenLayout">
      <Setter Property="RowSpacing" Value="{DynamicResource Component.TextsPage.ShortRowSpacing}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer x:Name="MatrixScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                IsVisible="{Binding Compare.HasWords}">
  <Grid Classes="matrixLayout" RowDefinitions="Auto,Auto,Auto,Auto">
    <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
      <Border Classes="notice" IsVisible="{Binding Compare.ShowsNoStandingsNotice}">
        <views:CopyableTextBlock TextWrapping="Wrap"
                                 Text="{x:Static app:MotifAppStrings.CompareRowsNotSortedNotice}" />
      </Border>
      <DockPanel>
        <views:FilterChip DockPanel.Dock="Left" VerticalAlignment="Top" Label="All words" Count="{Binding Compare.TotalCount}"
                          IsActive="{Binding !Compare.AnySelected}" Command="{Binding Compare.ClearSelectionCommand}" />
        <ItemsControl x:Name="ComparePanelPresetsItems" ItemsSource="{Binding Compare.Presets}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComparePresetViewModel">
              <views:FilterChip Label="{Binding Label}" Count="{Binding Count}" IsActive="{Binding IsActive}" IsVisible="{Binding Count}"
                                Command="{Binding $parent[views:ComparePanel].Compare.SelectPresetCommand}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </StackPanel>

    <StackPanel Grid.Row="1" Classes="matrixPanel" Spacing="{DynamicResource Component.MatrixCell.MatrixSpacing}"
                AutomationProperties.Name="{x:Static app:MotifAppStrings.CompareMatrixAccessibleName}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Related}">
        <views:CopyableTextBlock Classes="columnHeader matrixRowLabel" Text="{x:Static app:MotifAppStrings.CompareMatrixAxisLabel}"
                                 TextWrapping="Wrap" VerticalAlignment="Center"
                                 Margin="{DynamicResource Component.TextsPage.ShortLabelMargin}" />
        <ItemsControl x:Name="ComparePanelColumnsItems" Grid.Column="1" ItemsSource="{Binding Compare.Columns}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="5" ColumnSpacing="{DynamicResource Intent.Space.Compact}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CompareColumnViewModel">
              <Button Classes="header" Theme="{DynamicResource BorderlessButton}"
                      Command="{Binding $parent[views:ComparePanel].Compare.SelectColumnCommand}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding AccessibleName}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Compact}">
                  <views:MarkGlyph Classes="inline" Mark="{Binding OutcomeMark}" />
                  <TextBlock Grid.Column="1" Classes="outcomeMark" views:MarkClasses.Mark="{Binding OutcomeMark}"
                             Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Label}" views:ClearTipPlacement.IsEnabled="True" />
                  <TextBlock Grid.Column="2" Classes="muted" Text="{Binding CountText}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      <ItemsControl x:Name="ComparePanelRowsItems" ItemsSource="{Binding Compare.Rows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Classes="matrixRows" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CompareRowViewModel">
            <Grid ColumnDefinitions="Auto,*">
              <Button Classes="header matrixRowLabel" Theme="{DynamicResource BorderlessButton}" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Command="{Binding $parent[views:ComparePanel].Compare.SelectRowCommand}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding AccessibleName}">
                <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource Intent.Space.Minimal}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Compact}">
                    <controls:OpinionMark Kind="{Binding OpinionMark}" IsVisible="{Binding IsOpinionMarkVisible}" />
                    <TextBlock Grid.Column="1" Text="{Binding OpinionLabel}" TextWrapping="Wrap" FontWeight="{DynamicResource Intent.Weight.Strong}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.MatrixRowOpinionLabel}" />
                  </Grid>
                  <TextBlock Classes="muted" Text="{Binding CountText}" FontSize="{DynamicResource Intent.Type.Label}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.MatrixRowCount}" />
                </StackPanel>
              </Button>
              <ItemsControl x:Name="ComparePanelCellsItems" Grid.Column="1" ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="5" ColumnSpacing="{DynamicResource Intent.Space.Compact}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CompareCellViewModel">
                    <views:MatrixCell Tag="{Binding}" PointerPressed="OnCellPressed" KeyDown="OnCellKeyDown"
                                      ToolTip.Tip="{Binding Explanation}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Border Grid.Row="2" Classes="card" IsVisible="{Binding Compare.HasFixFirst}">
      <Expander IsExpanded="True">
        <Expander.Header>
          <DockPanel LastChildFill="True">
            <views:CopyableTextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding Compare.FixFirstSummary}"
                                     FontSize="{DynamicResource Intent.Type.Small}"
                                     AutomationProperties.Name="{x:Static app:MotifAppStrings.FixTheseFirstCountAccessibleName}" />
            <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.FixTheseFirst}" FontWeight="{DynamicResource Intent.Weight.Section}" />
          </DockPanel>
        </Expander.Header>
        <views:WordListSlot Schema="{x:Static word:WordListSchemas.FixFirst}"
                            Margin="{DynamicResource Intent.Gap.AfterRelated}">
          <Grid RowDefinitions="Auto,*">
            <word:WordRowHeader />
            <ListBox Grid.Row="1" x:Name="ComparePanelFixFirstRowsItems" Classes="wordRows" ItemsSource="{Binding Compare.FixFirstRows}"
                   MaxHeight="{DynamicResource Component.TextsPage.FixFirstListHeight}"
                   KeyboardNavigation.TabNavigation="Continue"
                   AutomationProperties.Name="{x:Static app:MotifAppStrings.WordsToCheckFirstAccessibleName}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CompareFixFirstViewModel">
                <word:WordRow Data="{Binding Presentation}" State="{Binding PresentationState, Mode=TwoWay}"
                              Host="{Binding $parent[views:ComparePanel].FixFirstPresentationHost}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </Grid>
        </views:WordListSlot>
      </Expander>
    </Border>

      <Border Grid.Row="3" Classes="card matrixChosen">
        <Grid Classes="matrixChosenLayout" RowDefinitions="Auto,Auto,Auto,Auto,*">
          <DockPanel Classes="matrixChosenHeading" AutomationProperties.Name="{Binding Compare.SelectionText}">
            <StackPanel DockPanel.Dock="Left" Classes="matrixChosenMarks" Orientation="Horizontal"
                        Margin="{DynamicResource Intent.Gap.AfterGroup}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}"
                          DataContext="{Binding Compare.ChosenCell}" x:DataType="vm:CompareCellViewModel"
                          IsVisible="{Binding $parent[views:ComparePanel].Compare.ChosenCell, Converter={x:Static ObjectConverters.IsNotNull}}">
                <controls:OpinionMark Kind="{Binding OpinionMark}" IsVisible="{Binding IsOpinionMarkVisible}"
                                      VerticalAlignment="Center" />
                <TextBlock Classes="matrixChosenWord" Text="{Binding RowLabel}" FontWeight="{DynamicResource Intent.Weight.Section}" />
                <TextBlock Classes="matrixChosenWord muted" Text="×" />
                <views:MarkGlyph Classes="inline bodyText matrixChosenWord" Mark="{Binding OutcomeMark}" />
                <TextBlock Classes="matrixChosenWord outcomeMark" views:MarkClasses.Mark="{Binding OutcomeMark}"
                           Text="{Binding ColumnLabel}" />
                <views:MarkChip Mark="{Binding MeaningMark}" Text="{Binding Label}" Compact="True" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}"
                          IsVisible="{Binding Compare.ChosenCell, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Classes="matrixChosenWord" Text="{Binding Compare.ListHeading}" FontWeight="{DynamicResource Intent.Weight.Section}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.MatrixListHeading}" />
                <views:MarkChip Classes="matrixListMeaning" Mark="{Binding Compare.ListMeaningMark}"
                                Text="{Binding Compare.ListMeaning}" Compact="True"
                                IsVisible="{Binding Compare.ListMeaning, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </StackPanel>
            <DockPanel VerticalAlignment="Center">
              <views:CopyableTextBlock DockPanel.Dock="Left" Text="{Binding Compare.ListSummary}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.MatrixListSummary}"
                                       Margin="{DynamicResource Intent.Gap.AfterRelated}" />
              <views:CopyableTextBlock Classes="muted" Text="{Binding Compare.ListExplanation}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.MatrixListExplanation}"
                                       TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </DockPanel>

          <Border Grid.Row="1" Classes="matrixShared" IsVisible="{Binding Compare.HasShared}"
                  AutomationProperties.Name="{x:Static app:MotifAppStrings.WhatTheseWordsShareAccessibleName}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Classes="matrixSharedHeading" Text="{x:Static app:MotifAppStrings.WhatTheseWordsShare}"
                         Margin="{DynamicResource Intent.Gap.AfterGroup}" />
              <TextBlock DockPanel.Dock="Right" Classes="matrixSharedCount" Text="{Binding Compare.SharedMoreText}"
                         IsVisible="{Binding Compare.SharedMoreText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ItemsControl x:Name="ComparePanelSharedItems" ItemsSource="{Binding Compare.Shared}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CompareSharedMorphemeViewModel">
                    <StackPanel Classes="matrixSharedItem" Orientation="Horizontal"
                                AutomationProperties.Name="{Binding AccessibleName}">
                      <TextBlock Classes="matrixSharedCount" Text="{Binding Separator}"
                                 IsVisible="{Binding HasSeparator}" />
                      <word:MorphemePanel Morphs="{Binding Morphs}" ShowCategory="False" RevealLinks="True" />
                      <TextBlock Classes="matrixSharedCount" Text="{Binding CountText}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>

          <WrapPanel Grid.Row="2">
            <ComboBox x:Name="ComparePanelSortChoicesItems" VerticalAlignment="Top" ItemsSource="{Binding Compare.SortChoices}"
                      SelectedItem="{Binding Compare.Sort}"
                      MinWidth="{DynamicResource Component.TextsPage.CompareSortMinWidth}"
                      Margin="{DynamicResource Component.TextsPage.CompareControlMargin}"
                      AutomationProperties.Name="{x:Static app:MotifAppStrings.OrderTheListedWordsAccessibleName}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CompareSort">
                  <TextBlock Text="{Binding Converter={x:Static views:ComparePanel.SortLabel}}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.MatrixSortChoice}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox x:Name="MatrixWordSearch" VerticalAlignment="Top" Width="{DynamicResource Component.TextsPage.CompareSearchWidth}"
                     Margin="{DynamicResource Component.TextsPage.CompareControlMargin}"
                     Text="{Binding Compare.SearchText}" PlaceholderText="Search words…"
                     AutomationProperties.Name="{x:Static app:MotifAppStrings.SearchTheListedWordsAccessibleName}" />
              <SplitButton Content="{x:Static app:MotifAppStrings.ParseAgain}" Command="{Binding Compare.RerunCommand}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.MatrixParseAgain}"
                           IsVisible="{Binding Compare.CanRerun}" Margin="{DynamicResource Component.TextsPage.CompareControlMargin}"
                           ToolTip.Tip="{x:Static app:MotifAppStrings.CompareParseAgainTip}"
                           views:ClearTipPlacement.IsEnabled="True"
                           AutomationProperties.Name="{x:Static app:MotifAppStrings.CompareParseAgainAccessibleName}">
                <SplitButton.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                      <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.SecondsPerWord}" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding Compare.RerunSeconds}" Minimum="1" Maximum="3600" Increment="10"
                                     Width="{DynamicResource Component.TextsPage.RerunTimeWidth}" FormatString="0"
                                     AutomationProperties.Name="{x:Static app:MotifAppStrings.SecondsEachWordGetsWhenRunAgainAccessibleName}" />
                    </StackPanel>
                  </Flyout>
                </SplitButton.Flyout>
              </SplitButton>
              <Button Content="{x:Static app:MotifAppStrings.AiHandoffHeading}" Command="{Binding Compare.HandOffCommand}"
                      Margin="{DynamicResource Component.TextsPage.CompareControlMargin}"
                      AutomationProperties.Name="{x:Static app:MotifAppStrings.AIHandoffForTheListedWordsAccessibleName}" />
              <Button Content="{x:Static app:MotifAppStrings.AddAsUnknown}" Command="{Binding Compare.ProposeCommand}" CommandParameter="add-candidate"
                      IsVisible="{Binding Compare.HasCheckedWords}"
                      Margin="{DynamicResource Component.TextsPage.CompareControlMargin}"
                      ToolTip.Tip="{Binding Compare.CheckedWordText}"
                      AutomationProperties.Name="{x:Static app:MotifAppStrings.AddCheckedWordsAsUnknownAccessibleName}" />
              <Button Content="{x:Static app:MotifAppStrings.IncorrectSpelling}" Command="{Binding Compare.ProposeCommand}" CommandParameter="incorrect-spelling"
                      IsVisible="{Binding Compare.HasCheckedWords}"
                      Margin="{DynamicResource Component.TextsPage.CompareControlMargin}"
                      ToolTip.Tip="{Binding Compare.CheckedWordText}"
                      AutomationProperties.Name="{x:Static app:MotifAppStrings.MarkCheckedWordsAsIncorrectSpellingAccessibleName}" />
          </WrapPanel>

          <StackPanel Grid.Row="3" Spacing="{DynamicResource Intent.Space.Minimal}">
            <views:RefusalBlock DataContext="{Binding Compare.Changes.ShownRefusal}" />
            <views:CopyableTextBlock Classes="muted" Text="{Binding Compare.Changes.CollectionNotice}" TextWrapping="Wrap"
                                     IsVisible="{Binding Compare.Changes.CollectionNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <views:WordListSlot Grid.Row="4" Schema="{x:Static word:WordListSchemas.All}"
                              ShowsMeaning="{Binding Compare.ShowsMeaning}">
            <Grid RowDefinitions="Auto,*" AutomationProperties.AutomationId="{x:Static app:AutomationIds.MatrixWordsGrid}">
            <word:WordRowHeader MeaningHeader="Meaning" />
            <ListBox x:Name="ComparePanelWordsItems" Grid.Row="1" Classes="wordRows" ItemsSource="{Binding Compare.Words}"
                     MaxHeight="{DynamicResource Component.TextsPage.CompareWordsListHeight}"
                     KeyboardNavigation.TabNavigation="Continue"
                     AutomationProperties.Name="{x:Static app:MotifAppStrings.WordsInTheChosenCellsAccessibleName}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CompareWordViewModel">
                  <word:WordRow Data="{Binding MatrixPresentation}" State="{Binding PresentationState, Mode=TwoWay}"
                                Host="{Binding $parent[views:ComparePanel].MatrixPresentationHost}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
          </views:WordListSlot>
        </Grid>
      </Border>
  </Grid>
  </ScrollViewer>
</UserControl>
