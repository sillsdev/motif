<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ComparePanel"
             x:DataType="views:ComparePanel">
  <UserControl.Styles>
    <Style Selector=":is(TextBlock).columnHeader">
      <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
    </Style>
    <Style Selector="ListBox.denseWords ListBoxItem">
      <Setter Property="Padding" Value="{DynamicResource Component.TextsPage.DenseRowPadding}" />
      <Setter Property="MinHeight" Value="{DynamicResource Component.TextsPage.DenseRowMinHeight}" />
      <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerBottom}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    </Style>
    <Style Selector="Button.header">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="{DynamicResource Component.TextsPage.HeaderButtonPadding}" />
    </Style>
    <Style Selector="Button.fixFirstWord">
      <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    </Style>
    <Style Selector="Button.fixFirstWord.focused">
      <Setter Property="Background" Value="{DynamicResource Intent.Selected.Fill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Intent.Accent}" />
      <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="{DynamicResource Intent.Space.Related}"
        Margin="{DynamicResource Component.TextsPage.PageInset}" IsVisible="{Binding Compare.HasWords}">
    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}">
      <Border Classes="notice" IsVisible="{Binding Compare.ShowsNoStandingsNotice}">
        <views:CopyableTextBlock TextWrapping="Wrap"
                                 Text="This Assessment did not record what the project holds, so every word sits in the first row. Run it again to fill the rows." />
      </Border>
      <views:FilterChip Label="All words" Count="{Binding Compare.TotalCount}" IsActive="{Binding !Compare.AnySelected}"
                        Command="{Binding Compare.ClearSelectionCommand}" />
      <ItemsControl ItemsSource="{Binding Compare.Presets}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ComparePresetViewModel">
            <views:FilterChip Label="{Binding Label}" Count="{Binding Count}" IsActive="{Binding IsActive}" IsVisible="{Binding Count}"
                              Command="{Binding $parent[views:ComparePanel].Compare.SelectPresetCommand}" CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="{DynamicResource Intent.Space.Compact}" AutomationProperties.Name="Compare matrix">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
        <RadioButton Content="Count words" GroupName="CompareCount" IsChecked="{Binding Compare.CountWords}"
                     AutomationProperties.Name="Count words in the matrix" />
        <RadioButton Content="Count occurrences" GroupName="CompareCount" IsChecked="{Binding Compare.CountOccurrences}"
                     AutomationProperties.Name="Count occurrences in the matrix" />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Related}">
        <views:CopyableTextBlock Width="{DynamicResource Component.TextsPage.MatrixRowLabelWidth}"
                                 Classes="columnHeader" Text="PROJECT ↓  PARSER →" VerticalAlignment="Bottom"
                                 Margin="{DynamicResource Component.TextsPage.ShortLabelMargin}" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Compare.Columns}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="5" ColumnSpacing="{DynamicResource Intent.Space.Compact}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CompareColumnViewModel">
              <Button Classes="header" Theme="{DynamicResource BorderlessButton}"
                      Command="{Binding $parent[views:ComparePanel].Compare.SelectColumnCommand}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding Label, StringFormat='Choose the {0} column'}">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="{DynamicResource Intent.Type.Body}" />
                  <TextBlock Classes="muted" Text="{Binding CountText}" FontSize="{DynamicResource Intent.Type.Label}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      <ItemsControl ItemsSource="{Binding Compare.Rows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="{DynamicResource Intent.Space.Compact}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CompareRowViewModel">
            <Grid ColumnDefinitions="Auto,*">
              <Button Width="{DynamicResource Component.TextsPage.MatrixRowLabelWidth}"
                      Classes="header" Theme="{DynamicResource BorderlessButton}" VerticalAlignment="Stretch"
                      Command="{Binding $parent[views:ComparePanel].Compare.SelectRowCommand}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding Label, StringFormat='Choose the {0} row'}">
                <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource Intent.Space.Minimal}">
                  <views:VerdictChip Verdict="{Binding Verdict}" Text="{Binding Label}" HorizontalAlignment="Left" />
                  <TextBlock Classes="muted" Text="{Binding CountText}" FontSize="{DynamicResource Intent.Type.Label}" />
                </StackPanel>
              </Button>
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="5" ColumnSpacing="{DynamicResource Intent.Space.Compact}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CompareCellViewModel">
                    <views:MatrixCell Tag="{Binding}" PointerPressed="OnCellPressed" KeyDown="OnCellKeyDown" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Border Grid.Row="2" Classes="card">
      <Expander IsExpanded="True">
        <Expander.Header>
          <DockPanel LastChildFill="True">
            <views:CopyableTextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding Compare.FixFirstSummary}"
                                     FontSize="{DynamicResource Intent.Type.Small}"
                                     AutomationProperties.Name="Fix these first count" />
            <views:CopyableTextBlock Text="Fix these first" FontWeight="SemiBold" />
          </DockPanel>
        </Expander.Header>
        <ListBox ItemsSource="{Binding Compare.FixFirstRows}"
                 MaxHeight="{DynamicResource Component.TextsPage.FixFirstListHeight}"
                 Margin="{DynamicResource Intent.Gap.AfterRelated}"
                 AutomationProperties.Name="Words to check first">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CompareFixFirstViewModel">
              <Expander IsExpanded="{Binding Word.IsExpanded}">
                <Expander.Header>
                  <Button Classes="fixFirstWord" Classes.focused="{Binding Word.IsFocused}"
                          Theme="{DynamicResource BorderlessButton}" Padding="{DynamicResource Intent.Inset.None}"
                          HorizontalContentAlignment="Stretch"
                          Command="{Binding $parent[views:ComparePanel].Compare.FocusFixFirstCommand}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Snug}">
                        <TextBlock Text="{Binding Word.Word}" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" Text="{Binding OccurrenceText}" />
                      </StackPanel>
                      <TextBlock Grid.Row="1" Classes="muted" Text="{Binding Category}"
                                 FontSize="{DynamicResource Intent.Type.Label}" />
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="muted" Text="{Binding Explanation}"
                                 FontSize="{DynamicResource Intent.Type.Label}" TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis" />
                      <Ellipse Grid.Column="1" Fill="{DynamicResource Intent.Warning.Text}"
                               Width="{DynamicResource Component.MatrixCell.MarkerSize}"
                               Height="{DynamicResource Component.MatrixCell.MarkerSize}"
                               IsVisible="{Binding Word.HasPendingChange}" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding Word.PendingChangeStatus}" />
                    </Grid>
                  </Button>
                </Expander.Header>
                <StackPanel Spacing="{DynamicResource Intent.Space.Compact}" Margin="{DynamicResource Intent.Gap.AfterRelated}">
                  <ItemsControl ItemsSource="{Binding MissedApproved}" IsVisible="{Binding MissedApproved.Count}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ParserReadingViewModel">
                        <views:CopyableTextBlock Text="{Binding Text, StringFormat='Approved analysis: {0}'}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding ParserReadings}" IsVisible="{Binding ParserReadings.Count}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CompareReadingChoice">
                        <views:CopyableTextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Expander>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Expander>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
      <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource Intent.Space.Minimal}">
        <views:CopyableTextBlock Text="{Binding Compare.ListSummary}" FontWeight="SemiBold" />
        <views:CopyableTextBlock Classes="muted" Text="{Binding Compare.SelectionText}"
                                 FontSize="{DynamicResource Intent.Type.Small}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBox Grid.Column="1" Width="{DynamicResource Component.TextsPage.CompareSearchWidth}"
               Text="{Binding Compare.SearchText}" PlaceholderText="Search these words..."
               AutomationProperties.Name="Search the listed words" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding Compare.SortChoices}" SelectedItem="{Binding Compare.Sort}"
                MinWidth="{DynamicResource Component.TextsPage.CompareSortMinWidth}"
                AutomationProperties.Name="Order the listed words">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CompareSort">
            <TextBlock Text="{Binding Converter={x:Static views:ComparePanel.SortLabel}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <StackPanel Grid.Row="4" Spacing="{DynamicResource Intent.Space.Minimal}">
      <WrapPanel>
        <views:CopyableTextBlock Classes="muted" Text="{Binding Compare.CheckedWordText}"
                                 Margin="{DynamicResource Component.TextsPage.ActionButtonMargin}" VerticalAlignment="Center" />
        <Button Content="Add as candidate" Command="{Binding Compare.ProposeCommand}" CommandParameter="add-candidate"
                Margin="{DynamicResource Component.TextsPage.ActionButtonMargin}"
                AutomationProperties.Name="Add checked words as candidates" />
        <Button Content="Incorrect spelling" Command="{Binding Compare.ProposeCommand}" CommandParameter="incorrect-spelling"
                Margin="{DynamicResource Component.TextsPage.ActionButtonMargin}"
                AutomationProperties.Name="Mark checked words as incorrect spelling" />
        <Button Content="Approve" Command="{Binding Compare.ProposeCommand}" CommandParameter="approve"
                Margin="{DynamicResource Component.TextsPage.ActionButtonMargin}"
                AutomationProperties.Name="Approve the chosen analysis for the checked word" />
        <Button Content="Reject" Command="{Binding Compare.ProposeCommand}" CommandParameter="reject"
                Margin="{DynamicResource Component.TextsPage.ActionButtonMargin}"
                AutomationProperties.Name="Reject the chosen analysis for the checked word" />
        <Button Content="Back to candidate" Command="{Binding Compare.ProposeCommand}" CommandParameter="candidate"
                Margin="{DynamicResource Component.TextsPage.ActionButtonMargin}"
                AutomationProperties.Name="Return the chosen analysis to candidate" />
        <NumericUpDown Value="{Binding Compare.RerunSeconds}" Minimum="1" Maximum="3600" Increment="10"
                       Width="{DynamicResource Component.TextsPage.RerunTimeWidth}" FormatString="0"
                       IsVisible="{Binding Compare.CanRerun}"
                       AutomationProperties.Name="Seconds each word gets when run again" />
        <Button Content="Run timed-out words again" Command="{Binding Compare.RerunCommand}"
                IsVisible="{Binding Compare.CanRerun}" Margin="{DynamicResource Component.TextsPage.ActionButtonMargin}"
                AutomationProperties.Name="Run the timed-out and untried words again" />
        <Button Content="AI Handoff for these words" Command="{Binding Compare.HandOffCommand}"
                Margin="{DynamicResource Component.TextsPage.ActionButtonMargin}"
                AutomationProperties.Name="AI Handoff for the listed words" />
      </WrapPanel>
      <views:CopyableTextBlock Classes="error" Text="{Binding Compare.Changes.ErrorText}" TextWrapping="Wrap"
                               IsVisible="{Binding Compare.Changes.HasError}" />
      <views:CopyableTextBlock Classes="muted" Text="{Binding Compare.Changes.CollectionNotice}" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="5" RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,*,Auto" Margin="{DynamicResource Component.TextsPage.DenseRowPadding}">
        <Border Width="{DynamicResource Component.TextsPage.WordCheckWidth}" />
        <views:CopyableTextBlock Grid.Column="1" Classes="columnHeader" Text="WORD" />
        <views:CopyableTextBlock Grid.Column="2" Width="{DynamicResource Component.TextsPage.WordOccurrencesWidth}"
                                 Classes="columnHeader" Text="IN TEXTS" />
        <views:CopyableTextBlock Grid.Column="3" Width="{DynamicResource Component.TextsPage.WordProjectWidth}"
                                 Classes="columnHeader" Text="IN THE PROJECT" />
        <views:CopyableTextBlock Grid.Column="4" Width="{DynamicResource Component.TextsPage.WordParserWidth}"
                                 Classes="columnHeader" Text="PARSER" />
        <views:CopyableTextBlock Grid.Column="5" Width="{DynamicResource Component.TextsPage.WordMeaningWidth}"
                                 Classes="columnHeader" Text="MEANING" />
        <views:CopyableTextBlock Grid.Column="6" Classes="columnHeader" Text="CHOOSE AN ANALYSIS" />
        <Border Grid.Column="7" Width="{DynamicResource Component.TextsPage.WordOpenWidth}" />
      </Grid>
      <ListBox Grid.Row="1" Classes="denseWords" ItemsSource="{Binding Compare.Words}"
               AutomationProperties.Name="Words in the chosen cells">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CompareWordViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,*,Auto" Margin="{DynamicResource Intent.Gap.AfterRelated}">
              <CheckBox Width="{DynamicResource Component.TextsPage.WordCheckWidth}"
                        Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Word, StringFormat='Tick {0} for a change'}" />
              <StackPanel Grid.Column="1" Spacing="{DynamicResource Intent.Space.Minimal}" VerticalAlignment="Center">
                <views:CopyableTextBlock Text="{Binding Word}" FontWeight="SemiBold" />
                <views:CopyableTextBlock Classes="muted" Text="{Binding PendingChangeStatus}"
                                         IsVisible="{Binding HasPendingChange}" FontSize="{DynamicResource Intent.Type.Label}" />
              </StackPanel>
              <views:CopyableTextBlock Grid.Column="2" Width="{DynamicResource Component.TextsPage.WordOccurrencesWidth}"
                                       Classes="muted" Text="{Binding OccurrenceText}" VerticalAlignment="Center" />
              <views:VerdictChip Grid.Column="3" Width="{DynamicResource Component.TextsPage.WordProjectWidth}"
                                 Verdict="{Binding RowVerdict}" Text="{Binding RowLabel}"
                                 Compact="True" HorizontalAlignment="Left" />
              <views:VerdictChip Grid.Column="4" Width="{DynamicResource Component.TextsPage.WordParserWidth}"
                                 Verdict="{Binding ColumnVerdict}" Text="{Binding ColumnLabel}"
                                 Compact="True" HorizontalAlignment="Left" />
              <views:CopyableTextBlock Grid.Column="5" Width="{DynamicResource Component.TextsPage.WordMeaningWidth}"
                                       Text="{Binding Meaning}" FontSize="{DynamicResource Intent.Type.Small}"
                                       VerticalAlignment="Center" Classes.error="{Binding IsViolation}" TextTrimming="CharacterEllipsis" />
              <ComboBox Grid.Column="6" ItemsSource="{Binding ReadingChoices}" SelectedItem="{Binding SelectedReading}"
                        PlaceholderText="Choose an analysis for an opinion" HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Word, StringFormat='Analysis for {0}'}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CompareReadingChoice">
                    <views:CopyableTextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <HyperlinkButton Grid.Column="7" Width="{DynamicResource Component.TextsPage.WordOpenWidth}"
                               Content="Open" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Command="{Binding $parent[views:ComparePanel].Compare.OpenWordCommand}" CommandParameter="{Binding}"
                               AutomationProperties.Name="{Binding Word, StringFormat='Analyze {0} in its texts'}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
