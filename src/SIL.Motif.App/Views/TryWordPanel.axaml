<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.TryWordPanel"
             x:DataType="vm:TryWordPageModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!-- The right gap keeps the scroll bar off the result line's links. -->
    <StackPanel Spacing="{DynamicResource Intent.Space.Group}" Margin="{DynamicResource Intent.Gap.AfterGroup}">
      <DockPanel LastChildFill="True">
        <!-- Tools for a trace wait behind one menu beside Try it, so the page itself holds only the answer. -->
        <Button DockPanel.Dock="Right" Content="&#x22ef;" Margin="{DynamicResource Intent.Gap.AfterRelated}"
                AutomationProperties.Name="Try a Word tools">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="{DynamicResource Intent.Space.Compact}" MinWidth="{DynamicResource Component.TryWord.SidebarWidth}">
                <Button Content="Open a saved trace..." Click="OnOpenDiagnosticClick" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Open a saved trace" />
                <Button Content="Copy for a chat model" Click="OnCopyInstructionsClick" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Copy AI diagnostic instructions" />
                <Button Content="Save the trace..." Click="OnSaveClick" IsEnabled="{Binding Trace.HasDiagnosticJson}"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="Save full diagnostic JSON" />
                <Button Content="Copy the trace" Click="OnCopyJsonClick" IsEnabled="{Binding Trace.HasDiagnosticJson}"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="Copy full diagnostic JSON" />
                <views:CopyableTextBlock Text="{Binding Trace.CaptureDetails}" Classes="muted" TextWrapping="Wrap"
                                         FontSize="{DynamicResource Intent.Type.Label}" IsVisible="{Binding Trace.HasCaptureDetails}"
                                         AutomationProperties.Name="Diagnostic capture details" />
                <views:CopyableTextBlock Text="{Binding Trace.WritingSystemSummary}" Classes="muted" TextWrapping="Wrap"
                                         FontSize="{DynamicResource Intent.Type.Label}" IsVisible="{Binding Trace.HasResult}"
                                         AutomationProperties.Name="Writing system direction and font" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button DockPanel.Dock="Right" Content="Try it" Command="{Binding Trace.TryCommand}"
                Classes="Primary" Theme="{DynamicResource SolidButton}"
                AutomationProperties.Name="Try the word"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.TryWordRun}"
                Margin="{DynamicResource Intent.Gap.AfterRelated}" />
        <TextBox Text="{Binding Trace.WordToTry}" PlaceholderText="Type any word..."
                 MinWidth="{DynamicResource Component.TryWord.InputMinWidth}"
                 AutomationProperties.Name="Word to try"
                 AutomationProperties.AutomationId="{x:Static app:AutomationIds.TryWordInput}" />
      </DockPanel>

      <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !Trace.HasResult}"
                               Text="Type a word to see how the grammar parses it, where it stops, and the rules on its way. Choosing a word on the Texts page brings it here." />

      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Group}" IsVisible="{Binding Trace.IsLoading}">
        <views:CopyableTextBlock Classes="muted" Text="Tracing... this can take a while. You can cancel at any time." VerticalAlignment="Center" />
        <Button Content="Cancel" Command="{Binding Trace.CancelCommand}"
                AutomationProperties.Name="Cancel the trace" />
      </StackPanel>
      <views:RefusalBlock DataContext="{Binding Trace.ShownRefusal}" />

      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}"
            IsVisible="{Binding Trace.HasResult}">
        <views:CopyableTextBlock Text="{Binding Trace.WordToTry}"
                                 FontSize="{DynamicResource Intent.Type.Title}" FontWeight="SemiBold"
                                 AutomationProperties.Name="Try a Word result"
                                 AutomationProperties.AutomationId="{x:Static app:AutomationIds.TryWordResult}" />
        <views:VerdictChip Grid.Column="1" Verdict="{Binding Trace.AnswerVerdict}"
                           Text="{Binding Trace.AnswerText}" />
        <views:CopyableTextBlock Grid.Column="2" Text="{Binding Trace.PageSummaryText}"
                                 Classes="muted" TextWrapping="Wrap"
                                 AutomationProperties.Name="Try a Word summary" />
        <HyperlinkButton Grid.Column="3" Content="Open in Texts" Command="{Binding OpenInTextsCommand}"
                         Theme="{DynamicResource BorderlessButton}" Padding="{DynamicResource Intent.Inset.None}"
                         FontSize="{DynamicResource Intent.Type.Caption}"
                         AutomationProperties.Name="Open in Texts" />
      </Grid>
      <StackPanel Spacing="{DynamicResource Intent.Space.Snug}" IsVisible="{Binding Trace.HasResult}">
        <views:CopyableTextBlock Text="{Binding Trace.SearchStatusText}" Classes="status" TextWrapping="Wrap"
                                 IsVisible="{Binding Trace.HasStopReason}" AutomationProperties.Name="Search completeness" />
      </StackPanel>

      <Border Classes="card" IsVisible="{Binding Trace.HasComparison}"
              AutomationProperties.Name="Expected beside the furthest try">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Intent.Space.Group}">
          <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
            <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Label}"
                                     FontWeight="SemiBold" Text="WHAT THE PROJECT EXPECTS" />
            <views:MorphemeRow Morphs="{Binding Trace.ExpectedMorphs}" Separators="True" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="{DynamicResource Intent.Space.Related}">
            <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Label}"
                                     FontWeight="SemiBold" Text="THE PARSER'S FURTHEST TRY" />
            <views:MorphemeRow Morphs="{Binding Trace.FurthestAttempt.Morphs, FallbackValue={x:Null}}" Separators="True" />
            <views:CopyableTextBlock Classes="stopText" FontWeight="SemiBold" TextWrapping="Wrap"
                                     Text="{Binding Trace.FurthestAttempt.StopHeadline, FallbackValue=''}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card bestPath" IsVisible="{Binding HasRulesOnBestPath}"
              AutomationProperties.Name="Rules on this word's best path">
        <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
          <TextBlock Text="Rules on this word's best path, with where its time went"
                     FontSize="{DynamicResource Intent.Type.Section}" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="1.3*,1.4*,1.3*,2*,Auto"
                ColumnSpacing="{DynamicResource Intent.Space.Related}">
            <TextBlock Classes="muted" Text="Rule" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Classes="muted" Text="Kind" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Classes="muted" Text="Outcome" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Classes="muted" Text="Explanation" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Classes="muted" Text="Word share" FontWeight="SemiBold"
                       IsVisible="{Binding HasWordShare}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding RulesOnBestPath}" AutomationProperties.Name="Best path rules">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TryWordRuleRowViewModel">
                <Border BorderBrush="{DynamicResource Intent.Border}"
                        BorderThickness="{DynamicResource Intent.Stroke.DividerBottom}">
                  <Button Command="{Binding OpenTimingCommand}" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" Theme="{DynamicResource BorderlessButton}"
                          Classes="ruleRow" ToolTip.Tip="Open stored Timing for this rule and word">
                    <Grid ColumnDefinitions="1.3*,1.4*,1.3*,2*,Auto"
                          ColumnSpacing="{DynamicResource Intent.Space.Related}">
                      <TextBlock Text="{Binding Rule}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Kind}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Text="{Binding Outcome}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="3" Text="{Binding Explanation}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="4" Classes.share="{Binding HasShare}" Classes.muted="{Binding !HasShare}"
                                 Text="{Binding Share}" TextAlignment="Right" IsVisible="{Binding HasShare}" />
                    </Grid>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <ContentControl x:Name="RichDiagnosticHost" IsVisible="{Binding Trace.HasResult}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
