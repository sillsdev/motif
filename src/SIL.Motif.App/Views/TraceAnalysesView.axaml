<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:controls="clr-namespace:SIL.Motif.App.Controls"
             xmlns:responses="clr-namespace:SIL.Motif.Contract.Responses;assembly=SIL.Motif.Contract"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.TraceAnalysesView"
             x:DataType="vm:TraceWordViewModel"
             controls:WritingSystemText.Resolver="{Binding TextStyles}">
  <!-- A word that parses leads with its analyses, each once, before anything the parser dropped. -->
  <StackPanel Spacing="{DynamicResource Intent.Space.Snug}" IsVisible="{Binding HasAnalyses}"
              AutomationProperties.Name="Analyses">
    <views:CopyableTextBlock Text="{Binding AnalysesHeading}" FontSize="{DynamicResource Intent.Type.Section}" FontWeight="SemiBold" />
    <ItemsControl x:Name="TraceAnalysesViewAnalysesItems" ItemsSource="{Binding Analyses}" AutomationProperties.Name="Recorded analyses">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TraceAnalysisViewModel">
          <Border Classes="card" Margin="{DynamicResource Component.TryWord.SmallBottomInset}">
            <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
                <views:CopyableTextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <views:CopyableTextBlock Grid.Column="1" Text="{Binding Surface}" ToolTip.Tip="{Binding LegacyMorphemesTip}" />
                <views:CopyableTextBlock Grid.Column="2" Classes="muted" Text="{Binding RecordedCountText}"
                                         IsVisible="{Binding HasRepeatedRecords}"
                                         ToolTip.Tip="The trace recorded this result more than once; distinct derivations are not established." />
              </Grid>
              <views:CopyableTextBlock Text="{Binding LegacyMorphemesText}" IsVisible="{Binding HasLegacyMorphemes}" TextWrapping="Wrap" />
              <views:CopyableTextBlock Text="{Binding ProjectionErrorText}" ToolTip.Tip="{Binding ProjectionError}"
                                       IsVisible="{Binding HasProjectionError}"
                                       Classes="muted" TextWrapping="Wrap" />
              <views:ProgressiveItemsControl x:Name="TraceAnalysesViewMorphsItems" FullItemsSource="{Binding Morphs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TraceMorphViewModel">
                    <Border Classes="card" Margin="{DynamicResource Intent.Gap.AfterRelated}">
                      <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                        <views:InspectLink Subject="{Binding InspectSubject}" Captured="{Binding Captured}" IsVisible="{Binding CanInspect}">
                          <controls:WritingSystemTextBlock Text="{Binding Form}" FontWeight="SemiBold"
                                     controls:WritingSystemText.Id="{Binding FormWritingSystem}" controls:WritingSystemText.StyleName="Normal" />
                        </views:InspectLink>
                        <views:CopyableTextBlock Text="{Binding Form}" FontWeight="SemiBold" IsVisible="{Binding CannotInspect}"
                                                 controls:WritingSystemText.Id="{Binding FormWritingSystem}" controls:WritingSystemText.StyleName="Normal" />
                        <views:CopyableTextBlock Text="{Binding Headword}" Classes="muted"
                                                 controls:WritingSystemText.Id="{Binding HeadwordWritingSystem}" controls:WritingSystemText.StyleName="Normal" />
                        <views:CopyableTextBlock Text="{Binding Gloss}"
                                                 controls:WritingSystemText.Id="{Binding GlossWritingSystem}" controls:WritingSystemText.StyleName="Normal" />
                        <views:CopyableTextBlock Text="{Binding Category}" Classes="muted" />
                        <Expander Header="Full morph details" IsExpanded="False">
                          <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                            <views:CopyableTextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                            <views:CopyableTextBlock Text="{Binding MsaDetails}" TextWrapping="Wrap" />
                            <Expander Header="Raw morph record">
                              <views:CopyableTextBlock Text="{Binding RawDetails}" Classes="muted" TextWrapping="Wrap" />
                            </Expander>
                            <views:CopyableTextBlock Text="{Binding Identity}" Classes="muted" TextWrapping="Wrap" />
                            <HyperlinkButton Content="{Binding LinkText}"
                                             NavigateUri="{Binding Link}"
                                             IsVisible="{Binding HasLink}"
                                             Padding="{DynamicResource Intent.Inset.None}"
                                             AutomationProperties.Name="{Binding LinkName}" />
                            <views:CopyableTextBlock Classes="muted"
                                                     Text="Live FieldWorks navigation is unavailable for this recorded morph."
                                                     IsVisible="{Binding HasNoLink}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Expander>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </views:ProgressiveItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Expander Header="Parser record" AutomationProperties.Name="Recorded source analyses" IsExpanded="{Binding ShowParserRecord, Mode=TwoWay}" IsVisible="{Binding IsExpert}">
      <ItemsControl x:Name="TraceAnalysesViewSourceAnalysesItems" ItemsSource="{Binding SourceAnalyses}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="responses:TraceAnalysis">
            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}" Margin="{DynamicResource Component.TryWord.SmallBottomInset}">
              <views:CopyableTextBlock Text="{Binding AnalysisId, StringFormat='Producer id: {0}'}" />
              <views:CopyableTextBlock Text="{Binding Index, StringFormat='Recorded index: {0}'}" />
              <views:CopyableTextBlock Text="{Binding Surface}" />
              <views:CopyableTextBlock Text="{Binding LegacyMorphemes, StringFormat='Parser morphemes: {0}'}" TextWrapping="Wrap" />
              <views:CopyableTextBlock Text="{Binding ProjectionStatus, StringFormat='Projection status: {0}'}" />
              <views:CopyableTextBlock Text="{Binding ProjectionErrorCode}" TextWrapping="Wrap" />
              <views:CopyableTextBlock Text="{Binding ProjectionError}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>
  </StackPanel>
</UserControl>
