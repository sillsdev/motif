<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:controls="clr-namespace:SIL.Motif.App.Controls"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.WordRowCard"
             x:DataType="views:WordRowCard"
             x:Name="Self">
  <Panel>
    <ContentControl Content="{Binding #Self.CardToken}"
                    IsVisible="{Binding #Self.CardToken, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:ResultsTokenViewModel">
          <StackPanel>
                        <Border Classes="wordCardSection hoverReveal">
                          <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                            <views:CopyableTextBlock Classes="wordCardHeading" Text="In FieldWorks · now" />
                            <views:CopyableTextBlock Classes="muted" Text="Nothing in FieldWorks for this word."
                                                     IsVisible="{Binding HasNothingStored}" />
                            <views:ProgressiveItemsControl x:Name="ResultsInTextPanelFieldWorksAnalysesItems"
                                                           FullItemsSource="{Binding FieldWorksAnalyses}"
                                                           IsVisible="{Binding HasFieldWorksAnalyses}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FieldWorksAnalysisDisplayViewModel">
                                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                                    <views:MorphemeRow Morphs="{Binding Morphs}" ShowCategory="False" RevealLinks="True" />
                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}"
                                                VerticalAlignment="Top">
                                      <controls:OpinionMark Kind="{Binding OpinionMarkKind}" ToolTip.Tip="{Binding OpinionLabel}"
                                                            views:ClearTipPlacement.IsEnabled="True" />
                                      <views:CopyableTextBlock Text="{Binding OpinionLabel}" FontWeight="SemiBold" />
                                    </StackPanel>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </views:ProgressiveItemsControl>
                          </StackPanel>
                        </Border>
                        <Border Classes="wordCardSection hoverReveal">
                          <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                            <views:CopyableTextBlock Classes="wordCardHeading" Text="In PanGloss · now" />
                            <Border Classes="panGlossLine" Classes.same="{Binding IsPanGlossSame}"
                                    Classes.different="{Binding IsPanGlossDifferent}" Classes.none="{Binding IsPanGlossNone}"
                                    Classes.capped="{Binding IsPanGlossCapped}">
                              <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                <DockPanel LastChildFill="False">
                                  <views:CopyableTextBlock Classes="f" Text="{Binding PanGlossCardSummary}" />
                                  <Button DockPanel.Dock="Right" Classes="revealControl revealLink revealOnHover" Content="PanGloss help"
                                          Command="{Binding Actions.OpenPanGlossGuideCommand}"
                                          AutomationProperties.Name="About PanGloss" />
                                </DockPanel>
                                <views:CopyableTextBlock Classes="hint" Text="{Binding ComparisonDetail}"
                                                         IsVisible="{Binding HasComparisonDetail}" TextWrapping="Wrap" />
                                <views:ProgressiveItemsControl x:Name="ResultsInTextPanelReadingsItems"
                                                               FullItemsSource="{Binding Readings}"
                                                               IsVisible="{Binding HasReadings}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ResultsReadingViewModel">
                                      <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                        <views:CopyableTextBlock Text="{Binding Text}" />
                                        <views:MorphemeRow Morphs="{Binding Morphs}" ShowCategory="False" RevealLinks="True" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </views:ProgressiveItemsControl>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </Border>
                        <Border Classes="wordCardSection hoverReveal" IsVisible="{Binding HasWhySection}">
                          <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                            <views:CopyableTextBlock Classes="wordCardHeading" Text="{Binding WarningSectionHeading}" />
                            <views:CopyableTextBlock Classes="muted" Text="No stored warning names this word."
                                                     IsVisible="{Binding HasNoNamedWarning}" />
                            <views:ProgressiveItemsControl x:Name="ResultsInTextPanelNamedWarningDetailsItems"
                                                           FullItemsSource="{Binding NamedWarningDetails}"
                                                           IsVisible="{Binding HasNamedWarning}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NamedWarningCardViewModel">
                                  <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                    <DockPanel LastChildFill="True">
                                      <Button DockPanel.Dock="Right" Classes="revealControl revealLink revealOnHover"
                                              Content="Open the warning" Command="{Binding $parent[ItemsControl].DataContext.Actions.OpenWarningsCommand}"
                                              AutomationProperties.Name="Open the grammar warning" />
                                      <views:CopyableTextBlock Classes="wordCardHeading" Text="{Binding Message}"
                                                               IsVisible="{Binding HasMessage}"
                                                               TextWrapping="Wrap" />
                                    </DockPanel>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </views:ProgressiveItemsControl>
                            <views:CopyableTextBlock Classes="muted" Text="{Binding NamedMorphemeSentence}"
                                                     IsVisible="{Binding HasNamedMorphemeNames}" />
                            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}"
                                        IsVisible="{Binding HasOtherWordsUsingMorpheme}">
                              <views:CopyableTextBlock Classes="muted" Text="{Binding OtherWordsUsingMorphemeHeading}" />
                              <views:CopyableTextBlock Text="{Binding OtherWordsUsingMorphemeLabel}"
                                                       TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}"
                                        IsVisible="{Binding ShowsWarningCandidates}">
                              <views:ProgressiveItemsControl x:Name="ResultsInTextPanelMembershipCandidateWarningsItems"
                                                             FullItemsSource="{Binding MembershipCandidateWarnings}"
                                                             IsVisible="{Binding HasMembershipCandidateWarnings}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:WarningCandidateViewModel">
                                    <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                      <views:CopyableTextBlock Classes="muted" Text="{Binding MembershipLabel}" />
                                      <views:CopyableTextBlock Text="{Binding WordsLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </views:ProgressiveItemsControl>
                              <views:ProgressiveItemsControl x:Name="ResultsInTextPanelSpellingCandidateWarningsItems"
                                                             FullItemsSource="{Binding SpellingCandidateWarnings}"
                                                             IsVisible="{Binding HasSpellingCandidateWarnings}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:WarningCandidateViewModel">
                                    <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                      <views:CopyableTextBlock Classes="muted" Text="{Binding SpellingLabel}" />
                                      <views:CopyableTextBlock Text="{Binding WordsLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </views:ProgressiveItemsControl>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                        <Border Classes="wordCardSection hoverReveal" IsVisible="{Binding HasTimingEvidence}">
                          <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                            <views:CopyableTextBlock Classes="wordCardHeading" Text="Time by rule" />
                            <ItemsControl x:Name="ResultsInTextPanelTimingSharesItems" ItemsSource="{Binding TimingShares}"
                                          IsVisible="{Binding HasTimingShares}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimingShareViewModel">
                                  <DockPanel LastChildFill="False">
                                    <views:CopyableTextBlock Text="{Binding Name}" />
                                    <views:CopyableTextBlock DockPanel.Dock="Right" Text="{Binding ShareLabel}" />
                                  </DockPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <views:CopyableTextBlock Classes="muted" Text="{Binding NotAttributedShareLabel}" />
                          </StackPanel>
                        </Border>
                        <Border Classes="wordCardSection last">
                          <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
                            <views:CopyableTextBlock Classes="wordCardHeading" Text="What to do" />
                            <WrapPanel>
                              <Button Classes="wordCardAction primary" Content="{Binding Marking.PrimaryAction.Label, StringFormat='✓ {0}'}"
                                      Command="{Binding Actions.StagePrimaryMarkingActionForTokenCommand}" CommandParameter="{Binding}"
                                      IsVisible="{Binding HasPrimaryAction}"
                                      AutomationProperties.Name="{Binding Marking.PrimaryAction.Label, StringFormat='Choose {0} for this word'}" />
                              <Button Classes="wordCardAction" Content="Fix ▾" AutomationProperties.Name="Fix actions for this word">
                                <Button.Flyout>
                                  <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Classes="menu">
                                      <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                              Command="{Binding AddChangeForTokenCommand}"
                                              CommandParameter="incorrect-spelling" AutomationProperties.Name="Mark this spelling Incorrect">
                                        <TextBlock Classes="menuTitle" Text="Incorrect spelling" />
                                      </Button>
                                      <ItemsControl x:Name="ResultsInTextPanelFixChoicesItems38"
                                                    ItemsSource="{Binding Marking.FixChoices}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="vm:AnalysisMarkingChoice">
                                            <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.StageMarkingChoiceForTokenCommand}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}">
                                              <StackPanel>
                                                <TextBlock Classes="menuTitle" Text="{Binding Label}" />
                                                <TextBlock Classes="menuDetail" Text="{Binding Subtitle}"
                                                           IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                              </StackPanel>
                                            </Button>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                    </StackPanel>
                                  </Flyout>
                                </Button.Flyout>
                              </Button>
                              <Button Classes="wordCardAction" Content="Try a Word" Command="{Binding TryWordForTokenCommand}" />
                              <Button Classes="wordCardAction" Content="Mark as unread" Command="{Binding Actions.MarkTokenUnreadCommand}"
                                      CommandParameter="{Binding}" AutomationProperties.Name="Mark this occurrence as unread"
                                      AutomationProperties.HelpText="{Binding MarkUnreadDisabledReason}"
                                      ToolTip.Tip="{Binding MarkUnreadDisabledReason}" ToolTip.ShowOnDisabled="True"
                                      views:ClearTipPlacement.IsEnabled="True" />
                              <Button Classes="wordCardAction" Content="Check again" Command="{Binding Actions.RecheckChangesCommand}"
                                      IsVisible="{Binding Marking.IsUncertain}" AutomationProperties.Name="Check this uncertain change again" />
                            </WrapPanel>
                          </StackPanel>
                        </Border>
          </StackPanel>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    <ContentControl Content="{Binding #Self.DataContext}"
                    IsVisible="{Binding #Self.CardToken, Converter={x:Static conv:ObjectConverters.IsNull}}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:CompareWordViewModel">
  <Grid Classes="wordRowCardGrid" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
    <views:CopyableTextBlock Classes="wordRowCardLabel" Text="FieldWorks" />
    <StackPanel Grid.Column="1" Classes="wordRowCardSection">
      <ItemsControl x:Name="WordRowCardOpinionMarksItems" ItemsSource="{Binding OpinionMarks}" IsVisible="{Binding HasSeveralOpinions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CompareOpinionMarkViewModel">
            <views:MarkChip Mark="{Binding Mark}" Text="{Binding Label}" Compact="True"
                            Margin="{DynamicResource Intent.Gap.AfterRelated}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <views:MorphemeRow Morphs="{Binding WordRow.FieldWorksMorphemes}" ShowCategory="False" RevealLinks="True" CompactLinks="True"
                         IsVisible="{Binding HasFieldWorksAnalysis}" />
      <views:CopyableTextBlock Classes="muted" Text="FieldWorks holds no analysis of this word."
                               IsVisible="{Binding !HasFieldWorksAnalysis}" />
    </StackPanel>

    <views:CopyableTextBlock Grid.Row="1" Classes="wordRowCardLabel" Text="PanGloss" />
    <StackPanel Grid.Row="1" Grid.Column="1" Classes="wordRowCardSection">
      <views:MarkChip Mark="{Binding WordRow.OutcomeMark}" Text="{Binding ReadingsSummary}" Compact="True"
                      HorizontalAlignment="Left" />
      <views:CopyableTextBlock Text="{Binding WordRow.RefusalReason}" TextWrapping="Wrap"
                               IsVisible="{Binding WordRow.HasRefusalReason}" Classes="wordRowNote" />
      <ItemsControl x:Name="WordRowCardReadingsItems" ItemsSource="{Binding Readings}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ParserReadingViewModel">
            <views:MorphemeRow Morphs="{Binding Morphs}" ShowCategory="True" RevealLinks="True" CompactLinks="True" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <views:CopyableTextBlock Classes="muted" Text="{Binding NoReadingsText}" TextWrapping="Wrap"
                               IsVisible="{Binding ShowsNoReadingsText}" />
    </StackPanel>

    <views:CopyableTextBlock Grid.Row="2" Classes="wordRowCardLabel" Text="NOT BUILT" IsVisible="{Binding ShowsMissedApproved}" />
    <StackPanel Grid.Row="2" Grid.Column="1" Classes="wordRowCardSection" IsVisible="{Binding ShowsMissedApproved}">
      <views:CopyableTextBlock Classes="muted" Text="Approved analyses PanGloss did not build" />
      <ItemsControl x:Name="WordRowCardNotBuiltAnalysesItems" ItemsSource="{Binding NotBuiltAnalyses}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ParserReadingViewModel">
            <views:MorphemeRow Morphs="{Binding Morphs}" ShowCategory="True" RevealLinks="True" CompactLinks="True" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Panel>
</UserControl>
