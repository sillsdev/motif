<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.SelectionPanel"
             x:DataType="views:SelectionPanel">
  <ScrollViewer Margin="{DynamicResource Component.TextsPage.PageInset}">
    <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
      <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
        <views:CopyableTextBlock Text="Texts" FontSize="{DynamicResource Intent.Type.Section}" FontWeight="SemiBold" />
        <views:CopyableTextBlock Classes="muted" Text="{Binding Selection.SummaryText}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}"
                  IsVisible="{Binding Selection.HasTexts}">
        <Button Content="Select all texts" Command="{Binding Selection.SelectAllTextsCommand}"
                Theme="{DynamicResource BorderlessButton}" Foreground="{DynamicResource Intent.Accent}"
                AutomationProperties.Name="Select all texts"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.SelectAllTexts}" />
        <Button Content="Clear" Command="{Binding Selection.ClearTextsCommand}"
                IsVisible="{Binding Selection.ShowClearTexts}"
                Theme="{DynamicResource BorderlessButton}" Foreground="{DynamicResource Intent.Accent}"
                AutomationProperties.Name="Clear" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ClearTexts}" />
      </StackPanel>

      <TextBox PlaceholderText="Search texts..." Text="{Binding Selection.SearchText}"
               AutomationProperties.Name="Search texts" />
      <ListBox x:Name="SelectionPanelTextsItems" ItemsSource="{Binding Selection.Texts}"
               MaxHeight="{DynamicResource Component.TextsPage.SelectionListHeight}"
               AutomationProperties.Name="Texts to analyze">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TextChoiceViewModel">
            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
              <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" />
              <views:CopyableTextBlock Classes="muted" Text="{Binding CountsText}"
                         Margin="{DynamicResource Component.TextsPage.CountIndent}"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding CountsText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <views:CopyableTextBlock Classes="muted" Text="{Binding Selection.TextsEmptyMessage}"
                 IsVisible="{Binding Selection.TextsEmptyMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                 TextWrapping="Wrap" />

      <Expander Header="Add words" IsExpanded="False">
        <TextBox Text="{Binding Selection.PastedWords}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="{DynamicResource Component.TextsPage.AddedWordsHeight}"
                 AutomationProperties.Name="Words to analyze, one per line" />
      </Expander>

      <Expander Header="Analysis options" IsExpanded="False">
        <StackPanel Spacing="{DynamicResource Intent.Space.Related}" Margin="{DynamicResource Intent.Gap.AfterGroup}">
          <CheckBox Content="All wordforms" IsChecked="{Binding Selection.AllWordforms}" />
          <CheckBox Content="Retry failed" IsChecked="{Binding Selection.RetryFailed}" />
          <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
            <views:CopyableTextBlock Text="Time limit per word (seconds)" />
            <NumericUpDown Value="{Binding Selection.PerWordTimeLimitSeconds}" Minimum="0.1" Increment="1"
                           FormatString="0.#" AutomationProperties.Name="Time limit per word in seconds" />
          </StackPanel>
          <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
            <views:CopyableTextBlock Text="Step limit per word" />
            <NumericUpDown Value="{Binding Selection.PerWordStepLimit}" Minimum="1" Increment="100000"
                           FormatString="N0" IsEnabled="{Binding !Selection.PerWordStepLimitUnbounded}"
                           AutomationProperties.Name="Step limit per word" />
            <CheckBox Content="No step limit" IsChecked="{Binding Selection.PerWordStepLimitUnbounded}" />
          </StackPanel>
          <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
            <views:CopyableTextBlock Text="Retry slower than (ms)" />
            <NumericUpDown Value="{Binding Selection.RetrySlowerThanMilliseconds}" Minimum="0"
                           AutomationProperties.Name="Retry slower than, in milliseconds" />
          </StackPanel>
          <views:CopyableTextBlock Classes="error" Text="{Binding Selection.StepLimitValidationMessage}"
                     IsVisible="{Binding Selection.StepLimitValidationMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
          <views:CopyableTextBlock Classes="error" Text="{Binding Selection.ThresholdValidationMessage}"
                     IsVisible="{Binding Selection.ThresholdValidationMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Expander>

      <views:RefusalBlock DataContext="{Binding Selection.ShownRefusal}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
