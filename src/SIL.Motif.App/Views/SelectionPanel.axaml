<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.SelectionPanel"
             x:DataType="views:SelectionPanel">
  <ScrollViewer Margin="{DynamicResource Component.TextsPage.PageInset}">
    <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
      <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
        <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.Texts}" FontSize="{DynamicResource Intent.Type.Section}"
                                 FontWeight="{DynamicResource Intent.Weight.Section}" />
        <views:CopyableTextBlock Classes="muted" Text="{Binding Selection.SummaryText}" TextWrapping="Wrap" />
      </StackPanel>

      <WrapPanel Orientation="Horizontal" ItemSpacing="{DynamicResource Intent.Space.Compact}"
                  IsVisible="{Binding Selection.HasTexts}">
        <Button Content="{x:Static app:MotifAppStrings.SelectAllTexts}" Command="{Binding Selection.SelectAllTextsCommand}"
                Theme="{DynamicResource BorderlessButton}" Foreground="{DynamicResource Intent.Accent}"
                AutomationProperties.Name="{x:Static app:MotifAppStrings.SelectAllTextsAccessibleName}"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.SelectAllTexts}" />
        <Button Content="{x:Static app:MotifAppStrings.Clear}" Command="{Binding Selection.ClearTextsCommand}"
                IsVisible="{Binding Selection.ShowClearTexts}"
                Theme="{DynamicResource BorderlessButton}" Foreground="{DynamicResource Intent.Accent}"
                AutomationProperties.Name="{x:Static app:MotifAppStrings.ClearAccessibleName}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ClearTexts}" />
      </WrapPanel>

      <TextBox PlaceholderText="Search texts..." Text="{Binding Selection.SearchText}"
               AutomationProperties.Name="{x:Static app:MotifAppStrings.SearchTextsAccessibleName}" />
      <ListBox x:Name="SelectionPanelTextsItems" ItemsSource="{Binding Selection.Texts}"
               MaxHeight="{DynamicResource Component.TextsPage.SelectionListHeight}"
               AutomationProperties.Name="{x:Static app:MotifAppStrings.TextsToAnalyzeAccessibleName}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TextChoiceViewModel">
            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
              <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Title}">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
              </CheckBox>
              <views:CopyableTextBlock Classes="muted" Text="{Binding CountsText}" TextWrapping="Wrap"
                         Margin="{DynamicResource Component.TextsPage.CountIndent}"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding CountsText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <views:CopyableTextBlock Classes="muted" Text="{Binding Selection.TextsEmptyMessage}"
                 IsVisible="{Binding Selection.TextsEmptyMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                 TextWrapping="Wrap" />

      <Expander Header="{x:Static app:MotifAppStrings.AddWords}" IsExpanded="False">
        <TextBox Text="{Binding Selection.PastedWords}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="{DynamicResource Component.TextsPage.AddedWordsHeight}"
                 AutomationProperties.Name="{x:Static app:MotifAppStrings.WordsToAnalyzeOnePerLineAccessibleName}" />
      </Expander>

      <Expander Header="{x:Static app:MotifAppStrings.AnalysisOptions}" IsExpanded="False">
        <StackPanel Spacing="{DynamicResource Intent.Space.Related}" Margin="{DynamicResource Intent.Gap.AfterGroup}">
          <CheckBox Content="{x:Static app:MotifAppStrings.AllWordforms}" IsChecked="{Binding Selection.AllWordforms}" />
          <CheckBox Content="{x:Static app:MotifAppStrings.RetryFailed}" IsChecked="{Binding Selection.RetryFailed}" />
          <StackPanel IsVisible="{Binding Settings.HasSavedSelection}"
                      Spacing="{DynamicResource Intent.Space.Related}">
            <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.DefaultSelectionParsingLimits}" />
            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
              <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.ParserWorkLimitPerWord}" />
              <NumericUpDown Classes="settingsNumber" Value="{Binding Settings.ParserWorkLimitValue}" Minimum="1"
                             Increment="100000" FormatString="N0" IsEnabled="{Binding !Settings.IsNoParserWorkLimit}"
                             LostFocus="OnLimitLostFocus" KeyDown="OnLimitKeyDown"
                             AutomationProperties.Name="{x:Static app:MotifAppStrings.SelectionParserWorkLimitPerWordAccessibleName}" />
              <CheckBox Content="{x:Static app:MotifAppStrings.NoParserWorkLimit}" IsChecked="{Binding Settings.IsNoParserWorkLimit}"
                        Click="OnNoParserWorkLimitClick" AutomationProperties.Name="{x:Static app:MotifAppStrings.SelectionHasNoParserWorkLimitAccessibleName}" />
              <TextBlock Classes="settingsRefusal" Text="{Binding Settings.ParserWorkLimitRefusal}"
                         IsVisible="{Binding Settings.HasParserWorkLimitRefusal}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
              <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.TimeLimitPerWordSeconds}" />
              <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource Intent.Space.Compact}"
                    HorizontalAlignment="Left">
                <NumericUpDown Classes="settingsNumber" Classes.refused="{Binding Settings.HasTimeLimitRefusal}"
                               Value="{Binding Settings.TimeLimitSeconds}" Minimum="0.001" Maximum="2147483.647"
                               Increment="0.1" FormatString="0.###" IsEnabled="{Binding Settings.IsTimeLimitEnabled}"
                               LostFocus="OnLimitLostFocus" KeyDown="OnLimitKeyDown"
                               AutomationProperties.Name="{x:Static app:MotifAppStrings.SelectionTimeLimitPerWordInAccessibleName}" />
                <Button Grid.Row="1" Classes="settingsLink" Content="{x:Static app:MotifAppStrings.UseMotifSEstimate}"
                        IsVisible="{Binding Settings.ShowUseEstimate}" Click="OnUseEstimateClick"
                        AutomationProperties.Name="{x:Static app:MotifAppStrings.UseMotifSEstimatedTimeLimitAccessibleName}" />
              </Grid>
              <TextBlock Classes="settingsCaption" Text="{Binding Settings.ParserWorkLimitEstimateText}" TextWrapping="Wrap" />
              <TextBlock Classes="settingsRefusal" Text="{Binding Settings.TimeLimitRefusal}"
                         IsVisible="{Binding Settings.HasTimeLimitRefusal}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.SaveADefaultSelectionToEdit}"
                     IsVisible="{Binding Settings.HasProjectWithoutSelection}" TextWrapping="Wrap" />
          <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
            <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.RetryWorkOverLabel}" />
            <NumericUpDown Value="{Binding Selection.RetryWorkOver}" Minimum="0" Increment="1" FormatString="N0"
                           AutomationProperties.Name="{x:Static app:MotifAppStrings.RetryWorkOverAccessibleName}" />
          </StackPanel>
          <views:CopyableTextBlock Classes="error" Text="{Binding Selection.ParserWorkLimitValidationMessage}"
                     IsVisible="{Binding Selection.ParserWorkLimitValidationMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
          <views:CopyableTextBlock Classes="error" Text="{Binding Selection.ThresholdValidationMessage}"
                     IsVisible="{Binding Selection.ThresholdValidationMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Expander>

      <views:RefusalBlock DataContext="{Binding Selection.ShownRefusal}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
