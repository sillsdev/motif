<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:controls="using:SIL.Motif.App.Controls"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ResultsInTextPanel"
             x:DataType="views:ResultsInTextPanel">
  <Grid ColumnDefinitions="*"
        Margin="{DynamicResource Component.TextsPage.ReaderInset}">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource Intent.Space.Related}">
      <DockPanel LastChildFill="True">
        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding InText.Texts}" SelectedItem="{Binding InText.SelectedText}"
                  IsVisible="{Binding InText.HasTexts}" VerticalAlignment="Center"
                  MinWidth="{DynamicResource Component.TextsPage.TextPickerWidth}"
                  MaxWidth="{DynamicResource Component.TextsPage.TextPickerMaxWidth}"
                  Margin="{DynamicResource Component.TextsPage.TextPickerGap}"
                  AutomationProperties.Name="Text to read">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ResultsTextViewModel">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button DockPanel.Dock="Right" Classes="menuButton" Content="{Binding InText.SelectMenuLabel}" VerticalAlignment="Center"
                Padding="{DynamicResource Component.TextsPage.ReaderActionPadding}"
                IsVisible="{Binding InText.HasResults}" AutomationProperties.Name="Select words for actions">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="{DynamicResource Intent.Space.Snug}"
                          MaxWidth="{DynamicResource Component.TextsPage.ActionMenuWidth}">
                <views:CopyableTextBlock Text="{Binding InText.CheckedWordCountLabel}" FontWeight="SemiBold" />
                <views:CopyableTextBlock Classes="muted" Text="{Binding InText.ScopeCountSummary}" />
                <StackPanel>
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{Binding InText.ChooseWordsLabel}" Command="{Binding InText.ChooseWordsCommand}"
                          AutomationProperties.Name="Choose words with checkboxes" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Select all" Command="{Binding InText.SelectAllWordsCommand}"
                          AutomationProperties.Name="Select all chosen word occurrences" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Content="Clear selection" Command="{Binding InText.ClearSelectedWordsCommand}"
                          IsVisible="{Binding InText.HasCheckedWords}"
                          AutomationProperties.Name="Clear selected word occurrences" />
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Intent.Space.Compact}" IsVisible="{Binding InText.HasCheckedWords}">
                  <views:CopyableTextBlock Classes="section-title" Text="For the selected words" />
                  <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="Approve one analysis at a time. Opinions apply to one word because each word has its own readings." />
                  <StackPanel>
                    <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Add readings as Unknown" Command="{Binding InText.AddParserReadingsCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
                    <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Accept the new set" Command="{Binding InText.AcceptNewSetCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
                    <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Mark Incorrect" Command="{Binding InText.MarkSpellingsIncorrectCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
                    <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Remove analyses" Command="{Binding InText.RemoveAnalysesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
                    <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Undo changes" Command="{Binding InText.UndoChangesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
                    <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Content="Check again" Command="{Binding InText.RecheckCheckedChangesCommand}"
                            IsVisible="{Binding InText.HasCheckedUncertainChanges}" />
                  </StackPanel>
                </StackPanel>
                <views:CopyableTextBlock Classes="section-title" Text="In this Text" />
                <StackPanel>
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Add readings as Unknown in this Text"
                          Command="{Binding InText.AddParserReadingsCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                          AutomationProperties.Name="Add parser readings as Unknown in this Text" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Accept new set in this Text" Command="{Binding InText.AcceptNewSetCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                          AutomationProperties.Name="Accept new set for the selected Text" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Mark spellings Incorrect in this Text"
                          Command="{Binding InText.MarkSpellingsIncorrectCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                          AutomationProperties.Name="Mark spellings Incorrect in the selected Text" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Undo changes in this Text" Command="{Binding InText.UndoChangesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                          AutomationProperties.Name="Undo changes in the selected Text" />
                </StackPanel>
                <Expander Header="{Binding InText.SelectedTextRemoveHeader}" IsVisible="{Binding InText.HasSelectedTextAnalyses}">
                  <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                    <views:CopyableTextBlock Classes="muted" Text="{Binding InText.SelectedTextRemovalPreview}" TextWrapping="Wrap" />
                    <Button Content="Stage removal from this Text" Command="{Binding InText.RemoveAnalysesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                            AutomationProperties.Name="Stage removal of the analyses used in this Text" />
                  </StackPanel>
                </Expander>
                <views:CopyableTextBlock Classes="section-title" Text="In all chosen Texts" />
                <StackPanel>
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Accept new set in Selection" Command="{Binding InText.AcceptNewSetCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.AssessmentSelection}"
                          AutomationProperties.Name="Accept new set for the Selection" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Add readings as Unknown in all chosen Texts"
                          Command="{Binding InText.AddParserReadingsCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.ChosenTexts}"
                          AutomationProperties.Name="Add parser readings as Unknown in all chosen Texts" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Mark spellings Incorrect in all chosen Texts"
                          Command="{Binding InText.MarkSpellingsIncorrectCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.ChosenTexts}"
                          AutomationProperties.Name="Mark spellings Incorrect in all chosen Texts" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Undo changes in all chosen Texts" Command="{Binding InText.UndoChangesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.ChosenTexts}"
                          AutomationProperties.Name="Undo changes in all chosen Texts" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="Check again" Command="{Binding InText.RecheckChangesCommand}"
                          AutomationProperties.Name="Check uncertain changes again" />
                </StackPanel>
                <Expander Header="{Binding InText.ChosenTextsRemoveHeader}" IsVisible="{Binding InText.HasChosenTextAnalyses}">
                  <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                    <views:CopyableTextBlock Classes="muted" Text="{Binding InText.ChosenTextsRemovalPreview}" TextWrapping="Wrap" />
                    <Button Content="Stage removal from all chosen Texts" Command="{Binding InText.RemoveAnalysesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.ChosenTexts}"
                            AutomationProperties.Name="Stage removal of the analyses used in all chosen Texts" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button DockPanel.Dock="Right" Classes="menuButton" Content="Read ▾" VerticalAlignment="Center"
                Margin="{DynamicResource Component.TextsPage.ReaderActionGap}"
                Padding="{DynamicResource Component.TextsPage.ReaderActionPadding}"
                IsVisible="{Binding InText.HasResults}" AutomationProperties.Name="Mark read or unread">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Classes="menu">
                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Content="Mark this Text as read" Command="{Binding InText.MarkTextReadCommand}"
                        AutomationProperties.Name="Mark the selected Text as read" />
                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Content="Mark this Text as unread" Command="{Binding InText.MarkTextUnreadCommand}"
                        AutomationProperties.Name="Mark the selected Text as unread" />
                <StackPanel Spacing="{DynamicResource Intent.Space.Compact}"
                            IsVisible="{Binding InText.HasSelectedReadStateOccurrences}">
                  <views:CopyableTextBlock Classes="muted" Text="{Binding InText.CheckedWordCountLabel}"
                                           AutomationProperties.Name="Selected occurrence count" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Content="Mark selected as read" Command="{Binding InText.MarkSelectionReadCommand}"
                          AutomationProperties.Name="Mark selected occurrences as read" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Content="Mark selected as unread" Command="{Binding InText.MarkSelectionUnreadCommand}"
                          AutomationProperties.Name="Mark selected occurrences as unread" />
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <ScrollViewer VerticalAlignment="Center" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled" IsVisible="{Binding InText.HasResults}">
          <WrapPanel>
          <views:FilterChip Classes="compact" Label="All" Count="{Binding InText.AllCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.All}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.All}" />
          <views:FilterChip Classes="compact" Label="Unread" Count="{Binding InText.UnreadCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.Unread}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.Unread}" />
          <views:FilterChip Classes="compact" Label="Differs" Count="{Binding InText.DiffersCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.Differs}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.Differs}" />
          <views:FilterChip Classes="compact" Label="Not in FieldWorks" Count="{Binding InText.NewCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.New}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.New}" />
          <views:FilterChip Classes="compact" Label="No parse" Count="{Binding InText.NoParseCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.NoParse}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.NoParse}" />
          <views:FilterChip Classes="compact" Label="Stopped" Count="{Binding InText.LimitCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.Limit}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.Limit}" />
          <views:FilterChip Classes="compact" Label="Not parsed" Count="{Binding InText.NotAssessedCount}"
                            IsVisible="{Binding InText.HasNotAssessed}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.NotAssessed}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.NotAssessed}" />
          <views:FilterChip Classes="compact" Label="Named in a warning" Count="{Binding InText.NamedInWarningCount}"
                            IsVisible="{Binding InText.HasWarningEvidence}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.NamedInWarning}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.NamedInWarning}" />
          </WrapPanel>
        </ScrollViewer>
      </DockPanel>

      <StackPanel Grid.Row="1" Spacing="{DynamicResource Intent.Space.Snug}">
        <views:RefusalBlock DataContext="{Binding InText.ReadStateRefusal}" />
        <views:CopyableTextBlock Classes="muted" Text="{Binding InText.ReadStateNotice}" TextWrapping="Wrap"
                                 IsVisible="{Binding InText.HasReadStateNotice}" />
        <views:CopyableTextBlock Classes="muted" Text="{Binding InText.Changes.CollectionNotice}" TextWrapping="Wrap"
                                 IsVisible="{Binding InText.Changes.CollectionNotice, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
      </StackPanel>
      <StackPanel Grid.Row="2" Spacing="{DynamicResource Intent.Space.Related}"
                  Margin="{DynamicResource Component.TextsPage.EmptyStateMargin}"
                  IsVisible="{Binding InText.HasMessage}">
        <views:CopyableTextBlock Classes="muted" Text="{Binding InText.Message}" TextWrapping="Wrap" />
        <Button Content="Choose texts" HorizontalAlignment="Left" IsVisible="{Binding InText.NeedsTexts}"
                Click="OnGoToTextsClick" AutomationProperties.Name="Choose texts to analyze" />
      </StackPanel>
      <ScrollViewer Grid.Row="2" IsVisible="{Binding InText.HasLines}">
        <ItemsControl ItemsSource="{Binding InText.VisibleLines}" AutomationProperties.Name="Text lines and parser results">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ResultsLineViewModel">
              <StackPanel Margin="{DynamicResource Component.TextsPage.LineMargin}">
              <StackPanel Classes="lineHead" Orientation="Horizontal">
                <views:CopyableTextBlock Classes="lineNumber" Text="{Binding Number}" />
                <views:CopyableTextBlock Classes="lineSentence" Text="{Binding Sentence}" />
                <views:CopyableTextBlock Classes="lineSentence" Text="{Binding NeedsALookSummary}" />
              </StackPanel>
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Classes="gutter stripRows">
                  <TextBlock Classes="gutterLabel wordRow" Text="Word" />
                  <TextBlock Classes="gutterLabel analysisRow" Text="FieldWorks" />
                  <TextBlock Classes="gutterLabel analysisRow" Text="PanGloss" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Tokens}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultsTokenViewModel">
                      <Border x:Name="WordStrip" IsVisible="{Binding IsWord}" Classes="wordStrip hoverReveal"
                              Classes.open="{Binding IsCardOpen}" Classes.uncertainChanged="{Binding IsUncertainChanged}"
                              Classes.dimmed="{Binding IsDimmed}" Focusable="True" Tag="{Binding}"
                              AutomationProperties.AutomationId="{Binding StripAutomationId}"
                              KeyDown="OnTokenKeyDown" ToolTip.Tip="{Binding HoverSummary}" views:ClearTipPlacement.IsEnabled="True">
                        <StackPanel Orientation="Horizontal">
                          <StackPanel Classes="stripStack stripRows" Tag="{Binding}" PointerPressed="OnTokenPressed">
                            <StackPanel Classes="stripWordRow wordRow" Orientation="Horizontal">
                              <CheckBox Classes="stripCheck" IsChecked="{Binding IsSelectedForActions}"
                                        IsVisible="{Binding $parent[views:ResultsInTextPanel].InText.ShowWordCheckboxes}"
                                        AutomationProperties.Name="{Binding SelectionAutomationName}" />
                              <controls:UnreadMark Classes.dotOnly="True" IsVisible="{Binding ShowUnread}"
                                                   VerticalAlignment="Center"
                                                   AutomationProperties.AutomationId="{Binding UnreadAutomationId}" />
                              <views:CopyableTextBlock Classes="stripWord" Text="{Binding Text}" VerticalAlignment="Center"
                                                       AutomationProperties.AutomationId="{Binding WordAutomationId}" />
                              <TextBlock Classes="warningMark" Text="{Binding WarningMarkLabel}"
                                         IsVisible="{Binding HasNamedWarning}"
                                         AutomationProperties.Name="{Binding WarningMarkLabel, StringFormat='Named in {0}'}" />
                              <controls:OpinionMark Kind="{Binding PrimaryOpinionMarkKind}" VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="{Binding OpinionMarkAutomationId}" />
                              <views:MarkChip Mark="{Binding DisapprovedMark}" Text="{Binding DisapprovedLabel}" Compact="True"
                                              IsVisible="{Binding HasDisapprovedReading}" ToolTip.Tip="{Binding DisapprovedTip}"
                                              views:ClearTipPlacement.IsEnabled="True"
                                              AutomationProperties.AutomationId="{Binding DisapprovedAutomationId}" />
                            </StackPanel>
                            <Border Classes="stripRow stripFieldWorks analysisRow"
                                    AutomationProperties.AutomationId="{Binding FieldWorksAutomationId}">
                              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}">
                                <ItemsControl ItemsSource="{Binding WarningMarkedFieldWorksMorphs}" IsVisible="{Binding HasFieldWorksAnalyses}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Classes="stripMorphs" Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ResultsStripMorphViewModel">
                                      <StackPanel>
                                        <Border Classes="warningMorphUnderline" Classes.named="{Binding IsNamedInWarning}">
                                          <TextBlock Classes="stripMorphForm" Text="{Binding Form}" />
                                        </Border>
                                        <TextBlock Classes="stripMorphGloss" Text="{Binding GlossOrPlaceholder}" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Classes="panGlossExtra" VerticalAlignment="Top" IsVisible="{Binding HasMoreFieldWorksAnalyses}">
                                  <TextBlock Text="{Binding MoreFieldWorksLabel}" />
                                </Border>
                                <TextBlock Classes="stripNothing" Text="Nothing in FieldWorks" IsVisible="{Binding HasNothingStored}" />
                              </StackPanel>
                            </Border>
                            <Border Classes="stripRow panGlossLine analysisRow" AutomationProperties.AutomationId="{Binding PanGlossAutomationId}"
                                    Classes.same="{Binding IsPanGlossSame}"
                                    Classes.different="{Binding IsPanGlossDifferent}" Classes.none="{Binding IsPanGlossNone}"
                                    Classes.capped="{Binding IsPanGlossCapped}">
                              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}">
                                <ItemsControl ItemsSource="{Binding PanGlossReadingMorphs}" IsVisible="{Binding ShowsPanGlossReading}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Classes="stripMorphs" Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ParserReadingMorphViewModel">
                                      <StackPanel>
                                        <TextBlock Classes="stripMorphForm f" Text="{Binding Form}" />
                                        <TextBlock Classes="stripMorphGloss" Text="{Binding GlossOrPlaceholder}" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Classes="panGlossExtra" VerticalAlignment="Top" IsVisible="{Binding HasMorePanGlossReadings}">
                                  <TextBlock Text="{Binding MorePanGlossLabel}" />
                                </Border>
                                <TextBlock Classes="f stripNote" Text="{Binding PanGlossNote}" IsVisible="{Binding ShowsPanGlossNote}" />
                              </StackPanel>
                            </Border>
                          </StackPanel>
                          <Border Classes="stripActions" IsVisible="{Binding ShowsActions}">
                            <StackPanel Classes="stripRows">
                              <StackPanel Classes="wordRow stripActionRow" Orientation="Horizontal">
                              <Button Classes="actionChip primary" Content="{Binding PrimaryActionLabel}" VerticalAlignment="Center"
                                      Command="{Binding $parent[views:ResultsInTextPanel].InText.StagePrimaryMarkingActionForTokenCommand}"
                                      CommandParameter="{Binding}" IsVisible="{Binding HasPrimaryAction}"
                                      AutomationProperties.AutomationId="{Binding PrimaryActionAutomationId}"
                                      AutomationProperties.Name="{Binding Marking.PrimaryAction.Label, StringFormat='Choose {0} for this word'}" />
                              <Button Classes="actionChip fix revealOnHover" Content="Fix ▾" AutomationProperties.Name="Fix actions from the word strip"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="{Binding FixAutomationId}">
                                <Button.Flyout>
                                  <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Classes="menu">
                                      <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                              Command="{Binding Actions.AddChangeCommand}"
                                              CommandParameter="incorrect-spelling" AutomationProperties.Name="Mark this spelling Incorrect">
                                        <TextBlock Classes="menuTitle" Text="Incorrect spelling" />
                                      </Button>
                                      <ItemsControl ItemsSource="{Binding Marking.FixChoices}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="vm:AnalysisMarkingChoice">
                                            <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.StageMarkingChoiceForTokenCommand}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}">
                                              <StackPanel>
                                                <TextBlock Classes="menuTitle" Text="{Binding Label}" />
                                                <TextBlock Classes="menuDetail" Text="{Binding Subtitle}"
                                                           IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                              </StackPanel>
                                            </Button>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                    </StackPanel>
                                  </Flyout>
                                </Button.Flyout>
                              </Button>
                              </StackPanel>
                            </StackPanel>
                          </Border>
                          <ItemsControl ItemsSource="{Binding StagedChanges}" IsVisible="{Binding HasStagedChanges}"
                                        AutomationProperties.AutomationId="{Binding StagedAutomationId}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:StagedMarkingDisplayViewModel">
                                <Border Classes="stagedStrip hoverReveal" ToolTip.Tip="{Binding FitStatus}">
                                  <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}" VerticalAlignment="Center">
                                    <TextBlock Classes="stagedLabel" Text="Staged" />
                                    <TextBlock Text="{Binding Transition}" TextWrapping="Wrap" />
                                    <Button Classes="revealControl revealButton revealOnHover" Content="Undo"
                                            Command="{Binding $parent[views:ResultsInTextPanel].InText.Changes.RemoveCommand}"
                                            CommandParameter="{Binding Change}"
                                            AutomationProperties.Name="{Binding Change.UndoAutomationName}" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
              <ContentControl Content="{Binding OpenCard}" IsVisible="{Binding HasOpenCard}"
                              Margin="{DynamicResource Component.TextsPage.CardIndent}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:ResultsTokenViewModel">
                    <Border Classes="card wordCard" Focusable="True" KeyDown="OnTokenCardKeyDown"
                            views:InspectLink.From="{Binding Text}"
                            AutomationProperties.Name="{Binding Text, StringFormat='Word card for {0}'}">
                      <StackPanel>
                        <Border Classes="wordCardHead hoverReveal">
                          <DockPanel LastChildFill="False">
                            <views:CopyableTextBlock Text="{Binding Text}" FontWeight="Bold" VerticalAlignment="Center" />
                            <controls:OpinionMark Kind="{Binding PrimaryOpinionMarkKind}" VerticalAlignment="Center"
                                                  Margin="{DynamicResource Component.TextsPage.ShortLabelMargin}" />
                            <views:CopyableTextBlock Classes="muted" Text="{Binding Location}" VerticalAlignment="Center" />
                            <views:CopyableTextBlock Classes="muted" Text="{Binding PendingChangeStatus, StringFormat='· {0}'}"
                                                     IsVisible="{Binding IsPending}" VerticalAlignment="Center"
                                                     Margin="{DynamicResource Component.TextsPage.ShortLabelMargin}" />
                            <Button DockPanel.Dock="Right" Classes="wordCardClose" Content="×" Click="OnCloseCardClick"
                                    AutomationProperties.Name="Close the word card" />
                            <views:CopyableTextBlock DockPanel.Dock="Right" Classes="muted" VerticalAlignment="Center"
                                                     Text="Esc closes · ← → next word"
                                                     Margin="{DynamicResource Component.TextsPage.ShortLabelMargin}" />
                            <HyperlinkButton DockPanel.Dock="Right" Classes="revealControl revealLink revealOnHover" Content="{Binding WordLinkText}"
                                             NavigateUri="{Binding WordLink}" IsVisible="{Binding HasWordLink}"
                                             VerticalAlignment="Center" AutomationProperties.Name="{Binding WordLinkName}" />
                          </DockPanel>
                        </Border>
                        <Border Classes="wordCardSection hoverReveal">
                          <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                            <views:CopyableTextBlock Classes="wordCardHeading" Text="In FieldWorks · now" />
                            <views:CopyableTextBlock Classes="muted" Text="Nothing in FieldWorks for this word."
                                                     IsVisible="{Binding HasNothingStored}" />
                            <ItemsControl ItemsSource="{Binding FieldWorksAnalyses}" IsVisible="{Binding HasFieldWorksAnalyses}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FieldWorksAnalysisDisplayViewModel">
                                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                                    <views:MorphemeRow Morphs="{Binding Morphs}" ShowCategory="False" RevealLinks="True" />
                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}"
                                                VerticalAlignment="Top">
                                      <controls:OpinionMark Kind="{Binding OpinionMarkKind}" ToolTip.Tip="{Binding OpinionLabel}" />
                                      <views:CopyableTextBlock Text="{Binding OpinionLabel}" FontWeight="SemiBold" />
                                    </StackPanel>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                        <Border Classes="wordCardSection hoverReveal">
                          <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                            <views:CopyableTextBlock Classes="wordCardHeading" Text="In PanGloss · now" />
                            <Border Classes="panGlossLine" Classes.same="{Binding IsPanGlossSame}"
                                    Classes.different="{Binding IsPanGlossDifferent}" Classes.none="{Binding IsPanGlossNone}"
                                    Classes.capped="{Binding IsPanGlossCapped}">
                              <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                <DockPanel LastChildFill="False">
                                  <views:CopyableTextBlock Classes="f" Text="{Binding PanGlossSummary}" />
                                  <Button DockPanel.Dock="Right" Classes="revealControl revealLink revealOnHover" Content="PanGloss help"
                                          Command="{Binding Actions.OpenPanGlossGuideCommand}"
                                          AutomationProperties.Name="About PanGloss" />
                                </DockPanel>
                                <views:CopyableTextBlock Classes="hint" Text="{Binding ComparisonDetail}"
                                                         IsVisible="{Binding HasComparisonDetail}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Readings}" IsVisible="{Binding HasReadings}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ResultsReadingViewModel">
                                      <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                        <views:CopyableTextBlock Text="{Binding Text}" />
                                        <views:MorphemeRow Morphs="{Binding Morphs}" ShowCategory="False" RevealLinks="True" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </Border>
                        <Border Classes="wordCardSection hoverReveal" IsVisible="{Binding HasWhySection}">
                          <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                            <views:CopyableTextBlock Classes="wordCardHeading" Text="Why it might not parse" />
                            <views:CopyableTextBlock Classes="muted" Text="No stored warning names this word."
                                                     IsVisible="{Binding HasNoNamedWarning}" />
                            <ItemsControl ItemsSource="{Binding NamedWarningDetails}" IsVisible="{Binding HasNamedWarning}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NamedWarningCardViewModel">
                                  <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                    <DockPanel LastChildFill="True">
                                      <Button DockPanel.Dock="Right" Classes="revealControl revealLink revealOnHover"
                                              Content="Open the warning" Command="{Binding $parent[ItemsControl].DataContext.Actions.OpenWarningsCommand}"
                                              AutomationProperties.Name="Open the grammar warning" />
                                      <views:CopyableTextBlock Classes="wordCardHeading" Text="{Binding Message}"
                                                               TextWrapping="Wrap" />
                                    </DockPanel>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <views:CopyableTextBlock Classes="muted" Text="Named exactly"
                                                     IsVisible="{Binding HasNamedWarning}" />
                            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}"
                                        IsVisible="{Binding HasOtherWordsUsingMorpheme}">
                              <views:CopyableTextBlock Classes="muted" Text="Other words using this morpheme" />
                              <views:CopyableTextBlock Text="{Binding OtherWordsUsingMorphemeLabel}"
                                                       TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}"
                                        IsVisible="{Binding HasWarningCandidates}">
                              <ItemsControl ItemsSource="{Binding MembershipCandidateWarnings}"
                                            IsVisible="{Binding HasMembershipCandidateWarnings}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:WarningCandidateViewModel">
                                    <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                      <views:CopyableTextBlock Classes="muted" Text="{Binding MembershipLabel}" />
                                      <views:CopyableTextBlock Text="{Binding WordsLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <ItemsControl ItemsSource="{Binding SpellingCandidateWarnings}"
                                            IsVisible="{Binding HasSpellingCandidateWarnings}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:WarningCandidateViewModel">
                                    <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                      <views:CopyableTextBlock Classes="muted" Text="{Binding SpellingLabel}" />
                                      <views:CopyableTextBlock Text="{Binding WordsLabel}" TextWrapping="Wrap" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                              <views:CopyableTextBlock Classes="muted" Text="This word's rule timing share" />
                              <ItemsControl ItemsSource="{Binding TimingShares}" IsVisible="{Binding HasTimingShares}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:TimingShareViewModel">
                                    <DockPanel LastChildFill="False">
                                      <views:CopyableTextBlock Text="{Binding Name}" />
                                      <views:CopyableTextBlock DockPanel.Dock="Right" Text="{Binding ShareLabel}" />
                                    </DockPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <views:CopyableTextBlock Classes="muted" Text="{Binding NotAttributedShareLabel}" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                        <Border Classes="wordCardSection last">
                          <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
                            <views:CopyableTextBlock Classes="wordCardHeading" Text="What to do" />
                            <WrapPanel>
                              <Button Classes="wordCardAction primary" Content="{Binding Marking.PrimaryAction.Label, StringFormat='✓ {0}'}"
                                      Command="{Binding Actions.StagePrimaryMarkingActionForTokenCommand}" CommandParameter="{Binding}"
                                      IsVisible="{Binding HasPrimaryAction}"
                                      AutomationProperties.Name="{Binding Marking.PrimaryAction.Label, StringFormat='Choose {0} for this word'}" />
                              <Button Classes="wordCardAction" Content="Fix ▾" AutomationProperties.Name="Fix actions for this word">
                                <Button.Flyout>
                                  <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Classes="menu">
                                      <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                              Command="{Binding Actions.AddChangeCommand}"
                                              CommandParameter="incorrect-spelling" AutomationProperties.Name="Mark this spelling Incorrect">
                                        <TextBlock Classes="menuTitle" Text="Incorrect spelling" />
                                      </Button>
                                      <ItemsControl ItemsSource="{Binding Marking.FixChoices}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="vm:AnalysisMarkingChoice">
                                            <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.Actions.StageMarkingChoiceCommand}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}">
                                              <StackPanel>
                                                <TextBlock Classes="menuTitle" Text="{Binding Label}" />
                                                <TextBlock Classes="menuDetail" Text="{Binding Subtitle}"
                                                           IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                              </StackPanel>
                                            </Button>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                    </StackPanel>
                                  </Flyout>
                                </Button.Flyout>
                              </Button>
                              <Button Classes="wordCardAction" Content="Try this word" Command="{Binding Actions.TryWordCommand}" />
                              <Button Classes="wordCardAction" Content="Mark as unread" Command="{Binding Actions.MarkTokenUnreadCommand}"
                                      CommandParameter="{Binding}" AutomationProperties.Name="Mark this occurrence as unread" />
                              <Button Classes="wordCardAction" Content="Check again" Command="{Binding Actions.RecheckChangesCommand}"
                                      IsVisible="{Binding Marking.IsUncertain}" AutomationProperties.Name="Check this uncertain change again" />
                            </WrapPanel>
                            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}" IsVisible="{Binding HasReadings}">
                              <views:CopyableTextBlock Classes="muted" Text="Approve one analysis at a time." />
                              <ComboBox ItemsSource="{Binding Readings}" SelectedItem="{Binding SelectedReading}"
                                        AutomationProperties.Name="Choose a PanGloss reading for this word">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ResultsReadingViewModel">
                                    <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Snug}">
                                        <views:CopyableTextBlock Text="{Binding Text}" />
                                        <views:CopyableTextBlock Classes="muted" Text="{Binding GradeLabel}" IsVisible="{Binding HasGrade}" />
                                        <views:CopyableTextBlock Classes="muted" Text="(stored here)" IsVisible="{Binding IsStoredHere}" />
                                      </StackPanel>
                                      <views:MorphemeRow Morphs="{Binding Morphs}" IsVisible="{Binding HasMorphs}"
                                                         ShowCategory="False" RevealLinks="True" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

  </Grid>
</UserControl>
