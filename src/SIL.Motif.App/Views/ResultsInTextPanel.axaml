<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:controls="using:SIL.Motif.App.Controls"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ResultsInTextPanel"
             x:DataType="views:ResultsInTextPanel">
  <Grid ColumnDefinitions="*"
        Margin="{DynamicResource Component.TextsPage.PageInset}">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource Intent.Space.Related}">
      <ComboBox ItemsSource="{Binding InText.Texts}" SelectedItem="{Binding InText.SelectedText}"
                IsVisible="{Binding InText.HasAssessment}"
                MinWidth="{DynamicResource Component.TextsPage.SelectionPanelWidth}"
                AutomationProperties.Name="Text to read">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ResultsTextViewModel"><TextBlock Text="{Binding Title}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <StackPanel Grid.Row="1" Spacing="{DynamicResource Intent.Space.Snug}" IsVisible="{Binding InText.HasResults}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Snug}">
          <TextBlock Text="{Binding InText.SelectedReadStateCount}" IsVisible="{Binding InText.HasSelectedReadStateOccurrences}"
                     AutomationProperties.Name="Selected occurrence count" />
          <Button Content="Mark selected as read" Command="{Binding InText.MarkSelectionReadCommand}"
                  IsVisible="{Binding InText.HasSelectedReadStateOccurrences}"
                  AutomationProperties.Name="Mark selected occurrences as read" />
          <Button Content="Mark selected as unread" Command="{Binding InText.MarkSelectionUnreadCommand}"
                  IsVisible="{Binding InText.HasSelectedReadStateOccurrences}"
                  AutomationProperties.Name="Mark selected occurrences as unread" />
          <Button Content="Mark this Text as read" Command="{Binding InText.MarkTextReadCommand}"
                  IsVisible="{Binding InText.HasAssessment}"
                  AutomationProperties.Name="Mark the selected Text as read" />
          <Button Content="Mark this Text as unread" Command="{Binding InText.MarkTextUnreadCommand}"
                  IsVisible="{Binding InText.HasAssessment}"
                  AutomationProperties.Name="Mark the selected Text as unread" />
        </StackPanel>
        <StackPanel Spacing="{DynamicResource Intent.Space.Snug}" IsVisible="{Binding InText.HasResults}">
        <WrapPanel>
          <views:FilterChip Label="All occurrences" Count="{Binding InText.AllCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.All}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.All}" />
          <views:FilterChip Label="Unread" Count="{Binding InText.UnreadCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.Unread}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.Unread}" />
          <views:FilterChip Label="Needs a look" Count="{Binding InText.NeedsALookCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.NeedsALook}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.NeedsALook}" />
          <views:FilterChip Label="Differs from stored" Count="{Binding InText.DiffersCount}" Verdict="Differs"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.Differs}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.Differs}" />
          <views:FilterChip Label="Not present" Count="{Binding InText.NewCount}" Verdict="New"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.New}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.New}" />
          <views:FilterChip Label="No parse" Count="{Binding InText.NoParseCount}" Verdict="NoResult"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.NoParse}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.NoParse}" />
          <views:FilterChip Label="Matches" Count="{Binding InText.MatchesCount}" Verdict="Agrees"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.Matches}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.Matches}" />
          <views:FilterChip Label="Stopped at a limit" Count="{Binding InText.LimitCount}" Verdict="Limit"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.Limit}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.Limit}" />
          <views:FilterChip Label="Skipped or not assessed" Count="{Binding InText.NotAssessedCount}"
                            IsVisible="{Binding InText.HasNotAssessed}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.NotAssessed}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.NotAssessed}" />
        </WrapPanel>
        <Expander Header="Actions by scope">
          <WrapPanel>
            <Button Content="Add readings as Unknown in this Text"
                    Command="{Binding InText.AddParserReadingsCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                    AutomationProperties.Name="Add parser readings as Unknown in this Text" />
            <Button Content="Accept new set in this Text" Command="{Binding InText.AcceptNewSetCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                    AutomationProperties.Name="Accept new set for the selected Text" />
            <Button Content="Mark spellings Incorrect in this Text"
                    Command="{Binding InText.MarkSpellingsIncorrectCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                    AutomationProperties.Name="Mark spellings Incorrect in the selected Text" />
            <Button Content="Accept new set in Selection" Command="{Binding InText.AcceptNewSetCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.AssessmentSelection}"
                    AutomationProperties.Name="Accept new set for the Selection" />
            <Button Content="Add readings as Unknown in all chosen Texts"
                    Command="{Binding InText.AddParserReadingsCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.ChosenTexts}"
                    AutomationProperties.Name="Add parser readings as Unknown in all chosen Texts" />
            <Button Content="Mark spellings Incorrect in all chosen Texts"
                    Command="{Binding InText.MarkSpellingsIncorrectCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.ChosenTexts}"
                    AutomationProperties.Name="Mark spellings Incorrect in all chosen Texts" />
            <Expander Header="{Binding InText.SelectedTextRemoveHeader}" IsVisible="{Binding InText.HasSelectedTextAnalyses}">
              <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                <views:CopyableTextBlock Classes="muted" Text="{Binding InText.SelectedTextRemovalPreview}" TextWrapping="Wrap" />
                <Button Content="Stage removal from this Text" Command="{Binding InText.RemoveAnalysesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                        AutomationProperties.Name="Stage removal of the analyses used in this Text" />
              </StackPanel>
            </Expander>
            <Expander Header="{Binding InText.ChosenTextsRemoveHeader}" IsVisible="{Binding InText.HasChosenTextAnalyses}">
              <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                <views:CopyableTextBlock Classes="muted" Text="{Binding InText.ChosenTextsRemovalPreview}" TextWrapping="Wrap" />
                <Button Content="Stage removal from all chosen Texts" Command="{Binding InText.RemoveAnalysesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.ChosenTexts}"
                        AutomationProperties.Name="Stage removal of the analyses used in all chosen Texts" />
              </StackPanel>
            </Expander>
            <Button Content="Undo changes in this Text" Command="{Binding InText.UndoChangesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                    AutomationProperties.Name="Undo changes in the selected Text" />
            <Button Content="Undo changes in all chosen Texts" Command="{Binding InText.UndoChangesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.ChosenTexts}"
                    AutomationProperties.Name="Undo changes in all chosen Texts" />
            <Button Content="Check again" Command="{Binding InText.RecheckChangesCommand}"
                    AutomationProperties.Name="Check uncertain changes again" />
          </WrapPanel>
        </Expander>
        <StackPanel Spacing="{DynamicResource Intent.Space.Snug}" IsVisible="{Binding InText.HasResults}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Snug}">
            <views:CopyableTextBlock Text="{Binding InText.CheckedWordCountLabel}" FontWeight="SemiBold" />
            <Button Content="Select all" Command="{Binding InText.SelectAllWordsCommand}"
                    AutomationProperties.Name="Select all chosen word occurrences" />
            <Button Content="Clear selection" Command="{Binding InText.ClearSelectedWordsCommand}"
                    IsVisible="{Binding InText.HasCheckedWords}"
                    AutomationProperties.Name="Clear selected word occurrences" />
          </StackPanel>
          <views:CopyableTextBlock Classes="muted" Text="Approve one analysis at a time. Opinions apply to one word because each word has its own readings."
                                   IsVisible="{Binding InText.HasCheckedWords}" TextWrapping="Wrap" />
          <views:CopyableTextBlock Classes="muted" Text="{Binding InText.ScopeCountSummary}" />
          <WrapPanel IsVisible="{Binding InText.HasCheckedWords}">
            <Button Content="Add readings as Unknown" Command="{Binding InText.AddParserReadingsCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
            <Button Content="Accept the new set" Command="{Binding InText.AcceptNewSetCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
            <Button Content="Mark Incorrect" Command="{Binding InText.MarkSpellingsIncorrectCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
            <Button Content="Remove analyses" Command="{Binding InText.RemoveAnalysesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
            <Button Content="Undo changes" Command="{Binding InText.UndoChangesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
            <Button Content="Check again" Command="{Binding InText.RecheckCheckedChangesCommand}"
                    IsVisible="{Binding InText.HasCheckedUncertainChanges}" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="2" Spacing="{DynamicResource Intent.Space.Snug}">
        <views:RefusalBlock DataContext="{Binding InText.ReadStateRefusal}" />
        <views:CopyableTextBlock Classes="muted" Text="{Binding InText.ReadStateNotice}" TextWrapping="Wrap"
                                 IsVisible="{Binding InText.HasReadStateNotice}" />
        <views:CopyableTextBlock Classes="muted" Text="{Binding InText.Changes.CollectionNotice}" TextWrapping="Wrap"
                                 IsVisible="{Binding InText.Changes.CollectionNotice, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
      </StackPanel>
      <StackPanel Grid.Row="3" Spacing="{DynamicResource Intent.Space.Related}"
                  Margin="{DynamicResource Component.TextsPage.EmptyStateMargin}"
                  IsVisible="{Binding InText.HasMessage}">
        <views:CopyableTextBlock Classes="muted" Text="{Binding InText.Message}" TextWrapping="Wrap" />
        <Button Content="Choose texts" HorizontalAlignment="Left" IsVisible="{Binding InText.NeedsTexts}"
                Click="OnGoToTextsClick" AutomationProperties.Name="Choose texts to analyze" />
      </StackPanel>
      <ScrollViewer Grid.Row="3" IsVisible="{Binding InText.HasResults}">
        <ItemsControl ItemsSource="{Binding InText.VisibleLines}" AutomationProperties.Name="Text lines and parser results">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ResultsLineViewModel">
              <DockPanel Margin="{DynamicResource Component.TextsPage.LineMargin}" LastChildFill="True">
                <views:CopyableTextBlock DockPanel.Dock="Left" Classes="muted" Text="{Binding Number}"
                                         Width="{DynamicResource Component.TextsPage.ReaderLineNumberWidth}" />
                <ItemsControl ItemsSource="{Binding Tokens}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultsTokenViewModel">
                      <Panel Margin="{DynamicResource Component.TextsPage.WordGap}">
                        <views:CopyableTextBlock Text="{Binding Text}" IsVisible="{Binding !IsWord}" FontSize="{DynamicResource Intent.Type.Brand}" />
                        <Border x:Name="WordStrip" IsVisible="{Binding IsWord}" Classes="wordVerdict analysisDensity hoverReveal" Classes.uncertainChanged="{Binding IsUncertainChanged}" Focusable="True" Tag="{Binding}"
                                views:VerdictClasses.Verdict="{Binding Meaning}" Classes.dimmed="{Binding IsDimmed}"
                                AutomationProperties.AutomationId="{Binding StripAutomationId}"
                                KeyDown="OnTokenKeyDown"
                                ToolTip.Tip="{Binding HoverSummary}">
                          <StackPanel Classes="analysisDensity" Spacing="{DynamicResource Intent.Space.Minimal}">
                            <DockPanel LastChildFill="False">
                              <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelectedForActions}"
                                        AutomationProperties.Name="{Binding SelectionAutomationName}" />
                              <controls:OpinionMark DockPanel.Dock="Left" Kind="{Binding PrimaryOpinionMarkKind}"
                                                     AutomationProperties.AutomationId="{Binding OpinionMarkAutomationId}"
                                                     Margin="{DynamicResource Component.TextsPage.ShortLabelMargin}" />
                              <views:CopyableTextBlock DockPanel.Dock="Left" Text="{Binding Text}" Tag="{Binding}"
                                                       PointerPressed="OnTokenPressed"
                                                       AutomationProperties.AutomationId="{Binding WordAutomationId}"
                                                       FontSize="{DynamicResource Intent.Type.Brand}" FontWeight="SemiBold" />
                              <controls:UnreadMark DockPanel.Dock="Right" IsVisible="{Binding Marking.IsUnread}"
                                                   AutomationProperties.AutomationId="{Binding UnreadAutomationId}" />
                              <Border DockPanel.Dock="Left" Classes="verdictChip differs compact"
                                      Margin="{DynamicResource Component.TextsPage.ShortLabelMargin}"
                                      IsVisible="{Binding HasDisapprovedReading}" ToolTip.Tip="{Binding DisapprovedTip}"
                                      AutomationProperties.AutomationId="{Binding DisapprovedAutomationId}">
                                <views:CopyableTextBlock Text="!" />
                              </Border>
                              <HyperlinkButton DockPanel.Dock="Left" Classes="revealControl revealLink" Content="FW ↗"
                                               NavigateUri="{Binding WordLink}" IsVisible="{Binding HasWordLink}"
                                               AutomationProperties.Name="{Binding WordLinkName}" />
                              <Button DockPanel.Dock="Right" Classes="actionChip" Content="{Binding Marking.PrimaryAction.Label}"
                                      Command="{Binding $parent[views:ResultsInTextPanel].InText.StagePrimaryMarkingActionForTokenCommand}"
                                      CommandParameter="{Binding}" IsVisible="{Binding HasPrimaryAction}"
                                      AutomationProperties.AutomationId="{Binding PrimaryActionAutomationId}"
                                      AutomationProperties.Name="{Binding Marking.PrimaryAction.Label, StringFormat='Choose {0} for this word'}" />
                              <Expander DockPanel.Dock="Right" Header="Fix ▾" AutomationProperties.Name="Fix actions from the word strip"
                                        AutomationProperties.AutomationId="{Binding FixAutomationId}">
                                <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                  <Button Content="Incorrect spelling" Command="{Binding Actions.AddChangeCommand}"
                                          CommandParameter="incorrect-spelling" AutomationProperties.Name="Mark this spelling Incorrect" />
                                  <ItemsControl ItemsSource="{Binding Marking.FixChoices}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="vm:AnalysisMarkingChoice">
                                        <Button Content="{Binding Label}"
                                                Command="{Binding $parent[ItemsControl].DataContext.StageMarkingChoiceForTokenCommand}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Expander>
                            <Ellipse DockPanel.Dock="Right" Width="{DynamicResource Component.MatrixCell.MarkerSize}"
                                     Height="{DynamicResource Component.MatrixCell.MarkerSize}"
                                       Fill="{DynamicResource Intent.Warning.Text}"
                                       Margin="{DynamicResource Component.TextsPage.ShortLabelMargin}"
                                       IsVisible="{Binding IsPending}" ToolTip.Tip="{Binding PendingChangeStatus}" />
                            </DockPanel>
                            <StackPanel AutomationProperties.AutomationId="{Binding FieldWorksAutomationId}">
                              <ItemsControl ItemsSource="{Binding FieldWorksAnalyses}" IsVisible="{Binding HasFieldWorksAnalyses}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:FieldWorksAnalysisDisplayViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Minimal}">
                                      <controls:OpinionMark Kind="{Binding OpinionMarkKind}"
                                                            ToolTip.Tip="{Binding Opinion}" />
                                      <views:MorphemeRow Morphs="{Binding Morphs}" ShowCategory="False" RevealLinks="True" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Minimal}"
                                          IsVisible="{Binding HasNothingStored}">
                                <controls:OpinionMark Kind="None" />
                                <views:CopyableTextBlock Classes="muted" Text="Nothing in FieldWorks" FontStyle="Italic" />
                              </StackPanel>
                            </StackPanel>
                            <Border Classes="panGlossLine" AutomationProperties.AutomationId="{Binding PanGlossAutomationId}"
                                    Classes.same="{Binding IsPanGlossSame}"
                                    Classes.different="{Binding IsPanGlossDifferent}" Classes.none="{Binding IsPanGlossNone}"
                                    Classes.capped="{Binding IsPanGlossCapped}">
                              <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                <DockPanel LastChildFill="False">
                                  <views:CopyableTextBlock Classes="f" Text="{Binding PanGlossSummary}" />
                                  <Button DockPanel.Dock="Right" Classes="revealControl revealLink" Content="PanGloss help"
                                          Command="{Binding $parent[views:ResultsInTextPanel].InText.OpenPanGlossGuideCommand}"
                                          AutomationProperties.Name="About PanGloss" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Readings}" IsVisible="{Binding HasReadings}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ResultsReadingViewModel">
                                      <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                        <views:CopyableTextBlock Text="{Binding Text}" />
                                        <views:MorphemeRow Morphs="{Binding Morphs}" ShowCategory="False" RevealLinks="True" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding StagedChanges}" IsVisible="{Binding StagedChanges.Count}"
                                          AutomationProperties.AutomationId="{Binding StagedAutomationId}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StagedMarkingDisplayViewModel">
                                  <Border Classes="stagedStrip" ToolTip.Tip="{Binding FitStatus}">
                                    <DockPanel LastChildFill="False">
                                      <views:CopyableTextBlock Classes="stagedLabel" Text="{Binding Transition}" />
                                      <Button DockPanel.Dock="Right" Classes="revealControl revealButton" Content="Undo"
                                              Command="{Binding $parent[views:ResultsInTextPanel].InText.Changes.RemoveCommand}"
                                              CommandParameter="{Binding Change}"
                                              AutomationProperties.Name="{Binding Change.UndoAutomationName}" />
                                    </DockPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                        <Popup IsOpen="{Binding IsCardOpen}" PlacementTarget="{Binding #WordStrip}"
                               Placement="Bottom" IsLightDismissEnabled="True">
                          <Border Classes="card wordCard hoverReveal" Width="{DynamicResource Component.TextsPage.TextInspectorWidth}"
                                  Focusable="True" KeyDown="OnTokenCardKeyDown">
                            <ScrollViewer>
                              <StackPanel Spacing="{DynamicResource Intent.Space.Related}" x:DataType="vm:ResultsTokenViewModel">
                                <DockPanel LastChildFill="False">
                                  <views:CopyableTextBlock Text="{Binding Text}" FontWeight="SemiBold"
                                                           FontSize="{DynamicResource Intent.Type.Section}" />
                                  <views:CopyableTextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding PendingChangeStatus}"
                                                           IsVisible="{Binding IsPending}" />
                                </DockPanel>
                                <views:CopyableTextBlock Classes="muted" Text="{Binding Location}" />
                                <views:CopyableTextBlock Text="{Binding VerdictLabel}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <views:CopyableTextBlock Classes="section-title" Text="FieldWorks"
                                                         FontSize="{DynamicResource Intent.Type.Body}" />
                                <views:CopyableTextBlock Classes="muted" Text="Nothing is stored for this word."
                                                         IsVisible="{Binding HasNothingStored}" />
                                <ItemsControl ItemsSource="{Binding FieldWorksAnalyses}" IsVisible="{Binding HasFieldWorksAnalyses}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FieldWorksAnalysisDisplayViewModel">
                                      <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Minimal}">
                                          <controls:OpinionMark Kind="{Binding OpinionMarkKind}" ToolTip.Tip="{Binding Opinion}" />
                                          <views:CopyableTextBlock Text="{Binding Opinion}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <views:MorphemeRow Morphs="{Binding Morphs}" ShowCategory="False" RevealLinks="True" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <views:CopyableTextBlock Classes="section-title" Text="PanGloss"
                                                         FontSize="{DynamicResource Intent.Type.Body}" />
                                <Border Classes="panGlossLine" Classes.same="{Binding IsPanGlossSame}"
                                        Classes.different="{Binding IsPanGlossDifferent}" Classes.none="{Binding IsPanGlossNone}"
                                        Classes.capped="{Binding IsPanGlossCapped}">
                                  <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                    <DockPanel LastChildFill="False">
                                      <views:CopyableTextBlock Classes="f" Text="{Binding PanGlossSummary}" />
                                      <Button DockPanel.Dock="Right" Classes="revealControl revealLink" Content="PanGloss help"
                                              Command="{Binding Actions.OpenPanGlossGuideCommand}"
                                              AutomationProperties.Name="About PanGloss" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Readings}" IsVisible="{Binding HasReadings}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ResultsReadingViewModel">
                                          <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                            <views:CopyableTextBlock Text="{Binding Text}" />
                                            <views:MorphemeRow Morphs="{Binding Morphs}" ShowCategory="False" RevealLinks="True" />
                                          </StackPanel>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </Border>

                                <views:CopyableTextBlock Classes="section-title" Text="What to do"
                                                         FontSize="{DynamicResource Intent.Type.Body}" />
                                <views:CopyableTextBlock Classes="muted" Text="Approve one analysis at a time."
                                                         IsVisible="{Binding HasReadings}" />
                                <ComboBox ItemsSource="{Binding Readings}" SelectedItem="{Binding SelectedReading}"
                                          IsVisible="{Binding HasReadings}"
                                          AutomationProperties.Name="Choose a PanGloss reading for this word">
                                  <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ResultsReadingViewModel">
                                      <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Snug}">
                                          <views:CopyableTextBlock Text="{Binding Text}" />
                                          <views:CopyableTextBlock Classes="muted" Text="{Binding GradeLabel}" IsVisible="{Binding HasGrade}" />
                                          <views:CopyableTextBlock Classes="muted" Text="(stored here)" IsVisible="{Binding IsStoredHere}" />
                                        </StackPanel>
                                        <views:MorphemeRow Morphs="{Binding Morphs}" IsVisible="{Binding HasMorphs}"
                                                           ShowCategory="False" RevealLinks="True" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Expander Header="Fix ▾" AutomationProperties.Name="Fix actions for this word">
                                  <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                    <Button Content="Incorrect spelling" Command="{Binding Actions.AddChangeCommand}"
                                            CommandParameter="incorrect-spelling" AutomationProperties.Name="Mark this spelling Incorrect" />
                                    <ItemsControl ItemsSource="{Binding Marking.FixChoices}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AnalysisMarkingChoice">
                                          <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                                            <Button Content="{Binding Label}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.Actions.StageMarkingChoiceCommand}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}" />
                                            <views:CopyableTextBlock Classes="muted" Text="{Binding Subtitle}" />
                                          </StackPanel>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </Expander>
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Snug}">
                                  <Button Content="Mark as read" Command="{Binding Actions.MarkTokenReadCommand}"
                                          CommandParameter="{Binding}" AutomationProperties.Name="Mark this occurrence as read" />
                                  <Button Content="Mark as unread" Command="{Binding Actions.MarkTokenUnreadCommand}"
                                          CommandParameter="{Binding}" AutomationProperties.Name="Mark this occurrence as unread" />
                                </StackPanel>
                                <Button Content="Check again" Command="{Binding Actions.RecheckChangesCommand}"
                                        IsVisible="{Binding Marking.IsUncertain}" AutomationProperties.Name="Check this uncertain change again" />
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                                  <Button Content="Try a Word" Command="{Binding Actions.TryWordCommand}" />
                                  <HyperlinkButton Content="Open in FieldWorks" NavigateUri="{Binding WordLink}"
                                                   IsVisible="{Binding HasWordLink}" AutomationProperties.Name="{Binding WordLinkName}" />
                                </StackPanel>
                              </StackPanel>
                            </ScrollViewer>
                          </Border>
                        </Popup>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

  </Grid>
</UserControl>
