<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ResultsInTextPanel"
             x:DataType="views:ResultsInTextPanel">
  <UserControl.Styles>
    <!-- Chips, word underlines and verdict colours all come from App.axaml. -->
    <Style Selector=":is(TextBlock).verdictText">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,340" ColumnSpacing="12" Margin="16,12,16,16">

    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="8">
      <ComboBox ItemsSource="{Binding InText.Texts}" SelectedItem="{Binding InText.SelectedText}"
                IsVisible="{Binding InText.HasTexts}" MinWidth="260" AutomationProperties.Name="Results text to read">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ResultsTextViewModel">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <StackPanel Grid.Row="1" Spacing="6" IsVisible="{Binding InText.HasTexts}">
        <WrapPanel>
          <views:FilterChip Label="All occurrences" Count="{Binding InText.AllCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.All}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.All}" />
          <views:FilterChip Label="Differs from stored" Count="{Binding InText.DiffersCount}" Verdict="Differs"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.Differs}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.Differs}" />
          <views:FilterChip Label="Not stored yet" Count="{Binding InText.NewCount}" Verdict="New"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.New}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.New}" />
          <views:FilterChip Label="No parse, nothing stored" Count="{Binding InText.NoParseCount}" Verdict="NoResult"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.NoParse}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.NoParse}" />
          <views:FilterChip Label="Matches" Count="{Binding InText.MatchesCount}" Verdict="Agrees"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.Matches}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.Matches}" />
          <views:FilterChip Label="Stopped at a limit" Count="{Binding InText.LimitCount}" Verdict="Limit"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.Limit}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.Limit}" />
          <views:FilterChip Label="Skipped or not assessed" Count="{Binding InText.NotAssessedCount}" IsVisible="{Binding InText.HasNotAssessed}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.NotAssessed}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.NotAssessed}" />
        </WrapPanel>
        <!-- The key, so a colour in the text below never has to be guessed at. -->
        <Border Background="{DynamicResource SemiColorFill0}" CornerRadius="6" Padding="10,4"
                IsVisible="{Binding !InText.HasMessage}" AutomationProperties.Name="Key to the colours">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <views:CopyableTextBlock Classes="muted" Text="Key" FontWeight="SemiBold" FontSize="12" />
            <views:VerdictChip Verdict="Agrees" Text="agrees" Compact="True" />
            <views:VerdictChip Verdict="Differs" Text="differs from stored" Compact="True" />
            <views:VerdictChip Verdict="New" Text="not stored yet" Compact="True" />
            <views:VerdictChip Verdict="NoResult" Text="no parse" Compact="True" />
            <views:VerdictChip Verdict="Limit" Text="stopped at a limit" Compact="True" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="2" Spacing="10" Margin="0,8" IsVisible="{Binding InText.HasMessage}">
        <views:CopyableTextBlock Classes="muted" Text="{Binding InText.Message}" TextWrapping="Wrap" />
        <Button Content="Go to Texts" HorizontalAlignment="Left" IsVisible="{Binding InText.NeedsTexts}"
                Click="OnGoToTextsClick" AutomationProperties.Name="Go to Texts to check a text" />
      </StackPanel>
      <ScrollViewer Grid.Row="2" IsVisible="{Binding !InText.HasMessage}">
        <ItemsControl ItemsSource="{Binding InText.VisibleLines}" AutomationProperties.Name="Results text lines">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ResultsLineViewModel">
              <DockPanel Margin="0,4" LastChildFill="True">
                <views:CopyableTextBlock DockPanel.Dock="Left" Classes="muted" Text="{Binding Number}" Width="28" />
                <ItemsControl ItemsSource="{Binding Tokens}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultsTokenViewModel">
                      <Panel Margin="0,0,14,10">
                        <views:CopyableTextBlock Text="{Binding Text}" IsVisible="{Binding !IsWord}" FontSize="15" />
                        <!-- One block: the word, what is stored here, then the parser's verdict on it. -->
                        <Border IsVisible="{Binding IsWord}" Classes="wordVerdict" Focusable="True" Tag="{Binding}"
                                views:VerdictClasses.Verdict="{Binding Meaning}"
                                Classes.dimmed="{Binding IsDimmed}"
                                PointerPressed="OnTokenPressed" KeyDown="OnTokenKeyDown"
                                ToolTip.Tip="{Binding VerdictLabel}">
                          <StackPanel Spacing="1">
                            <DockPanel LastChildFill="False">
                              <HyperlinkButton DockPanel.Dock="Left" Content="{Binding Text}" NavigateUri="{Binding WordLink}"
                                               IsVisible="{Binding HasWordLink}" Padding="0" FontSize="15" FontWeight="SemiBold"
                                               AutomationProperties.Name="{Binding WordLinkName}" />
                              <views:CopyableTextBlock DockPanel.Dock="Left" Text="{Binding Text}" IsVisible="{Binding HasNoWordLink}"
                                                       FontSize="15" FontWeight="SemiBold" />
                              <!-- A word the project has rejected a reading for is worth seeing in the text itself. -->
                              <Border DockPanel.Dock="Left" Classes="verdictChip differs compact" Margin="6,0,0,0"
                                      IsVisible="{Binding HasDisapprovedReading}" ToolTip.Tip="{Binding DisapprovedTip}">
                                <views:CopyableTextBlock Text="!" />
                              </Border>
                            </DockPanel>
                            <views:MorphemeRow Morphs="{Binding Stored}" IsVisible="{Binding HasStored}" ShowCategory="False" />
                            <views:CopyableTextBlock Classes="muted" Text="nothing stored" FontSize="11" FontStyle="Italic"
                                       IsVisible="{Binding HasNothingStored}" />
                            <views:CopyableTextBlock Classes="verdictText" views:VerdictClasses.Verdict="{Binding Meaning}"
                                       Text="{Binding ParserLine}" FontSize="11" MaxWidth="260" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Right: the clicked word, what is stored here, and every reading the parser produced. -->
    <Border Grid.Column="1" Classes="card" IsVisible="{Binding InText.HasSelectedToken}">
      <ScrollViewer>
        <StackPanel Spacing="8" DataContext="{Binding InText.SelectedToken}" x:DataType="vm:ResultsTokenViewModel">
          <views:CopyableTextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="16" />
          <views:CopyableTextBlock Classes="muted" Text="{Binding Location}" />
          <views:CopyableTextBlock Text="{Binding VerdictLabel}" TextWrapping="Wrap" FontWeight="SemiBold" />

          <views:CopyableTextBlock Classes="section-title" Text="Stored at this occurrence" FontSize="13" />
          <views:CopyableTextBlock Classes="muted" Text="Nothing is stored here." IsVisible="{Binding HasNothingStored}" />
          <ItemsControl ItemsSource="{Binding Stored}" IsVisible="{Binding HasStored}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ParserReadingMorphViewModel">
                <StackPanel Margin="0,0,10,0" Spacing="0">
                  <HyperlinkButton Content="{Binding Form}" NavigateUri="{Binding Link}" IsVisible="{Binding HasLink}"
                                   Padding="0" FontWeight="SemiBold" FontSize="12"
                                   AutomationProperties.Name="{Binding LinkName}" />
                  <views:CopyableTextBlock Text="{Binding Form}" IsVisible="{Binding HasNoLink}" FontWeight="SemiBold" FontSize="12" />
                  <views:CopyableTextBlock Classes="muted" Text="{Binding GlossOrPlaceholder}" FontSize="11" />
                  <views:CopyableTextBlock Classes="muted" Text="{Binding Category}" FontSize="10" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <views:CopyableTextBlock Classes="section-title" Text="What the parser produced" FontSize="13" />
          <views:CopyableTextBlock Classes="muted" Text="No readings." IsVisible="{Binding !HasReadings}" />
          <ItemsControl ItemsSource="{Binding Readings}" AutomationProperties.Name="Parser readings for this occurrence">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ResultsReadingViewModel">
                <DockPanel Margin="0,2" LastChildFill="True">
                  <views:CopyableTextBlock DockPanel.Dock="Right" Classes="muted" FontSize="11" Text="{Binding GradeLabel}"
                             IsVisible="{Binding HasGrade}" Margin="8,0,0,0"
                             Foreground="{DynamicResource SemiColorText2}" />
                  <views:CopyableTextBlock DockPanel.Dock="Left" Text="✓ stored here " FontSize="11"
                             Foreground="{DynamicResource SemiColorSuccess}" IsVisible="{Binding IsStoredHere}" />
                  <views:CopyableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Content="Show in Words" Command="{Binding $parent[views:ResultsInTextPanel].InText.ShowInWordsCommand}"
                    AutomationProperties.Name="Show this word in the Words view" />
            <Button Content="Try this word" Command="{Binding $parent[views:ResultsInTextPanel].InText.TryWordCommand}"
                    AutomationProperties.Name="Try this word" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
