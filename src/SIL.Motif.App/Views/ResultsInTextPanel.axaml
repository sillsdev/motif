<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:controls="using:SIL.Motif.App.Controls"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             xmlns:word="clr-namespace:SIL.Motif.App.Controls.WordPresentation"
             x:Class="SIL.Motif.App.Views.ResultsInTextPanel"
             x:DataType="views:ResultsInTextPanel">
  <Grid ColumnDefinitions="*"
        Margin="{DynamicResource Component.TextsPage.ReaderInset}">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource Intent.Space.Related}">
      <Grid x:Name="ReaderToolbar" ColumnDefinitions="Auto,*,Auto,Auto,3*" RowDefinitions="Auto,Auto,Auto">
        <ComboBox x:Name="ResultsInTextPanelTextsItems" Grid.Column="0" ItemsSource="{Binding InText.Texts}" SelectedItem="{Binding InText.SelectedText}"
                  IsVisible="{Binding InText.HasTexts}" VerticalAlignment="Center"
                  MinWidth="{DynamicResource Component.TextsPage.TextPickerWidth}"
                  MaxWidth="{DynamicResource Component.TextsPage.TextPickerMaxWidth}"
                  Margin="{DynamicResource Component.TextsPage.TextPickerGap}"
                  AutomationProperties.Name="{x:Static app:MotifAppStrings.TextToReadAccessibleName}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ResultsTextViewModel">
              <controls:WritingSystemTextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"
                         controls:WritingSystemText.Id="{Binding TitleWritingSystem}" controls:WritingSystemText.StyleName="Normal" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox x:Name="ReaderWordSearch" Grid.Column="1" Text="{Binding InText.SearchText}"
                 PlaceholderText="Search words..." MinWidth="{DynamicResource Component.TextsPage.ReaderSearchMinWidth}"
                 MaxWidth="{DynamicResource Component.TextsPage.ReaderSearchMaxWidth}"
                 IsVisible="{Binding InText.HasTexts}" AutomationProperties.Name="{x:Static app:MotifAppStrings.SearchWordsInAnalyzeTextsAccessibleName}" />
        <Button x:Name="ReaderSelectMenu" Grid.Column="3" Classes="menuButton" Content="{Binding InText.SelectMenuLabel}" VerticalAlignment="Center"
                Padding="{DynamicResource Component.TextsPage.ReaderActionPadding}"
                IsVisible="{Binding InText.HasResults}" AutomationProperties.Name="{x:Static app:MotifAppStrings.SelectWordsForActionsAccessibleName}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="{DynamicResource Intent.Space.Snug}"
                          MaxWidth="{DynamicResource Component.TextsPage.ActionMenuWidth}">
                <views:CopyableTextBlock Text="{Binding InText.CheckedWordCountLabel}" FontWeight="{DynamicResource Intent.Weight.Strong}" />
                <views:CopyableTextBlock Classes="muted" Text="{Binding InText.ScopeCountSummary}" />
                <StackPanel>
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{Binding InText.ChooseWordsLabel}" Command="{Binding InText.ChooseWordsCommand}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.ChooseWordsWithCheckboxesAccessibleName}" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.SelectAll}" Command="{Binding InText.SelectAllWordsCommand}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.SelectAllChosenWordOccurrencesAccessibleName}" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Content="{x:Static app:MotifAppStrings.ClearSelection}" Command="{Binding InText.ClearSelectedWordsCommand}"
                          IsVisible="{Binding InText.HasCheckedWords}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.ClearSelectedWordOccurrencesAccessibleName}" />
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Intent.Space.Compact}" IsVisible="{Binding InText.HasCheckedWords}">
                  <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.ForTheSelectedWords}" />
                  <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="{x:Static app:MotifAppStrings.ApproveOneAnalysisAtATime}" />
                  <StackPanel>
                    <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.AddReadingsAsUnknown}" Command="{Binding InText.AddParserReadingsCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
                    <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.AcceptTheNewSet}" Command="{Binding InText.AcceptNewSetCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
                    <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.MarkIncorrect}" Command="{Binding InText.MarkSpellingsIncorrectCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
                    <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.RemoveAnalyses}" Command="{Binding InText.RemoveAnalysesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
                    <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.UndoChanges}" Command="{Binding InText.UndoChangesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.CheckedWords}" />
                    <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Content="{x:Static app:MotifAppStrings.CheckAgain}" Command="{Binding InText.RecheckCheckedChangesCommand}"
                            IsVisible="{Binding InText.HasCheckedUncertainChanges}" />
                  </StackPanel>
                </StackPanel>
                <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.InThisText}" />
                <StackPanel>
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.AddReadingsAsUnknownInThis}"
                          Command="{Binding InText.AddParserReadingsCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.AddParserReadingsAsUnknownInThisTextAccessibleName}" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.AcceptNewSetInThisText}" Command="{Binding InText.AcceptNewSetCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.AcceptNewSetForTheSelectedAccessibleName}" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.MarkSpellingsIncorrectInThisText}"
                          Command="{Binding InText.MarkSpellingsIncorrectCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.MarkSpellingsIncorrectInTheSelectedAccessibleName}" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.UndoChangesInThisText}" Command="{Binding InText.UndoChangesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.UndoChangesInTheSelectedTextAccessibleName}" />
                </StackPanel>
                <Expander Header="{Binding InText.SelectedTextRemoveHeader}" IsVisible="{Binding InText.HasSelectedTextAnalyses}">
                  <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                    <views:CopyableTextBlock Classes="muted" Text="{Binding InText.SelectedTextRemovalPreview}" TextWrapping="Wrap" />
                    <Button Content="{x:Static app:MotifAppStrings.StageRemovalFromThisText}" Command="{Binding InText.RemoveAnalysesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.SelectedText}"
                            AutomationProperties.Name="{x:Static app:MotifAppStrings.StageRemovalOfTheAnalysesUsedInThisTextAccessibleName}" />
                  </StackPanel>
                </Expander>
                <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.InAllChosenTexts}" />
                <StackPanel>
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.AcceptNewSetInSelection}" Command="{Binding InText.AcceptNewSetCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.AssessmentSelection}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.AcceptNewSetForTheSelectionAccessibleName}" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.AddReadingsAsUnknownInAll}"
                          Command="{Binding InText.AddParserReadingsCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.ChosenTexts}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.AddParserReadingsAsUnknownInAllChosenTextsAccessibleName}" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.MarkSpellingsIncorrectInAllChosen}"
                          Command="{Binding InText.MarkSpellingsIncorrectCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.ChosenTexts}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.MarkSpellingsIncorrectInAllChosenAccessibleName}" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.UndoChangesInAllChosenTexts}" Command="{Binding InText.UndoChangesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.ChosenTexts}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.UndoChangesInAllChosenTextsAccessibleName}" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding $self.IsEffectivelyEnabled}" Content="{x:Static app:MotifAppStrings.CheckAgain}" Command="{Binding InText.RecheckChangesCommand}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.CheckUncertainChangesAgainAccessibleName}" />
                </StackPanel>
                <Expander Header="{Binding InText.ChosenTextsRemoveHeader}" IsVisible="{Binding InText.HasChosenTextAnalyses}">
                  <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                    <views:CopyableTextBlock Classes="muted" Text="{Binding InText.ChosenTextsRemovalPreview}" TextWrapping="Wrap" />
                    <Button Content="{x:Static app:MotifAppStrings.StageRemovalFromAllChosenTexts}" Command="{Binding InText.RemoveAnalysesCommand}" CommandParameter="{x:Static vm:AnalysisOperationScope.ChosenTexts}"
                            AutomationProperties.Name="{x:Static app:MotifAppStrings.StageRemovalOfTheAnalysesUsedInAllChosenTextsAccessibleName}" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="ReaderReadMenu" Grid.Column="2" Classes="menuButton" Content="{x:Static app:MotifAppStrings.Read}" VerticalAlignment="Center" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReaderReadMenu}"
                Margin="{DynamicResource Component.TextsPage.ReaderActionGap}"
                Padding="{DynamicResource Component.TextsPage.ReaderActionPadding}"
                IsVisible="{Binding InText.HasResults}" AutomationProperties.Name="{x:Static app:MotifAppStrings.MarkReadOrUnreadAccessibleName}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Classes="menu">
                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Content="{x:Static app:MotifAppStrings.MarkThisTextAsRead}" Command="{Binding InText.MarkTextReadCommand}"
                        AutomationProperties.Name="{x:Static app:MotifAppStrings.MarkTheSelectedTextAsReadAccessibleName}" />
                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Content="{x:Static app:MotifAppStrings.MarkThisTextAsUnread}" Command="{Binding InText.MarkTextUnreadCommand}"
                        AutomationProperties.Name="{x:Static app:MotifAppStrings.MarkTheSelectedTextAsUnreadAccessibleName}" />
                <StackPanel Spacing="{DynamicResource Intent.Space.Compact}"
                            IsVisible="{Binding InText.HasSelectedReadStateOccurrences}">
                  <views:CopyableTextBlock Classes="muted" Text="{Binding InText.CheckedWordCountLabel}"
                                           AutomationProperties.Name="{x:Static app:MotifAppStrings.SelectedOccurrenceCountAccessibleName}" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Content="{x:Static app:MotifAppStrings.MarkSelectedAsRead}" Command="{Binding InText.MarkSelectionReadCommand}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.MarkSelectedOccurrencesAsReadAccessibleName}" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}" Content="{x:Static app:MotifAppStrings.MarkSelectedAsUnread}" Command="{Binding InText.MarkSelectionUnreadCommand}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.MarkSelectedOccurrencesAsUnreadAccessibleName}" />
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <WrapPanel x:Name="ResultsInTextFilterChips" Grid.Column="4" VerticalAlignment="Center"
                   IsVisible="{Binding InText.HasResults}">
          <views:FilterChip Classes="compact" Label="All" Count="{Binding InText.AllCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.All}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.All}" />
          <views:FilterChip Classes="compact" Label="Unread" Count="{Binding InText.UnreadCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.Unread}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.Unread}" />
          <views:FilterChip Classes="compact" Label="Different" Count="{Binding InText.DiffersCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.Differs}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.Differs}" />
          <views:FilterChip Classes="compact" Label="Not in FieldWorks" Count="{Binding InText.NewCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.New}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.New}" />
          <views:FilterChip Classes="compact" Label="No parse" Count="{Binding InText.NoParseCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.NoParse}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.NoParse}" />
          <views:FilterChip Classes="compact" Label="Stopped" Count="{Binding InText.LimitCount}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.Limit}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.Limit}" />
          <views:FilterChip Classes="compact" Label="Not parsed" Count="{Binding InText.NotAssessedCount}"
                            IsVisible="{Binding InText.HasNotAssessed}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.NotAssessed}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.NotAssessed}" />
          <views:FilterChip Classes="compact" Label="Named in a warning" Count="{Binding InText.NamedInWarningCount}"
                            IsVisible="{Binding InText.HasWarningEvidence}"
                            IsActive="{Binding InText.Filter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ResultsInTextFilter.NamedInWarning}}"
                            Command="{Binding InText.SetFilterCommand}" CommandParameter="{x:Static vm:ResultsInTextFilter.NamedInWarning}" />
        </WrapPanel>
      </Grid>

      <StackPanel Grid.Row="1" Spacing="{DynamicResource Intent.Space.Snug}">
        <views:RefusalBlock DataContext="{Binding InText.ReadStateRefusal}" />
        <views:CopyableTextBlock Classes="muted" Text="{Binding InText.ReadStateNotice}" TextWrapping="Wrap"
                                 IsVisible="{Binding InText.HasReadStateNotice}" />
        <views:CopyableTextBlock Classes="muted" Text="{Binding InText.Changes.CollectionNotice}" TextWrapping="Wrap"
                                 IsVisible="{Binding InText.Changes.CollectionNotice, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
      </StackPanel>
      <StackPanel Grid.Row="2" Spacing="{DynamicResource Intent.Space.Related}"
                  Margin="{DynamicResource Component.TextsPage.EmptyStateMargin}"
                  IsVisible="{Binding InText.HasMessage}">
        <views:CopyableTextBlock Classes="muted" Text="{Binding InText.Message}" TextWrapping="Wrap" />
        <Button Content="{x:Static app:MotifAppStrings.ChooseTexts}" HorizontalAlignment="Left" IsVisible="{Binding InText.NeedsTexts}"
                Click="OnGoToTextsClick" AutomationProperties.Name="{x:Static app:MotifAppStrings.ChooseTextsToAnalyzeAccessibleName}" />
      </StackPanel>
      <ScrollViewer Grid.Row="2" x:Name="TextScrollViewer" IsVisible="{Binding InText.HasLines}">
        <ItemsControl x:Name="TextLineItems" ItemsSource="{Binding InText.DisplayedLines}" AutomationProperties.Name="{x:Static app:MotifAppStrings.TextLinesAndParserResultsAccessibleName}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <views:ResultsModelTemplate>
                  <DataTemplate x:DataType="vm:ResultsLineViewModel">
              <StackPanel Margin="{DynamicResource Component.TextsPage.LineMargin}" HorizontalAlignment="Stretch">
              <Grid Classes="lineHead" ColumnDefinitions="Auto,*,Auto"
                    controls:WritingSystemText.FlowId="{Binding SentenceWritingSystem}"
                    controls:WritingSystemText.FlowEnabled="True">
                <views:CopyableTextBlock Classes="lineNumber" Text="{Binding Number}" IsVisible="{Binding ShowsLineNumber}"
                                         controls:WritingSystemText.WindowText="True" />
                <views:CopyableTextBlock Grid.Column="1" Classes="lineSentence" Text="{Binding Sentence}"
                                         TextWrapping="Wrap"
                                         controls:WritingSystemText.Id="{Binding SentenceWritingSystem}"
                                         controls:WritingSystemText.StyleName="{Binding SentenceStyle}" />
                <views:CopyableTextBlock Grid.Column="2" Classes="lineSentence" Text="{Binding NeedsALookSummary}"
                                         TextWrapping="Wrap"
                                         controls:WritingSystemText.WindowText="True" />
              </Grid>
              <controls:RunningTextPanel Classes="resultsLineBody" HorizontalAlignment="Stretch"
                                          controls:WritingSystemText.FlowId="{Binding SentenceWritingSystem}"
                                          controls:WritingSystemText.FlowEnabled="True">
                <StackPanel Classes="gutter stripRows"
                            controls:WritingSystemText.WindowText="True">
                  <TextBlock Classes="gutterLabel gutterWordRow" Text="{x:Static app:MotifAppStrings.Word}" />
                  <TextBlock Classes="gutterLabel analysisRow fieldWorksRow" Text="{x:Static app:MotifAppStrings.FieldWorks}" />
                  <TextBlock Classes="gutterLabel analysisRow" Text="{x:Static app:MotifAppStrings.PanGloss}" />
                </StackPanel>
                <views:ProgressiveItemsControl x:Name="ResultsInTextPanelTokensItems" DefersFirstPage="True" FullItemsSource="{Binding DisplayTokens}" HorizontalAlignment="Stretch">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:WordStripWrapPanel Orientation="Horizontal"
                                                                                           HorizontalAlignment="Stretch"
                                                                                           controls:WritingSystemText.FlowEnabled="True" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <views:ResultsModelTemplate>
                    <views:WordStripTokenTemplate>
                    <DataTemplate x:DataType="vm:ResultsTokenViewModel">
                      <word:WordStripToken Data="{Binding}" State="{Binding PresentationState, Mode=TwoWay}"
                                           Host="{Binding $parent[views:ResultsInTextPanel].WordHost}"
                                           ShowsSelectionCheckBox="{Binding $parent[views:ResultsInTextPanel].InText.ShowWordCheckboxes}" />
                    </DataTemplate>
                    </views:WordStripTokenTemplate>
                  </views:ResultsModelTemplate>
                  </ItemsControl.ItemTemplate>
                </views:ProgressiveItemsControl>
              </controls:RunningTextPanel>
              <ContentControl Content="{Binding OpenCard}" IsVisible="{Binding HasOpenCard}"
                              Margin="{DynamicResource Component.TextsPage.CardIndent}">
                <ContentControl.ContentTemplate>
                  <views:ResultsModelTemplate>
                  <DataTemplate x:DataType="vm:ResultsTokenViewModel">
                    <word:WordCard Host="{Binding $parent[views:ResultsInTextPanel].WordHost}"
                                   Key="{Binding PresentationKey}" EvidenceRevision="{Binding EvidenceRevision}"
                                   HandlesTextReaderShortcuts="True" Focusable="True"
                                   views:InspectLink.From="{Binding Text}"
                                   AutomationProperties.Name="{Binding Text, StringFormat='Word card for {0}'}">
                      <word:WordCard.Header>
                        <Border Classes="wordPresentationCardHeader hoverReveal">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
                            <WrapPanel VerticalAlignment="Center">
                              <views:CopyableTextBlock Text="{Binding Text}" FontWeight="{DynamicResource Intent.Weight.Strong}" VerticalAlignment="Center"
                                                       controls:WritingSystemText.Id="{Binding TextWritingSystem}" controls:WritingSystemText.StyleName="Normal" />
                              <controls:OpinionMark Kind="{Binding PrimaryOpinionMarkKind}" VerticalAlignment="Center"
                                                    Margin="{DynamicResource Component.TextsPage.ShortLabelMargin}" />
                              <views:CopyableTextBlock Classes="muted" Text="{Binding Location}" VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                              <views:CopyableTextBlock Classes="muted" Text="{Binding PendingChangeStatus, StringFormat='· {0}'}"
                                                       IsVisible="{Binding IsPending}" VerticalAlignment="Center"
                                                       Margin="{DynamicResource Component.TextsPage.ShortLabelMargin}" />
                              <views:CopyableTextBlock Classes="muted" VerticalAlignment="Center"
                                                       Text="{x:Static app:MotifAppStrings.InspectorKeyHint}" TextWrapping="Wrap"
                                                       Margin="{DynamicResource Component.TextsPage.ShortLabelMargin}" />
                            </WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                              <HyperlinkButton Classes="revealControl revealLink revealOnHover"
                                               NavigateUri="{Binding WordLink}" IsVisible="{Binding HasWordLink}"
                                               VerticalAlignment="Center" AutomationProperties.Name="{Binding WordLinkName}"
                                               ToolTip.Tip="{Binding WordLinkText}">
                                <TextBlock Text="{Binding WordLinkText}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           AutomationProperties.Name="{Binding WordLinkText}" />
                              </HyperlinkButton>
                              <Button Classes="wordPresentationCardClose" Content="×"
                                      Tag="{x:Static word:WordAction.CloseCard}"
                                      AutomationProperties.Name="{x:Static app:MotifAppStrings.CloseTheWordCardAccessibleName}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </word:WordCard.Header>
                    </word:WordCard>
                  </DataTemplate>
                  </views:ResultsModelTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
              </StackPanel>
                  </DataTemplate>
            </views:ResultsModelTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

  </Grid>
</UserControl>
