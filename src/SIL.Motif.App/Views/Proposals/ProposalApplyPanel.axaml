<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ProposalApplyPanel"
             x:DataType="vm:ProposalDocumentViewModel"
             AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalApply}">
  <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
    <views:CopyableTextBlock Text="{Binding ApplyDisplayReason}" IsVisible="{Binding !!ApplyDisplayReason}" TextWrapping="Wrap" />
    <views:CopyableTextBlock x:Name="ApplyLossNotice" Text="{Binding ApplyLossNotice}" IsVisible="{Binding !!ApplyLossNotice}" TextWrapping="Wrap" />
    <StackPanel IsVisible="{Binding IsPending}" Spacing="{DynamicResource Intent.Space.Related}">
      <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.ReviewApplyMeasuring}"
                               IsVisible="{Binding PendingMeasurement.IsMeasuring}" TextWrapping="Wrap" />
      <Button Content="{x:Static app:MotifAppStrings.Cancel}" Command="{Binding PendingMeasurement.CancelCommand}"
              IsVisible="{Binding PendingMeasurement.IsMeasuring}" HorizontalAlignment="Left" />
      <views:RefusalBlock DataContext="{Binding PendingMeasurement.Refusal}" />
    </StackPanel>
    <Button AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalRemoveNonFitting}"
            Content="{x:Static app:MotifAppStrings.ApplyRemoveNonFitting}" Command="{Binding RemoveNonFittingCommand}"
            IsVisible="{Binding OffersRemoveNonFitting}" HorizontalAlignment="Left" />
    <Button AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalPrepareApply}"
            Content="{x:Static app:MotifAppStrings.ProposalApplyPrepare}" Command="{Binding PrepareApplyCommand}"
            IsVisible="{Binding ShowsPrepareApply}" HorizontalAlignment="Left" />
    <StackPanel IsVisible="{Binding IsConfirmingApply}" Spacing="{DynamicResource Intent.Space.Related}">
      <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.ProposalApplyConfirm}" TextWrapping="Wrap" />
      <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.ProposalApplyDeferredNotice}"
                               IsVisible="{Binding ShowsDeferredApplyNotice}" TextWrapping="Wrap" />
      <views:CopyableTextBlock x:Name="ApplyBackupNotice" Text="{x:Static app:MotifAppStrings.ApplyBackupNotice}" TextWrapping="Wrap" />
      <HyperlinkButton x:Name="ApplyBackupLink" Content="{x:Static app:MotifAppStrings.ApplyBackupLink}"
                       Command="{Binding OpenBackupHelpCommand}" HorizontalAlignment="Left" />
      <WrapPanel>
        <Button AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalConfirmApply}"
                Classes="primary writes-fieldworks"
                Content="{x:Static app:MotifAppStrings.BoardApply}" Command="{Binding ConfirmApplyCommand}"
                IsEnabled="{Binding CanApply}" />
        <Button Classes="secondary" Content="{x:Static app:MotifAppStrings.Cancel}" Command="{Binding CancelApplyCommand}" />
      </WrapPanel>
    </StackPanel>
    <views:RefusalBlock DataContext="{Binding ApplyRefusal}" />
    <views:CopyableTextBlock AutomationProperties.AutomationId="{x:Static app:AutomationIds.ProposalReceipt}"
                             Text="{Binding ReceiptText}" IsVisible="{Binding HasReceipt}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
