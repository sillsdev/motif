<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:queries="clr-namespace:SIL.Motif.Commands.Queries;assembly=SIL.Motif.Commands"
             x:Class="SIL.Motif.App.Views.ProjectPanel"
             x:DataType="views:ProjectPanel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid ColumnDefinitions="*,28,340" Margin="24,20,24,24">

      <!-- Where the project stands: its Baseline, its latest Assessment and its grammar, one card each. -->
      <StackPanel Grid.Column="0" Spacing="14">

        <Border Classes="card">
          <StackPanel Spacing="10">
            <DockPanel LastChildFill="True">
              <Button Content="Browse..."
                      Command="{Binding Page.BrowseCommand}"
                      AutomationProperties.Name="Browse for a FieldWorks project file"
                      DockPanel.Dock="Right" Margin="8,0,0,0" />
              <ComboBox ItemsSource="{Binding Page.KnownProjects}"
                        SelectedItem="{Binding Page.SelectedKnownProject}"
                        PlaceholderText="{Binding Page.OpenUnlistedPath}"
                        AutomationProperties.Name="Known projects"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="queries:KnownProjectSummary">
                    <views:CopyableTextBlock Text="{Binding FullFwDataPath}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </DockPanel>
            <DockPanel LastChildFill="True">
              <Button Content="Refresh Baseline"
                      Command="{Binding Page.RefreshBaselineCommand}"
                      DockPanel.Dock="Right" VerticalAlignment="Top"
                      AutomationProperties.Name="Refresh the Baseline" />
              <StackPanel Spacing="2">
                <views:CopyableTextBlock Text="Baseline" FontWeight="SemiBold" />
                <views:CopyableTextBlock Text="{Binding Page.Baseline.CapturedTimeText}" IsVisible="{Binding !Page.Baseline.HasBaseline}" />
                <views:CopyableTextBlock Text="{Binding Page.Baseline.SavedText}" IsVisible="{Binding Page.Baseline.HasBaseline}" />
                <views:CopyableTextBlock Classes="muted" Text="{Binding Page.Baseline.CapturedAtText}" IsVisible="{Binding Page.Baseline.HasBaseline}" />
                <views:CopyableTextBlock Classes="muted" Text="{Binding Page.Baseline.HeldStatusText}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Classes="error" Text="{Binding Page.Baseline.RefusalMessage}" TextWrapping="Wrap"
                           IsVisible="{Binding Page.Baseline.RefusalMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" AutomationProperties.Name="Latest Assessment">
          <StackPanel Spacing="12">
            <DockPanel LastChildFill="False">
              <views:CopyableTextBlock Text="Latest Assessment" FontSize="15" FontWeight="SemiBold" DockPanel.Dock="Left" />
              <views:CopyableTextBlock Classes="muted" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       IsVisible="{Binding Page.Context.HasEvidence}"
                                       Text="{Binding Page.Words.CountSummary}" />
              <views:CopyableTextBlock Classes="muted" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                       IsVisible="{Binding Page.HasAssessment}"
                                       Text="{Binding Page.CompletedAt, StringFormat='{}{0:ddd d MMM, h:mm tt}'}" />
            </DockPanel>
            <StackPanel IsVisible="{Binding Page.HasOverview}" Spacing="4">
              <views:CopyableTextBlock Classes="muted" Text="{Binding Page.OverviewSummary}" TextWrapping="Wrap" />
              <Border Classes="notice" IsVisible="{Binding Page.OverviewIsStale}">
                <views:CopyableTextBlock Text="FieldWorks has changed since the Baseline behind these numbers."
                                         TextWrapping="Wrap" />
              </Border>
            </StackPanel>
            <views:CopyableTextBlock Classes="error" Text="{Binding Page.OverviewRefusalMessage}" TextWrapping="Wrap"
                                     IsVisible="{Binding Page.OverviewRefusalMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Page.ShowNoAssessment}"
                                     Text="No Assessment yet. Choose Texts or paste words, then run one to see how the grammar does." />
            <StackPanel Spacing="12" IsVisible="{Binding Page.Context.HasEvidence}">
              <views:OutcomeBar Segments="{Binding Page.Words.Outcomes}" AutomationProperties.Name="What the parser came to" />
              <Border Classes="notice" IsVisible="{Binding Page.Words.ManyStoppedAtALimit}">
                <DockPanel LastChildFill="True">
                  <HyperlinkButton DockPanel.Dock="Right" VerticalAlignment="Center" Padding="0" Margin="12,0,0,0"
                                   Content="Give each word longer" Click="OnOpenTimeLimitClick" />
                  <views:CopyableTextBlock Text="{Binding Page.Words.LimitHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <Border Classes="notice" IsVisible="{Binding Page.Words.AnySkipped}">
                <views:CopyableTextBlock Text="{Binding Page.Words.SkippedHint}" TextWrapping="Wrap" />
              </Border>
              <Border Height="1" Background="{DynamicResource Intent.Border}" />
              <views:CopyableTextBlock Text="Against what the project stores" FontWeight="SemiBold" />
              <WrapPanel>
                <views:VerdictChip Verdict="NoResult" Margin="0,0,8,6"
                                   Text="{Binding Page.Words.MissedCount, StringFormat='{}{0} approved analyses missed'}" />
                <views:VerdictChip Verdict="Differs" Margin="0,0,8,6"
                                   Text="{Binding Page.Words.DisapprovedCount, StringFormat='{}{0} disapproved readings produced'}" />
                <views:VerdictChip Verdict="New" Margin="0,0,8,6"
                                   Text="{Binding Page.Words.NoOpinionCount, StringFormat='{}{0} words with new readings'}" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="18">
                <HyperlinkButton Content="Open the words" Padding="0" Click="OnOpenResultsClick" />
                <HyperlinkButton Content="Why words stopped: Timing" Padding="0" Click="OnOpenStatisticsClick"
                                 IsVisible="{Binding Page.Words.AnyStoppedAtALimit}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" AutomationProperties.Name="Grammar summary">
          <DockPanel LastChildFill="True">
            <HyperlinkButton DockPanel.Dock="Right" VerticalAlignment="Center" Content="Open Warnings" Padding="0" Click="OnOpenGrammarClick" />
            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <views:CopyableTextBlock Text="Grammar" FontSize="15" FontWeight="SemiBold" />
                <views:CopyableTextBlock Text="&#183;" Classes="muted" FontSize="15" />
                <views:CopyableTextBlock Text="{Binding Page.Grammar.SummaryText}" FontSize="15" />
              </StackPanel>
              <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Page.Grammar.ShowFindings}"
                                       Text="{Binding Page.Grammar.BreakdownText}" />
            </StackPanel>
          </DockPanel>
        </Border>

      </StackPanel>

      <!-- History: every Baseline and Assessment, newest first. -->
      <StackPanel Grid.Column="2" Spacing="6">
        <views:CopyableTextBlock Text="History" FontSize="15" FontWeight="SemiBold" />
        <views:CopyableTextBlock Classes="muted" Text="Loading history..." IsVisible="{Binding History.IsLoading}" />
        <views:CopyableTextBlock Classes="error" Text="{Binding History.RefusalMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding History.RefusalMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
        <views:CopyableTextBlock Classes="muted" Text="Nothing recorded for this project yet."
                   IsVisible="{Binding !History.HasEntries}" />
        <ItemsControl ItemsSource="{Binding History.Entries}" AutomationProperties.Name="Project history">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="queries:ProjectHistoryEntry">
              <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,1,0,0" Padding="0,10">
                <StackPanel Spacing="2">
                  <DockPanel LastChildFill="False">
                    <views:CopyableTextBlock DockPanel.Dock="Left" Text="{Binding Kind}" FontWeight="SemiBold" />
                    <views:CopyableTextBlock DockPanel.Dock="Right" Classes="muted"
                                             Text="{Binding At.LocalDateTime, StringFormat='{}{0:ddd d MMM, h:mm tt}'}" />
                  </DockPanel>
                  <views:CopyableTextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </Grid>
  </ScrollViewer>
</UserControl>
