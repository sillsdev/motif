<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.TextWordsPanel"
             x:DataType="views:TextWordsPanel">
  <Grid Margin="{DynamicResource Component.TextsPage.PageInset}"
        RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource Intent.Space.Related}">
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="{Binding Words.HandOffCheckedWordsLabel}"
              Command="{Binding Words.HandOffCheckedWordsCommand}"
              AutomationProperties.Name="{Binding Words.HandOffCheckedWordsLabel}"
              AutomationProperties.HelpText="{Binding Words.HandOffCheckedWordsHelpText}"
              ToolTip.Tip="{Binding Words.HandOffCheckedWordsHelpText}"
              views:ClearTipPlacement.IsEnabled="True" ToolTip.ShowOnDisabled="True" />
      <TextBox DockPanel.Dock="Right" Text="{Binding Words.SearchText}" PlaceholderText="Search words..."
               AutomationProperties.Name="Search words" />
      <views:CopyableTextBlock Text="{Binding Words.SummaryText}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
    </DockPanel>

    <WrapPanel Grid.Row="1">
      <views:FilterChip Label="All" Count="{Binding Words.AllCount}" IsActive="{Binding Words.IsAllFilter}"
                        Command="{Binding Words.SetStatusFilterCommand}" CommandParameter="{x:Null}" />
      <views:FilterChip Label="Approved" Count="{Binding Words.ApprovedFilterCount}" Mark="{x:Static vm:Mark.Approved}"
                        IsActive="{Binding Words.StatusFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:WordProjectStatus.Approved}}"
                        Command="{Binding Words.SetStatusFilterCommand}" CommandParameter="{x:Static vm:WordProjectStatus.Approved}" />
      <views:FilterChip Label="Unknown" Count="{Binding Words.CandidateFilterCount}" Mark="{x:Static vm:Mark.Unknown}"
                        IsVisible="{Binding Words.CandidateFilterCount}"
                        IsActive="{Binding Words.StatusFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:WordProjectStatus.Candidate}}"
                        Command="{Binding Words.SetStatusFilterCommand}" CommandParameter="{x:Static vm:WordProjectStatus.Candidate}" />
      <views:FilterChip Label="Disapproved" Count="{Binding Words.RejectedFilterCount}" Mark="{x:Static vm:Mark.Disapproved}"
                        IsVisible="{Binding Words.RejectedFilterCount}"
                        IsActive="{Binding Words.StatusFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:WordProjectStatus.Rejected}}"
                        Command="{Binding Words.SetStatusFilterCommand}" CommandParameter="{x:Static vm:WordProjectStatus.Rejected}" />
      <views:FilterChip Label="Not in FieldWorks" Count="{Binding Words.NotPresentFilterCount}" Mark="{x:Static vm:Mark.NotInFieldWorks}"
                        IsActive="{Binding Words.StatusFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:WordProjectStatus.NotPresent}}"
                        Command="{Binding Words.SetStatusFilterCommand}" CommandParameter="{x:Static vm:WordProjectStatus.NotPresent}" />
      <views:FilterChip Label="Incorrect spelling" Count="{Binding Words.IncorrectSpellingFilterCount}"
                        IsVisible="{Binding Words.IncorrectSpellingFilterCount}"
                        IsActive="{Binding Words.StatusFilter, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:WordProjectStatus.IncorrectSpelling}}"
                        Command="{Binding Words.SetStatusFilterCommand}" CommandParameter="{x:Static vm:WordProjectStatus.IncorrectSpelling}" />
      <views:FilterChip Label="Several analyses" Count="{Binding Words.SeveralFilterCount}"
                        IsVisible="{Binding Words.SeveralFilterCount}" IsActive="{Binding Words.SeveralOnly}"
                        Command="{Binding Words.ShowSeveralCommand}" />
    </WrapPanel>

    <views:RefusalBlock Grid.Row="2" DataContext="{Binding Words.ShownRefusal}" />

    <Grid Grid.Row="3" RowDefinitions="Auto,*" Grid.IsSharedSizeScope="True">
      <views:WordRowHeader Columns="{x:Static views:WordRowColumnSets.WordList}" />
      <ListBox x:Name="TextWordsPanelRowsItems" Grid.Row="1" Classes="wordRows" ItemsSource="{Binding Words.Rows}"
               AutomationProperties.Name="Words to test" KeyboardNavigation.TabNavigation="Continue">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TextWordRowViewModel">
            <views:WordRow Row="{Binding Listed.Row}" List="word-list" IsOpen="{Binding Listed.IsOpen}"
                           IsChecked="{Binding IsChecked}" Columns="{x:Static views:WordRowColumnSets.WordList}">
              <views:WordRow.Card>
                <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
                  <views:ListedWordCard DataContext="{Binding Listed}" />
                  <views:CopyableTextBlock Classes="muted" Text="{Binding ProjectSummary}" TextWrapping="Wrap"
                                           IsVisible="{Binding HasSeveralAnalyses}" />
                  <views:CopyableTextBlock Classes="wordRowCardHeading" Text="WHERE IT APPEARS"
                                           HorizontalAlignment="Stretch" TextAlignment="Left" />
                  <ItemsControl x:Name="TextWordsPanelOccurrencesItems" ItemsSource="{Binding Occurrences}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WordOccurrenceRowViewModel">
                        <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                          <views:CopyableTextBlock Classes="muted" Text="{Binding Location}" />
                          <views:CopyableTextBlock Text="{Binding Sentence}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </views:WordRow.Card>
            </views:WordRow>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
