<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:controls="clr-namespace:SIL.Motif.App.Controls"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ReviewPanel"
             x:DataType="vm:ReviewPageModel">
  <Grid Classes="reviewLayout" ColumnDefinitions="*,Auto">
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="reviewStack">
        <views:CopyableTextBlock Classes="section-title" Text="{Binding Changes.CountText}" />
        <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !Changes.HasItems}"
                                 Text="No changes yet. Choose a word in Texts, then choose what should happen to its analysis." />
        <ItemsControl x:Name="ReviewGroups" ItemsSource="{Binding ReviewGroups}"
                      AutomationProperties.Name="Changes grouped for review">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReviewChangeGroupViewModel">
              <StackPanel Classes="reviewRelated">
                <DockPanel LastChildFill="True">
                  <Border Classes="hoverReveal" DockPanel.Dock="Right"
                          Background="{DynamicResource Intent.Clear}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                      <HyperlinkButton Classes="reviewLink revealControl revealLink" Content="Go to text"
                                       Command="{Binding GoToTextCommand}"
                                       AutomationProperties.Name="{Binding GoToTextAutomationName}" />
                      <HyperlinkButton Classes="reviewLink revealControl revealLink" Content="Undo all"
                                       Command="{Binding UndoAllCommand}"
                                       AutomationProperties.Name="{Binding UndoAllAutomationName}" />
                    </StackPanel>
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                    <views:CopyableTextBlock Classes="section-title" Text="{Binding Title}" />
                    <views:CopyableTextBlock Classes="muted" Text="{Binding WordCountText}" />
                  </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Items}"
                              AutomationProperties.Name="{Binding Title, StringFormat='Changes in {0}'}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChangeViewModel">
                      <Border Classes="card reviewCard hoverReveal">
                        <StackPanel Classes="reviewRelated">
                          <DockPanel LastChildFill="True">
                            <Border Classes="hoverReveal" DockPanel.Dock="Right"
                                    Background="{DynamicResource Intent.Clear}">
                              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                                <HyperlinkButton Classes="reviewLink revealControl revealLink" Content="Check again"
                                                 Command="{Binding $parent[views:ReviewPanel].Page.ReconfirmChangeCommand}"
                                                 CommandParameter="{Binding}"
                                                 AutomationProperties.Name="{Binding CheckAgainAutomationName}"
                                                 IsVisible="{Binding IsUncertain}" />
                                <HyperlinkButton Classes="reviewLink revealControl revealLink" Content="Show context"
                                                 Command="{Binding $parent[views:ReviewPanel].Page.ToggleContextCommand}"
                                                 CommandParameter="{Binding}"
                                                 AutomationProperties.Name="{Binding ShowContextAutomationName}"
                                                 IsVisible="{Binding HasContext}" />
                                <HyperlinkButton Classes="reviewLink revealControl revealLink" Content="Go to text"
                                                 Command="{Binding $parent[views:ReviewPanel].Page.GoToTextCommand}"
                                                 CommandParameter="{Binding}"
                                                 AutomationProperties.Name="{Binding GoToTextAutomationName}" />
                                <HyperlinkButton Classes="reviewLink revealControl revealLink" Content="Undo"
                                                 Command="{Binding $parent[views:ReviewPanel].Page.Changes.RemoveCommand}"
                                                 CommandParameter="{Binding}"
                                                 AutomationProperties.Name="{Binding UndoAutomationName}" />
                              </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                              <views:CopyableTextBlock Classes="reviewWord" Text="{Binding Word}" />
                              <views:CopyableTextBlock Classes="reviewEmphasis" Text="{Binding TransitionText}"
                                                       VerticalAlignment="Center" />
                            </StackPanel>
                          </DockPanel>
                          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                            <views:CopyableTextBlock Classes="reviewSmall" Text="Where:" />
                            <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding WhereText}" />
                          </StackPanel>
                          <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding SourceText}"
                                                   IsVisible="{Binding HasSourceText}" />
                          <StackPanel Classes="reviewCompact">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                              <views:CopyableTextBlock Classes="reviewSmall" Text="Now" />
                              <controls:OpinionMark Kind="{Binding NowOpinionMark}"
                                                    IsVisible="{Binding HasNowOpinionMark}" />
                              <views:CopyableTextBlock Classes="reviewEmphasis"
                                                       Text="{Binding StagedTransition.Now}" />
                            </StackPanel>
                            <Border Classes="stagedStrip">
                              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                                <views:CopyableTextBlock Classes="stagedLabel" Text="After" />
                                <controls:OpinionMark Kind="{Binding AfterOpinionMark}"
                                                      IsVisible="{Binding HasAfterOpinionMark}" />
                                <views:CopyableTextBlock Text="{Binding StagedTransition.AfterApply}" />
                              </StackPanel>
                            </Border>
                          </StackPanel>
                          <ItemsControl ItemsSource="{Binding Analyses}" IsVisible="{Binding HasAnalyses}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ReviewAnalysisViewModel">
                                <Grid>
                                  <Border Classes="reviewReading" Classes.parser="{Binding ParserBuilt}"
                                          Classes.touched="{Binding Touched}">
                                    <StackPanel Classes="reviewCompact">
                                      <ItemsControl ItemsSource="{Binding Morphs}">
                                        <ItemsControl.ItemsPanel>
                                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="vm:ParserReadingMorphViewModel">
                                            <Border Classes="reviewMorph">
                                              <StackPanel>
                                                <views:CopyableTextBlock Classes="reviewEmphasis" Text="{Binding Form}" />
                                                <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding GlossOrPlaceholder}" />
                                                <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding Category}" />
                                              </StackPanel>
                                            </Border>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                                        <views:CopyableTextBlock Classes="reviewEmphasis" Text="{Binding Opinion}" />
                                        <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding Source}" />
                                      </StackPanel>
                                    </StackPanel>
                                  </Border>
                                  <Rectangle Classes="reviewParserOutline" IsVisible="{Binding ParserBuilt}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding Reading}"
                                                   IsVisible="{Binding !HasAnalyses}" TextWrapping="Wrap" />
                          <views:CopyableTextBlock Classes="reviewSmall" Classes.error="{Binding IsNoLongerFits}"
                                                   Text="{Binding FitStatus}" TextWrapping="Wrap"
                                                   IsVisible="{Binding IsNoLongerFits}" />
                          <StackPanel Classes="reviewCompact" IsVisible="{Binding IsUncertain}">
                            <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding UncertaintyReason}"
                                                     TextWrapping="Wrap" IsVisible="{Binding HasUncertainty}" />
                            <views:CopyableTextBlock Classes="reviewSmall" Text="Current sentence" />
                            <ItemsControl ItemsSource="{Binding AfterWords}" AutomationProperties.Name="Current sentence">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UncertaintyTokenViewModel">
                                  <Border Classes="reviewSentenceToken" Classes.changed="{Binding IsChanged}">
                                    <views:CopyableTextBlock Text="{Binding Form}" />
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Classes="reviewCompact" IsVisible="{Binding IsContextExpanded}">
                              <views:CopyableTextBlock Classes="reviewSmall" Text="Sentence when the change was made" />
                              <ItemsControl ItemsSource="{Binding BeforeWords}" AutomationProperties.Name="Sentence when the change was made">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:UncertaintyTokenViewModel">
                                    <Border Classes="reviewSentenceToken" Classes.changed="{Binding IsChanged}">
                                      <views:CopyableTextBlock Text="{Binding Form}" />
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </StackPanel>
                          <Border IsVisible="{Binding HasUnavailableContext}">
                            <views:ParsePrompt DataContext="{Binding $parent[views:ReviewPanel].Page.Context}" />
                          </Border>
                          <ItemsControl ItemsSource="{Binding ContextTokens}"
                                        IsVisible="{Binding IsContextExpanded}"
                                        AutomationProperties.Name="Sentence context">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ResultsTokenViewModel">
                                <Border Classes="reviewSentenceToken">
                                  <views:CopyableTextBlock Text="{Binding Text}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Column="1" Classes="reviewStack reviewRight">
      <Border Classes="card">
        <StackPanel Classes="reviewRelated">
          <views:CopyableTextBlock Classes="section-title" Text="What applying does to the numbers"
                                   TextWrapping="Wrap" />
          <views:CopyableTextBlock x:Name="ReviewNumbersText" Classes="muted" Text="{Binding NumbersText}" TextWrapping="Wrap"
                                   IsVisible="{Binding !Context.NeedsAssessment}" />
          <views:CopyableTextBlock x:Name="ReviewMeasurementProgress" Classes="reviewSmall" Text="{Binding MeasurementProgressText}"
                                   IsVisible="{Binding IsMeasuring}" TextWrapping="Wrap" />
          <views:RefusalBlock DataContext="{Binding MeasurementRefusal}" />
          <Button Content="Check these changes" Command="{Binding MeasureCommand}"
                  AutomationProperties.Name="Check what applying does to the numbers" />
          <Button Content="Cancel" Command="{Binding CancelMeasureCommand}"
                  IsVisible="{Binding IsMeasuring}" />
          <views:ParsePrompt DataContext="{Binding Context}"
                             IsVisible="{Binding NeedsAssessment}" />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Classes="reviewRelated">
          <views:CopyableTextBlock Classes="section-title" Text="{Binding ProjectName, StringFormat='Apply to {0}'}"
                                   TextWrapping="Wrap" />
          <views:CopyableTextBlock Classes="muted" Text="{Binding Changes.CountText}" />
          <views:CopyableTextBlock Classes="reviewSmall"
                                   Text="Tech demo: make sure you have a FieldWorks backup before applying."
                                   TextWrapping="Wrap" />
          <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding ApplyBlockReason}" TextWrapping="Wrap" />
          <views:RefusalBlock DataContext="{Binding ApplyRefusal}" />
          <Button Content="{Binding ApplyButtonText}" Command="{Binding ApplyCommand}"
                  IsEnabled="{Binding CanApply}" AutomationProperties.Name="Apply to FieldWorks project" />
          <Button Content="Keep editing" Command="{Binding KeepEditingCommand}" />
          <views:RefusalBlock DataContext="{Binding Changes.ShownRefusal}" />
          <HyperlinkButton Classes="reviewLink" Content="Recheck all changes against the refreshed project"
                           Command="{Binding CheckAgainCommand}"
                           IsVisible="{Binding HasNonFittingChanges}" />
          <HyperlinkButton Classes="reviewLink" Content="Remove the ones that no longer fit"
                           Command="{Binding RemoveNonFittingCommand}"
                           IsVisible="{Binding HasNonFittingChanges}" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding HasReceipt}">
        <StackPanel Classes="reviewCompact">
          <views:CopyableTextBlock Classes="section-title" Text="Applied to the FieldWorks project" />
          <views:CopyableTextBlock Text="{Binding ReceiptText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
