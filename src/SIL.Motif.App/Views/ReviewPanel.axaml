<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ReviewPanel"
             x:DataType="vm:HandoffWorkspaceViewModel">
  <Grid ColumnDefinitions="*,300" ColumnSpacing="14" Margin="20,12,20,16">

    <!-- Left: every change collected on any page, one card each. -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !Changes.HasItems}"
                                 Text="No changes yet. Choose words on the Texts page, then say what should happen to them; they wait here, not applied yet, until you apply them to the FieldWorks project." />
        <ItemsControl x:Name="ChangeList" ItemsSource="{Binding Changes.Items}" AutomationProperties.Name="Changes to review">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChangeViewModel">
              <Border Classes="card" Padding="14,12" Margin="0,0,0,10">
                <DockPanel LastChildFill="True">
                  <HyperlinkButton DockPanel.Dock="Right" Content="Remove" FontSize="12" VerticalAlignment="Top" Padding="0"
                                   Command="{Binding $parent[views:ReviewPanel].Workspace.Changes.RemoveCommand}"
                                   CommandParameter="{Binding}"
                                   AutomationProperties.Name="{Binding Word, StringFormat='Remove the change to {0}'}" />
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <views:CopyableTextBlock Text="{Binding Word}" FontSize="15" FontWeight="Bold" />
                      <views:CopyableTextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <views:CopyableTextBlock Classes="muted" FontSize="12" VerticalAlignment="Center"
                                               Text="{Binding HeldLabel, StringFormat='was {0}'}" />
                    </StackPanel>
                    <views:CopyableTextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Reading}"
                                             IsVisible="{Binding Reading, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Right: what saving would do, and the one place a change is saved from. -->
    <StackPanel Grid.Column="1" Spacing="12">
      <Border Classes="card" Padding="14">
        <StackPanel Spacing="8">
          <views:CopyableTextBlock Text="{Binding ProjectName, StringFormat='Apply to {0}'}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <views:CopyableTextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Changes.Summary}" />
          <views:CopyableTextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Changes.ApplyStatus}"
                                   IsVisible="{Binding Changes.HasItems}" />
          <Button Content="Apply to FieldWorks project" IsEnabled="False" HorizontalAlignment="Stretch"
                  ToolTip.Tip="Motif cannot yet write approvals, rejections or new analyses to FieldWorks."
                  AutomationProperties.Name="Apply the changes to the FieldWorks project" />
          <Button Content="Keep editing" HorizontalAlignment="Stretch"
                  Command="{Binding ShowPageCommand}" CommandParameter="{x:Static vm:WorkspacePage.Texts}"
                  AutomationProperties.Name="Keep editing on the Texts page" />
          <HyperlinkButton Content="Clear every change" Padding="0" FontSize="12" IsVisible="{Binding Changes.HasItems}"
                           Command="{Binding Changes.ClearCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
