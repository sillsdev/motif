<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:word="clr-namespace:SIL.Motif.App.Controls.WordPresentation"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ReviewPanel"
             x:DataType="vm:ReviewPageModel">
  <UserControl.Styles>
    <Style Selector="Button.measureAction">
      <Setter Property="AutomationProperties.AutomationId" Value="{x:Static app:AutomationIds.MeasureChanges}" />
    </Style>
  </UserControl.Styles>
  <Grid Classes="reviewLayout" ColumnDefinitions="*,Auto">
    <views:WordListSlot Grid.Column="0" Schema="{x:Static word:WordListSchemas.Review}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewWordsSlot}">
    <Grid RowDefinitions="Auto,*" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewWordsGrid}">
    <word:WordRowHeader Grid.Row="0" IsVisible="{Binding HasWordRows}" />
    <ListBox x:Name="ReviewItems" Grid.Row="1" Classes="wordRows" ItemsSource="{Binding ReviewEntries}"
             VerticalAlignment="Stretch" AutomationProperties.Name="Changes grouped for review"
             KeyboardNavigation.TabNavigation="Continue" Grid.IsSharedSizeScope="True">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ReviewListEntryViewModel">
          <Grid>
            <ContentControl Content="{Binding Page}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ReviewPageModel">
            <StackPanel Classes="reviewStack reviewPageHeader">
              <StackPanel Classes="reviewCompact">
                <views:CopyableTextBlock Classes="section-title" Text="{Binding CountText}" TextWrapping="Wrap" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewCountTitle}" />
                <views:CopyableTextBlock x:Name="ReviewHeaderNote" Classes="muted" IsVisible="{Binding ShowsHeaderNote}"
                                         TextWrapping="Wrap" Text="{Binding HeaderNoteText}" />
                <views:CopyableTextBlock x:Name="ApplyBlockedTitle" Classes="reviewBlockedTitle"
                                         Text="{Binding ApplyBlockedTitle}" IsVisible="{Binding IsApplyBlocked}" />
              </StackPanel>
              <WrapPanel Classes="reviewToolbar" IsVisible="{Binding HasEntries}">
                <Button Classes="reviewAction" Content="Previous" Command="{Binding PreviousCommand}"
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewPrevious}" />
                <Button Classes="reviewAction" Content="Next" Command="{Binding NextCommand}"
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewNext}" />
                <Button Classes="reviewAction" Content="Keep" Command="{Binding KeepCommand}"
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewKeep}" />
                <Button Classes="reviewAction" Content="Undo" Command="{Binding UndoCommand}"
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewUndo}" />
                <Button Classes="reviewAction" Content="{Binding KeepAllText}" Command="{Binding KeepAllCommand}" />
                <Button Classes="reviewAction" Content="{Binding UndoAllText}" Command="{Binding UndoAllCommand}"
                        IsVisible="{Binding ShowsUndoAll}" />
                <views:CopyableTextBlock Classes="reviewSmall reviewGap" Text="{Binding LookedAtText}"
                                         AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewLookedAt}" />
              </WrapPanel>
              <Border Classes="reviewPrompt" IsVisible="{Binding UndoPrompt, Converter={x:Static ObjectConverters.IsNotNull}}"
                      AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewUndoPrompt}">
                <StackPanel Classes="reviewCompact">
                  <views:CopyableTextBlock Text="{Binding UndoPrompt.Sentence}" TextWrapping="Wrap" />
                  <WrapPanel Classes="reviewToolbar">
                    <Button Classes="reviewAction" Content="{Binding UndoPrompt.UndoAllText}"
                            Command="{Binding UndoPrompt.UndoAllOfThem}" />
                    <Button Classes="reviewAction" Content="Cancel" Command="{Binding UndoPrompt.Cancel}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <views:RefusalBlock DataContext="{Binding UndoRefusal}" />
              <StackPanel Classes="reviewCompact" IsVisible="{Binding ShowsEmptyState}">
                <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap"
                                         Text="Choose a word in Analyze texts, then choose what should happen to its analysis." />
                <HyperlinkButton Classes="reviewLink" Content="Go to Analyze texts" Command="{Binding OpenAnalyzeTextsCommand}" />
              </StackPanel>
              <Border IsVisible="{Binding HasRetirementReview}">
                <ScrollViewer MaxHeight="{Binding $parent[views:ReviewPanel].Bounds.Height}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <views:RetirementProposalReviewPanel DataContext="{Binding RetirementReview}" />
                </ScrollViewer>
              </Border>
            </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl Content="{Binding GroupHeader}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ReviewChangeGroupViewModel">
            <Border Classes="reviewGroup reviewEntry header"
                    Classes.noLongerFits="{Binding IsNoLongerFits}"
                    Classes.uncertain="{Binding IsUncertain}">
              <StackPanel>
                <Border Classes="reviewGroupHeader">
                  <WrapPanel ItemSpacing="{DynamicResource Intent.Space.Related}"
                             LineSpacing="{DynamicResource Intent.Space.Compact}" VerticalAlignment="Center">
                    <views:CopyableTextBlock Classes="reviewGroupTitle" Text="{Binding Title}" TextWrapping="Wrap" />
                    <views:CopyableTextBlock Classes="reviewSmall reviewGap" Text="{Binding WordCountText}" TextWrapping="Wrap" />
                    <views:CopyableTextBlock Classes="reviewGroupNote reviewGap" Text="{Binding Note}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewGroupNote}"
                                             IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                    <HyperlinkButton Classes="reviewLink" Content="Check again"
                                     Command="{Binding $parent[views:ReviewPanel].Page.CheckAgainCommand}"
                                     IsVisible="{Binding IsNoLongerFits}"
                                     AutomationProperties.Name="Check all changes again against the refreshed project" />
                    <Button Classes="reviewAction" Content="{Binding UndoAllText}" Command="{Binding UndoAllCommand}"
                            IsVisible="{Binding IsNoLongerFits}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewGroupUndoAll}"
                            AutomationProperties.Name="{Binding UndoAllAutomationName}" />
                    <HyperlinkButton Classes="reviewLink" Content="{Binding UndoAllText}"
                                     Command="{Binding UndoAllCommand}" IsVisible="{Binding !IsNoLongerFits}"
                                     AutomationProperties.Name="{Binding UndoAllAutomationName}" />
                  </WrapPanel>
                </Border>
              </StackPanel>
            </Border>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl Content="{Binding GrammarGroup}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ReviewGrammarGroupViewModel">
            <Border Classes="reviewGroup reviewEntry header">
              <Border Classes="reviewGroupHeader">
                <WrapPanel ItemSpacing="{DynamicResource Intent.Space.Related}"
                           LineSpacing="{DynamicResource Intent.Space.Compact}" VerticalAlignment="Center">
                  <views:CopyableTextBlock Classes="reviewGroupTitle" Text="{Binding Title}" TextWrapping="Wrap" />
                  <views:CopyableTextBlock Classes="reviewSmall reviewGap" Text="{Binding CountText}" TextWrapping="Wrap" />
                </WrapPanel>
              </Border>
            </Border>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl Content="{Binding GrammarEntry}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ReviewListEntryViewModel">
            <Border Classes="reviewGroup reviewEntry" Classes.last="{Binding IsLastChange}">
              <Border Classes="reviewCurrentFrame reviewGrammarRow" Classes.current="{Binding Review.IsCurrent}">
                <StackPanel Classes="reviewCompact">
                  <views:CopyableTextBlock Classes="reviewEmphasis" Text="{Binding Review.Title}" TextWrapping="Wrap" />
                  <views:CopyableTextBlock Classes="muted" Text="{Binding Review.Summary}" TextWrapping="Wrap" />
                  <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding Review.EffectText}"
                                           IsVisible="{Binding Review.HasEffects}" TextWrapping="Wrap" />
                  <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding Review.PartsText}"
                                           IsVisible="{Binding Review.HasParts}" TextWrapping="Wrap" />
                  <WrapPanel Classes="reviewActions">
                    <Border Classes="reviewPill reviewLookedAt" IsVisible="{Binding Review.IsLookedAt}">
                      <views:CopyableTextBlock Text="✓ Looked at" />
                    </Border>
                    <Button Classes="reviewAction" Content="Keep" Command="{Binding Review.KeepCommand}"
                            AutomationProperties.Name="{Binding Review.KeepAutomationName}" />
                    <Button Classes="reviewAction" Content="Undo" Command="{Binding Review.UndoCommand}"
                            AutomationProperties.Name="{Binding Review.UndoAutomationName}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Border>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl Content="{Binding ChangeEntry}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ReviewListEntryViewModel">
            <Border Classes="reviewGroup reviewEntry"
                    Classes.last="{Binding IsLastChange}"
                    Classes.noLongerFits="{Binding Group.IsNoLongerFits}"
                    Classes.uncertain="{Binding Group.IsUncertain}">
              <Border Classes="reviewCurrentFrame" Classes.current="{Binding Review.IsCurrent}">
                <word:WordRow Data="{Binding Change.Presentation}"
                              State="{Binding Change.PresentationState, Mode=TwoWay}"
                              Host="{Binding $parent[views:ReviewPanel].PresentationHost}" />
              </Border>
            </Border>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    </Grid>
    </views:WordListSlot>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsSideCards}">
    <StackPanel Classes="reviewStack reviewRight">
      <Border Classes="card">
        <StackPanel Classes="reviewRelated">
          <views:CopyableTextBlock Classes="section-title" Text="{Binding ProjectName, StringFormat='Apply to {0}'}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewApplyTitle}"
                                   TextWrapping="Wrap" />
          <views:CopyableTextBlock Classes="muted" Text="{Binding CountText}" TextWrapping="Wrap" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewApplyCount}" />
          <ItemsControl x:Name="ApplyChecks" ItemsSource="{Binding ApplyChecks}" IsVisible="{Binding HasApplyChecks}"
                        AutomationProperties.Name="What Apply checks">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Classes="reviewCompact" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ApplyCheck">
                <Border Classes="reviewPill reviewCheck" Classes.failed="{Binding !Passed}">
                  <views:CopyableTextBlock Text="{Binding MarkedText}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl x:Name="ApplyBlockers" ItemsSource="{Binding ApplyBlockers}"
                        AutomationProperties.Name="What blocks Apply">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Classes="reviewRelated" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ApplyBlocker">
                <StackPanel Classes="reviewCompact" IsVisible="{Binding IsMeasureAction}">
                  <Button Classes="reviewAction" Content="{Binding ActionText}" Command="{Binding Action}"
                          IsVisible="{Binding IsMeasureAction}"
                          Classes.measureAction="{Binding IsMeasureAction}"
                          AutomationProperties.Name="{Binding ActionAccessibleName}"
                          />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <views:CopyableTextBlock x:Name="ReviewNumbersText" Classes="muted" Text="{Binding NumbersText}"
                                   IsVisible="{Binding ShowsNumbersText}" TextWrapping="Wrap" />
          <views:CopyableTextBlock x:Name="ReviewMeasurementProgress" Classes="reviewSmall" Text="{Binding MeasurementProgressText}"
                                   IsVisible="{Binding IsMeasuring}" TextWrapping="Wrap" />
          <views:RefusalBlock DataContext="{Binding MeasurementRefusal}" />
          <Button Content="Cancel" Command="{Binding CancelMeasureCommand}"
                  IsVisible="{Binding IsMeasuring}" />
          <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding ApplyBlockReason}" TextWrapping="Wrap"
                                   IsVisible="{Binding IsApplying}" />
          <views:RefusalBlock DataContext="{Binding ShownApplyRefusal}" />
          <Button Content="{Binding ApplyButtonText}" Command="{Binding ApplyCommand}"
                  IsEnabled="{Binding CanApply}" AutomationProperties.Name="Apply to FieldWorks project"
                  ToolTip.Tip="{Binding ApplyDisabledReason}" ToolTip.ShowOnDisabled="True"
                  Classes="reviewApplyTooltip"
                  views:ClearTipPlacement.IsEnabled="True"
                  AutomationProperties.AutomationId="{x:Static app:AutomationIds.ApplyChanges}" />
          <Button Content="{Binding BackText}" Command="{Binding KeepEditingCommand}" IsVisible="{Binding ShowsBackButton}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewBack}" />
          <Button Content="Decline" Command="{Binding DeclineCommand}" IsVisible="{Binding ShowsDecline}"
                  AutomationProperties.AutomationId="{x:Static app:AutomationIds.DeclineProposal}" />
          <views:RefusalBlock DataContext="{Binding DeclineRefusal}" />
          <views:CopyableTextBlock Classes="reviewSmall"
                                   Text="FieldWorks must be closed, or it keeps its own copy. Keep a backup: this is a tech demo."
                                   TextWrapping="Wrap" />
          <views:RefusalBlock DataContext="{Binding Changes.ShownRefusal}" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding HasReceipt}">
        <StackPanel Classes="reviewCompact">
          <views:CopyableTextBlock Classes="section-title" Text="Applied to the FieldWorks project" />
          <views:CopyableTextBlock Text="{Binding ReceiptText}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="{x:Static app:AutomationIds.ApplyReceipt}" />
        </StackPanel>
      </Border>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
