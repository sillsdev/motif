<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ReviewPanel"
             x:DataType="vm:ReviewPageModel">
  <Grid Classes="reviewLayout" ColumnDefinitions="*,Auto">
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="reviewStack">
        <views:CopyableTextBlock Classes="section-title" Text="{Binding Changes.CountText}" />
        <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !Changes.HasItems}"
                                 Text="No changes yet. Choose a word in Texts, then choose what should happen to its analysis." />
        <ItemsControl x:Name="ChangeList" ItemsSource="{Binding Changes.Items}"
                      AutomationProperties.Name="Changes to review">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChangeViewModel">
              <Border Classes="card reviewCard">
                <StackPanel Classes="reviewRelated">
                  <DockPanel LastChildFill="True">
                    <HyperlinkButton Classes="reviewLink" DockPanel.Dock="Right" Content="Remove"
                                     VerticalAlignment="Top"
                                     Command="{Binding $parent[views:ReviewPanel].Page.Changes.RemoveCommand}"
                                     CommandParameter="{Binding}"
                                     AutomationProperties.Name="{Binding Word, StringFormat='Remove the change to {0}'}" />
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                      <views:CopyableTextBlock Classes="reviewWord" Text="{Binding Word}" />
                      <views:CopyableTextBlock Classes="reviewEmphasis" Text="{Binding ReviewLabel}"
                                               VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Analyses}" IsVisible="{Binding HasAnalyses}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ReviewAnalysisViewModel">
                        <Grid>
                          <Border Classes="reviewReading" Classes.parser="{Binding ParserBuilt}"
                                  Classes.touched="{Binding Touched}">
                            <StackPanel Classes="reviewCompact">
                              <ItemsControl ItemsSource="{Binding Morphs}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ParserReadingMorphViewModel">
                                    <Border Classes="reviewMorph">
                                      <StackPanel>
                                        <views:CopyableTextBlock Classes="reviewEmphasis" Text="{Binding Form}" />
                                        <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding GlossOrPlaceholder}" />
                                        <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding Category}" />
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                                <views:CopyableTextBlock Classes="reviewEmphasis" Text="{Binding Opinion}" />
                                <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding Source}" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                          <Rectangle Classes="reviewParserOutline" IsVisible="{Binding ParserBuilt}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding Reading}"
                                           IsVisible="{Binding !HasAnalyses}" TextWrapping="Wrap" />
                  <views:CopyableTextBlock Classes="reviewSmall" Classes.error="{Binding IsNoLongerFits}"
                                           Text="{Binding FitStatus}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Column="1" Classes="reviewStack reviewRight">
      <Border Classes="card">
        <StackPanel Classes="reviewRelated">
          <views:CopyableTextBlock Classes="section-title" Text="What applying does to the numbers"
                                   TextWrapping="Wrap" />
          <views:CopyableTextBlock Classes="muted" Text="{Binding NumbersText}" TextWrapping="Wrap" />
          <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding MeasurementProgressText}"
                                   IsVisible="{Binding IsMeasuring}" TextWrapping="Wrap" />
          <views:RefusalBlock DataContext="{Binding MeasurementRefusal}" />
          <Button Content="Check these changes" Command="{Binding MeasureCommand}"
                  AutomationProperties.Name="Check what applying does to the numbers" />
          <Button Content="Cancel" Command="{Binding CancelMeasureCommand}"
                  IsVisible="{Binding IsMeasuring}" />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Classes="reviewRelated">
          <views:CopyableTextBlock Classes="section-title" Text="{Binding ProjectName, StringFormat='Apply to {0}'}"
                                   TextWrapping="Wrap" />
          <views:CopyableTextBlock Classes="muted" Text="{Binding Changes.CountText}" />
          <views:CopyableTextBlock Classes="reviewSmall" Text="{Binding ApplyBlockReason}" TextWrapping="Wrap" />
          <views:RefusalBlock DataContext="{Binding ApplyRefusal}" />
          <Button Content="{Binding ApplyButtonText}" Command="{Binding ApplyCommand}"
                  IsEnabled="{Binding CanApply}" AutomationProperties.Name="Apply to FieldWorks project" />
          <Button Content="Keep editing" Command="{Binding KeepEditingCommand}" />
          <views:RefusalBlock DataContext="{Binding Changes.ShownRefusal}" />
          <HyperlinkButton Classes="reviewLink" Content="Check again against the refreshed project"
                           Command="{Binding CheckAgainCommand}"
                           IsVisible="{Binding HasNonFittingChanges}" />
          <HyperlinkButton Classes="reviewLink" Content="Remove the ones that no longer fit"
                           Command="{Binding RemoveNonFittingCommand}"
                           IsVisible="{Binding HasNonFittingChanges}" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding HasReceipt}">
        <StackPanel Classes="reviewCompact">
          <views:CopyableTextBlock Classes="section-title" Text="Applied to the FieldWorks project" />
          <views:CopyableTextBlock Text="{Binding ReceiptText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
