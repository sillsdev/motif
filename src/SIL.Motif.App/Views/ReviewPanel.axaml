<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:controls="clr-namespace:SIL.Motif.App.Controls"
             xmlns:word="clr-namespace:SIL.Motif.App.Controls.WordPresentation"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ReviewPanel"
             x:DataType="vm:ReviewPageModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/ReviewScoped.axaml" />
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="ApplyShortReasonTemplate" x:DataType="vm:ApplyBlocker">
      <StackPanel Classes="applyReason"
                  Classes.ReconciliationNeeded="{Binding Kind, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ApplyBlockerKind.ReconciliationNeeded}}"
                  Classes.NoLongerFits="{Binding Kind, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ApplyBlockerKind.NoLongerFits}}"
                  Classes.Uncertain="{Binding Kind, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ApplyBlockerKind.Uncertain}}"
                  Classes.FieldWorksHoldsProject="{Binding Kind, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ApplyBlockerKind.FieldWorksHoldsProject}}"
                  Classes.FieldWorksSavedSince="{Binding Kind, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ApplyBlockerKind.FieldWorksSavedSince}}"
                  Classes.LosesApprovedAnalysis="{Binding Kind, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ApplyBlockerKind.LosesApprovedAnalysis}}"
                  Classes.NotMeasured="{Binding Kind, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ApplyBlockerKind.NotMeasured}}"
                  Classes.TrialNeeded="{Binding Kind, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ApplyBlockerKind.TrialNeeded}}"
                  Classes.NothingToApply="{Binding Kind, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ApplyBlockerKind.NothingToApply}}"
                  Classes.NotReady="{Binding Kind, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ApplyBlockerKind.NotReady}}"
                  Classes.FitNotChecked="{Binding Kind, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ApplyBlockerKind.FitNotChecked}}">
        <StackPanel.Styles>
          <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/ReviewScoped.axaml" />
        </StackPanel.Styles>
        <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason blockerReason reasonReconciliationNeeded"
                                 Text="{x:Static app:MotifAppStrings.ReviewApplyReconciliationNeeded}" TextWrapping="Wrap" />
        <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason blockerReason reasonNoLongerFits"
                                 Text="{x:Static app:MotifAppStrings.ReviewApplyDoesNotFit}" TextWrapping="Wrap" />
        <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason blockerReason reasonUncertain"
                                 Text="{x:Static app:MotifAppStrings.ReviewApplyUncertain}" TextWrapping="Wrap" />
        <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason blockerReason reasonFieldWorksHoldsProject"
                                 Text="{x:Static app:MotifAppStrings.ReviewApplyFieldWorksHoldsProject}" TextWrapping="Wrap" />
        <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason blockerReason reasonFieldWorksSavedSince"
                                 Text="{x:Static app:MotifAppStrings.ReviewApplyFieldWorksSavedSince}" TextWrapping="Wrap" />
        <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason blockerReason reasonLosesApprovedAnalysis"
                                 Text="{x:Static app:MotifAppStrings.ReviewApplyLosesAnalysis}" TextWrapping="Wrap" />
        <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason blockerReason reasonNotMeasured"
                                 Text="{x:Static app:MotifAppStrings.ReviewApplyNotMeasured}" TextWrapping="Wrap" />
        <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason blockerReason reasonTrialNeeded"
                                 Text="{x:Static app:MotifAppStrings.ReviewApplyTrialNeeded}" TextWrapping="Wrap" />
        <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason blockerReason reasonNothingToApply"
                                 Text="{x:Static app:MotifAppStrings.ReviewApplyNothingToApply}" TextWrapping="Wrap" />
        <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason blockerReason reasonNotReady"
                                 Text="{x:Static app:MotifAppStrings.ReviewApplyNotReady}" TextWrapping="Wrap" />
        <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason blockerReason reasonFitNotChecked"
                                 Text="{x:Static app:MotifAppStrings.ReviewApplyFitNotChecked}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ApplyFooterTemplate" x:DataType="vm:ReviewPageModel">
      <Border Classes="reviewFooter" IsVisible="{Binding ShowsSideCards}">
        <Border.Styles>
          <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/ReviewScoped.axaml" />
        </Border.Styles>
      <StackPanel Classes="reviewRelated reviewFooterDetails">
        <views:CopyableTextBlock x:Name="ApplyFullReason" Classes="reviewBlockedTitle" Text="{Binding ApplyDisabledReason}"
                                 IsVisible="{Binding !CanApply}" TextWrapping="Wrap"
                                 AutomationProperties.Name="{x:Static app:MotifAppStrings.WhyApplyIsUnavailableAccessibleName}" />
        <views:RefusalBlock Classes="refusalFlow" DataContext="{Binding MeasurementRefusal}" />
        <views:TrialBaselineNoticeBlock DataContext="{Binding BaselineNotice}" />
        <views:RefusalBlock Classes="refusalFlow" DataContext="{Binding ShownApplyRefusal}" />
        <views:RefusalBlock Classes="refusalFlow" DataContext="{Binding DeclineRefusal}" />
        <views:RefusalBlock Classes="refusalFlow" DataContext="{Binding Changes.ShownRefusal}" />

        <StackPanel Classes="reviewCompact" IsVisible="{Binding HasReceipt}">
          <views:CopyableTextBlock Classes="section-title" Text="{x:Static app:MotifAppStrings.AppliedToTheFieldWorksProject}" />
          <views:CopyableTextBlock Text="{Binding ReceiptText}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="{x:Static app:AutomationIds.ApplyReceipt}" />
        </StackPanel>
        <views:CopyableTextBlock Classes="section-title" Text="{Binding ApplyTitle}"
                                 AutomationProperties.HelpText="{Binding ProjectName}"
                                 AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewApplyTitle}"
                                 TextWrapping="Wrap" />
        <views:CopyableTextBlock Classes="muted" Text="{Binding CountText}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewApplyCount}" />
        <ItemsControl x:Name="ApplyChecks" ItemsSource="{Binding ApplyChecks}" IsVisible="{Binding HasApplyChecks}"
                      AutomationProperties.Name="{x:Static app:MotifAppStrings.WhatApplyChecksAccessibleName}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Classes="reviewCompact" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ApplyCheck">
              <Border Classes="reviewPill reviewCheck" Classes.failed="{Binding !Passed}">
                <views:CopyableTextBlock Text="{Binding MarkedText}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <HyperlinkButton Classes="reviewLink" Content="{x:Static app:MotifAppStrings.ShowThem}"
                         Command="{Binding ShowNeedsAttentionCommand}"
                         IsVisible="{Binding HasChangesNeedingAttention}"
                         AutomationProperties.Name="{x:Static app:MotifAppStrings.ShowChangesThatNoLongerFitAccessibleName}" />
        <views:CopyableTextBlock x:Name="ReviewNumbersText" Classes="muted" Text="{Binding NumbersText}"
                                 IsVisible="{Binding ShowsNumbersText}" TextWrapping="Wrap" />
        <views:CopyableTextBlock x:Name="ReviewMeasurementProgress" Text="{Binding MeasurementProgressText}"
                                 IsVisible="{Binding IsMeasuring}" TextWrapping="Wrap" />
        <views:CopyableTextBlock Text="{Binding ApplyBlockReason}" TextWrapping="Wrap"
                                 IsVisible="{Binding IsApplying}" />
        <views:CopyableTextBlock x:Name="ApplyBackupNote"
                                 Text="{x:Static app:MotifAppStrings.FieldWorksMustBeClosedOrIt}"
                                 TextWrapping="Wrap" />
      </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ApplyActionsTemplate" x:DataType="vm:ReviewPageModel">
      <Border Classes="reviewActions" IsVisible="{Binding ShowsSideCards}">
        <Border.Styles>
          <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/ReviewScoped.axaml" />
          <Style Selector="Button.measureAction">
            <Setter Property="AutomationProperties.AutomationId" Value="{x:Static app:AutomationIds.MeasureChanges}" />
          </Style>
        </Border.Styles>
    <StackPanel x:Name="ApplyActions" Classes="reviewCompact">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Related}">
        <Button Content="{x:Static app:MotifAppStrings.ReviewApply}" Command="{Binding ApplyCommand}"
                IsEnabled="{Binding CanApply}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ApplyToFieldWorksProjectAccessibleName}"
                ToolTip.Tip="{Binding ApplyDisabledReason}" ToolTip.ShowOnDisabled="True"
                Classes="reviewAction reviewApplyTooltip"
                views:ClearTipPlacement.IsEnabled="True"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.ApplyChanges}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding !CanApply}">
          <ContentControl Content="{Binding ApplyBlockers[0]}" ContentTemplate="{StaticResource ApplyShortReasonTemplate}"
                          IsVisible="{Binding IsApplyBlocked}" />
          <StackPanel IsVisible="{Binding !IsApplyBlocked}">
            <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason"
                                     Text="{x:Static app:MotifAppStrings.ReviewApplyApplying}" TextWrapping="Wrap"
                                     IsVisible="{Binding IsApplying}" />
            <StackPanel IsVisible="{Binding !IsApplying}">
              <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason"
                                       Text="{x:Static app:MotifAppStrings.ReviewApplyMeasuring}" TextWrapping="Wrap"
                                       IsVisible="{Binding IsMeasuring}" />
              <views:CopyableTextBlock Classes="reviewBlockedTitle applyShortReason"
                                       Text="{x:Static app:MotifAppStrings.ReviewApplyChooseChange}" TextWrapping="Wrap"
                                       IsVisible="{Binding !IsMeasuring}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
      <WrapPanel Classes="reviewToolbar">
        <ItemsControl x:Name="ApplyBlockers" ItemsSource="{Binding ApplyBlockers}"
                      AutomationProperties.Name="{x:Static app:MotifAppStrings.WhatBlocksApplyAccessibleName}">
          <ItemsControl.Styles>
            <Style Selector="ContentPresenter" x:DataType="vm:ApplyBlocker">
              <Setter Property="IsVisible" Value="{Binding IsMeasureAction}" />
            </Style>
          </ItemsControl.Styles>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Classes="reviewRelated" Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ApplyBlocker">
              <Button Classes="reviewAction" Content="{Binding ActionText}" Command="{Binding Action}"
                      IsVisible="{Binding IsMeasureAction}"
                      Classes.measureAction="{Binding IsMeasureAction}"
                      AutomationProperties.Name="{Binding ActionAccessibleName}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="reviewAction" Content="{x:Static app:MotifAppStrings.Cancel}" Command="{Binding CancelMeasureCommand}"
                IsVisible="{Binding IsMeasuring}" />
        <Button Classes="reviewAction" Content="{Binding BackText}" Command="{Binding KeepEditingCommand}" IsVisible="{Binding ShowsBackButton}"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewBack}" />
        <Button Classes="reviewAction" Content="{x:Static app:MotifAppStrings.Decline}" Command="{Binding DeclineCommand}" IsVisible="{Binding ShowsDecline}"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.DeclineProposal}" />
      </WrapPanel>
    </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReviewNavigatorTemplate" x:DataType="vm:ReviewPageModel">
      <StackPanel Classes="reviewRelated">
        <StackPanel.Styles>
          <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/ReviewScoped.axaml" />
        </StackPanel.Styles>
        <views:CopyableTextBlock Classes="reviewEmphasis" Text="{Binding LookedAtText}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewLookedAt}" />
        <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.Show}" Classes="muted" />
        <ComboBox SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static app:MotifAppStrings.ShowChangesAccessibleName}">
          <ComboBoxItem Content="{x:Static app:MotifAppStrings.AllChanges}" />
          <ComboBoxItem Content="{x:Static app:MotifAppStrings.NotLookedAtYet}" />
          <ComboBoxItem Content="{x:Static app:MotifAppStrings.StillFit}" />
          <ComboBoxItem Content="{x:Static app:MotifAppStrings.NeedADecision}" />
        </ComboBox>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ReviewPageHeaderTemplate" x:DataType="vm:ReviewPageModel">
            <StackPanel Classes="reviewStack reviewPageHeader">
              <StackPanel Classes="reviewCompact">
                <views:CopyableTextBlock Classes="section-title" Text="{Binding CountText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CountText}" IsVisible="{Binding !IsApplyBlocked}" AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewCountTitle}" />
                <Border Classes="reviewHeaderGuidance" controls:DenseTable.Secondary="True">
                  <views:CopyableTextBlock x:Name="ReviewHeaderNote" Classes="muted" IsVisible="{Binding ShowsHeaderNote}"
                                           TextWrapping="Wrap" Text="{Binding HeaderNoteText}" />
                </Border>
                <views:CopyableTextBlock x:Name="ApplyBlockedTitle" Classes="reviewBlockedTitle"
                                         Text="{Binding ApplyBlockedTitle}" IsVisible="{Binding IsApplyBlocked}" />
              </StackPanel>
              <WrapPanel Classes="reviewToolbar" IsVisible="{Binding HasEntries}">
                <Button Classes="reviewAction" Content="{x:Static app:MotifAppStrings.Previous}" Command="{Binding PreviousCommand}"
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewPrevious}" />
                <Button Classes="reviewAction" Content="{x:Static app:MotifAppStrings.Next}" Command="{Binding NextCommand}"
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewNext}" />
                <Button Classes="reviewAction" Content="{x:Static app:MotifAppStrings.Keep}" Command="{Binding KeepCommand}"
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewKeep}" />
                <Button Classes="reviewAction" Content="{x:Static app:MotifAppStrings.Undo}" Command="{Binding UndoCommand}"
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewUndo}" />
                <Button Classes="denseTableMenu" Content="⋯" AutomationProperties.Name="{x:Static app:MotifAppStrings.ReviewAllChangesAccessibleName}"
                        ToolTip.Tip="{x:Static app:MotifAppStrings.ReviewAllChangesTip}">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                      <StackPanel Classes="menu">
                        <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                Content="{Binding KeepAllText}" Command="{Binding KeepAllCommand}" />
                        <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                Content="{Binding UndoAllText}" Command="{Binding UndoAllCommand}"
                                IsVisible="{Binding ShowsUndoAll}" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </WrapPanel>
              <Border Classes="reviewPrompt" IsVisible="{Binding UndoPrompt, Converter={x:Static ObjectConverters.IsNotNull}}"
                      AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewUndoPrompt}">
                <StackPanel Classes="reviewCompact">
                  <views:CopyableTextBlock Text="{Binding UndoPrompt.Sentence}" TextWrapping="Wrap" />
                  <WrapPanel Classes="reviewToolbar">
                    <Button Classes="reviewAction" Content="{Binding UndoPrompt.UndoAllText}"
                            Command="{Binding UndoPrompt.UndoAllOfThem}" />
                    <Button Classes="reviewAction" Content="{x:Static app:MotifAppStrings.Cancel}" Command="{Binding UndoPrompt.Cancel}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <views:RefusalBlock DataContext="{Binding UndoRefusal}" />
              <StackPanel Classes="reviewCompact" IsVisible="{Binding ShowsEmptyState}">
                <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap"
                                         Text="{x:Static app:MotifAppStrings.ChooseAWordInAnalyzeTexts}" />
                <HyperlinkButton Classes="reviewLink" Content="{x:Static app:MotifAppStrings.GoToAnalyzeTexts}" Command="{Binding OpenAnalyzeTextsCommand}" />
              </StackPanel>

            </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Classes="reviewLayout">
    <Grid RowDefinitions="Auto,Auto,*" controls:DenseTable.IsWidthHost="True"
          AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewWordsGrid}">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ReviewPageHeaderTemplate}" />
      <Border Grid.Row="1" Classes="denseTableColumnHeader">
        <Grid x:Name="ReviewTableHeader" controls:DenseTable.Columns="{StaticResource Component.Review.TableColumns}"
              controls:DenseTable.CompactColumns="{StaticResource Component.Review.TableCompactColumns}">
          <views:CopyableTextBlock Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.WordChange}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <views:CopyableTextBlock Grid.Column="1" controls:DenseTable.Secondary="True" Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.OpinionChange}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <views:CopyableTextBlock Grid.Column="2" controls:DenseTable.Secondary="True" Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.Analysis}" VerticalAlignment="Center" />
          <views:CopyableTextBlock Grid.Column="3" controls:DenseTable.Secondary="True" Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.PanGlossEffects}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <views:CopyableTextBlock Grid.Column="4" controls:DenseTable.Secondary="True" Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.Where}" VerticalAlignment="Center" />
          <views:CopyableTextBlock Grid.Column="5" Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.Fits}" VerticalAlignment="Center" />
          <views:CopyableTextBlock Grid.Column="6" Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.KeepUndo}" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <ListBox x:Name="ReviewItems" Grid.Row="2" Classes="denseTable" ItemsSource="{Binding TableEntries}"
               SelectedItem="{Binding SelectedTableEntry, Mode=TwoWay}"
               Focusable="True" IsTabStop="True" KeyboardNavigation.TabNavigation="Once"
               AutomationProperties.Name="{x:Static app:MotifAppStrings.ChangesGroupedForReviewAccessibleName}"
               AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReviewWordsSlot}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.DataTemplates>
          <DataTemplate DataType="vm:ReviewGrammarGroupViewModel" x:DataType="vm:ReviewGrammarGroupViewModel">
            <Border Classes="denseTableGroupHeader">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Intent.Space.Compact}">
                <TextBlock Classes="denseTableGroupName" Text="{Binding Title}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="denseTableCount" Text="{Binding CountText}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="vm:ReviewChangeGroupViewModel" x:DataType="vm:ReviewChangeGroupViewModel">
            <Border Classes="denseTableGroupHeader">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{StaticResource Intent.Space.Compact}">
                <TextBlock Classes="denseTableGroupName" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding NoteTip}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="denseTableCount" Text="{Binding WordCountText}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="denseTableAction" Content="{x:Static app:MotifAppStrings.CheckAgain}"
                        Command="{Binding $parent[views:ReviewPanel].Page.CheckAgainCommand}"
                        IsVisible="{Binding IsNoLongerFits}" AutomationProperties.Name="{x:Static app:MotifAppStrings.CheckAllChangesAgainAgainstTheAccessibleName}" />
                <Button Grid.Column="3" Classes="denseTableAction" Content="{x:Static app:MotifAppStrings.UndoAll}" Command="{Binding UndoAllCommand}"
                        AutomationProperties.Name="{Binding UndoAllAutomationName}"
                        AutomationProperties.AutomationId="{Binding UndoAllAutomationId}" />
              </Grid>
            </Border>
          </DataTemplate>
          <views:ReviewRowTemplate>
            <views:ReviewRowTemplate.Grammar>
              <DataTemplate x:DataType="vm:ReviewListEntryViewModel">
                <Grid>
                  <Border Classes="denseTableRow" MinHeight="{StaticResource Component.DenseTable.RowHeight}">
                    <Grid controls:DenseTable.Columns="{StaticResource Component.Review.TableColumns}"
                          controls:DenseTable.CompactColumns="{StaticResource Component.Review.TableCompactColumns}">
                      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center"
                            ColumnSpacing="{StaticResource Intent.Space.Minimal}">
                        <StackPanel>
                          <views:CopyableTextBlock Classes="denseTableCell denseTableItem" Text="{Binding Review.Title}"
                              TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Review.Title}" />
                          <views:CopyableTextBlock Classes="denseTableCell" Text="{Binding Review.Summary}"
                              TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Review.Summary}" />
                        </StackPanel>
                        <views:CopyableTextBlock Grid.Column="1" Classes="denseTableCount" Text="✓" IsVisible="{Binding Review.IsLookedAt}"
                            VerticalAlignment="Center" AutomationProperties.Name="{x:Static app:MotifAppStrings.LookedAtAccessibleName}" ToolTip.Tip="{x:Static app:MotifAppStrings.LookedAtTip}" />
                      </Grid>
                      <views:CopyableTextBlock Grid.Column="3" controls:DenseTable.Secondary="True" Classes="denseTableCell"
                          Text="{Binding Review.TableOutcomeText}" VerticalAlignment="Center"
                          TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Review.TableOutcomeText}" />
                      <views:CopyableTextBlock Grid.Column="4" controls:DenseTable.Secondary="True" Classes="denseTableCell"
                          Text="{x:Static app:MotifAppStrings.Project}" VerticalAlignment="Center" />
                      <Border Grid.Column="5" Classes="reviewFitTag" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding Review.TableFitDescription}" AutomationProperties.Name="{Binding Review.TableFitDescription}"
                              Classes.fits="{Binding Review.Change.StillFits}" Classes.noLongerFits="{Binding Review.Change.IsNoLongerFits}"
                              Classes.uncertain="{Binding Review.Change.IsUncertain}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Intent.Space.Minimal}">
                          <views:CopyableTextBlock Text="{Binding Review.FitGlyph}" Classes="reviewFitText" />
                          <views:CopyableTextBlock Grid.Column="1" Text="{Binding Review.TableFitText}" Classes="reviewFitText" TextWrapping="NoWrap" />
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center"
                                  Spacing="{StaticResource Intent.Space.Minimal}">
                        <Button Classes="denseTableAction" Content="{x:Static app:MotifAppStrings.Keep}" Command="{Binding Review.KeepCommand}"
                                AutomationProperties.Name="{Binding Review.TableKeepAutomationName}" />
                        <Button Classes="denseTableAction" Content="{x:Static app:MotifAppStrings.Undo}" Command="{Binding Review.UndoCommand}"
                                AutomationProperties.Name="{Binding Review.TableUndoAutomationName}" />
                        <Button Classes="denseTableMenu" Content="⋯" IsTabStop="True"
                                AutomationProperties.Name="{Binding Review.MoreAutomationName}">
                          <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                              <StackPanel Classes="menu">
                                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                        Content="{x:Static app:MotifAppStrings.Details}" Click="OnDetailsRequested"
                                        AutomationProperties.Name="{x:Static app:MotifAppStrings.DetailsForThisChangeAccessibleName}" />
                                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                        Content="{x:Static app:MotifAppStrings.Keep}" Command="{Binding Review.KeepCommand}" />
                                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                        Content="{x:Static app:MotifAppStrings.Undo}" Command="{Binding Review.UndoCommand}" />
                              </StackPanel>
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="denseTableFocusRing" />
                </Grid>
              </DataTemplate>
            </views:ReviewRowTemplate.Grammar>
            <views:ReviewRowTemplate.Word>
              <DataTemplate x:DataType="vm:ReviewListEntryViewModel">
                <Grid>
                  <Border Classes="denseTableRow" MinHeight="{StaticResource Component.DenseTable.RowHeight}">
                    <Grid controls:DenseTable.Columns="{StaticResource Component.Review.TableColumns}"
                          controls:DenseTable.CompactColumns="{StaticResource Component.Review.TableCompactColumns}">
                      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center"
                            ColumnSpacing="{StaticResource Intent.Space.Minimal}">
                        <views:CopyableTextBlock Classes="denseTableItem" Text="{Binding Review.Change.Word}"
                            controls:WritingSystemText.Id="{Binding Review.Change.Presentation.Facts.WordWritingSystem}"
                            controls:WritingSystemText.StyleName="Normal" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Review.Change.Word}" />
                        <views:CopyableTextBlock Grid.Column="1" Classes="denseTableCount" Text="✓" IsVisible="{Binding Review.IsLookedAt}"
                            VerticalAlignment="Center" AutomationProperties.Name="{x:Static app:MotifAppStrings.LookedAtAccessibleName}" ToolTip.Tip="{x:Static app:MotifAppStrings.LookedAtTip}" />
                      </Grid>
                      <Grid Grid.Column="1" controls:DenseTable.Secondary="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Spacing="{StaticResource Intent.Space.Compact}"
                                    IsVisible="{Binding Review.Change.HasOpinionTransitionMarks}">
                          <controls:OpinionMark Kind="{Binding Review.Change.NowOpinionMark}" ToolTip.Tip="{Binding Review.Change.StagedTransition.Now}" />
                          <views:CopyableTextBlock Text="→" Classes="denseTableCell" />
                          <controls:OpinionMark Kind="{Binding Review.Change.AfterOpinionMark}" ToolTip.Tip="{Binding Review.Change.StagedTransition.AfterApply}" />
                        </StackPanel>
                        <views:CopyableTextBlock Text="{Binding Review.Change.TransitionText}" Classes="denseTableCell"
                            VerticalAlignment="Center" IsVisible="{Binding !Review.Change.HasOpinionTransitionMarks}"
                            TextWrapping="Wrap" ToolTip.Tip="{Binding Review.Change.TransitionText}" />
                      </Grid>
                      <word:MorphemePanel Grid.Column="2" controls:DenseTable.Secondary="True" VerticalAlignment="Center"
                          Morphs="{Binding Review.Change.RowMorphs}" ShowCategory="False"
                          MaxVisibleMorphs="6" OverflowRequest="{Binding Review.Change.ReviewMorphologyRequest}" />
                      <views:MarkChip Grid.Column="3" controls:DenseTable.Secondary="True" VerticalAlignment="Center"
                          Mark="{Binding Review.Change.Presentation.Facts.CompactOutcomeMark}"
                          Text="{Binding Review.Change.Presentation.Facts.CompactOutcomeWord}" Compact="True" WrapText="True" />
                      <views:CopyableTextBlock Grid.Column="4" controls:DenseTable.Secondary="True" Classes="denseTableCell"
                          Text="{Binding Review.Change.Presentation.PendingChange.WhereText}" VerticalAlignment="Center"
                          TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Review.Change.Presentation.PendingChange.WhereText}" />
                      <Border Grid.Column="5" Classes="reviewFitTag" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding Review.TableFitDescription}" AutomationProperties.Name="{Binding Review.TableFitDescription}"
                              Classes.fits="{Binding Review.Change.StillFits}" Classes.noLongerFits="{Binding Review.Change.IsNoLongerFits}"
                              Classes.uncertain="{Binding Review.Change.IsUncertain}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Intent.Space.Minimal}">
                          <views:CopyableTextBlock Text="{Binding Review.FitGlyph}" Classes="reviewFitText" />
                          <views:CopyableTextBlock Grid.Column="1" Text="{Binding Review.TableFitText}" Classes="reviewFitText" TextWrapping="NoWrap" />
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center"
                                  Spacing="{StaticResource Intent.Space.Minimal}">
                        <Button Classes="denseTableAction" Content="{x:Static app:MotifAppStrings.Keep}" Command="{Binding Review.KeepCommand}"
                                AutomationProperties.Name="{Binding Review.TableKeepAutomationName}" />
                        <Button Classes="denseTableAction" Content="{x:Static app:MotifAppStrings.Undo}" Command="{Binding Review.UndoCommand}"
                                AutomationProperties.Name="{Binding Review.TableUndoAutomationName}" />
                        <Button Classes="denseTableMenu" Content="⋯" IsTabStop="True"
                                AutomationProperties.Name="{Binding Review.MoreAutomationName}">
                          <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                              <StackPanel Classes="menu">
                                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                        Content="{x:Static app:MotifAppStrings.Details}" Click="OnDetailsRequested"
                                        AutomationProperties.Name="{x:Static app:MotifAppStrings.DetailsForThisChangeAccessibleName}" />
                                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                        Content="{x:Static app:MotifAppStrings.Keep}" Command="{Binding Review.KeepCommand}" />
                                <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                        Content="{x:Static app:MotifAppStrings.Undo}" Command="{Binding Review.UndoCommand}" />
                              </StackPanel>
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="denseTableFocusRing" />
                </Grid>
              </DataTemplate>
            </views:ReviewRowTemplate.Word>
          </views:ReviewRowTemplate>
        </ListBox.DataTemplates>
      </ListBox>
    </Grid>

  </Grid>
</UserControl>
