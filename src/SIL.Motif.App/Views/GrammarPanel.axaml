<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.GrammarPanel"
             x:DataType="views:GrammarPanel">
  <Grid Classes="warningPanel" RowDefinitions="Auto,*" RowSpacing="{DynamicResource Intent.Space.Group}">

    <views:CopyableTextBlock Classes="muted"
               Text="What PanGloss noticed while loading the grammar. None of these stop a parse; each can make some words fail."
               TextWrapping="Wrap" />

    <Panel Grid.Row="1">

      <StackPanel IsVisible="{Binding Grammar.ShowLoading}" Spacing="{DynamicResource Intent.Space.Related}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Group}">
          <views:CopyableTextBlock Text="Checking the grammar..." FontWeight="SemiBold" />
          <views:CopyableTextBlock Classes="muted" Text="{Binding Grammar.ElapsedText}" />
        </StackPanel>
        <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Grammar loading" />
        <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap"
                   Text="The parser reads the whole project, so the first check of a Baseline can take a minute on a large project. Later visits are instant until the Baseline is refreshed. You can choose texts meanwhile; they do not depend on the grammar." />
      </StackPanel>

      <StackPanel IsVisible="{Binding Grammar.ShowRefused}" Spacing="{DynamicResource Intent.Space.Related}">
        <Border Classes="notice">
          <views:RefusalBlock DataContext="{Binding Grammar.ShownRefusal}" />
        </Border>
        <Button Content="Try again"
                Classes="Primary" Theme="{DynamicResource SolidButton}"
                Command="{Binding Grammar.CheckCommand}"
                AutomationProperties.Name="Try checking the grammar again" />
      </StackPanel>

      <StackPanel IsVisible="{Binding Grammar.ShowNoBaseline}" Spacing="{DynamicResource Intent.Space.Related}">
        <views:CopyableTextBlock Classes="muted" Text="Capture a Baseline before the grammar can be checked." TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel IsVisible="{Binding Grammar.ShowNoFindings}" Spacing="{DynamicResource Intent.Space.Related}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:CopyableTextBlock Text="No findings" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <views:CopyableTextBlock Classes="muted" Text="The parser loaded the grammar without warnings." HorizontalAlignment="Center" />
        <Button Content="Check the grammar again" HorizontalAlignment="Center"
                Command="{Binding Grammar.CheckCommand}" AutomationProperties.Name="Check the grammar again" />
      </StackPanel>

      <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Intent.Space.Group}" IsVisible="{Binding Grammar.ShowFindings}">
        <DockPanel LastChildFill="False">
          <WrapPanel DockPanel.Dock="Left">
            <views:FilterChip Label="All" Count="{Binding Grammar.Warnings.TotalCount}"
                              IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.All}}"
                              Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.All}" />
            <views:FilterChip Label="Errors" Count="{Binding Grammar.Warnings.ErrorCount}" GlyphText="{x:Static vm:GrammarLevelMarks.Error}"
                              IsVisible="{Binding Grammar.Warnings.HasReportedErrors}"
                              IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.Errors}}"
                              Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.Errors}" />
            <views:FilterChip Label="Warnings" Count="{Binding Grammar.Warnings.WarningCount}" GlyphText="{x:Static vm:GrammarLevelMarks.Warning}"
                              IsVisible="{Binding Grammar.Warnings.HasReportedWarnings}"
                              IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.Warnings}}"
                              Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.Warnings}" />
            <views:FilterChip Label="Information" Count="{Binding Grammar.Warnings.InformationCount}" GlyphText="{x:Static vm:GrammarLevelMarks.Information}"
                              IsVisible="{Binding Grammar.Warnings.HasReportedInformation}"
                              IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.Information}}"
                              Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.Information}" />
          </WrapPanel>
          <Button DockPanel.Dock="Right" Content="Check the grammar again"
                  Command="{Binding Grammar.CheckCommand}"
                  AutomationProperties.Name="Check the grammar again" />
        </DockPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Section}">

          <!-- Left: every kind of finding, the ones where the parser left something out first. -->
          <ScrollViewer Grid.Column="0" Classes="warningKinds">
            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
              <views:CopyableTextBlock Classes="muted warningHeading"
                         Text="{Binding Grammar.Warnings.ErrorCount, StringFormat='ERRORS · {0}'}"
                         IsVisible="{Binding Grammar.Warnings.HasErrorGroups}" />
              <ItemsControl ItemsSource="{Binding Grammar.Warnings.ErrorGroups}" IsVisible="{Binding Grammar.Warnings.HasErrorGroups}"
                            AutomationProperties.Name="Kinds of errors">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GrammarFindingGroupViewModel">
                    <Button Classes="findingGroup" Classes.chosen="{Binding IsSelected}"
                            Command="{Binding $parent[views:GrammarPanel].Grammar.Warnings.SelectGroupCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                      <DockPanel>
                        <views:VerdictChip DockPanel.Dock="Right" Verdict="{Binding Meaning}" GlyphText="{Binding Mark}" Text="{Binding Count}" Compact="True" />
                        <TextBlock Classes="groupName" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <views:CopyableTextBlock Classes="muted warningHeading"
                         Text="{Binding Grammar.Warnings.WarningCount, StringFormat='WARNINGS · {0}'}"
                         IsVisible="{Binding Grammar.Warnings.HasWarningGroups}" />
              <ItemsControl ItemsSource="{Binding Grammar.Warnings.WarningGroups}" IsVisible="{Binding Grammar.Warnings.HasWarningGroups}"
                            AutomationProperties.Name="Kinds of warning">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GrammarFindingGroupViewModel">
                    <Button Classes="findingGroup" Classes.chosen="{Binding IsSelected}"
                            Command="{Binding $parent[views:GrammarPanel].Grammar.Warnings.SelectGroupCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                      <DockPanel>
                        <views:VerdictChip DockPanel.Dock="Right" Verdict="{Binding Meaning}" GlyphText="{Binding Mark}" Text="{Binding Count}" Compact="True" />
                        <TextBlock Classes="groupName" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <views:CopyableTextBlock Classes="muted warningHeading"
                         Text="{Binding Grammar.Warnings.InformationCount, StringFormat='INFORMATION · {0}'}"
                         IsVisible="{Binding Grammar.Warnings.HasInformationGroups}" />
              <ItemsControl ItemsSource="{Binding Grammar.Warnings.InformationGroups}" IsVisible="{Binding Grammar.Warnings.HasInformationGroups}"
                            AutomationProperties.Name="Kinds of information">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GrammarFindingGroupViewModel">
                    <Button Classes="findingGroup" Classes.chosen="{Binding IsSelected}"
                            Command="{Binding $parent[views:GrammarPanel].Grammar.Warnings.SelectGroupCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                      <DockPanel>
                        <views:VerdictChip DockPanel.Dock="Right" Verdict="{Binding Meaning}" GlyphText="{Binding Mark}" Text="{Binding Count}" Compact="True" />
                        <TextBlock Classes="groupName" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- Right: the chosen kind's findings, each with the objects it names linked into FieldWorks. -->
          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource Intent.Space.Related}">
            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Group}">
                <views:CopyableTextBlock Classes="section-title" Text="{Binding Grammar.Warnings.SelectedGroupTitle}" TextWrapping="Wrap" />
                <views:CopyableTextBlock Classes="muted" Text="{Binding Grammar.Warnings.CountSummary}" VerticalAlignment="Center" />
              </StackPanel>
              <views:CopyableTextBlock Classes="muted" Text="Choose a finding to see what to do in FieldWorks." TextWrapping="Wrap" />
            </StackPanel>
        <!-- What the chosen kind means; what to do about it sits on each row, since the advice names that row's item. -->
        <Border Grid.Row="1" Classes="card warningDetail"
                IsVisible="{Binding Grammar.Warnings.SelectedGroup.HasDescription, FallbackValue=False}">
          <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
            <views:CopyableTextBlock Text="What it means" FontWeight="SemiBold" />
            <views:CopyableTextBlock Text="{Binding Grammar.Warnings.SelectedGroup.Description, FallbackValue=''}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,2*" ColumnSpacing="{DynamicResource Intent.Space.Snug}">
          <TextBox Grid.Column="0" Text="{Binding Grammar.Warnings.WhereFilter}"
                   PlaceholderText="Where..." AutomationProperties.Name="Filter grammar warnings by where they apply" />
          <TextBox Grid.Column="1" Text="{Binding Grammar.Warnings.ProblemFilter}"
                   PlaceholderText="What it means..." AutomationProperties.Name="Filter grammar warnings by problem" />
        </Grid>
        <DataGrid x:Name="FindingsGrid" Grid.Row="3" ItemsSource="{Binding Grammar.Warnings.Rows}"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal"
                  ClipboardCopyMode="IncludeHeader"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  AutomationProperties.Name="Grammar warnings">
          <!-- A chosen finding opens on PanGloss's advice for it and the steps that show whether the fix worked. -->
          <DataGrid.RowDetailsTemplate>
            <DataTemplate x:DataType="vm:GrammarWarningRowViewModel">
              <Grid Classes="warningRowDetail" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Intent.Space.Group}">
                <Border Classes="card warningRowCard">
                  <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                    <views:CopyableTextBlock Text="What to do in FieldWorks" FontWeight="SemiBold" />
                    <views:CopyableTextBlock Text="{Binding Advice}" TextWrapping="Wrap" />
                    <Border Classes="warningUnnamed" IsVisible="{Binding NamesNoItem}">
                      <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                        <views:CopyableTextBlock Text="{Binding NoItemText}" TextWrapping="Wrap" />
                        <views:CopyableTextBlock Text="{Binding WhereToLookText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card warningRowCard" IsVisible="{Binding ShowsFixSteps}">
                  <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                    <views:CopyableTextBlock Text="After you fix it" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Snug}">
                      <Border Classes="stepMark warningStep"><views:CopyableTextBlock Text="1" /></Border>
                      <views:CopyableTextBlock Grid.Column="1" Text="Save your change in FieldWorks." TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Snug}">
                      <Border Classes="stepMark warningStep"><views:CopyableTextBlock Text="2" /></Border>
                      <views:CopyableTextBlock Grid.Column="1" TextWrapping="Wrap"
                                               Text="Press Refresh at the top of this window. Motif reads the saved project and checks the grammar again." />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Snug}">
                      <Border Classes="stepMark warningStep"><views:CopyableTextBlock Text="3" /></Border>
                      <views:CopyableTextBlock Grid.Column="1" TextWrapping="Wrap"
                                               Text="If the fix worked, this finding is gone. Parse all words again to see how your words parse now." />
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
          <DataGrid.Columns>
            <!-- A DataGridColumn's Binding has no compiled-binding item scope of its own (unlike a
                 DataTemplate); ReflectionBinding is the documented per-binding opt-out. -->
            <DataGridTemplateColumn Header="Level" Width="Auto" SortMemberPath="Severity"
                                    ClipboardContentBinding="{ReflectionBinding Severity}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:GrammarWarningRowViewModel">
                  <TextBlock Classes="warningSeverity warningCell" Classes.error="{Binding IsError}"
                             Classes.warning="{Binding IsWarning}" Classes.info="{Binding IsInfo}"
                             Text="{Binding Severity}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Kind" Width="Auto" SortMemberPath="KindLabel"
                                    ClipboardContentBinding="{ReflectionBinding KindLabel}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:GrammarWarningRowViewModel">
                  <TextBlock Classes="muted warningCell" Text="{Binding KindLabel}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Where" Width="*" SortMemberPath="Where"
                                    ClipboardContentBinding="{ReflectionBinding Where}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:GrammarWarningRowViewModel">
                  <StackPanel Classes="warningCell" Spacing="{DynamicResource Intent.Space.Minimal}">
                    <views:GrammarWarningPartsBlock Parts="{Binding SubjectParts}" IsVisible="{Binding HasWhere}" />
                    <views:CopyableTextBlock Classes="muted" Text="no single place" IsVisible="{Binding !HasWhere}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="What it means" Width="2*" SortMemberPath="GroupName"
                                    ClipboardContentBinding="{ReflectionBinding Text}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:GrammarWarningRowViewModel">
                  <StackPanel Classes="warningCell" Spacing="{DynamicResource Intent.Space.Minimal}">
                    <views:CopyableTextBlock Text="{Binding Meaning}" TextWrapping="Wrap" IsVisible="{Binding HasMeaning}" />
                    <views:GrammarWarningPartsBlock Parts="{Binding ProblemParts}" Classes.parserLine="{Binding HasMeaning}"
                                                    ToolTip.Tip="{Binding Text}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Seen" Width="Auto" SortMemberPath="RepeatCount"
                                    ClipboardContentBinding="{ReflectionBinding RepeatCount}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:GrammarWarningRowViewModel">
                  <TextBlock Classes="warningCell warningSeen" Text="{Binding SeenText}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
          </Grid>
        </Grid>
      </Grid>
    </Panel>
  </Grid>
</UserControl>
