<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.GrammarPanel"
             x:DataType="views:GrammarPanel">
  <Grid Classes="warningPanel" RowDefinitions="Auto,*" RowSpacing="{DynamicResource Intent.Space.Group}">
    <views:CopyableTextBlock Classes="muted"
                              Text="PanGloss findings from a check of the whole grammar."
                              TextWrapping="Wrap" />

    <Panel Grid.Row="1">
      <StackPanel IsVisible="{Binding Grammar.ShowLoading}" Spacing="{DynamicResource Intent.Space.Related}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Group}">
          <views:CopyableTextBlock Text="Checking the grammar..." FontWeight="SemiBold" />
          <views:CopyableTextBlock Classes="muted" Text="{Binding Grammar.ElapsedText}" />
        </StackPanel>
        <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Grammar loading" />
        <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap"
                   Text="The parser reads the whole project, so the first check of a Baseline can take a minute on a large project. Later visits are instant until the Baseline is refreshed. You can choose texts meanwhile; they do not depend on the grammar." />
      </StackPanel>

      <StackPanel IsVisible="{Binding Grammar.ShowRefused}" Spacing="{DynamicResource Intent.Space.Related}">
        <Border Classes="notice">
          <views:RefusalBlock DataContext="{Binding Grammar.ShownRefusal}" />
        </Border>
        <Button Content="Try again"
                Classes="Primary" Theme="{DynamicResource SolidButton}"
                Command="{Binding Grammar.CheckCommand}"
                AutomationProperties.Name="Try checking the grammar again" />
      </StackPanel>

      <StackPanel IsVisible="{Binding Grammar.ShowNoBaseline}" Spacing="{DynamicResource Intent.Space.Related}">
        <views:CopyableTextBlock Classes="muted" Text="Capture a Baseline before the grammar can be checked." TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Classes="warningEmpty" IsVisible="{Binding Grammar.ShowNoFindings}"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:CopyableTextBlock Text="No grammar findings were reported." FontWeight="SemiBold" HorizontalAlignment="Center" />
        <Button Content="Check the grammar again" HorizontalAlignment="Center"
                Command="{Binding Grammar.CheckCommand}" AutomationProperties.Name="Check the grammar again" />
      </StackPanel>

      <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Intent.Space.Related}"
            IsVisible="{Binding Grammar.ShowFindings}">
        <WrapPanel Classes="warningControls">
          <views:FilterChip Label="All" Count="{Binding Grammar.Warnings.TotalCount}"
                            IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.All}}"
                            Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.All}"
                            Margin="{DynamicResource Intent.Gap.AfterRelated}" />
          <views:FilterChip Label="Errors" Count="{Binding Grammar.Warnings.ErrorCount}" Mark="{x:Static vm:Mark.Error}"
                            IsVisible="{Binding Grammar.Warnings.HasReportedErrors}"
                            IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.Errors}}"
                            Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.Errors}"
                            Margin="{DynamicResource Intent.Gap.AfterRelated}" />
          <views:FilterChip Label="Warnings" Count="{Binding Grammar.Warnings.WarningCount}" Mark="{x:Static vm:Mark.Warning}"
                            IsVisible="{Binding Grammar.Warnings.HasReportedWarnings}"
                            IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.Warnings}}"
                            Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.Warnings}"
                            Margin="{DynamicResource Intent.Gap.AfterRelated}" />
          <views:FilterChip Label="Information" Count="{Binding Grammar.Warnings.InformationCount}" Mark="{x:Static vm:Mark.Information}"
                            IsVisible="{Binding Grammar.Warnings.HasReportedInformation}"
                            IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.Information}}"
                            Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.Information}"
                            Margin="{DynamicResource Intent.Gap.AfterRelated}" />
          <ToggleButton Content="Touch your words" IsChecked="{Binding Grammar.Warnings.TouchYourWords, Mode=TwoWay}"
                        AutomationProperties.Name="Show findings with exact uses in your words"
                        Margin="{DynamicResource Intent.Gap.AfterRelated}" />
          <ToggleButton Content="Most of your words first" IsChecked="{Binding Grammar.Warnings.MostYourWordsFirst, Mode=TwoWay}"
                        AutomationProperties.Name="Sort by exact uses in your words"
                        Margin="{DynamicResource Intent.Gap.AfterRelated}" />
          <views:CopyableTextBlock Classes="muted" Text="{Binding Grammar.Warnings.CountSummary}"
                                    VerticalAlignment="Center" Margin="{DynamicResource Intent.Gap.AfterRelated}" />
          <Button Content="Check the grammar again" Command="{Binding Grammar.CheckCommand}"
                  AutomationProperties.Name="Check the grammar again" Margin="{DynamicResource Intent.Gap.AfterRelated}" />
        </WrapPanel>

        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Grammar.Warnings.Rows}" AutomationProperties.Name="Grammar findings">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GrammarWarningRowViewModel">
                <Border Classes="warningRow hoverReveal">
                  <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
                    <Button Classes="warningSummary" Command="{Binding ToggleOpenCommand}"
                            AutomationProperties.Name="{Binding Message}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Group}">
                        <views:MarkChip Classes="warningLevelMark" Mark="{Binding SeverityMark}" Compact="True"
                                        VerticalAlignment="Center" />
                        <views:CopyableTextBlock Grid.Column="1" Classes="warningMessage" Text="{Binding Message}"
                                                  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <views:CopyableTextBlock Grid.Column="2" Classes="muted warningReach"
                                                  Text="{Binding LineSummaryText}" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                    <views:CopyableTextBlock Classes="muted warningHoverTitle" Text="{Binding PanGlossTitle}"
                                              TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                    <StackPanel IsVisible="{Binding IsOpen}" Spacing="{DynamicResource Intent.Space.Related}">
                      <Border Classes="card warningDetail">
                        <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                          <views:CopyableTextBlock Classes="warningGroup" Text="{Binding PanGlossTitle}"
                                                    FontWeight="SemiBold"
                                                    IsVisible="{Binding PanGlossTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <views:CopyableTextBlock Classes="muted warningState" Text="{Binding ReachStateText}" TextWrapping="Wrap" />
                          <StackPanel IsVisible="{Binding HasMessage}" Spacing="{DynamicResource Intent.Space.Minimal}">
                            <views:CopyableTextBlock Classes="muted" Text="PanGloss description" FontWeight="SemiBold" />
                            <views:CopyableTextBlock Classes="warningFullDescription" Text="{Binding Message}"
                                                      TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel IsVisible="{Binding HasExplanation}" Spacing="{DynamicResource Intent.Space.Minimal}">
                            <views:CopyableTextBlock Classes="muted" Text="PanGloss explanation" FontWeight="SemiBold" />
                            <views:CopyableTextBlock Text="{Binding PanGlossExplanation}" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel IsVisible="{Binding HasProblemParts}" Spacing="{DynamicResource Intent.Space.Minimal}">
                            <views:CopyableTextBlock Classes="muted" Text="PanGloss problem details" FontWeight="SemiBold" />
                            <Border Classes="hoverReveal warningProblem">
                              <views:GrammarWarningPartsBlock Parts="{Binding ProblemParts}" />
                            </Border>
                          </StackPanel>
                          <Border Classes="hoverReveal warningSubjects">
                            <views:GrammarWarningPartsBlock Parts="{Binding SubjectParts}" />
                          </Border>
                          <StackPanel IsVisible="{Binding HasGuidance}" Spacing="{DynamicResource Intent.Space.Minimal}">
                            <views:CopyableTextBlock Classes="muted" Text="PanGloss guidance" FontWeight="SemiBold" />
                            <views:CopyableTextBlock Text="{Binding PanGlossGuidance}" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel IsVisible="{Binding HasFieldWorksPlaces}" Spacing="{DynamicResource Intent.Space.Minimal}">
                            <views:CopyableTextBlock Classes="muted" Text="FieldWorks places" FontWeight="SemiBold" />
                            <views:CopyableTextBlock Text="{Binding PanGlossFieldWorksPlaces}" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel IsVisible="{Binding HasHelp}" Spacing="{DynamicResource Intent.Space.Minimal}">
                            <views:CopyableTextBlock Classes="muted" Text="PanGloss help" FontWeight="SemiBold" />
                            <views:CopyableTextBlock Text="{Binding PanGlossHelp}" TextWrapping="Wrap" />
                          </StackPanel>
                          <HyperlinkButton Classes="revealControl revealLink" Content="PanGloss reference"
                                           NavigateUri="{Binding PanGlossReference}"
                                           IsVisible="{Binding HasPanGlossReference}" />
                        </StackPanel>
                      </Border>

                      <StackPanel IsVisible="{Binding HasAnyWordRows}" Spacing="{DynamicResource Intent.Space.Minimal}">
                        <views:CopyableTextBlock Text="Your words" FontWeight="SemiBold" />
                        <Grid IsSharedSizeScope="True" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource Intent.Space.Minimal}">
                          <views:WordRowHeader Columns="{x:Static views:WordRowColumnSets.Warnings}" />
                          <ItemsControl Grid.Row="1" ItemsSource="{Binding WordRows}" IsVisible="{Binding HasExactRows}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:WordRowViewModel">
                                <views:WordRow Row="{Binding}" Columns="{x:Static views:WordRowColumnSets.Warnings}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </StackPanel>
                      <StackPanel IsVisible="{Binding HasMembershipCandidates}" Spacing="{DynamicResource Intent.Space.Minimal}">
                        <views:CopyableTextBlock Classes="muted" Text="Words matched by membership; selection is not confirmed" />
                        <ItemsControl ItemsSource="{Binding MembershipCandidateRows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WordRowViewModel">
                              <views:WordRow Row="{Binding}" Columns="{x:Static views:WordRowColumnSets.Warnings}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <StackPanel IsVisible="{Binding HasSpellingCandidates}" Spacing="{DynamicResource Intent.Space.Minimal}">
                        <views:CopyableTextBlock Classes="muted" Text="Words matched by spelling; use is not confirmed" />
                        <ItemsControl ItemsSource="{Binding SpellingCandidateRows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WordRowViewModel">
                              <views:WordRow Row="{Binding}" Columns="{x:Static views:WordRowColumnSets.Warnings}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                        <Button Content="Hand off this finding" Command="{Binding $parent[views:GrammarPanel].Grammar.Warnings.HandOffCommand}"
                                CommandParameter="{Binding}" />
                        <Button Content="Parse these words again" IsVisible="{Binding CanParseAgain}"
                                Command="{Binding $parent[views:GrammarPanel].Grammar.Warnings.ReparseCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>

                      <Border Classes="warningWorkflow" IsVisible="{Binding HasYourWords}">
                        <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                          <views:CopyableTextBlock Text="Motif workflow" FontWeight="SemiBold" />
                          <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap"
                                                    Text="Save in FieldWorks, press Refresh, then parse these words again to see the current results." />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Panel>
  </Grid>
</UserControl>
