<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:controls="clr-namespace:SIL.Motif.App.Controls"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             xmlns:word="clr-namespace:SIL.Motif.App.Controls.WordPresentation"
             x:Class="SIL.Motif.App.Views.GrammarPanel"
             x:DataType="views:GrammarPanel">
  <Grid Classes="warningPanel" RowDefinitions="Auto,*" RowSpacing="{DynamicResource Intent.Space.Group}">
    <views:CopyableTextBlock Classes="muted"
                              Text="{x:Static app:MotifAppStrings.GrammarFindingsIntro}"
                              TextWrapping="Wrap" />

    <Panel Grid.Row="1">
      <StackPanel IsVisible="{Binding Grammar.ShowLoading}" Spacing="{DynamicResource Intent.Space.Related}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Group}">
          <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.CheckingTheGrammar}" FontWeight="{DynamicResource Intent.Weight.Section}" />
          <views:CopyableTextBlock Classes="muted" Text="{Binding Grammar.ElapsedText}" />
        </StackPanel>
        <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{x:Static app:MotifAppStrings.GrammarLoadingAccessibleName}" />
        <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap"
                   Text="{x:Static app:MotifAppStrings.GrammarLoadingExplanation}" />
      </StackPanel>

      <ScrollViewer x:Name="GrammarRefusalScroll" IsVisible="{Binding Grammar.ShowRefused}" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{x:Static app:MotifAppStrings.GrammarCheckRefusalAccessibleName}">
        <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
          <Border Classes="notice">
            <views:RefusalBlock DataContext="{Binding Grammar.ShownRefusal}" />
          </Border>
          <Button Content="{x:Static app:MotifAppStrings.TryAgain}"
                  Classes="Primary" Theme="{DynamicResource SolidButton}"
                  Command="{Binding Grammar.CheckCommand}"
                  AutomationProperties.Name="{x:Static app:MotifAppStrings.TryCheckingTheGrammarAgainAccessibleName}" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel IsVisible="{Binding Grammar.ShowNoBaseline}" Spacing="{DynamicResource Intent.Space.Related}">
        <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.GrammarBaselineRequired}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Classes="warningEmpty" IsVisible="{Binding Grammar.ShowNoFindings}"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.NoGrammarFindingsWereReported}" FontWeight="{DynamicResource Intent.Weight.Section}" HorizontalAlignment="Center" />
        <Button Content="{x:Static app:MotifAppStrings.CheckTheGrammarAgain}" HorizontalAlignment="Center"
                Command="{Binding Grammar.CheckCommand}" AutomationProperties.Name="{x:Static app:MotifAppStrings.CheckTheGrammarAgainAccessibleName}" />
      </StackPanel>

      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource Intent.Space.Related}"
            IsVisible="{Binding Grammar.ShowFindings}">
        <WrapPanel x:Name="WarningsBodyControls" Classes="warningControls" Orientation="Horizontal">
          <views:CopyableTextBlock x:Name="WarningsCountSummary" Classes="muted"
                                   Text="{Binding Grammar.Warnings.CountSummary}"
                                   IsVisible="{Binding !ShowInlineFilters}" />
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}"
                      IsVisible="{Binding ShowInlineFilters}">
            <views:FilterChip Label="All" Count="{Binding Grammar.Warnings.TotalCount}"
                              IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.All}}"
                              Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.All}"
                              Margin="{DynamicResource Intent.Gap.AfterRelated}" />
            <views:FilterChip Label="Errors" Count="{Binding Grammar.Warnings.ErrorCount}" Mark="{x:Static vm:Mark.Error}"
                              IsVisible="{Binding Grammar.Warnings.HasReportedErrors}"
                              IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.Errors}}"
                              Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.Errors}"
                              Margin="{DynamicResource Intent.Gap.AfterRelated}" />
            <views:FilterChip Label="Warnings" Count="{Binding Grammar.Warnings.WarningCount}" Mark="{x:Static vm:Mark.Warning}"
                              IsVisible="{Binding Grammar.Warnings.HasReportedWarnings}"
                              IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.Warnings}}"
                              Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.Warnings}"
                              Margin="{DynamicResource Intent.Gap.AfterRelated}" />
            <views:FilterChip Label="Information" Count="{Binding Grammar.Warnings.InformationCount}" Mark="{x:Static vm:Mark.Information}"
                              IsVisible="{Binding Grammar.Warnings.HasReportedInformation}"
                              IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.Information}}"
                              Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.Information}"
                              Margin="{DynamicResource Intent.Gap.AfterRelated}" />
          </StackPanel>
          <ToggleButton Content="{Binding Grammar.Warnings.TouchYourWordsText}"
                        IsChecked="{Binding Grammar.Warnings.TouchYourWords, Mode=TwoWay}"
                        AutomationProperties.Name="{x:Static app:MotifAppStrings.ShowFindingsWithExactUsesInYourWordsAccessibleName}"
                        IsVisible="{Binding ShowInlineFilters}"
                        Margin="{DynamicResource Intent.Gap.AfterRelated}" />
          <Button Content="{Binding Grammar.Warnings.SortLabel}"
                  AutomationProperties.Name="{x:Static app:MotifAppStrings.ChooseWarningSortOrderAccessibleName}"
                  Margin="{DynamicResource Intent.Gap.AfterRelated}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Classes="menu">
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                          Content="{x:Static app:MotifAppStrings.MostOfYourWordsFirst}"
                          Command="{Binding Grammar.Warnings.SetMostYourWordsFirstCommand}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.SortFindingsByExactWordUsesAccessibleName}" />
                  <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                          Content="{x:Static app:MotifAppStrings.ReportOrder}" Command="{Binding Grammar.Warnings.SetReportOrderCommand}"
                          AutomationProperties.Name="{x:Static app:MotifAppStrings.SortFindingsInReportOrderAccessibleName}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Content="{x:Static app:MotifAppStrings.CheckTheGrammarAgain}" Command="{Binding Grammar.CheckCommand}"
                  AutomationProperties.Name="{x:Static app:MotifAppStrings.CheckTheGrammarAgainAccessibleName}" Margin="{DynamicResource Intent.Gap.AfterRelated}" />
        </WrapPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*" controls:DenseTable.IsWidthHost="True">
          <Border Classes="denseTableColumnHeader">
            <Grid ColumnSpacing="{DynamicResource Intent.Space.Group}" controls:DenseTable.Columns="Narrow 2* 2* Narrow Actions"
                  controls:DenseTable.CompactColumns="0 * 0 0 Actions">
              <Border controls:DenseTable.Secondary="True">
                <views:CopyableTextBlock Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.Severity}" VerticalAlignment="Center" />
              </Border>
              <views:CopyableTextBlock Grid.Column="1" Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.WarningsItemColumnHeading}" VerticalAlignment="Center" />
              <Border Grid.Column="2" controls:DenseTable.Secondary="True">
                <views:CopyableTextBlock Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.WhatIsWrong}" VerticalAlignment="Center" />
              </Border>
              <Border Grid.Column="3" controls:DenseTable.Secondary="True">
                <views:CopyableTextBlock Classes="denseTableHeading" Text="{x:Static app:MotifAppStrings.NamedWords}" VerticalAlignment="Center" />
              </Border>
              <Border Grid.Column="4" />
            </Grid>
          </Border>

          <ListBox x:Name="GrammarPanelRowsItems" Grid.Row="1" Classes="denseTable"
                   ItemsSource="{Binding TableEntries}"
                   SelectedItem="{Binding Grammar.Warnings.SelectedTableEntry, Mode=TwoWay}"
                   Focusable="True" IsTabStop="True" KeyboardNavigation.TabNavigation="Once"
                   AutomationProperties.Name="{x:Static app:MotifAppStrings.GrammarFindingsAccessibleName}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.DataTemplates>
              <DataTemplate DataType="vm:DenseTableGroup" x:DataType="vm:DenseTableGroup">
                <Border Classes="denseTableGroupHeader">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Group}">
                    <TextBlock Classes="denseTableGroupName" Text="{Binding Label}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="denseTableCount" Text="{Binding CountText}"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:GrammarWarningRowViewModel" x:DataType="vm:GrammarWarningRowViewModel">
                <Grid>
                <Border Classes="denseTableRow">
                  <Grid ColumnSpacing="{DynamicResource Intent.Space.Group}" controls:DenseTable.Columns="Narrow 2* 2* Narrow Actions"
                        controls:DenseTable.CompactColumns="0 * 0 0 Actions">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Compact}"
                                VerticalAlignment="Center" controls:DenseTable.Secondary="True">
                      <views:MarkChip Mark="{Binding SeverityMark}" Compact="True" />
                      <TextBlock Classes="denseTableCell" Text="{Binding SeverityLabel}" />
                    </StackPanel>
                    <views:CopyableTextBlock Grid.Column="1" Classes="denseTableCell denseTableItem"
                                              Text="{Binding TableItemText}" TextWrapping="NoWrap"
                                              TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Grid.Column="2" controls:DenseTable.Secondary="True">
                      <views:CopyableTextBlock Classes="denseTableCell" Text="{Binding TableProblemText}"
                                              TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                              VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="3" controls:DenseTable.Secondary="True">
                      <views:CopyableTextBlock Classes="denseTableCell"
                                              Text="{Binding TableNamedWordsText}" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Minimal}"
                                VerticalAlignment="Center">
                      <Button Classes="denseTableAction" Content="{x:Static app:MotifAppStrings.Details}"
                              Command="{Binding $parent[views:GrammarPanel].OpenFindingDetailsCommand}"
                              CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding RowTitleText, StringFormat='Details for {0}'}" />
                      <Button Classes="denseTableMenu" Content="⋯" IsTabStop="True"
                              AutomationProperties.Name="{Binding RowTitleText, StringFormat='Actions for {0}'}">
                        <Button.Flyout>
                          <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Classes="menu">
                              <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                      Content="{x:Static app:MotifAppStrings.OpenDetails}"
                                      Command="{Binding $parent[views:GrammarPanel].OpenFindingDetailsCommand}"
                                      CommandParameter="{Binding}" />
                              <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                      Content="{x:Static app:MotifAppStrings.AIHandoffForThisWarning}"
                                      Command="{Binding $parent[views:GrammarPanel].Grammar.Warnings.HandOffCommand}"
                                      CommandParameter="{Binding}" />
                              <Button Classes="menuEntry" Theme="{DynamicResource BorderlessButton}"
                                      Content="{x:Static app:MotifAppStrings.ParseTheseWordsAgain}" IsVisible="{Binding CanParseAgain}"
                                      Command="{Binding $parent[views:GrammarPanel].Grammar.Warnings.ReparseCommand}"
                                      CommandParameter="{Binding}" />
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="denseTableFocusRing" />
                </Grid>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>
        </Grid>

        <ScrollViewer x:Name="GrammarPanelSelectionDetailsHost" Grid.Row="2"
                      MaxHeight="{DynamicResource Component.DenseTable.DetailMaxHeight}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding ShowInlineSelectionDetails}">
          <ItemsControl x:Name="GrammarPanelSelectionDetailsItems" ItemsSource="{Binding InlineSelectionDetails}"
                        AutomationProperties.Name="{x:Static app:MotifAppStrings.SelectedWarningDetailsAccessibleName}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GrammarWarningRowViewModel">
                <Border Classes="warningRow" IsVisible="{Binding IsOpen}">
                  <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
                    <Button Classes="warningSummary" Command="{Binding ToggleOpenCommand}"
                            AutomationProperties.Name="{Binding RowTitleText}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Group}">
                        <views:MarkChip Classes="warningLevelMark" Mark="{Binding SeverityMark}" Compact="True"
                                        VerticalAlignment="Center" />
                        <views:CopyableTextBlock Grid.Column="1" Classes="warningMessage" Text="{Binding RowTitleText}"
                                                  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <views:CopyableTextBlock Grid.Column="2" Classes="muted warningReach"
                                                  Text="{Binding LineSummaryText}" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                    <StackPanel IsVisible="{Binding IsOpen}" Spacing="{DynamicResource Intent.Space.Related}">
                      <views:CopyableTextBlock Classes="muted" Text="{Binding StatusText}"
                                                IsVisible="{Binding HasRefreshStatus}" TextWrapping="Wrap" />
                      <views:CopyableTextBlock Classes="muted warningState" Text="{Binding ReachStateText}"
                                                IsVisible="{Binding HasReachStateText}" TextWrapping="Wrap" />
                      <ItemsControl x:Name="GrammarPanelDetailsItems" ItemsSource="{Binding Details}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GrammarWarningDetailViewModel">
                            <Border Classes="card warningDetail">
                              <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
                                <views:CopyableTextBlock Classes="muted" Text="{Binding SeenText}"
                                                          IsVisible="{Binding HasSeenText}" />
                                <StackPanel IsVisible="{Binding HasExplanation}" Spacing="{DynamicResource Intent.Space.Minimal}">
                                  <views:CopyableTextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding HasWordforms}" Spacing="{DynamicResource Intent.Space.Minimal}">
                                  <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.WordformsNotCompared}" FontWeight="{DynamicResource Intent.Weight.Section}" />
                                  <views:CopyableTextBlock Text="{Binding WordformsText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding HasProblemParts}" Spacing="{DynamicResource Intent.Space.Minimal}">
                                  <Border Classes="warningProblem">
                                    <views:GrammarWarningPartsBlock Parts="{Binding ProblemParts}" />
                                  </Border>
                                </StackPanel>
                                <Border Classes="warningSubjects">
                                  <views:GrammarWarningPartsBlock Parts="{Binding SubjectParts}" />
                                </Border>
                                <ItemsControl x:Name="GrammarPanelEntryLinksItems" ItemsSource="{Binding EntryLinks}" IsVisible="{Binding HasEntryLinks}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GrammarWarningEntryLink">
                                      <HyperlinkButton Classes="warningEntryAction" Content="{Binding Label}"
                                                       NavigateUri="{Binding Address}" />
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel IsVisible="{Binding HasGuidance}" Spacing="{DynamicResource Intent.Space.Minimal}">
                                  <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.WhatToDoInFieldWorks}" FontWeight="{DynamicResource Intent.Weight.Section}" />
                                  <views:CopyableTextBlock Text="{Binding Guidance}" TextWrapping="Wrap" />
                                </StackPanel>
                                <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.WarningNoAdviceYet}"
                                                          IsVisible="{Binding !HasGuidance}" TextWrapping="Wrap" />
                                <HyperlinkButton Classes="revealControl revealLink" Content="{x:Static app:MotifAppStrings.LearnMore}"
                                                 NavigateUri="{Binding HelpUrl}" IsVisible="{Binding HasHelp}" />
                                <views:CopyableTextBlock Classes="muted warningRawMessage" Text="{Binding Description}"
                                                          IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <StackPanel IsVisible="{Binding HasAnyWordRows}" Spacing="{DynamicResource Intent.Space.Minimal}">
                        <views:CopyableTextBlock Text="{Binding ExactWordsHeading}" FontWeight="{DynamicResource Intent.Weight.Section}"
                                                 IsVisible="{Binding HasExactRows}" />
                        <views:WordListSlot Schema="{x:Static word:WordListSchemas.Warnings}">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource Intent.Space.Minimal}">
                          <word:WordRowHeader />
                          <ItemsControl x:Name="GrammarPanelWordRowsItems" Grid.Row="1" ItemsSource="{Binding WordRows}" IsVisible="{Binding HasExactRows}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:WordRowViewModel">
                                <word:WordRow Data="{Binding Presentation}"
                                              State="{Binding PresentationState, Mode=TwoWay}"
                                              Host="{Binding $parent[views:GrammarPanel].ExactWordPresentationHost}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                        </views:WordListSlot>
                      </StackPanel>
                      <views:CopyableTextBlock Classes="muted" Text="{Binding NoExactUsesText}"
                                               IsVisible="{Binding HasNoExactUses}" />
                      <StackPanel IsVisible="{Binding HasMembershipCandidates}" Spacing="{DynamicResource Intent.Space.Minimal}">
                        <views:CopyableTextBlock Classes="muted" Text="{x:Static app:MotifAppStrings.WarningWordsUsingNamedResource}" />
                        <views:WordListSlot Schema="{x:Static word:WordListSchemas.Warnings}">
                        <Grid RowDefinitions="Auto,Auto">
                          <word:WordRowHeader IsVisible="False" />
                        <ItemsControl x:Name="GrammarPanelMembershipCandidateRowsItems" Grid.Row="1" ItemsSource="{Binding MembershipCandidateRows}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WordRowViewModel">
                              <word:WordRow Data="{Binding Presentation}"
                                            State="{Binding PresentationState, Mode=TwoWay}"
                                            Host="{Binding $parent[views:GrammarPanel].MembershipCandidatePresentationHost}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Grid>
                        </views:WordListSlot>
                      </StackPanel>
                      <StackPanel IsVisible="{Binding HasSpellingCandidates}" Spacing="{DynamicResource Intent.Space.Minimal}">
                        <views:CopyableTextBlock Classes="muted" Text="{Binding SpellingCandidatesText}" />
                        <views:WordListSlot Schema="{x:Static word:WordListSchemas.Warnings}">
                        <Grid RowDefinitions="Auto,Auto">
                          <word:WordRowHeader IsVisible="False" />
                        <ItemsControl x:Name="GrammarPanelSpellingCandidateRowsItems" Grid.Row="1" ItemsSource="{Binding SpellingCandidateRows}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WordRowViewModel">
                              <word:WordRow Data="{Binding Presentation}"
                                            State="{Binding PresentationState, Mode=TwoWay}"
                                            Host="{Binding $parent[views:GrammarPanel].SpellingCandidatePresentationHost}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Grid>
                        </views:WordListSlot>
                      </StackPanel>

                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Related}">
                        <Button Content="{x:Static app:MotifAppStrings.AIHandoffForThisWarning}" Command="{Binding $parent[views:GrammarPanel].Grammar.Warnings.HandOffCommand}"
                                CommandParameter="{Binding}" />
                        <Button Content="{x:Static app:MotifAppStrings.ParseTheseWordsAgain}" IsVisible="{Binding CanParseAgain}"
                                Command="{Binding $parent[views:GrammarPanel].Grammar.Warnings.ReparseCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>

                      <Border Classes="warningWorkflow" IsVisible="{Binding HasYourWords}">
                        <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
                          <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.AfterYouFixIt}" FontWeight="{DynamicResource Intent.Weight.Section}" />
                          <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap"
                                                    Text="{x:Static app:MotifAppStrings.WarningAfterFixSteps}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Panel>
  </Grid>
</UserControl>
