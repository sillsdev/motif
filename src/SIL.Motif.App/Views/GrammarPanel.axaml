<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.GrammarPanel"
             x:DataType="views:GrammarPanel">
  <UserControl.Styles>
    <Style Selector=":is(TextBlock).severity">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
    <Style Selector=":is(TextBlock).severity.warning">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorWarning}" />
    </Style>
    <Style Selector=":is(TextBlock).severity.capability">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
    </Style>
    <Style Selector="Button.findingGroup">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.findingGroup.chosen">
      <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
    </Style>
    <Style Selector="Button.findingGroup TextBlock.groupName">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="12">

    <!-- The stage bar already names the stage, so the page starts with what it knows. -->
    <views:CopyableTextBlock Classes="muted"
               Text="Loaded with the project. Nothing here depends on which texts you choose."
               TextWrapping="Wrap" />

    <Panel Grid.Row="1">

      <StackPanel IsVisible="{Binding Grammar.ShowLoading}" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <views:CopyableTextBlock Text="Checking the grammar..." FontWeight="SemiBold" />
          <views:CopyableTextBlock Classes="muted" Text="{Binding Grammar.ElapsedText}" />
        </StackPanel>
        <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Grammar loading" />
        <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap"
                   Text="The parser reads the whole project, so the first check of a Baseline can take a minute on a large project. Later visits are instant until the Baseline is refreshed. You can choose texts meanwhile; they do not depend on the grammar." />
      </StackPanel>

      <StackPanel IsVisible="{Binding Grammar.ShowRefused}" Spacing="8">
        <Border Classes="notice">
          <StackPanel Spacing="4">
            <views:CopyableTextBlock Text="The parser declined this grammar" FontWeight="SemiBold" />
            <views:CopyableTextBlock Classes="muted" Text="Nothing can be assessed until it loads. The Details say why." TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Expander Header="Details" IsExpanded="False">
          <views:CopyableTextBlock Text="{Binding Grammar.Refusal.Message}" TextWrapping="Wrap" />
        </Expander>
        <Button Content="Try again"
                Classes="Primary" Theme="{DynamicResource SolidButton}"
                Command="{Binding Grammar.CheckCommand}"
                AutomationProperties.Name="Try checking the grammar again" />
      </StackPanel>

      <StackPanel IsVisible="{Binding Grammar.ShowNoBaseline}" Spacing="8">
        <views:CopyableTextBlock Classes="muted" Text="Capture a Baseline in Project before the grammar can be checked." TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel IsVisible="{Binding Grammar.ShowNoFindings}" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:CopyableTextBlock Text="No findings" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <views:CopyableTextBlock Classes="muted" Text="The parser loaded the grammar without warnings." HorizontalAlignment="Center" />
      </StackPanel>

      <Grid RowDefinitions="Auto,*" RowSpacing="10" IsVisible="{Binding Grammar.ShowFindings}">
        <DockPanel LastChildFill="False">
          <WrapPanel DockPanel.Dock="Left">
            <views:FilterChip Label="All" Count="{Binding Grammar.Warnings.TotalCount}"
                              IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.All}}"
                              Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.All}" />
            <views:FilterChip Label="Left out of the grammar" Count="{Binding Grammar.Warnings.LeftOutCount}" Verdict="Differs"
                              IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.LeftOut}}"
                              Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.LeftOut}" />
            <views:FilterChip Label="Worth a look" Count="{Binding Grammar.Warnings.WorthALookCount}" Verdict="Limit"
                              IsActive="{Binding Grammar.Warnings.Bucket, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:GrammarFindingBucket.WorthALook}}"
                              Command="{Binding Grammar.Warnings.SetBucketCommand}" CommandParameter="{x:Static vm:GrammarFindingBucket.WorthALook}" />
          </WrapPanel>
          <Button DockPanel.Dock="Right" Content="Reload grammar"
                  Command="{Binding Grammar.CheckCommand}"
                  AutomationProperties.Name="Check the grammar again" />
          <views:CopyableTextBlock DockPanel.Dock="Right" Classes="muted" Margin="0,0,12,0" VerticalAlignment="Center"
                     Text="Findings never block an Assessment." />
        </DockPanel>

        <Grid Grid.Row="1" ColumnDefinitions="320,*" ColumnSpacing="16">

          <!-- Left: every kind of finding, the ones where the parser left something out first. -->
          <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="2">
              <views:CopyableTextBlock Classes="muted" FontSize="12" FontWeight="SemiBold" Margin="8,4,0,2"
                         Text="{Binding Grammar.Warnings.LeftOutCount, StringFormat='LEFT OUT OF THE GRAMMAR · {0}'}"
                         IsVisible="{Binding Grammar.Warnings.HasLeftOutGroups}" />
              <ItemsControl ItemsSource="{Binding Grammar.Warnings.LeftOutGroups}" IsVisible="{Binding Grammar.Warnings.HasLeftOutGroups}"
                            AutomationProperties.Name="Kinds of finding left out of the grammar">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GrammarFindingGroupViewModel">
                    <Button Classes="findingGroup" Classes.chosen="{Binding IsSelected}"
                            Command="{Binding $parent[views:GrammarPanel].Grammar.Warnings.SelectGroupCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                      <DockPanel>
                        <views:VerdictChip DockPanel.Dock="Right" Verdict="{Binding Meaning}" Text="{Binding Count}" Compact="True" />
                        <TextBlock Classes="groupName" Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center" />
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <views:CopyableTextBlock Classes="muted" FontSize="12" FontWeight="SemiBold" Margin="8,12,0,2"
                         Text="{Binding Grammar.Warnings.WorthALookCount, StringFormat='WORTH A LOOK · {0}'}"
                         IsVisible="{Binding Grammar.Warnings.HasWorthALookGroups}" />
              <ItemsControl ItemsSource="{Binding Grammar.Warnings.WorthALookGroups}" IsVisible="{Binding Grammar.Warnings.HasWorthALookGroups}"
                            AutomationProperties.Name="Kinds of finding worth a look">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GrammarFindingGroupViewModel">
                    <Button Classes="findingGroup" Classes.chosen="{Binding IsSelected}"
                            Command="{Binding $parent[views:GrammarPanel].Grammar.Warnings.SelectGroupCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                      <DockPanel>
                        <views:VerdictChip DockPanel.Dock="Right" Verdict="{Binding Meaning}" Text="{Binding Count}" Compact="True" />
                        <TextBlock Classes="groupName" Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center" />
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- Right: the chosen kind's findings, each with the objects it names linked into FieldWorks. -->
          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <views:CopyableTextBlock Classes="section-title" Text="{Binding Grammar.Warnings.SelectedGroupTitle}" TextWrapping="Wrap" />
              <views:CopyableTextBlock Classes="muted" Text="{Binding Grammar.Warnings.CountSummary}" VerticalAlignment="Center" />
            </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,2*" ColumnSpacing="6">
          <TextBox Grid.Column="0" Text="{Binding Grammar.Warnings.WhereFilter}"
                   PlaceholderText="Where..." AutomationProperties.Name="Filter grammar warnings by where they apply" />
          <TextBox Grid.Column="1" Text="{Binding Grammar.Warnings.ProblemFilter}"
                   PlaceholderText="Problem..." AutomationProperties.Name="Filter grammar warnings by problem" />
        </Grid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Grammar.Warnings.Rows}"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal"
                  ClipboardCopyMode="IncludeHeader"
                  AutomationProperties.Name="Grammar warnings">
          <DataGrid.Columns>
            <!-- A DataGridColumn's Binding has no compiled-binding item scope of its own (unlike a
                 DataTemplate); ReflectionBinding is the documented per-binding opt-out. -->
            <DataGridTemplateColumn Header="Where" Width="*" SortMemberPath="Where"
                                    ClipboardContentBinding="{ReflectionBinding Where}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:GrammarWarningRowViewModel">
                  <views:GrammarWarningPartsBlock Parts="{Binding SubjectParts}" Margin="6,4" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Problem" Width="2*" SortMemberPath="Problem"
                                    ClipboardContentBinding="{ReflectionBinding Problem}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:GrammarWarningRowViewModel">
                  <views:GrammarWarningPartsBlock Parts="{Binding ProblemParts}" Margin="6,4"
                                                  ToolTip.Tip="{Binding Text}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
          </Grid>
        </Grid>
      </Grid>
    </Panel>
  </Grid>
</UserControl>
