<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             x:Class="SIL.Motif.App.Views.KeyboardShortcutsFlyoutView">
  <Border Classes="card" Width="{DynamicResource Component.Shell.HelpWidth}"
          MaxHeight="{DynamicResource Component.Shell.HelpHeight}">
    <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
      <TextBlock Classes="section-title" Text="{x:Static app:KeyboardShortcutRegistry.Title}" />
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="KeyboardShortcutsFlyoutViewShortcutsItems"
                      ItemsSource="{x:Static app:KeyboardShortcutRegistry.Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="app:KeyboardShortcutEntry">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Related}"
                    RowDefinitions="Auto,Auto" Margin="{DynamicResource Intent.Gap.AfterRelated}">
                <TextBlock Classes="wordRowNumber" Text="{Binding Gesture}" />
                <TextBlock Grid.Column="1" Text="{Binding Action}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" Text="{Binding Scope}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
  </Border>
</UserControl>
