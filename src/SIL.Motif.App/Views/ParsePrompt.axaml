<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:SIL.Motif.App.Views"
             xmlns:vm="using:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ParsePrompt"
             x:DataType="vm:WorkspaceContext">
  <StackPanel Spacing="{DynamicResource Intent.Space.Related}" HorizontalAlignment="Center"
              IsVisible="{Binding NeedsAssessment}">
    <views:CopyableTextBlock Classes="muted" Text="{Binding ParsePromptText}" TextWrapping="Wrap" />
    <Button Content="{Binding ParsePromptActionText}" Command="{Binding ParsePromptActionCommand}"
            IsVisible="{Binding ShowParsePromptAction}" HorizontalAlignment="Center"
            AutomationProperties.Name="{Binding ParsePromptActionText}" />
  </StackPanel>
</UserControl>
