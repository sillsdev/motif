<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:app="clr-namespace:SIL.Motif.App" xmlns:views="clr-namespace:SIL.Motif.App.Views" xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
 x:Class="SIL.Motif.App.Views.Settings.AssistantConnectionsPanel" x:DataType="vm:AssistantConnectionsViewModel">
 <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
  <views:CopyableTextBlock Classes="settingsGroupHeading" Text="{x:Static app:MotifAppStrings.AssistantConnectionsHeading}" />

  <views:CopyableTextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.AdvancedAiModeTitle}" />
  <views:CopyableTextBlock TextWrapping="Wrap" Text="{x:Static app:MotifAppStrings.AdvancedAiModeExplanation}" />
  <CheckBox Content="{x:Static app:MotifAppStrings.TurnOnAdvancedAiMode}" IsChecked="{Binding IsEnabled}" />
  <views:CopyableTextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.ChatGptTitle}" />
  <views:CopyableTextBlock TextWrapping="Wrap" Text="{x:Static app:MotifAppStrings.ChatGptKeyHelp}" />
  <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.ChatGptKey}" />
  <TextBox PasswordChar="●" Text="{Binding ChatGptKey}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ChatGptKey}" />
  <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.ChatGptTunnelId}" />
  <TextBox Text="{Binding ChatGptTunnelId}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ChatGptTunnelId}" />
  <WrapPanel ItemSpacing="{DynamicResource Intent.Space.Compact}" LineSpacing="{DynamicResource Intent.Space.Compact}">
    <Button Content="{x:Static app:MotifAppStrings.ChatGptConnect}" Command="{Binding ConnectChatGptCommand}" />
    <Button Content="{x:Static app:MotifAppStrings.ChatGptDisconnect}" Command="{Binding DisconnectChatGptCommand}" />
  </WrapPanel>
  <views:CopyableTextBlock Text="{Binding ChatGptStatus}" TextWrapping="Wrap" />
  <views:CopyableTextBlock Text="{Binding ChatGptSaveWarning}" TextWrapping="Wrap" />
  <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.ChatGptInstructions}" TextWrapping="Wrap" />
  <Border Classes="notice" IsVisible="{Binding HasVersionWarning}">
    <views:CopyableTextBlock Text="{Binding VersionWarning}" TextWrapping="Wrap" />
  </Border>
  <views:CopyableTextBlock Classes="settingsLabelText" Text="{x:Static app:MotifAppStrings.ChooseAssistantsTitle}" />
  <views:CopyableTextBlock TextWrapping="Wrap" Text="{x:Static app:MotifAppStrings.ChooseAssistantsExplanation}" />
  <views:CopyableTextBlock TextWrapping="Wrap" Text="{Binding EmptyAssistantText}" IsVisible="{Binding HasNoAssistants}"
                           AutomationProperties.AutomationId="{x:Static app:AutomationIds.AssistantsEmptyText}" />
  <ItemsControl x:Name="AssistantConnectionsItems" ItemsSource="{Binding Assistants}" IsVisible="{Binding HasAssistants}">
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:AssistantChoiceViewModel">
        <CheckBox IsChecked="{Binding IsSelected}"><TextBlock Text="{Binding Name}" /></CheckBox>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
  <Button Content="{x:Static app:MotifAppStrings.ConnectSelectedAssistants}" Command="{Binding ConnectSelectedCommand}" />
  <views:CopyableTextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" TextWrapping="Wrap" />
  <WrapPanel IsVisible="{Binding ShowsDesktopUpload}" ItemSpacing="{DynamicResource Intent.Space.Compact}" LineSpacing="{DynamicResource Intent.Space.Compact}">
    <Button Content="{x:Static app:MotifAppStrings.OpenPluginFolder}" Command="{Binding OpenPluginZipCommand}" />
    <Button Content="{x:Static app:MotifAppStrings.OpenClaudePlugins}" Command="{Binding OpenClaudePluginsCommand}" />
  </WrapPanel>

 </StackPanel>
</UserControl>
