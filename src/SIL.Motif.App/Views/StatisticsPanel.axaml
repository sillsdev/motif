<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.StatisticsPanel"
             x:DataType="views:StatisticsPanel">
  <DockPanel Margin="{DynamicResource Component.Statistics.PageMargin}">

    <!-- What the numbers say, before the numbers: three cards for a word grouping. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Intent.Space.Group}"
          Margin="{DynamicResource Intent.Gap.AfterGroup}"
          IsVisible="{Binding Statistics.HasWordRows}">
      <Border Grid.Column="0" Classes="card">
        <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
          <views:CopyableTextBlock Text="{Binding Statistics.IncompleteHeadline}" FontWeight="{DynamicResource Intent.Weight.Section}" TextWrapping="Wrap" />
          <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Statistics.IncompleteDetail}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
          <views:CopyableTextBlock Text="{Binding Statistics.AnalysesHeadline}" FontWeight="{DynamicResource Intent.Weight.Section}" TextWrapping="Wrap" />
          <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Statistics.AnalysesDetail}" />
        </StackPanel>
      </Border>
    </Grid>

    <DockPanel LastChildFill="False" DockPanel.Dock="Top" Margin="{DynamicResource Intent.Gap.AfterRelated}">
      <ComboBox x:Name="StatisticsPanelGroupChoicesItems" ItemsSource="{Binding Statistics.GroupChoices}"
                SelectedItem="{Binding Statistics.SelectedGroupChoice}"
                AutomationProperties.Name="{x:Static app:MotifAppStrings.StatisticsGroupAccessibleName}"
                Margin="{DynamicResource Intent.Gap.AfterGroup}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:StatsGroupChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBox Text="{Binding Statistics.FilterText}"
               PlaceholderText="{x:Static app:MotifAppStrings.StatisticsFilterPlaceholder}"
               Width="{DynamicResource Component.Statistics.FilterWidth}"
               AutomationProperties.Name="{x:Static app:MotifAppStrings.FilterStatisticsRowsAccessibleName}"
               Margin="{DynamicResource Intent.Gap.AfterGroup}" />
      <views:FilterChip Label="All rows" Count="{Binding Statistics.RowCount}" Margin="{DynamicResource Intent.Gap.AfterRelated}"
                        IsActive="{Binding !Statistics.OnlyIncomplete}" Click="OnAllRowsClick" />
      <views:FilterChip Label="Stopped" Count="{Binding Statistics.IncompleteCount}" Mark="{x:Static vm:Mark.Stopped}" Margin="{DynamicResource Intent.Gap.AfterGroup}"
                        IsActive="{Binding Statistics.OnlyIncomplete}" Click="OnOnlyIncompleteClick" />
    </DockPanel>

    <views:CopyableTextBlock DockPanel.Dock="Top" Classes="muted"
               Text="{Binding Statistics.ScopeNote}"
               AutomationProperties.Name="{x:Static app:MotifAppStrings.StatisticsWordScopeAccessibleName}" />

    <views:RefusalBlock DataContext="{Binding Statistics.ShownRefusal}" DockPanel.Dock="Top" />
    <views:CopyableTextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="{DynamicResource Intent.Type.Label}" Margin="{DynamicResource Intent.Gap.AfterRelated}" HorizontalAlignment="Stretch" TextWrapping="Wrap"
               Text="{Binding Statistics.ShadingNote}" />
    <views:CopyableTextBlock Text="{x:Static app:MotifAppStrings.StatisticsStaleNotice}"
               IsVisible="{Binding Statistics.IsStale}"
               FontStyle="Italic"
               DockPanel.Dock="Top" />

    <DataGrid x:Name="Grid" ItemsSource="{Binding Statistics.Rows}" ColumnWidth="*"
              MinHeight="{DynamicResource Component.Statistics.MinimumViewportHeight}"
              MaxHeight="{DynamicResource Component.Statistics.ViewportHeight}"
              IsReadOnly="True"
              CanUserSortColumns="True"
              ClipboardCopyMode="IncludeHeader"
              Sorting="OnGridSorting"
              AutomationProperties.Name="{x:Static app:MotifAppStrings.StatisticsRowsAccessibleName}">
      <DataGrid.Columns>
        <!-- A DataGridColumn's Binding has no compiled-binding item scope of its own (unlike a
             DataTemplate); ReflectionBinding is the documented per-binding opt-out. -->
        <DataGridTemplateColumn Header="{x:Static app:MotifAppStrings.StatisticsColumnKind}" Tag="kind" ClipboardContentBinding="{ReflectionBinding Kind}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StatsRowViewModel">
              <views:CopyableTextBlock Text="{Binding Kind}" Margin="{DynamicResource Component.Statistics.CellMargin}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static app:MotifAppStrings.StatisticsColumnObject}" Tag="object" ClipboardContentBinding="{ReflectionBinding Object}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StatsRowViewModel">
              <views:CopyableTextBlock Text="{Binding Object}" TextTrimming="CharacterEllipsis"
                                      ToolTip.Tip="{Binding Object}" views:ClearTipPlacement.IsEnabled="True"
                                      Background="{DynamicResource Intent.Clear}"
                                      Margin="{DynamicResource Component.Statistics.CellMargin}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static app:MotifAppStrings.Word}" Tag="word" MinWidth="{StaticResource Component.Statistics.WordMinWidth}" ClipboardContentBinding="{ReflectionBinding Word}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StatsRowViewModel">
              <views:CopyableTextBlock Text="{Binding Word}" TextTrimming="CharacterEllipsis"
                                      ToolTip.Tip="{Binding Word}" views:ClearTipPlacement.IsEnabled="True"
                                      Background="{DynamicResource Intent.Clear}"
                                      Margin="{DynamicResource Component.Statistics.CellMargin}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static app:MotifAppStrings.StatisticsColumnCompletion}" Tag="completion" MinWidth="{StaticResource Component.Statistics.CompletionMinWidth}" ClipboardContentBinding="{ReflectionBinding CompletionStatus}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StatsRowViewModel">
              <views:MarkChip Mark="{Binding CompletionMark}" Text="{Binding CompletionShort}" Compact="True"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="{DynamicResource Component.Statistics.CellMargin}" HorizontalAlignment="Left" IsVisible="{Binding HasCompletion}"
                                 ToolTip.Tip="{Binding CompletionStatus}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static app:MotifAppStrings.StatsHeaderAttempts}" Tag="attempts" Width="Auto" ClipboardContentBinding="{ReflectionBinding Attempts}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StatsRowViewModel">
              <views:HeatCell Text="{Binding AttemptsText}" TextToolTip="{Binding AttemptsText}"
                              Intensity="{Binding AttemptsHeat}" Margin="{DynamicResource Component.Statistics.CellMargin}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static app:MotifAppStrings.StatisticsColumnAnalyses}" Tag="passes" Width="Auto" ClipboardContentBinding="{ReflectionBinding Passes}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StatsRowViewModel">
              <views:HeatCell Text="{Binding PassesText}" TextToolTip="{Binding PassesText}"
                              Intensity="{Binding PassesHeat}" Margin="{DynamicResource Component.Statistics.CellMargin}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static app:MotifAppStrings.StatsHeaderWorkSteps}" Tag="workSteps" Width="Auto" ClipboardContentBinding="{ReflectionBinding WorkSteps}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StatsRowViewModel">
              <views:HeatCell Text="{Binding WorkText}" TextToolTip="{Binding WorkText}"
                              Intensity="{Binding WorkHeat}" Margin="{DynamicResource Component.Statistics.CellMargin}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</UserControl>
