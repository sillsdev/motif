<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.DifferencePanel"
             x:DataType="views:DifferencePanel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource Intent.Space.Related}"
        Margin="{DynamicResource Component.DifferencePanel.PanelInset}"
        IsVisible="{Binding Difference.HasDifference}">
    <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
      <views:CopyableTextBlock Text="{Binding Difference.Summary}"
                               FontSize="{DynamicResource Intent.Type.Section}" FontWeight="SemiBold" />
      <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Small}"
                               Text="{Binding Difference.OnlyInOneText}" />
      <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Small}"
                               Text="{Binding Difference.RunComparisonText}" />
    </StackPanel>

    <ListBox Grid.Row="1" Classes="dense" MaxHeight="{DynamicResource Component.DifferencePanel.MoveListHeight}"
             ItemsSource="{Binding Difference.Moves}" AutomationProperties.Name="Moves between cells, worst first">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:MoveViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}"
                AutomationProperties.Name="{Binding AccessibleName}">
            <views:MarkChip Mark="{Binding Mark}" Text="{Binding KindLabel}" Compact="True"
                            HorizontalAlignment="Left" />
            <views:CopyableTextBlock Grid.Column="1" Text="{Binding TransitionText}"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <views:CopyableTextBlock Grid.Column="2" Text="{Binding CountText}" FontWeight="SemiBold"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <views:WordRowHeader Grid.Row="2" Columns="{x:Static views:WordRowColumnSets.WhatChanged}"
                         IsVisible="{Binding Difference.HasChosenMove}" />
    <ListBox Grid.Row="3" Classes="wordRows" ItemsSource="{Binding Difference.Words}"
             AutomationProperties.Name="Words in the chosen move"
             IsVisible="{Binding Difference.HasChosenMove}" KeyboardNavigation.TabNavigation="Continue">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:MovedWordViewModel">
          <views:WordRow Row="{Binding Listed.Row}" List="what-changed" IsOpen="{Binding Listed.IsOpen}"
                         Columns="{x:Static views:WordRowColumnSets.WhatChanged}" Note="{Binding BeforeNote}">
            <views:WordRow.Card>
              <views:ListedWordCard DataContext="{Binding Listed}" />
            </views:WordRow.Card>
          </views:WordRow>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
