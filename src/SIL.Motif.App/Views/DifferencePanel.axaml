<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.DifferencePanel"
             x:DataType="views:DifferencePanel">
  <Grid ColumnSpacing="{DynamicResource Component.DifferencePanel.ColumnGap}"
        Margin="{DynamicResource Component.DifferencePanel.PanelInset}"
        IsVisible="{Binding Difference.HasDifference}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="{Binding Source={StaticResource Component.DifferencePanel.InspectorWidth}, Converter={x:Static views:DifferencePanel.SizeToGridLength}}" />
    </Grid.ColumnDefinitions>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="{DynamicResource Intent.Space.Related}"
          Grid.IsSharedSizeScope="True">

      <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
        <views:CopyableTextBlock Text="{Binding Difference.Summary}" FontSize="{DynamicResource Intent.Type.Section}" FontWeight="SemiBold" />
        <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Small}" Text="{Binding Difference.OnlyInOneText}" />
      </StackPanel>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Section}">
        <Border Classes="card" Padding="{DynamicResource Component.DifferencePanel.CardPadding}">
          <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
            <views:CopyableTextBlock Text="Before" FontWeight="SemiBold" />
            <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Label}" Text="{Binding Difference.BeforeLabel}" />
            <views:MiniMatrix DataContext="{Binding Difference.Before}" IsInteractive="False" Hint="The chosen move starts in the outlined cell" />
          </StackPanel>
        </Border>
        <TextBlock Text="→" FontSize="{DynamicResource Component.DifferencePanel.MoveArrowSize}" VerticalAlignment="Center" Classes="muted" />
        <Border Classes="card" Padding="{DynamicResource Component.DifferencePanel.CardPadding}">
          <StackPanel Spacing="{DynamicResource Intent.Space.Compact}">
            <views:CopyableTextBlock Text="After" FontWeight="SemiBold" />
            <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Label}" Text="{Binding Difference.AfterLabel}" />
            <views:MiniMatrix DataContext="{Binding Difference.After}" IsInteractive="False" Hint="and ends in the outlined cell here" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Grid Grid.Row="2" Margin="{DynamicResource Component.DifferencePanel.MoveHeaderMargin}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding Source={StaticResource Component.DifferencePanel.KindColumnWidth}, Converter={x:Static views:DifferencePanel.SizeToGridLength}}" />
          <ColumnDefinition Width="{Binding Source={StaticResource Component.DifferencePanel.CellColumnWidth}, Converter={x:Static views:DifferencePanel.SizeToGridLength}}" />
          <ColumnDefinition Width="{Binding Source={StaticResource Component.DifferencePanel.ArrowColumnWidth}, Converter={x:Static views:DifferencePanel.SizeToGridLength}}" />
          <ColumnDefinition Width="{Binding Source={StaticResource Component.DifferencePanel.KindColumnWidth}, Converter={x:Static views:DifferencePanel.SizeToGridLength}}" />
          <ColumnDefinition Width="{Binding Source={StaticResource Component.DifferencePanel.CellColumnWidth}, Converter={x:Static views:DifferencePanel.SizeToGridLength}}" />
          <ColumnDefinition Width="{Binding Source={StaticResource Component.DifferencePanel.CountColumnWidth}, Converter={x:Static views:DifferencePanel.SizeToGridLength}}" />
        </Grid.ColumnDefinitions>
        <views:CopyableTextBlock Grid.Column="0" Classes="columnHeader" Text="WHAT IT MEANS" />
        <views:CopyableTextBlock Grid.Column="1" Classes="columnHeader" Text="FROM" />
        <views:CopyableTextBlock Grid.Column="3" Classes="columnHeader" Text="" />
        <views:CopyableTextBlock Grid.Column="4" Classes="columnHeader" Text="TO" />
        <views:CopyableTextBlock Grid.Column="5" Classes="columnHeader" Text="WORDS" HorizontalAlignment="Right" />
      </Grid>
      <ListBox Grid.Row="3" Classes="dense" MaxHeight="{DynamicResource Component.DifferencePanel.MoveListHeight}" ItemsSource="{Binding Difference.Moves}"
               SelectedItem="{Binding Difference.SelectedMove}" AutomationProperties.Name="Moves between cells, worst first">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MoveViewModel">
            <Grid AutomationProperties.Name="{Binding AccessibleName}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Source={StaticResource Component.DifferencePanel.KindColumnWidth}, Converter={x:Static views:DifferencePanel.SizeToGridLength}}" />
                <ColumnDefinition Width="{Binding Source={StaticResource Component.DifferencePanel.CellColumnWidth}, Converter={x:Static views:DifferencePanel.SizeToGridLength}}" />
                <ColumnDefinition Width="{Binding Source={StaticResource Component.DifferencePanel.ArrowColumnWidth}, Converter={x:Static views:DifferencePanel.SizeToGridLength}}" />
                <ColumnDefinition Width="{Binding Source={StaticResource Component.DifferencePanel.KindColumnWidth}, Converter={x:Static views:DifferencePanel.SizeToGridLength}}" />
                <ColumnDefinition Width="{Binding Source={StaticResource Component.DifferencePanel.CellColumnWidth}, Converter={x:Static views:DifferencePanel.SizeToGridLength}}" />
                <ColumnDefinition Width="{Binding Source={StaticResource Component.DifferencePanel.CountColumnWidth}, Converter={x:Static views:DifferencePanel.SizeToGridLength}}" />
              </Grid.ColumnDefinitions>
              <views:MarkChip Grid.Column="0" Mark="{Binding Mark}" Text="{Binding KindLabel}" Compact="True" HorizontalAlignment="Left" />
              <StackPanel Grid.Column="1">
                <views:CopyableTextBlock Text="{Binding FromLabel}" FontSize="{DynamicResource Intent.Type.Status}" />
                <views:CopyableTextBlock Classes="muted" Text="{Binding FromRow}" FontSize="{DynamicResource Intent.Type.Label}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="muted" Text="→" VerticalAlignment="Center" />
              <StackPanel Grid.Column="4">
                <views:CopyableTextBlock Text="{Binding ToLabel}" FontSize="{DynamicResource Intent.Type.Status}" Classes.error="{Binding IsRegression}" />
                <views:CopyableTextBlock Classes="muted" Text="{Binding ToRow}" FontSize="{DynamicResource Intent.Type.Label}" />
              </StackPanel>
              <views:CopyableTextBlock Grid.Column="5" Text="{Binding CountText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <views:WordRowHeader Grid.Row="4" Columns="{x:Static views:WordRowColumnSets.WhatChanged}"
                           IsVisible="{Binding Difference.HasChosenMove}" />
      <ListBox Grid.Row="5" Classes="wordRows" ItemsSource="{Binding Difference.Words}" AutomationProperties.Name="Words in the chosen move"
               IsVisible="{Binding Difference.HasChosenMove}" KeyboardNavigation.TabNavigation="Continue">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MovedWordViewModel">
            <views:WordRow Row="{Binding Listed.Row}" List="what-changed" IsOpen="{Binding Listed.IsOpen}"
                           Columns="{x:Static views:WordRowColumnSets.WhatChanged}" Note="{Binding BeforeNote}">
              <views:WordRow.Card>
                <views:ListedWordCard DataContext="{Binding Listed}" />
              </views:WordRow.Card>
            </views:WordRow>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <StackPanel Grid.Column="1" Spacing="{DynamicResource Intent.Space.Group}">
      <Border Classes="card" Padding="{DynamicResource Component.DifferencePanel.CardPadding}">
        <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
          <views:CopyableTextBlock Text="Where the two sides come from" FontWeight="SemiBold" />
          <views:CopyableTextBlock FontSize="{DynamicResource Intent.Type.Small}" TextWrapping="Wrap"
                                   Text="The run before this one, and this one: the same words measured twice, joined word by word. After a re-run, only the re-run words can move; the rest are the same answers." />
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="{DynamicResource Component.DifferencePanel.CardPadding}">
        <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
          <views:CopyableTextBlock Text="Reading a move" FontWeight="SemiBold" />
          <views:CopyableTextBlock FontSize="{DynamicResource Intent.Type.Small}" TextWrapping="Wrap"
                                   Text="Regressions come first: a word that now breaks a decision, or lost its analysis. A word that no longer runs out of time is settled, never a regression, unless its new result breaks a decision." />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
