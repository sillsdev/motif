<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.ListWordCard">
  <StackPanel x:Name="Root" Classes="listCard" x:DataType="vm:ListWordCardViewModel">
    <Panel x:Name="AlignmentHost" />
    <views:CopyableTextBlock Classes="listCardSentence" Text="{Binding WhereTheyPart}" TextWrapping="Wrap" />
    <Button Classes="listCardCompare" Content="{Binding CompareLabel}" Command="{Binding CompareCommand}"
            HorizontalAlignment="Left" AutomationProperties.Name="{Binding CompareName}" />
  </StackPanel>
</UserControl>
