<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             x:Class="SIL.Motif.App.Views.ExpertTracePanel"
             x:DataType="vm:TraceWordViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/TryWordScoped.axaml" />
  </UserControl.Styles>
  <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
    <WrapPanel ItemSpacing="{DynamicResource Intent.Space.Related}" LineSpacing="{DynamicResource Intent.Space.Compact}">
      <ComboBox x:Name="ExpertTracePanelExpertAttemptsItems" ItemsSource="{Binding ExpertAttempts}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                PlaceholderText="{x:Static app:MotifAppStrings.ExpertAnalysisPathPlaceholder}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ExpertAttemptAccessibleName}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TraceCandidateViewModel">
            <TextBlock Text="{Binding AttemptId, StringFormat='Attempt {0}'}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <CheckBox Content="{x:Static app:MotifAppStrings.EveryStep}" IsChecked="{Binding ExpertWholeTree, Mode=TwoWay}"
                AutomationProperties.Name="{x:Static app:MotifAppStrings.ExpertWholeTreeAccessibleName}" ToolTip.Tip="{x:Static app:MotifAppStrings.ExpertEveryStepTip}" />
    </WrapPanel>
    <TextBlock Text="{Binding ExpertScopeText}" Classes="muted" TextWrapping="Wrap"
               IsVisible="{Binding ExpertScopeText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
    <Grid ColumnSpacing="{DynamicResource Intent.Space.Related}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="1.25*" MinWidth="{DynamicResource Component.TryWord.TraceOutcomeColumnMinWidth}" />
        <ColumnDefinition Width="2*" MinWidth="{DynamicResource Component.TryWord.TraceNotationColumnMinWidth}" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Static app:MotifAppStrings.EventSource}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Text="{x:Static app:MotifAppStrings.InputOutput}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="2" Text="{x:Static app:MotifAppStrings.Outcome}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="3" Text="{x:Static app:MotifAppStrings.Notation}" TextWrapping="Wrap" />
    </Grid>
    <ItemsControl x:Name="ExpertTracePanelExpertEventsItems" ItemsSource="{Binding ExpertEvents}" AutomationProperties.Name="{x:Static app:MotifAppStrings.ExpertTraceEventsAccessibleName}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TraceStepViewModel">
          <Border Classes="hoverReveal" BorderBrush="{DynamicResource Intent.Border}" BorderThickness="{DynamicResource Intent.Stroke.DividerBottom}"
                  Padding="{DynamicResource Component.TryWord.SmallInset}" Background="{DynamicResource Intent.Clear}">
            <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
            <Grid ColumnSpacing="{DynamicResource Intent.Space.Related}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="1.25*" MinWidth="{DynamicResource Component.TryWord.TraceOutcomeColumnMinWidth}" />
        <ColumnDefinition Width="2*" MinWidth="{DynamicResource Component.TryWord.TraceNotationColumnMinWidth}" />
      </Grid.ColumnDefinitions>
              <WrapPanel ItemSpacing="{DynamicResource Intent.Space.Related}">
                <TextBlock Text="{Binding KindText}" TextWrapping="Wrap" />
                <views:InspectLink Subject="{Binding InspectSubject}" Captured="{Binding Captured}" IsVisible="{Binding CanInspect}">
                  <TextBlock Text="{Binding SourceLabel}" TextWrapping="Wrap" />
                </views:InspectLink>
                <TextBlock Text="{Binding SourceLabel}" IsVisible="{Binding HasUnlinkedSource}" TextWrapping="Wrap" />

              </WrapPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Minimal}">
                <views:TraceNotationToken Classes="traceToken" Theme="{DynamicResource BorderlessButton}"
                                          ToolTip.Tip="{Binding InputTip}" AutomationProperties.Name="{Binding InputTip}">
                  <TextBlock Text="{Binding Input}" TextWrapping="Wrap" />
                </views:TraceNotationToken>
                <TextBlock Text="→" VerticalAlignment="Center" />
                <views:TraceNotationToken Classes="traceToken" Theme="{DynamicResource BorderlessButton}"
                                          ToolTip.Tip="{Binding OutputTip}" AutomationProperties.Name="{Binding OutputTip}">
                  <TextBlock Text="{Binding Output}" TextWrapping="Wrap" />
                </views:TraceNotationToken>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="{DynamicResource Intent.Space.Minimal}">
                <TextBlock Text="{Binding RecordedOutcomeText}" TextWrapping="Wrap" />
                <views:TraceNotationToken Classes="traceToken" Theme="{DynamicResource BorderlessButton}" ToolTip.Tip="{x:Static app:MotifAppStrings.ExpertSubruleIndexTip}"
                                          IsVisible="{Binding HasSubrule}">
                  <TextBlock Text="{Binding SubruleText}" TextWrapping="Wrap" />
                </views:TraceNotationToken>
              </StackPanel>
              <StackPanel Grid.Column="3" Spacing="{DynamicResource Intent.Space.Minimal}">
                <views:TraceNotationToken Classes="traceToken" Command="{Binding $parent[views:ExpertTracePanel].((vm:TraceWordViewModel)DataContext).SelectExpertStepCommand}" CommandParameter="{Binding}"
                        Theme="{DynamicResource BorderlessButton}" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="{Binding RecordedEventAddress}" ToolTip.Tip="{x:Static app:MotifAppStrings.ExpertOccurrenceTip}">
                  <StackPanel>
                    <TextBlock Text="{Binding RecordedStep.StepId}" Classes="traceNotation" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Type}" Classes="traceNotation" TextWrapping="Wrap" />
                  </StackPanel>
                </views:TraceNotationToken>
              </StackPanel>
            </Grid>
            <views:CopyableTextBlock Text="{Binding ReadableText}" IsVisible="{Binding IsSelected}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Expander IsExpanded="False" AutomationProperties.Name="{x:Static app:MotifAppStrings.ExpertPhonologicalRulesAccessibleName}">
      <Expander.Header>
        <TextBlock Text="{x:Static app:MotifAppStrings.PhonologicalRulesApplied}" TextWrapping="Wrap" />
      </Expander.Header>
      <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
        <TextBlock Text="{x:Static app:MotifAppStrings.ExpertPhonologicalEventsNote}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="{x:Static app:MotifAppStrings.ExpertNoPhonologicalEvents}" IsVisible="{Binding !HasExpertPhonologicalEvents}"
                   Classes="muted" TextWrapping="Wrap" />
        <ItemsControl x:Name="ExpertTracePanelExpertPhonologicalEventsItems" ItemsSource="{Binding ExpertPhonologicalEvents}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TraceStepViewModel">
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource Intent.Space.Related}">
                <Button Classes="traceToken" Command="{Binding $parent[views:ExpertTracePanel].((vm:TraceWordViewModel)DataContext).SelectExpertStepCommand}" CommandParameter="{Binding}"
                        Theme="{DynamicResource BorderlessButton}" HorizontalContentAlignment="Left">
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                </Button>
                <StackPanel Grid.Column="1">
                  <views:TraceNotationToken Classes="traceToken" Theme="{DynamicResource BorderlessButton}"
                                            ToolTip.Tip="{Binding InputTip}" AutomationProperties.Name="{Binding InputTip}">
                    <TextBlock Text="{Binding Input}" TextWrapping="Wrap" />
                  </views:TraceNotationToken>
                  <views:TraceNotationToken Classes="traceToken" Theme="{DynamicResource BorderlessButton}"
                                            ToolTip.Tip="{Binding OutputTip}" AutomationProperties.Name="{Binding OutputTip}">
                    <TextBlock Text="{Binding Output}" TextWrapping="Wrap" />
                  </views:TraceNotationToken>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{Binding RecordedEventAddress}" Classes="traceNotation" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RecordedOutcomeText}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Expander>
    <Border Classes="card" IsVisible="{Binding SelectedStep, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="{DynamicResource Intent.Space.Related}">
        <TextBlock Text="{x:Static app:MotifAppStrings.SelectedEvent}" />
        <TextBlock Text="{Binding SelectedStep.RecordedEventAddress}" Classes="traceNotation" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="1.05*,*" ColumnSpacing="{DynamicResource Intent.Space.Related}">
          <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
            <TextBlock Text="{x:Static app:MotifAppStrings.Readable}" />
            <views:CopyableTextBlock Text="{Binding ExpertReadableText}" TextWrapping="Wrap" />
            <Expander IsExpanded="False">
              <Expander.Header>
                <TextBlock Text="{x:Static app:MotifAppStrings.RecordedRejectionDetails}" TextWrapping="Wrap" />
              </Expander.Header>
              <views:CopyableTextBlock Text="{Binding SelectedStep.RecordedRejectionText}" TextWrapping="Wrap" />
            </Expander>
          </StackPanel>
          <Expander Grid.Column="1" IsExpanded="False">
            <Expander.Header>
              <TextBlock Text="{x:Static app:MotifAppStrings.ParserRecord}" TextWrapping="Wrap" />
            </Expander.Header>
            <views:CopyableTextBlock Text="{Binding ExpertRawRecord}" Classes="traceNotation" TextWrapping="Wrap" />
          </Expander>
        </Grid>
        <Expander IsExpanded="False" AutomationProperties.Name="{x:Static app:MotifAppStrings.ExpertEnvironmentNotationAccessibleName}">
          <Expander.Header>
            <TextBlock Text="{x:Static app:MotifAppStrings.EnvironmentNotation}" TextWrapping="Wrap" />
          </Expander.Header>
          <StackPanel>
          <TextBlock Text="{x:Static app:MotifAppStrings.EnvironmentNotRecorded}" IsVisible="{Binding !HasExpertEnvironment}" Classes="muted" />
          <ItemsControl x:Name="ExpertTracePanelExpertEnvironmentTokensItems" ItemsSource="{Binding ExpertEnvironmentTokens}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EnvironmentToken">
                <Grid ColumnDefinitions="*,3*" ColumnSpacing="{DynamicResource Intent.Space.Related}">
                  <views:TraceNotationToken Theme="{DynamicResource BorderlessButton}" Classes="traceToken"
                                            ToolTip.Tip="{Binding Explanation}">
                    <TextBlock Text="{Binding Raw}" TextWrapping="Wrap" />
                  </views:TraceNotationToken>
                  <TextBlock Grid.Column="1" Text="{Binding Explanation}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
