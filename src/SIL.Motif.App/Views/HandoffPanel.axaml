<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.HandoffPanel"
             x:DataType="views:HandoffPanel">
  <StackPanel Spacing="16" Margin="24">

    <StackPanel Spacing="4">
      <views:CopyableTextBlock Classes="stage-title" Text="Handoff" />
      <views:CopyableTextBlock Classes="muted"
                 Text="Give a chat model the files it needs to help you read this Assessment."
                 TextWrapping="Wrap" />
    </StackPanel>

    <Border Classes="notice">
      <views:CopyableTextBlock Text="{Binding Handoff.DataSensitivitySentence}" TextWrapping="Wrap" />
    </Border>

    <ProgressBar IsVisible="{Binding Handoff.IsActive}"
                 IsIndeterminate="{Binding Handoff.IsIndeterminate}"
                 Minimum="0"
                 Maximum="1"
                 Value="{Binding Handoff.ProgressFraction}"
                 AutomationProperties.Name="Handoff progress" />
    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding Handoff.IsActive}">
      <views:CopyableTextBlock Text="{Binding Handoff.Progress.Message}" VerticalAlignment="Center" />
      <Button Content="Cancel"
              Command="{Binding Handoff.CancelCommand}"
              AutomationProperties.Name="Cancel the running Handoff" />
    </StackPanel>

    <views:CopyableTextBlock Classes="error" Text="{Binding Handoff.Refusal.Message}"
               IsVisible="{Binding Handoff.Refusal, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
    <Expander Header="Details"
              IsExpanded="False"
              IsVisible="{Binding Handoff.Refusal, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <ItemsControl ItemsSource="{Binding Handoff.RefusalFacts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <views:CopyableTextBlock Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>

    <Grid IsVisible="{Binding Handoff.HasCompletedFiles}" ColumnDefinitions="*,300" ColumnSpacing="16">

      <Border Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Spacing="2">
            <views:CopyableTextBlock Classes="section-title" Text="{Binding Handoff.Files.Count, StringFormat='{}{0} file(s)'}" />
            <views:CopyableTextBlock Classes="muted" Text="{Binding Handoff.OutputDirectory}" TextWrapping="Wrap" FontSize="12" />
          </StackPanel>

          <Button x:Name="AllFilesButton"
                  Content="Drag all files into your chat"
                  Click="OnAllFilesClick"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Height="64"
                  ToolTip.Tip="Drag into a chat. From the keyboard, press Enter to copy the folder path."
                  AutomationProperties.Name="Drag all Handoff files" />

          <ItemsControl ItemsSource="{Binding Handoff.Files}"
                        AutomationProperties.Name="Handoff files">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandoffFileViewModel">
                <Border Padding="0,8"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="0,1,0,0"
                        Background="Transparent"
                        PointerPressed="OnFileTilePointerPressed"
                        AutomationProperties.Name="{Binding DragAccessibleName}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Background="{DynamicResource SemiColorPrimary}"
                            CornerRadius="6"
                            MinWidth="48"
                            Padding="6,4"
                            VerticalAlignment="Center">
                      <views:CopyableTextBlock Text="{Binding KindLabel}"
                                 Foreground="White"
                                 FontSize="11"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center" />
                    </Border>
                    <views:CopyableTextBlock Grid.Column="1"
                               Text="{Binding RelativePath}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="Copy path"
                            Click="OnCopyPathClick"
                            AutomationProperties.Name="{Binding CopyPathAccessibleName}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="16">
          <views:CopyableTextBlock Classes="section-title" Text="Next" />

          <StackPanel Spacing="8">
            <views:CopyableTextBlock Text="1. Copy the starter prompt" FontWeight="SemiBold" />
            <Button Content="Copy starter prompt"
                    Classes="Primary" Theme="{DynamicResource SolidButton}"
                    Click="OnCopyStarterPromptClick"
                    IsEnabled="{Binding Handoff.HasCompletedFiles}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Copy the starter prompt" />
          </StackPanel>

          <StackPanel Spacing="2">
            <views:CopyableTextBlock Text="2. Open a chat" FontWeight="SemiBold" />
            <views:CopyableTextBlock Classes="muted" Text="Claude, ChatGPT or Gemini." TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="2">
            <views:CopyableTextBlock Text="3. Add the files, then paste" FontWeight="SemiBold" />
            <views:CopyableTextBlock Classes="muted" Text="Drag the files into the chat, then paste the prompt."
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Expander Header="handoff.md" IsExpanded="False" IsVisible="{Binding Handoff.HandoffMarkdown, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <md:MarkdownRenderer MarkdownBuilder="{Binding Handoff.HandoffMarkdown,
                             Converter={x:Static md:ValueConverters.ToObservableStringBuilder}}" />
    </Expander>

  </StackPanel>
</UserControl>
