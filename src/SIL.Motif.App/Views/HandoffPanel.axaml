<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.HandoffPanel"
             x:DataType="views:HandoffPanel">
  <StackPanel Spacing="8" Margin="12">

    <TextBlock Text="Handoff" FontWeight="Bold" />

    <DockPanel LastChildFill="False">
      <Button Content="Handoff"
              Command="{Binding Handoff.RunCommand}"
              AutomationProperties.Name="Write the Handoff folder" />
      <Button Content="Cancel"
              Command="{Binding Handoff.CancelCommand}"
              IsVisible="{Binding Handoff.IsActive}"
              AutomationProperties.Name="Cancel the running Handoff"
              Margin="8,0,0,0" />
    </DockPanel>

    <ProgressBar IsVisible="{Binding Handoff.IsActive}"
                 IsIndeterminate="{Binding Handoff.IsIndeterminate}"
                 Minimum="0"
                 Maximum="1"
                 Value="{Binding Handoff.ProgressFraction}"
                 AutomationProperties.Name="Handoff progress" />
    <TextBlock Text="{Binding Handoff.Progress.Message}"
               IsVisible="{Binding Handoff.IsActive}" />

    <TextBlock Text="{Binding Handoff.Refusal.Message}"
               IsVisible="{Binding Handoff.Refusal, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
               Foreground="Red" />
    <Expander Header="Details"
              IsExpanded="False"
              IsVisible="{Binding Handoff.Refusal, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <ItemsControl ItemsSource="{Binding Handoff.RefusalFacts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>

    <TextBlock Text="{Binding Handoff.DataSensitivitySentence}"
               TextWrapping="Wrap"
               FontStyle="Italic" />

    <TextBlock Text="{Binding Handoff.OutputDirectory, StringFormat='Destination: {0}'}"
               IsVisible="{Binding Handoff.OutputDirectory, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

    <Border IsVisible="{Binding Handoff.HasCompletedFiles}"
            BorderBrush="#82909E"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Background="#F3F6F8">
      <StackPanel Spacing="12">
        <DockPanel LastChildFill="False">
          <TextBlock Text="Drag these files into your chat (Claude, ChatGPT or Gemini)." TextWrapping="Wrap" />
          <Button Content="Copy starter prompt"
                  Click="OnCopyStarterPromptClick"
                  IsEnabled="{Binding Handoff.HasCompletedFiles}"
                  AutomationProperties.Name="Copy the starter prompt"
                  Margin="10,0,0,0" />
        </DockPanel>

        <Border BorderBrush="#82909E"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Background="#E8EDF1">
          <TextBlock Text="All files"
                     FontWeight="Bold"
                     PointerPressed="OnAllFilesPointerPressed"
                     AutomationProperties.Name="Drag all Handoff files" />
        </Border>

        <ItemsControl ItemsSource="{Binding Handoff.Files}"
                      AutomationProperties.Name="Handoff files">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" ItemWidth="210" ItemHeight="170" ItemSpacing="10" LineSpacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HandoffFileViewModel">
              <Border Width="200"
                      Padding="10"
                      BorderBrush="#82909E"
                      BorderThickness="1"
                      CornerRadius="10"
                      Background="#FFFFFF"
                      PointerPressed="OnFileTilePointerPressed"
                      AutomationProperties.Name="{Binding DragAccessibleName}">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                  <Border Width="58"
                          Height="70"
                          CornerRadius="8"
                          Background="#263746"
                          HorizontalAlignment="Left">
                    <Grid RowDefinitions="16,*">
                      <Border Grid.Row="0" Background="#2F9EAA" CornerRadius="8,8,0,0" />
                      <TextBlock Grid.Row="1"
                                 Text="{Binding KindLabel}"
                                 Foreground="#FFFFFF"
                                 FontSize="11"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <TextBlock Grid.Row="1"
                             Text="{Binding RelativePath}"
                             TextWrapping="Wrap"
                             Foreground="#1F2933"
                             VerticalAlignment="Center" />
                  <Button Grid.Row="2"
                          Content="Copy path"
                          Click="OnCopyPathClick"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="{Binding CopyPathAccessibleName}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Expander Header="handoff.md" IsExpanded="False" IsVisible="{Binding Handoff.HandoffMarkdown, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <md:MarkdownRenderer MarkdownBuilder="{Binding Handoff.HandoffMarkdown,
                             Converter={x:Static md:ValueConverters.ToObservableStringBuilder}}" />
    </Expander>

  </StackPanel>
</UserControl>
