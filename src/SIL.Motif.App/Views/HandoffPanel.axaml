<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.HandoffPanel"
             x:DataType="views:HandoffPanel">
  <ScrollViewer>
  <Border Padding="{DynamicResource Component.Handoff.PageMargin}">
  <Grid x:Name="HandoffColumns" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Component.Handoff.ColumnGap}"
        RowSpacing="{DynamicResource Component.Handoff.SectionGap}" SizeChanged="OnHandoffSizeChanged">

      <StackPanel Spacing="{DynamicResource Component.Handoff.SectionGap}">

        <views:CopyableTextBlock Classes="muted" TextWrapping="Wrap"
                   Text="{x:Static app:MotifAppStrings.HandoffIntro}" />

        <views:CopyableTextBlock Text="{Binding Handoff.UnavailableReason}" TextWrapping="Wrap"
                                 IsVisible="{Binding Handoff.ShowsUnavailableReason}" />

        <Border Classes="notice" IsVisible="{Binding Handoff.HasChosenWords}" AutomationProperties.Name="{x:Static app:MotifAppStrings.WordsChosenInCompareAccessibleName}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{x:Static app:MotifAppStrings.HandOffEveryParsedWordInstead}" Click="OnUseWholeAssessmentClick"
                    VerticalAlignment="Center" Margin="{DynamicResource Component.Handoff.ActionMargin}" />
            <views:CopyableTextBlock Text="{Binding Handoff.ChosenWordsText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <Border Classes="notice" IsVisible="{Binding Handoff.IsOutOfDate}"
                AutomationProperties.Name="{x:Static app:MotifAppStrings.TheAIHandoffIsOutOfDateAccessibleName}">
          <DockPanel>
            <Ellipse DockPanel.Dock="Left" Classes="freshDot" Classes.stale="{Binding Handoff.IsOutOfDate}"
                     Margin="{DynamicResource Component.Handoff.GlyphMargin}" />
            <views:CopyableTextBlock Text="{Binding Handoff.OutOfDateText}" TextWrapping="Wrap" />
          </DockPanel>
        </Border>

        <ProgressBar IsVisible="{Binding Handoff.IsActive}"
                     IsIndeterminate="{Binding Handoff.IsIndeterminate}"
                     Minimum="0" Maximum="1" Value="{Binding Handoff.ProgressFraction}"
                     AutomationProperties.Name="{x:Static app:MotifAppStrings.AIHandoffProgressAccessibleName}"
                     AutomationProperties.AutomationId="{x:Static app:AutomationIds.HandoffProgress}" />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Intent.Space.Group}" IsVisible="{Binding Handoff.IsActive}">
          <views:CopyableTextBlock Text="{Binding Handoff.Progress.Message}" VerticalAlignment="Center" />
          <Button Content="{x:Static app:MotifAppStrings.Cancel}" Command="{Binding Handoff.CancelCommand}"
                  AutomationProperties.Name="{x:Static app:MotifAppStrings.CancelTheRunningAIHandoffAccessibleName}"
                  AutomationProperties.AutomationId="{x:Static app:AutomationIds.CancelHandoff}" />
        </StackPanel>

        <views:RefusalBlock DataContext="{Binding Handoff.ShownRefusal}" />

        <!-- Before the first write: what the folder will hold, so nothing about it is a surprise. -->
        <Border Classes="card" IsVisible="{Binding !Handoff.HasCompletedFiles}"
                AutomationProperties.Name="{x:Static app:MotifAppStrings.WhatTheAIHandoffWillContainAccessibleName}">
          <StackPanel Spacing="{DynamicResource Component.Handoff.CardGap}">
            <views:CopyableTextBlock TextWrapping="Wrap" Classes="section-title" Text="{x:Static app:MotifAppStrings.WhatGoesIn}" FontSize="{DynamicResource Component.Handoff.TitleSize}" />
            <ItemsControl x:Name="HandoffPanelPlannedFilesItems" ItemsSource="{Binding PlannedFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="views:PlannedHandoffFile">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Component.Handoff.PlannedGap}" Margin="{DynamicResource Component.Handoff.PlannedMargin}">
                    <views:CopyableTextBlock Text="{Binding Name}" FontWeight="{DynamicResource Intent.Weight.Section}" Width="{DynamicResource Component.Handoff.PlannedNameWidth}" />
                    <views:CopyableTextBlock Grid.Column="1" Classes="muted" Text="{Binding Purpose}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Small}" TextWrapping="Wrap"
                       Text="{Binding Handoff.DataSensitivitySentence}" />
          </StackPanel>
        </Border>

        <!-- After a write: the folder, the drag target, and every file it holds. -->
        <Border Classes="card" IsVisible="{Binding Handoff.HasCompletedFiles}">
          <StackPanel Spacing="{DynamicResource Intent.Space.Group}">
            <StackPanel Spacing="{DynamicResource Intent.Space.Minimal}">
              <views:CopyableTextBlock TextWrapping="Wrap" Classes="section-title"
                         Text="{Binding Handoff.WrittenAtText}" />
              <views:CopyableTextBlock Text="{Binding Handoff.CoverageText}" TextWrapping="Wrap"
                         IsVisible="{Binding Handoff.CoverageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <views:CopyableTextBlock Classes="muted" Text="{Binding Handoff.OutputDirectory}" TextWrapping="Wrap" FontSize="{DynamicResource Intent.Type.Small}" />
            </StackPanel>

            <Button x:Name="AllFilesButton"
                    Content="{Binding Handoff.Files.Count, StringFormat='Drag all {0} files into your chat'}"
                    Click="OnAllFilesClick"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="{DynamicResource Component.Handoff.DragHeight}"
                    ToolTip.Tip="{x:Static app:MotifAppStrings.HandoffFolderTip}"
                    ToolTip.Placement="Top" ToolTip.VerticalOffset="0"
                    AutomationProperties.Name="{x:Static vm:WindowCopy.DragAllAiHandoffFiles}"
                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.DragAllHandoffFiles}">
              <Button.ContentTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
                </DataTemplate>
              </Button.ContentTemplate>
            </Button>

            <ItemsControl x:Name="HandoffPanelFilesItems" ItemsSource="{Binding Handoff.Files}" AutomationProperties.Name="{x:Static app:MotifAppStrings.AIHandoffFilesAccessibleName}"
                          AutomationProperties.AutomationId="{x:Static app:AutomationIds.HandoffFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HandoffFileViewModel">
                  <Border Classes="handoffFile" PointerPressed="OnFileTilePointerPressed"
                          AutomationProperties.Name="{Binding DragAccessibleName}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Intent.Space.Group}">
                      <Border Classes="handoffKind">
                        <views:CopyableTextBlock Text="{Binding KindLabel}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="{DynamicResource Component.Handoff.LineGap}" VerticalAlignment="Center">
                        <views:CopyableTextBlock Text="{Binding RelativePath}" TextWrapping="Wrap" FontWeight="{DynamicResource Intent.Weight.Strong}" />
                        <views:CopyableTextBlock Classes="muted" Text="{Binding Purpose}" FontSize="{DynamicResource Intent.Type.Small}" TextWrapping="Wrap"
                                   IsVisible="{Binding HasPurpose}" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="{x:Static app:MotifAppStrings.CopyPath}" Click="OnCopyPathClick"
                              AutomationProperties.Name="{Binding CopyPathAccessibleName}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Expander Header="handoff.md" IsExpanded="False"
                  IsVisible="{Binding Handoff.HandoffMarkdown, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <md:MarkdownRenderer MarkdownBuilder="{Binding Handoff.HandoffMarkdown,
                                 Converter={x:Static md:ValueConverters.ToObservableStringBuilder}}" />
        </Expander>
      </StackPanel>

    <!-- Right when wide, below when narrow: the three steps to a chat, and what to ask once you are there. -->
      <StackPanel x:Name="HandoffGuide" Grid.Column="1" MaxWidth="{DynamicResource Component.Handoff.GuideWidth}"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="{DynamicResource Intent.Space.Compact}">
        <views:CopyableTextBlock TextWrapping="Wrap" Classes="section-title" Text="{x:Static app:MotifAppStrings.GetAChatModelsHelp}" FontSize="{DynamicResource Component.Handoff.TitleSize}" />

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Group}" Margin="{DynamicResource Component.Handoff.FirstStepMargin}">
          <Border Classes="stepMark"><views:CopyableTextBlock Text="1" /></Border>
          <StackPanel Grid.Column="1" Spacing="{DynamicResource Intent.Space.Snug}">
            <views:CopyableTextBlock TextWrapping="Wrap" Text="{x:Static app:MotifAppStrings.CopyTheStarterPrompt}" FontWeight="{DynamicResource Intent.Weight.Section}" />
            <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Small}" TextWrapping="Wrap"
                       Text="{x:Static app:MotifAppStrings.HandoffStarterPromptDetail}" />
            <Button Content="{x:Static app:MotifAppStrings.CopyStarterPrompt}" Classes="Primary" Theme="{DynamicResource SolidButton}"
                    Click="OnCopyStarterPromptClick" IsEnabled="{Binding Handoff.HasCompletedFiles}"
                    HorizontalAlignment="Left" AutomationProperties.Name="{x:Static app:MotifAppStrings.CopyTheStarterPromptAccessibleName}">
              <Button.ContentTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
                </DataTemplate>
              </Button.ContentTemplate>
            </Button>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Group}" Margin="{DynamicResource Component.Handoff.StepMargin}">
          <Border Classes="stepMark"><views:CopyableTextBlock Text="2" /></Border>
          <StackPanel Grid.Column="1" Spacing="{DynamicResource Intent.Space.Minimal}">
            <views:CopyableTextBlock TextWrapping="Wrap" Text="{x:Static app:MotifAppStrings.OpenAChat}" FontWeight="{DynamicResource Intent.Weight.Section}" />
            <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Small}" Text="{x:Static app:MotifAppStrings.ClaudeChatGPTOrGemini}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Intent.Space.Group}" Margin="{DynamicResource Component.Handoff.StepMargin}">
          <Border Classes="stepMark"><views:CopyableTextBlock Text="3" /></Border>
          <StackPanel Grid.Column="1" Spacing="{DynamicResource Intent.Space.Minimal}">
            <views:CopyableTextBlock TextWrapping="Wrap" Text="{x:Static app:MotifAppStrings.AddTheFilesThenPaste}" FontWeight="{DynamicResource Intent.Weight.Section}" />
            <views:CopyableTextBlock Classes="muted" FontSize="{DynamicResource Intent.Type.Small}" TextWrapping="Wrap"
                       Text="{x:Static app:MotifAppStrings.HandoffAddFilesDetail}" />
          </StackPanel>
        </Grid>

        <Border Classes="card" Margin="{DynamicResource Component.Handoff.AskMargin}">
          <StackPanel Spacing="{DynamicResource Intent.Space.Snug}">
            <views:CopyableTextBlock TextWrapping="Wrap" Text="{x:Static app:MotifAppStrings.HandoffTryAskingHeading}" FontWeight="{DynamicResource Intent.Weight.Section}" />
            <views:CopyableTextBlock TextWrapping="Wrap" Classes="muted" FontSize="{DynamicResource Intent.Type.Label}" Text="{x:Static app:MotifAppStrings.HandoffTryAskingDetail}" />
            <ItemsControl x:Name="HandoffPanelQuestionsItems" ItemsSource="{Binding Questions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Classes="handoffQuestion" Click="OnCopyQuestionClick" Tag="{Binding}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          ToolTip.Tip="{x:Static app:MotifAppStrings.CopyThisQuestionTip}" AutomationProperties.Name="{Binding}">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
  </Grid>
  </Border>
  </ScrollViewer>
</UserControl>
