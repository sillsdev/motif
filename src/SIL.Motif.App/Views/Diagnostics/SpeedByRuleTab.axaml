<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.SpeedByRuleTab" x:DataType="vm:DiagnosticsPageModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="{DynamicResource Intent.Space.Related}"
        AutomationProperties.AutomationId="{x:Static app:AutomationIds.DiagnosticsSpeedByRule}">
    <views:CopyableTextBlock Text="{Binding SpeedByRule.UnavailableText}" TextWrapping="Wrap" />
    <views:CopyableTextBlock Grid.Row="1" Text="{Binding SpeedByRule.DenominatorText}" TextWrapping="Wrap" />
    <views:CopyableTextBlock Grid.Row="2" Classes="muted" Text="{Binding SpeedByRule.DetailText}" TextWrapping="Wrap" />
    <ContentControl x:Name="RowsHost" Grid.Row="3" />
    <HyperlinkButton Grid.Row="4" Content="{x:Static app:MotifAppStrings.BoardOpenInFieldWorks}"
                     NavigateUri="{Binding SpeedByRule.FieldWorksAddress}"
                     IsVisible="{Binding SpeedByRule.FieldWorksAddress, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </Grid>
</UserControl>
