<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
             xmlns:views="clr-namespace:SIL.Motif.App.Views"
             xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
             x:Class="SIL.Motif.App.Views.WarningsTab" x:DataType="vm:DiagnosticsPageModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://SIL.Motif.App/Tokens/Components/DiagnosticsScoped.axaml" />
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource Intent.Space.Related}">
    <views:CopyableTextBlock Text="{Binding Warnings.StatusText}" TextWrapping="Wrap" />
    <views:CopyableTextBlock Grid.Row="1" Text="{Binding Warnings.SummaryText}" TextWrapping="Wrap"
                             IsVisible="{Binding Warnings.SummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Grid x:Name="WarningBody" Grid.Row="2" RowDefinitions="*,*"
          ColumnSpacing="{DynamicResource Intent.Space.Group}" RowSpacing="{DynamicResource Intent.Space.Related}">
      <ContentControl x:Name="RowsHost" />
      <ContentControl x:Name="WarningEvidence" Grid.Row="1"
                      AutomationProperties.AutomationId="{x:Static app:AutomationIds.DiagnosticsWarningDetails}" />
    </Grid>
  </Grid>
</UserControl>
