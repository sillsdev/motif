<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SIL.Motif.App"
        xmlns:controls="clr-namespace:SIL.Motif.App.Controls"
        xmlns:views="clr-namespace:SIL.Motif.App.Views"
        xmlns:vm="clr-namespace:SIL.Motif.App.ViewModels"
        xmlns:word="clr-namespace:SIL.Motif.App.Controls.WordPresentation"
        x:Class="SIL.Motif.App.Controls.WordPresentation.WordStripToken"
        x:Name="WordStrip" x:DataType="vm:ResultsTokenViewModel"
          IsVisible="{Binding IsWord}" Classes="wordStrip hoverReveal"
          Classes.open="{Binding #WordStrip.State.IsOpen}"
          Classes.uncertainChanged="{Binding IsUncertainChanged}"
          Classes.dimmed="{Binding IsDimmed}" Focusable="True" IsTabStop="True"
          AutomationProperties.AutomationId="{Binding StripAutomationId}"
          ToolTip.Tip="{Binding TooltipSummary}" views:ClearTipPlacement.IsEnabled="True">
  <Grid x:Name="StripContent" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Intent.Space.Related}">
    <StackPanel x:Name="StripStack" Classes="stripStack stripRows">
      <StackPanel x:Name="WordLine" Classes="stripWordRow" Orientation="Horizontal">
        <views:CopyableTextBlock x:Name="WordText" Classes="stripWord" Text="{Binding Text}" VerticalAlignment="Center"
                                 controls:WritingSystemText.Id="{Binding TextWritingSystem}" controls:WritingSystemText.StyleName="Normal"
                                 Classes.differentVerdict="{Binding HasDifferentVerdictCue}"
                                 Classes.noParseVerdict="{Binding HasNoParseVerdictCue}"
                                 Classes.stoppedVerdict="{Binding HasStoppedVerdictCue}"
                                 AutomationProperties.AutomationId="{Binding WordAutomationId}" />
        <views:MarkGlyph x:Name="VerdictGlyph" Classes.inline="True" Mark="{Binding WordVerdictMark}"
                         AutomationProperties.Name="{Binding WordVerdictMark.Word}" />
        <views:DispositionFace x:Name="MarkFace" Classes="dispositionFace rest" Letter="{Binding Disposition.MarkLetter}"
                               Classes.approved="{Binding Disposition.IsMarkApproved}" Classes.unknown="{Binding Disposition.IsMarkUnknown}"
                               Classes.disapproved="{Binding Disposition.IsMarkDisapproved}" Classes.absent="{Binding Disposition.IsMarkAbsent}"
                               Classes.changed="{Binding Disposition.IsChanged}" />
      </StackPanel>
      <Border x:Name="FieldWorksLine" Classes="stripRow stripFieldWorks analysisRow"
              AutomationProperties.AutomationId="{Binding FieldWorksAutomationId}" />
    </StackPanel>
    <Border x:Name="StripActions" Grid.Column="1" Classes="stripActions" />
  </Grid>
</Border>
