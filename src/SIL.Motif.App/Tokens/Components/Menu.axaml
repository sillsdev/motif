<!--
  A flyout menu of entries, each a bold title over a muted line saying what it does, and the pop-up that holds it.
  A pop-up never scrolls sideways: Semi's presenter caps its width and scrolls past the cap, which hid the Help
  pop-up's left side and the tools menu's labels, so its content wraps to the presenter's width instead.
  Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.Menu.Width" ResourceKey="Primitive.Size.280" />
    <StaticResource x:Key="Component.Menu.EntryPadding" ResourceKey="Primitive.Inset.10_8_10_8" />
    <StaticResource x:Key="Component.Menu.ActionGap" ResourceKey="Primitive.Inset.0_0_4_4" />
    <StaticResource x:Key="Component.Menu.ButtonPadding" ResourceKey="Primitive.Inset.6_2_6_2" />
    <StaticResource x:Key="Component.Menu.ButtonHeight" ResourceKey="Primitive.Size.24" />
    <StaticResource x:Key="Component.Menu.HelpMaxWidth" ResourceKey="Primitive.Size.780" />
  </Styles.Resources>
  <Style Selector="FlyoutPresenter">
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <!-- The Help card is wider than Semi's cap, so its presenter alone may grow to hold it. -->
  <Style Selector="FlyoutPresenter.help">
    <Setter Property="MaxWidth" Value="{DynamicResource Component.Menu.HelpMaxWidth}" />
  </Style>
  <Style Selector="StackPanel.menu">
    <Setter Property="Width" Value="{DynamicResource Component.Menu.Width}" />
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Minimal}" />
  </Style>
  <Style Selector="Button.menuButton">
    <Setter Property="Padding" Value="{DynamicResource Component.Menu.ButtonPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Component.Menu.ButtonHeight}" />
    <Setter Property="Height" Value="{DynamicResource Component.Menu.ButtonHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
  </Style>
  <Style Selector="Button.menuAction">
    <Setter Property="Margin" Value="{DynamicResource Component.Menu.ActionGap}" />
  </Style>
  <Style Selector="Button.menuEntry">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="{DynamicResource Component.Menu.EntryPadding}" />
  </Style>
  <Style Selector="Button.menuEntry :is(TextBlock).menuTitle">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Navigation}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.menuEntry :is(TextBlock).menuDetail">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
</Styles>
