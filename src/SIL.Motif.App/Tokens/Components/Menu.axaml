<!--
  A flyout menu of entries, each a bold title over a muted line saying what it does.
  Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.Menu.Width" ResourceKey="Primitive.Size.280" />
    <StaticResource x:Key="Component.Menu.EntryPadding" ResourceKey="Primitive.Inset.10_8_10_8" />
  </Styles.Resources>
  <Style Selector="StackPanel.menu">
    <Setter Property="Width" Value="{DynamicResource Component.Menu.Width}" />
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Minimal}" />
  </Style>
  <Style Selector="Button.menuEntry">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="{DynamicResource Component.Menu.EntryPadding}" />
  </Style>
  <Style Selector="Button.menuEntry :is(TextBlock).menuTitle">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Navigation}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.menuEntry :is(TextBlock).menuDetail">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
</Styles>
