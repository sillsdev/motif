<!--
  The marks every page shares, one class per kind, so no mark answers two questions.
  An outcome is coloured text and never fills; a meaning is the only mark that fills or edges; a severity marks a
  grammar-check finding, its glyph a triangle, a circled ! or a circled i; a trace step is FieldWorks' green and
  red path. Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:doc="using:Avalonia.Controls.Documents"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.Mark.Padding" ResourceKey="Primitive.Inset.6_0_6_0" />
    <StaticResource x:Key="Component.Mark.Radius" ResourceKey="Primitive.Radius.3" />
    <StaticResource x:Key="Component.Mark.GlyphSize" ResourceKey="Primitive.Size.14" />
    <StaticResource x:Key="Component.Mark.InlineGlyphSize" ResourceKey="Primitive.Size.8" />
    <StaticResource x:Key="Component.Mark.BodyGlyphSize" ResourceKey="Primitive.Size.9" />
    <StaticResource x:Key="Component.Mark.GlyphRadius" ResourceKey="Primitive.Radius.7" />
    <StaticResource x:Key="Component.Mark.GlyphType" ResourceKey="Primitive.Type.9" />
    <StaticResource x:Key="Component.Mark.WarningIconSize" ResourceKey="Primitive.Size.10" />
  </Styles.Resources>

  <Style Selector=":is(TextBlock).outcomeMark">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
  </Style>
  <Style Selector="Border.markChip.outcome :is(TextBlock).markGlyph">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
  </Style>
  <Style Selector=":is(TextBlock).outcomeMark.same">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Outcome.Same}" />
  </Style>
  <Style Selector=":is(TextBlock).outcomeMark.different">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Outcome.Different}" />
  </Style>
  <Style Selector=":is(TextBlock).outcomeMark.noParse">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Outcome.NoParse}" />
  </Style>
  <Style Selector=":is(TextBlock).outcomeMark.stopped">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Outcome.Stopped}" />
  </Style>
  <Style Selector=":is(TextBlock).outcomeMark.notParsed">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Outcome.NotParsed}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="PathIcon.markGlyphIcon">
    <Setter Property="Width" Value="{DynamicResource Component.Mark.GlyphSize}" />
    <Setter Property="Height" Value="{DynamicResource Component.Mark.GlyphSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(Grid).markGlyphHost.inline PathIcon.markGlyphIcon">
    <Setter Property="Width" Value="{DynamicResource Component.Mark.InlineGlyphSize}" />
    <Setter Property="Height" Value="{DynamicResource Component.Mark.InlineGlyphSize}" />
  </Style>
  <Style Selector=":is(Grid).markGlyphHost.inline.bodyText PathIcon.markGlyphIcon">
    <Setter Property="Width" Value="{DynamicResource Component.Mark.BodyGlyphSize}" />
    <Setter Property="Height" Value="{DynamicResource Component.Mark.BodyGlyphSize}" />
  </Style>
  <Style Selector=":is(Grid).markGlyphHost.outcome.same">
    <Setter Property="doc:TextElement.Foreground" Value="{DynamicResource Intent.Outcome.Same}" />
  </Style>
  <Style Selector=":is(Grid).markGlyphHost.outcome.different">
    <Setter Property="doc:TextElement.Foreground" Value="{DynamicResource Intent.Outcome.Different}" />
  </Style>
  <Style Selector=":is(Grid).markGlyphHost.outcome.noParse">
    <Setter Property="doc:TextElement.Foreground" Value="{DynamicResource Intent.Outcome.NoParse}" />
  </Style>
  <Style Selector=":is(Grid).markGlyphHost.outcome.stopped">
    <Setter Property="doc:TextElement.Foreground" Value="{DynamicResource Intent.Outcome.Stopped}" />
  </Style>
  <Style Selector=":is(Grid).markGlyphHost.outcome.notParsed">
    <Setter Property="doc:TextElement.Foreground" Value="{DynamicResource Intent.Outcome.NotParsed}" />
  </Style>
  <Style Selector=":is(Grid).markGlyphHost.step">
    <Setter Property="doc:TextElement.Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
  <Style Selector=":is(Grid).markGlyphHost.step.built">
    <Setter Property="doc:TextElement.Foreground" Value="{DynamicResource Intent.Success.Text}" />
  </Style>
  <Style Selector=":is(Grid).markGlyphHost.step.refused">
    <Setter Property="doc:TextElement.Foreground" Value="{DynamicResource Intent.Danger.Text}" />
  </Style>
  <Style Selector=":is(Grid).markGlyphHost.severity.warning">
    <Setter Property="doc:TextElement.Foreground" Value="{DynamicResource Intent.Severity.Warning}" />
  </Style>

  <Style Selector="Border.meaningMark">
    <Setter Property="Padding" Value="{DynamicResource Component.Mark.Padding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Mark.Radius}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.meaningMark :is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.meaningMark.fine :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Consequence.Fine}" />
  </Style>
  <Style Selector="Border.meaningMark.look">
    <Setter Property="Background" Value="{DynamicResource Intent.Consequence.Look.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Consequence.Look.Edge}" />
  </Style>
  <Style Selector="Border.meaningMark.look :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Consequence.Look}" />
  </Style>
  <Style Selector="Border.meaningMark.problem">
    <Setter Property="Background" Value="{DynamicResource Intent.Consequence.Problem.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Consequence.Problem.Edge}" />
  </Style>
  <Style Selector="Border.meaningMark.problem :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Consequence.Problem}" />
  </Style>
  <Style Selector="Border.meaningMark.neutral :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Consequence.Neutral}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="Border.severityMark">
    <Setter Property="Padding" Value="{DynamicResource Component.Mark.Padding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Mark.Radius}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.severityMark :is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.severityMark.warning">
    <Setter Property="Background" Value="{DynamicResource Intent.Severity.Warning.Fill}" />
  </Style>
  <Style Selector="Border.severityMark.warning :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Severity.Warning}" />
  </Style>
  <Style Selector="Border.severityMark.error :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Severity.Error}" />
  </Style>
  <Style Selector="Border.severityMark.info :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Severity.Info}" />
  </Style>

  <Style Selector=":is(TextBlock).stepMark">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
  <Style Selector=":is(TextBlock).stepMark.built">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Success.Text}" />
  </Style>
  <Style Selector=":is(TextBlock).stepMark.refused">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Danger.Text}" />
  </Style>

  <!-- A severity's glyph on its own: a warning's triangle bare, an error's ! and a note's i each in a ring. -->
  <Style Selector="Border.severityGlyph">
    <Setter Property="Width" Value="{DynamicResource Component.Mark.GlyphSize}" />
    <Setter Property="Height" Value="{DynamicResource Component.Mark.GlyphSize}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Mark.GlyphRadius}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.severityGlyph :is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource Component.Mark.GlyphType}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.severityGlyph.warning :is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Severity.Warning}" />
  </Style>
  <Style Selector="Border.severityGlyph.error">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Severity.Error}" />
  </Style>
  <Style Selector="Border.severityGlyph.error :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Severity.Error}" />
  </Style>
  <Style Selector="Border.severityGlyph.info">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Severity.Info}" />
  </Style>
  <Style Selector="Border.severityGlyph.info :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Severity.Info}" />
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style Selector="Border.severityGlyph :is(Grid).markGlyphHost PathIcon.markGlyphIcon.warning">
    <Setter Property="Width" Value="{DynamicResource Component.Mark.WarningIconSize}" />
    <Setter Property="Height" Value="{DynamicResource Component.Mark.WarningIconSize}" />
  </Style>
</Styles>
