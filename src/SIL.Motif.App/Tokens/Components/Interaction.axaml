<!--
  The cues every control shares. The keyboard focus ring: one look for every control, in the focus colour and stroke,
  following the control's own corners; Avalonia draws it only for Tab and arrow-key focus, so a pointer click never
  leaves a ring behind. A link underlines under the pointer. The pressed cue: a button held down shrinks a little, as if pushed in, which hover never does;
  an inset shadow would not paint on Semi's translucent button fills.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SIL.Motif.App.Views">
  <Styles.Resources>
    <StaticResource x:Key="Component.Interaction.ExpanderChevronMargin" ResourceKey="Primitive.Inset.4_0_10_0" />
  </Styles.Resources>
  <Style Selector="AdornerLayer">
    <Setter Property="DefaultFocusAdorner">
      <FocusAdornerTemplate>
        <views:FocusRing />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Expander">
    <Setter Property="views:ExpanderChevronAlignment.IsEnabled" Value="True" />
  </Style>
  <Style Selector="ComboBox /template/ Popup#PART_Popup">
    <Setter Property="InheritsTransform" Value="True" />
  </Style>
  <Style Selector="Border.focusRing">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Focus}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Focus}" />
  </Style>
  <Style Selector="HyperlinkButton:pointerover">
    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="RenderTransform" Value="{DynamicResource Intent.Transform.Pressed}" />
  </Style>
</Styles>
