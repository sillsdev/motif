<!--
  A number's heat shade.
  Names Intent keys only.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.heat">
    <Setter Property="Background" Value="{DynamicResource Intent.Warning}" />
  </Style>
</Styles>
