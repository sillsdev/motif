<!--
  A Matrix cell wears its result: Fine in text, Have a look and Problem filled and edged, No result in text.
  It names its word and place counts together. The chosen cells' list sits in a panel under the
  Matrix, headed by the cell's marks, with a strip of the morphemes its words share.
  Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.MatrixCell.Padding" ResourceKey="Primitive.Inset.8_4_8_4" />
    <StaticResource x:Key="Component.MatrixCell.Radius" ResourceKey="Primitive.Radius.8" />
    <StaticResource x:Key="Component.MatrixCell.Height" ResourceKey="Primitive.Size.52" />
    <StaticResource x:Key="Component.MatrixCell.MarkerSize" ResourceKey="Primitive.Size.8" />
    <StaticResource x:Key="Component.MatrixCell.CompactWidth" ResourceKey="Primitive.Size.40" />
    <StaticResource x:Key="Component.MatrixCell.CompactHeight" ResourceKey="Primitive.Size.22" />
    <StaticResource x:Key="Component.MatrixCell.MarkerMargin" ResourceKey="Primitive.Inset.0_0_4_0" />
    <StaticResource x:Key="Component.MatrixCell.SharedPadding" ResourceKey="Primitive.Inset.8_4_8_4" />
    <StaticResource x:Key="Component.MatrixCell.SharedRadius" ResourceKey="Primitive.Radius.6" />
    <StaticResource x:Key="Component.MatrixCell.ChosenPadding" ResourceKey="Primitive.Inset.8_4_8_4" />
  </Styles.Resources>
  <Style Selector="Border.matrixCell">
    <Setter Property="CornerRadius" Value="{DynamicResource Component.MatrixCell.Radius}" />
    <Setter Property="Padding" Value="{DynamicResource Component.MatrixCell.Padding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Component.MatrixCell.Height}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Surface}" />
  </Style>
  <Style Selector="Border.matrixCell :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Consequence.Neutral}" />
  </Style>
  <Style Selector="Border.matrixCell :is(TextBlock).matrixCellCount">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.matrixCell :is(TextBlock).matrixCellLabel">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
  </Style>
  <Style Selector="Border.matrixCell.compact">
    <Setter Property="Width" Value="{DynamicResource Component.MatrixCell.CompactWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource Component.MatrixCell.CompactHeight}" />
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Intent.Radius.Control}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
  </Style>
  <Style Selector="Border.matrixCell.compact :is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.matrixCell.compact :is(TextBlock).matrixCellLabel, Border.matrixCell.compact Ellipse.matrixPending">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.matrixCell.good :is(TextBlock), Border.matrixCell.fine :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Consequence.Fine}" />
  </Style>
  <Style Selector="Border.matrixCell.violation">
    <Setter Property="Background" Value="{DynamicResource Intent.Consequence.Problem.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Consequence.Problem.Edge}" />
  </Style>
  <Style Selector="Border.matrixCell.violation :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Consequence.Problem}" />
  </Style>
  <Style Selector="Border.matrixCell.review, Border.matrixCell.new">
    <Setter Property="Background" Value="{DynamicResource Intent.Consequence.Look.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Consequence.Look.Edge}" />
  </Style>
  <Style Selector="Border.matrixCell.review :is(TextBlock), Border.matrixCell.new :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Consequence.Look}" />
  </Style>
  <Style Selector="Border.matrixCell.none">
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Border.matrixCell.none :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
  <!-- A zero drops its family's tint rather than fading, so its words stay readable; after the families to win. -->
  <Style Selector="Border.matrixCell.empty">
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
  </Style>
  <Style Selector="Border.matrixCell.empty :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
  <!-- An empty cell's 0 drops to its meaning's size, so the cells with words are the numbers the eye finds. -->
  <Style Selector="Border.matrixCell.empty:not(.none) :is(TextBlock).matrixCellCount">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
  </Style>
  <!-- Hover and choosing ring the inside of the cell, never taking its meaning's edge away; a row clips outside. -->
  <Style Selector="Border.matrixCell:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Primary}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Intent.Shadow.Hover}" />
  </Style>
  <Style Selector="Border.matrixCell.violation:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Consequence.Problem.Edge}" />
  </Style>
  <Style Selector="Border.matrixCell.review:pointerover, Border.matrixCell.new:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Consequence.Look.Edge}" />
  </Style>
  <Style Selector="Border.matrixCell.selected">
    <Setter Property="BoxShadow" Value="{DynamicResource Intent.Shadow.Selected}" />
  </Style>
  <Style Selector="Ellipse.matrixPending">
    <Setter Property="Width" Value="{DynamicResource Component.MatrixCell.MarkerSize}" />
    <Setter Property="Height" Value="{DynamicResource Component.MatrixCell.MarkerSize}" />
    <Setter Property="Fill" Value="{DynamicResource Intent.Warning.Text}" />
  </Style>

  <!-- The chosen cells' list keeps a thin inset, so its word rows keep the width every column head needs. -->
  <Style Selector="Border.card.matrixChosen">
    <Setter Property="Padding" Value="{DynamicResource Component.MatrixCell.ChosenPadding}" />
  </Style>
  <Style Selector="StackPanel.matrixChosenMarks">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector="StackPanel.matrixChosenMarks :is(TextBlock).matrixChosenWord">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Body}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.matrixShared">
    <Setter Property="Padding" Value="{DynamicResource Component.MatrixCell.SharedPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.MatrixCell.SharedRadius}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Subtle}" />
  </Style>
  <Style Selector="Border.matrixShared :is(TextBlock).matrixSharedHeading">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.matrixShared StackPanel.matrixSharedItem">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Minimal}" />
    <Setter Property="Margin" Value="{DynamicResource Intent.Gap.AfterRelated}" />
  </Style>
  <Style Selector="Border.matrixShared :is(TextBlock).matrixSharedCount">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
