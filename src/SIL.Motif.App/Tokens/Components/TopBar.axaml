<!--
  The top bar: the Motif wordmark, the project menu, the freshness line and Refresh, with the banner below it.
  Names Intent keys only.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.topBar">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerBottom}" />
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.Bar}" />
    <Setter Property="Height" Value="{DynamicResource Intent.Size.Bar}" />
  </Style>
  <Style Selector="StackPanel.topBarGroup">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Related}" />
  </Style>
  <Style Selector="StackPanel.brand">
    <Setter Property="Margin" Value="{DynamicResource Intent.Gap.AfterGroup}" />
  </Style>
  <Style Selector="Image.brandLogo">
    <Setter Property="Width" Value="{DynamicResource Intent.Size.IconLarge}" />
    <Setter Property="Height" Value="{DynamicResource Intent.Size.IconLarge}" />
  </Style>
  <Style Selector=":is(TextBlock).brandName">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Brand}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.projectMenu">
    <Setter Property="MaxWidth" Value="{DynamicResource Intent.Size.MenuButtonMax}" />
    <Setter Property="Margin" Value="{DynamicResource Intent.Gap.AfterGroup}" />
  </Style>
  <Style Selector="Button.projectMenu :is(TextBlock).projectName">
    <Setter Property="MaxWidth" Value="{DynamicResource Intent.Size.MenuLabelMax}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Body}" />
  </Style>
  <Style Selector="Button.projectMenu :is(TextBlock).disclosure">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="Margin" Value="{DynamicResource Intent.Gap.Banner}" />
  </Style>
  <Style Selector="Button.bannerAction">
    <Setter Property="Margin" Value="{DynamicResource Intent.Gap.AfterRelated}" />
  </Style>
</Styles>
