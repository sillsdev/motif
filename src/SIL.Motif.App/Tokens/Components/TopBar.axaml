<!--
  The top bar: one row holding the Motif icon, the menu bar (behind a ≡ when narrow), the project chip and Refresh, and the project card the chip opens.
  Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.TopBar.Padding" ResourceKey="Primitive.Inset.12_0_8_0" />
    <StaticResource x:Key="Component.TopBar.WindowsChromePadding" ResourceKey="Primitive.Inset.18_0_138_0" />
    <StaticResource x:Key="Component.TopBar.MacChromePadding" ResourceKey="Primitive.Inset.76_0_18_0" />
    <StaticResource x:Key="Component.TopBar.Height" ResourceKey="Primitive.Size.34" />
    <StaticResource x:Key="Component.TopBar.CompactWidth" ResourceKey="Primitive.Size.1100" />
    <StaticResource x:Key="Component.TopBar.MenuItemPadding" ResourceKey="Primitive.Inset.6_2_6_2" />
    <StaticResource x:Key="Component.TopBar.NarrowWidth" ResourceKey="Primitive.Size.760" />
    <StaticResource x:Key="Component.TopBar.LogoSize" ResourceKey="Primitive.Size.16" />
    <StaticResource x:Key="Component.TopBar.ChipPadding" ResourceKey="Primitive.Inset.6_2_6_2" />
    <StaticResource x:Key="Component.TopBar.ChipDotMargin" ResourceKey="Primitive.Inset.0_0_6_0" />
    <StaticResource x:Key="Component.TopBar.ChipCaretMargin" ResourceKey="Primitive.Inset.6_0_0_0" />
    <StaticResource x:Key="Component.TopBar.ChipHeight" ResourceKey="Primitive.Size.24" />
    <StaticResource x:Key="Component.TopBar.ChipDetailMaxWidth" ResourceKey="Primitive.Size.170" />
    <StaticResource x:Key="Component.TopBar.SeparatorWidth" ResourceKey="Primitive.Size.1" />
    <StaticResource x:Key="Component.TopBar.CardFooterPadding" ResourceKey="Primitive.Inset.0_8_0_0" />
    <StaticResource x:Key="Component.TopBar.SeparatorHeight" ResourceKey="Primitive.Size.16" />
    <StaticResource x:Key="Component.TopBar.SeparatorMargin" ResourceKey="Primitive.Inset.6_0_6_0" />
    <StaticResource x:Key="Component.TopBar.CardWidth" ResourceKey="Primitive.Size.360" />
    <StaticResource x:Key="Component.TopBar.CardStatusPadding" ResourceKey="Primitive.Inset.8_8_8_8" />
    <StaticResource x:Key="Component.TopBar.ProjectNameMaxWidth" ResourceKey="Primitive.Size.190" />
    <StaticResource x:Key="Component.TopBar.ParseProgressWidth" ResourceKey="Primitive.Size.190" />
    <StaticResource x:Key="Component.TopBar.ParseProgressHeight" ResourceKey="Primitive.Size.8" />
  </Styles.Resources>
  <Style Selector="Border.topBar">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerBottom}" />
    <Setter Property="Padding" Value="{DynamicResource Component.TopBar.Padding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Component.TopBar.Height}" />
  </Style>
  <Style Selector="Border.topBar.windowsChrome">
    <Setter Property="Padding" Value="{DynamicResource Component.TopBar.WindowsChromePadding}" />
  </Style>
  <Style Selector="Border.topBar.macChrome">
    <Setter Property="Padding" Value="{DynamicResource Component.TopBar.MacChromePadding}" />
  </Style>
  <Style Selector="Button#PART_FullScreenButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button#PART_PopoverFullScreenButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- The top bar draws the Motif brand itself; the caption's own title text would sit on top of it. -->
  <Style Selector="Panel#PART_TitleTextPanel > TextBlock">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Image.brandLogo">
    <Setter Property="Width" Value="{DynamicResource Component.TopBar.LogoSize}" />
    <Setter Property="Height" Value="{DynamicResource Component.TopBar.LogoSize}" />
    <Setter Property="Margin" Value="{DynamicResource Intent.Gap.AfterGroup}" />
  </Style>
  <Style Selector="Border.topBarSeparator">
    <Setter Property="Width" Value="{DynamicResource Component.TopBar.SeparatorWidth}" />
    <Setter Property="Height" Value="{DynamicResource Component.TopBar.SeparatorHeight}" />
    <Setter Property="Margin" Value="{DynamicResource Component.TopBar.SeparatorMargin}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Border}" />
  </Style>
  <!-- Narrow: the menus sit behind a ≡ (the menu bar's one item), the separator goes, and the chip keeps its name alone. -->
  <Style Selector="Border.topBar.narrow Border.topBarSeparator">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.topBar.narrow TextBlock.chipDetail">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.projectChip">
    <Setter Property="Padding" Value="{DynamicResource Component.TopBar.ChipPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Component.TopBar.ChipHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.refreshIcon">
    <Setter Property="Padding" Value="{DynamicResource Component.TopBar.ChipPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Component.TopBar.ChipHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.chipDetail">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Status}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
    <Setter Property="MaxWidth" Value="{DynamicResource Component.TopBar.ChipDetailMaxWidth}" />
  </Style>
  <Style Selector="Button.projectChip Ellipse.freshDot">
    <Setter Property="Margin" Value="{DynamicResource Component.TopBar.ChipDotMargin}" />
  </Style>
  <Style Selector="TextBlock.chipCaret">
    <Setter Property="Margin" Value="{DynamicResource Component.TopBar.ChipCaretMargin}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
  <!-- The project card: its own box and padding, so the pop-up's presenter adds none. -->
  <Style Selector="FlyoutPresenter.projectCard">
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
    <Setter Property="MaxWidth" Value="{DynamicResource Component.TopBar.CardWidth}" />
  </Style>
  <Style Selector="Border.projectCard">
    <Setter Property="Width" Value="{DynamicResource Component.TopBar.CardWidth}" />
  </Style>
  <Style Selector=":is(TextBlock).cardProjectName">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Navigation}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.cardStatus">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Subtle}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Intent.Radius.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Component.TopBar.CardStatusPadding}" />
  </Style>
  <Style Selector="Border.cardStatus.current">
    <Setter Property="Background" Value="{DynamicResource Intent.Success.Fill}" />
  </Style>
  <Style Selector="Border.cardStatus.stale">
    <Setter Property="Background" Value="{DynamicResource Intent.Warning.Fill}" />
  </Style>
  <Style Selector="Border.cardStatus.refused">
    <Setter Property="Background" Value="{DynamicResource Intent.Danger.Fill}" />
  </Style>
  <Style Selector="Border.cardFooter">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerTop}" />
    <Setter Property="Padding" Value="{DynamicResource Component.TopBar.CardFooterPadding}" />
  </Style>
  <Style Selector="Menu.mainMenu > MenuItem">
    <Setter Property="Padding" Value="{DynamicResource Component.TopBar.MenuItemPadding}" />
  </Style>
  <Style Selector=":is(TextBlock).projectName">
    <Setter Property="MaxWidth" Value="{DynamicResource Component.TopBar.ProjectNameMaxWidth}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Body}" />
  </Style>
  <Style Selector="ProgressBar.topBarParseProgress">
    <Setter Property="Width" Value="{DynamicResource Component.TopBar.ParseProgressWidth}" />
    <Setter Property="Height" Value="{DynamicResource Component.TopBar.ParseProgressHeight}" />
  </Style>
</Styles>
