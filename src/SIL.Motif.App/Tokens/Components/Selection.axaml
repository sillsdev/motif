<!-- The Selection editor's dense controls, with colors from Intent and sizes from token aliases. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.Selection.CountMargin" ResourceKey="Primitive.Inset.0_0_0_2" />
    <StaticResource x:Key="Component.Selection.ChipPadding" ResourceKey="Primitive.Inset.12_4_12_4" />
  </Styles.Resources>
  <Style Selector=":is(TextBlock).columnHeader">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
  <Style Selector=":is(TextBlock).smallText">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
  </Style>
  <Style Selector=":is(TextBlock).textCount">
    <Setter Property="Margin" Value="{DynamicResource Component.Selection.CountMargin}" />
  </Style>
  <Style Selector="Button.viewChip">
    <Setter Property="Padding" Value="{DynamicResource Component.Selection.ChipPadding}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
  </Style>
  <Style Selector="Button.viewChip.active">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Neutral}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</Styles>
