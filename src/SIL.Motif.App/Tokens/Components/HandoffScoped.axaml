<!-- Handoff styles that only its own views use. Those views include this file, so no other control tries these selectors. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A written file: a row under a hairline, led by a solid mark naming its kind. -->
  <Style Selector="Border.handoffFile">
    <Setter Property="Padding" Value="{DynamicResource Component.Handoff.FilePadding}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Component.Handoff.FileEdge}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
  </Style>
  <Style Selector="Border.handoffKind">
    <Setter Property="Background" Value="{DynamicResource Intent.Emphasis.Fill}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Intent.Radius.Control}" />
    <Setter Property="MinWidth" Value="{DynamicResource Component.Handoff.KindMinWidth}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Handoff.KindPadding}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A suggested question reads as a link: one click copies it for the chat. -->
  <Style Selector="Button.handoffQuestion">
    <Setter Property="ToolTip.Placement" Value="Top" />
    <Setter Property="ToolTip.VerticalOffset" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Handoff.QuestionInset}" />
    <Setter Property="Margin" Value="{DynamicResource Component.Handoff.QuestionInset}" />
  </Style>
</Styles>
