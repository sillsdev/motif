<!--
  The project summary page uses a figure strip and flat tables for stored results and their detail links.
  Colours come from Intent keys; sizes and gaps come from Intent keys or this file's Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.Overview.PageMargin" ResourceKey="Intent.Inset.Page" />
    <StaticResource x:Key="Component.Overview.HeaderPadding" ResourceKey="Intent.Inset.Panel" />
    <StaticResource x:Key="Component.Overview.TilePadding" ResourceKey="Intent.Inset.Panel" />
    <StaticResource x:Key="Component.Overview.HandoffPadding" ResourceKey="Intent.Inset.Row" />
    <StaticResource x:Key="Component.Overview.CardRadius" ResourceKey="Intent.Radius.None" />
    <StaticResource x:Key="Component.Overview.HandoffGap" ResourceKey="Primitive.Space.12" />
    <StaticResource x:Key="Component.Overview.CountMargin" ResourceKey="Primitive.Inset.0_2_0_2" />
    <StaticResource x:Key="Component.Overview.HeaderGap" ResourceKey="Intent.Space.Minimal" />
    <StaticResource x:Key="Component.Overview.SectionGap" ResourceKey="Intent.Space.Compact" />
    <StaticResource x:Key="Component.Overview.MinimumRowHeight" ResourceKey="Primitive.Size.24" />
    <StaticResource x:Key="Component.Overview.TitleType" ResourceKey="Intent.Type.Section" />
    <StaticResource x:Key="Component.Overview.HistoryEntryPadding" ResourceKey="Primitive.Inset.0_8_0_8" />
    <StaticResource x:Key="Component.Overview.HandoffIconSize" ResourceKey="Primitive.Size.18" />
    <StaticResource x:Key="Component.Overview.KindBarHeight" ResourceKey="Primitive.Size.10" />
    <StaticResource x:Key="Component.Overview.FigureType" ResourceKey="Intent.Type.Section" />
    <StaticResource x:Key="Component.Overview.RowPadding" ResourceKey="Primitive.Inset.8_2_8_2" />
    <StaticResource x:Key="Component.Overview.ColumnsBreakpoint" ResourceKey="Primitive.Size.760" />
  </Styles.Resources>
  <Style Selector="Button.overviewInspectorAction">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <!-- The inset is the scrolled content's own padding so a scroll that reveals a control counts it. -->
  <Style Selector="Border.overviewPageFrame">
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.PageMargin}" />
  </Style>
  <Style Selector="StackPanel.overviewPage">
    <Setter Property="Spacing" Value="{DynamicResource Component.Overview.SectionGap}" />
  </Style>
  <Style Selector="StackPanel.overviewHeaderContent">
    <Setter Property="Spacing" Value="{DynamicResource Component.Overview.HeaderGap}" />
  </Style>
  <Style Selector="Border.overviewHeader">
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.HeaderPadding}" />
  </Style>
  <Style Selector="StackPanel.overviewProject">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector="Border.overviewRecentRow">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Overview.CardRadius}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.HistoryEntryPadding}" />
  </Style>
  <Style Selector="Button.overviewRecentProject">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.None}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="StackPanel.overviewRefusalActions">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Related}" />
  </Style>
  <Style Selector="UniformGrid.overviewCounts">
    <Setter Property="Margin" Value="{DynamicResource Intent.Inset.None}" />
  </Style>
  <Style Selector="UniformGrid.overviewTiles">
    <Setter Property="ColumnSpacing" Value="{DynamicResource Intent.Space.Group}" />
    <Setter Property="RowSpacing" Value="{DynamicResource Intent.Space.Group}" />
  </Style>
  <Style Selector="StackPanel.overviewCount">
    <Setter Property="Margin" Value="{DynamicResource Component.Overview.CountMargin}" />
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Minimal}" />
  </Style>
  <Style Selector=":is(TextBlock).overviewCountValue">
    <Setter Property="FontSize" Value="{DynamicResource Component.Overview.FigureType}" />
    <Setter Property="FontWeight" Value="{DynamicResource Intent.Weight.Section}" />
  </Style>
  <Style Selector=":is(TextBlock).overviewProjectName">
    <Setter Property="FontSize" Value="{DynamicResource Component.Overview.TitleType}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).overviewMuted">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Status}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.overviewTile">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Overview.CardRadius}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.TilePadding}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <!-- A tile that holds word rows, each with its own next steps, is a frame with a link rather than a button. -->
  <Style Selector="Border.overviewTile">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerBottom}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Overview.CardRadius}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.TilePadding}" />
  </Style>
  <Style Selector="Border.overviewTile:pointerover">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Hover}" />
  </Style>
  <Style Selector="HyperlinkButton.overviewTileLink">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Link}" />
  </Style>
  <Style Selector="Button.overviewLookFirstRow">
    <Setter Property="MinHeight" Value="{DynamicResource Component.Overview.MinimumRowHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Surface}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.None}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.overviewLookFirstRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Hover}" />
  </Style>
  <Style Selector=":is(TextBlock).overviewLookFirstAction">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Link}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
  </Style>
  <!-- Semi repaints the face under the pointer and on a press, so the tile's hover fill and outline go there too. -->
  <Style Selector="Button.overviewTile:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.overviewTile:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
  </Style>
  <Style Selector="StackPanel.overviewTileContent">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Snug}" />
  </Style>
  <Style Selector="Border.overviewLookFirst">
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.TilePadding}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerBottom}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Overview.CardRadius}" />
  </Style>
  <Style Selector="StackPanel.overviewLookFirstContent">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector="StackPanel.overviewLookFirstWords">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Minimal}" />
  </Style>
  <Style Selector=":is(TextBlock).overviewLookFirstNumber">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="StackPanel.overviewWarningKindRow">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Minimal}" />
  </Style>
  <Style Selector="Border.overviewTile :is(StackPanel).outcomeLegendEntry > :is(TextBlock).outcomeLegendText">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
  </Style>
  <Style Selector=":is(StackPanel).overviewOutcomeBar">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector=":is(StackPanel).overviewOutcomeBar :is(TextBlock).outcomeLegendText">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector=":is(TextBlock).overviewTileTitle">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).overviewTileValue">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).overviewTileDetail">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Border.overviewHandoff">
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.HandoffPadding}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerBottom}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Overview.CardRadius}" />
  </Style>
  <Style Selector="PathIcon.overviewHandoffIcon">
    <Setter Property="Width" Value="{DynamicResource Component.Overview.HandoffIconSize}" />
    <Setter Property="Height" Value="{DynamicResource Component.Overview.HandoffIconSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Accent}" />
  </Style>
  <Style Selector=":is(TextBlock).overviewHandoffText">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Status}" />
  </Style>
  <Style Selector="Expander.overviewHistory">
    <Setter Property="Margin" Value="{DynamicResource Intent.Gap.AfterRelated}" />
  </Style>
  <Style Selector="StackPanel.overviewHistoryContent">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector="Border.overviewHistoryEntry">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerBottom}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.HistoryEntryPadding}" />
  </Style>
  <Style Selector="StackPanel.overviewHistoryRow">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector=":is(TextBlock).overviewHistoryKind">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.overviewTableRow">
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.RowPadding}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerBottom}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Intent.Radius.None}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Surface}" />
  </Style>
  <Style Selector="Button.overviewTableRow">
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.RowPadding}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerBottom}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Intent.Radius.None}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Surface}" />
  </Style>
  <Style Selector="Button.overviewTableRow">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Text}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.overviewTableRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
  </Style>
  <Style Selector="Grid.overviewShareBar">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Neutral}" />
    <Setter Property="Height" Value="{DynamicResource Component.Overview.KindBarHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.overviewShareFill:not(.outcome):not(.meaning)">
    <Setter Property="Background" Value="{DynamicResource Intent.Timing.Unattributed}" />
  </Style>
  <Style Selector="Border.overviewShareFill.morph_rule">
    <Setter Property="Background" Value="{DynamicResource Intent.Timing.MorphRule}" />
  </Style>
  <Style Selector="Border.overviewShareFill.phon_rule">
    <Setter Property="Background" Value="{DynamicResource Intent.Timing.PhonRule}" />
  </Style>
  <Style Selector="Border.overviewShareFill.lex_entry">
    <Setter Property="Background" Value="{DynamicResource Intent.Timing.Lexicon}" />
  </Style>
  <Style Selector="Border.overviewShareFill.root_index">
    <Setter Property="Background" Value="{DynamicResource Intent.Timing.RootLookup}" />
  </Style>
</Styles>
