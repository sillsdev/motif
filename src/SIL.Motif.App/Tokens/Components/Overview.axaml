<!--
  The project summary page: each card shows one stored Overview response and routes to its detail page.
  Colours come from Intent keys; sizes and gaps come from Intent keys or this file's Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.Overview.PageMargin" ResourceKey="Primitive.Inset.16_16_16_16" />
    <StaticResource x:Key="Component.Overview.HeaderPadding" ResourceKey="Primitive.Inset.16_16_16_16" />
    <StaticResource x:Key="Component.Overview.TilePadding" ResourceKey="Primitive.Inset.16_16_16_16" />
    <StaticResource x:Key="Component.Overview.HandoffPadding" ResourceKey="Primitive.Inset.12_4_12_4" />
    <StaticResource x:Key="Component.Overview.CardRadius" ResourceKey="Primitive.Radius.12" />
    <StaticResource x:Key="Component.Overview.HandoffGap" ResourceKey="Primitive.Space.12" />
    <StaticResource x:Key="Component.Overview.CountMargin" ResourceKey="Primitive.Inset.0_8_0_8" />
    <StaticResource x:Key="Component.Overview.HistoryEntryPadding" ResourceKey="Primitive.Inset.0_8_0_8" />
    <StaticResource x:Key="Component.Overview.HandoffIconSize" ResourceKey="Primitive.Size.18" />
    <StaticResource x:Key="Component.Overview.KindBarHeight" ResourceKey="Primitive.Size.10" />
  </Styles.Resources>
  <Style Selector="StackPanel.overviewPage">
    <Setter Property="Margin" Value="{DynamicResource Component.Overview.PageMargin}" />
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Section}" />
  </Style>
  <Style Selector="StackPanel.overviewHeaderContent">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Section}" />
  </Style>
  <Style Selector="Border.overviewHeader">
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.HeaderPadding}" />
  </Style>
  <Style Selector="StackPanel.overviewProject">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector="StackPanel.overviewRefusalActions">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Related}" />
  </Style>
  <Style Selector="UniformGrid.overviewCounts">
    <Setter Property="Margin" Value="{DynamicResource Intent.Gap.AfterGroup}" />
  </Style>
  <Style Selector="UniformGrid.overviewTiles">
    <Setter Property="ColumnSpacing" Value="{DynamicResource Intent.Space.Group}" />
    <Setter Property="RowSpacing" Value="{DynamicResource Intent.Space.Group}" />
  </Style>
  <Style Selector="StackPanel.overviewCount">
    <Setter Property="Margin" Value="{DynamicResource Component.Overview.CountMargin}" />
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Minimal}" />
  </Style>
  <Style Selector=":is(TextBlock).overviewCountValue">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Section}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).overviewProjectName">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).overviewMuted">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Status}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.overviewTile">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Overview.CardRadius}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.TilePadding}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <!-- A tile that holds word rows, each with its own next steps, is a frame with a link rather than a button. -->
  <Style Selector="Border.overviewTile">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Overview.CardRadius}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.TilePadding}" />
  </Style>
  <Style Selector="Border.overviewTile:pointerover">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Hover}" />
  </Style>
  <Style Selector="HyperlinkButton.overviewTileLink, HyperlinkButton.overviewLookFirstLink">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Link}" />
  </Style>
  <!-- Semi repaints the face under the pointer and on a press, so the tile's hover fill and outline go there too. -->
  <Style Selector="Button.overviewTile:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.overviewTile:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
  </Style>
  <Style Selector="StackPanel.overviewTileContent">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Snug}" />
  </Style>
  <Style Selector="Border.overviewLookFirst">
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.TilePadding}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Overview.CardRadius}" />
  </Style>
  <Style Selector="StackPanel.overviewLookFirstContent">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Related}" />
  </Style>
  <Style Selector="Grid.overviewLookFirstRow">
    <Setter Property="ColumnSpacing" Value="{DynamicResource Intent.Space.Related}" />
    <Setter Property="RowSpacing" Value="{DynamicResource Intent.Space.Minimal}" />
  </Style>
  <Style Selector="StackPanel.overviewLookFirstWords">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Minimal}" />
  </Style>
  <Style Selector=":is(TextBlock).overviewLookFirstNumber">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="StackPanel.overviewWarningKindRow">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Minimal}" />
  </Style>
  <Style Selector="Border.overviewTile :is(StackPanel).outcomeLegendEntry > :is(TextBlock).outcomeLegendText">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
  </Style>
  <Style Selector=":is(StackPanel).overviewOutcomeBar">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector=":is(StackPanel).overviewOutcomeBar :is(TextBlock).outcomeLegendText">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector=":is(TextBlock).overviewTileTitle">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).overviewTileValue">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).overviewTileDetail">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Border.overviewHandoff">
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.HandoffPadding}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Overview.CardRadius}" />
  </Style>
  <Style Selector="PathIcon.overviewHandoffIcon">
    <Setter Property="Width" Value="{DynamicResource Component.Overview.HandoffIconSize}" />
    <Setter Property="Height" Value="{DynamicResource Component.Overview.HandoffIconSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Accent}" />
  </Style>
  <Style Selector=":is(TextBlock).overviewHandoffText">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Status}" />
  </Style>
  <Style Selector="Expander.overviewHistory">
    <Setter Property="Margin" Value="{DynamicResource Intent.Gap.AfterRelated}" />
  </Style>
  <Style Selector="StackPanel.overviewHistoryContent">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector="Border.overviewHistoryEntry">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerBottom}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Overview.HistoryEntryPadding}" />
  </Style>
  <Style Selector="StackPanel.overviewHistoryRow">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector=":is(TextBlock).overviewHistoryKind">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</Styles>
