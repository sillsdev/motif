<!--
  A notice: a tinted box that asks for attention without being an error.
  Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.Notice.Padding" ResourceKey="Intent.Inset.Notice" />
    <StaticResource x:Key="Component.Notice.Radius" ResourceKey="Intent.Radius.Control" />
    <StaticResource x:Key="Component.Notice.ActionGap" ResourceKey="Intent.Space.Section" />
    <StaticResource x:Key="Component.Notice.TechDemoPadding" ResourceKey="Primitive.Inset.6_0_6_0" />
    <StaticResource x:Key="Component.Notice.QuietPadding" ResourceKey="Primitive.Inset.0_8_0_8" />
  </Styles.Resources>
  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{DynamicResource Intent.Warning.Fill}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Notice.Radius}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Notice.Padding}" />
  </Style>
  <Style Selector="Border.notice.techDemoNotice">
    <Setter Property="Padding" Value="{DynamicResource Component.Notice.TechDemoPadding}" />
  </Style>
  <Style Selector=":is(TextBlock).techDemoNoticeText">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
  </Style>
  <!-- Semi's default button label is too light on the notice's tint; a solid primary button keeps its own. -->
  <Style Selector="Border.notice Button:not(.Primary)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Link.Text}" />
  </Style>
  <!-- A page's note while a Proposal is open: what is paired and what stays today's. -->
  <Style Selector="Border.proposalPageNote">
    <Setter Property="Background" Value="{DynamicResource Intent.Proposal.Fill}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Notice.Radius}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Notice.Padding}" />
  </Style>
  <Style Selector="Border.proposalPageNote :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Proposal.Text}" />
  </Style>
  <Style Selector="Border.quietWritingSystemNotice">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerBottom}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Notice.QuietPadding}" />
  </Style>
  <Style Selector="Border.quietWritingSystemNotice Button">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Link.Text}" />
  </Style>
</Styles>
