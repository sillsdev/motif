<!-- The Timing resources. Its styles are in TimingScoped.axaml, included by the views that use them. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SIL.Motif.App.Views">

  <Styles.Resources>
    <StaticResource x:Key="Component.Timing.PagePadding" ResourceKey="Intent.Inset.Page" />
    <StaticResource x:Key="Component.Timing.SideWidth" ResourceKey="Primitive.Size.280" />
    <StaticResource x:Key="Component.Timing.BarHeight" ResourceKey="Primitive.Size.22" />
    <StaticResource x:Key="Component.Timing.PickerHeight" ResourceKey="Primitive.Size.52" />
    <StaticResource x:Key="Component.Timing.SourcePickerWidth" ResourceKey="Primitive.Size.170" />
    <StaticResource x:Key="Component.Timing.SlowestCountWidth" ResourceKey="Primitive.Size.90" />
    <StaticResource x:Key="Component.Timing.WordsColumnMinWidth" ResourceKey="Primitive.Size.70" />
    <StaticResource x:Key="Component.Timing.NarrowColumnMinWidth" ResourceKey="Primitive.Size.52" />
    <StaticResource x:Key="Component.Timing.RowPadding" ResourceKey="Intent.Inset.Row" />
    <StaticResource x:Key="Component.Timing.HeaderPadding" ResourceKey="Intent.Inset.Row" />
    <StaticResource x:Key="Component.Timing.HeadlineGap" ResourceKey="Intent.Space.Section" />
  </Styles.Resources>
</Styles>
