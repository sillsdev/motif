<!-- The Warnings resources, and the styles that controls outside Warnings reach. The rest are in WarningsScoped.axaml. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <StaticResource x:Key="Component.Warnings.PageMargin" ResourceKey="Intent.Inset.Page" />
    <StaticResource x:Key="Component.Warnings.EmptyMargin" ResourceKey="Intent.Inset.Page" />
    <StaticResource x:Key="Component.Warnings.RowMargin" ResourceKey="Primitive.Inset.0_0_0_4" />
    <StaticResource x:Key="Component.Warnings.RowPadding" ResourceKey="Primitive.Inset.4_2_4_2" />
    <StaticResource x:Key="Component.Warnings.SummaryPadding" ResourceKey="Intent.Inset.Row" />
    <StaticResource x:Key="Component.Warnings.DetailPadding" ResourceKey="Intent.Inset.Panel" />
    <StaticResource x:Key="Component.Warnings.WorkflowPadding" ResourceKey="Intent.Inset.Row" />
  </Styles.Resources>

  <Style Selector="StackPanel.warningEmpty">
    <Setter Property="Margin" Value="{DynamicResource Component.Warnings.EmptyMargin}" />
  </Style>

</Styles>
