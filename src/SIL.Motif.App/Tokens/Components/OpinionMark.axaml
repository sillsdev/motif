<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.OpinionMark.Size" ResourceKey="Primitive.Size.13" />
    <StaticResource x:Key="Component.OpinionMark.Stroke" ResourceKey="Primitive.Inset.1p2_1p2_1p2_1p2" />
    <StaticResource x:Key="Component.OpinionMark.StrokeWidth" ResourceKey="Primitive.Stroke.1p2" />
    <StaticResource x:Key="Component.OpinionMark.Type" ResourceKey="Primitive.Type.8" />
    <StaticResource x:Key="Component.OpinionMark.Radius" ResourceKey="Primitive.Radius.2" />
    <StaticResource x:Key="Component.OpinionMark.UnknownRadius" ResourceKey="Primitive.Radius.7" />
    <StaticResource x:Key="Component.OpinionMark.Dash" ResourceKey="Primitive.Dash.3_2" />
  </Styles.Resources>
  <Style Selector="Border.opinionMark">
    <Setter Property="Width" Value="{DynamicResource Component.OpinionMark.Size}" />
    <Setter Property="Height" Value="{DynamicResource Component.OpinionMark.Size}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Component.OpinionMark.Stroke}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.OpinionMark.Radius}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Opinion.None.Outline}" />
  </Style>
  <Style Selector="Border.opinionMark :is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource Component.OpinionMark.Type}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Opinion.None.Text}" />
  </Style>
  <Style Selector="Border.opinionMark.approved">
    <Setter Property="AutomationProperties.Name" Value="Approved" />
    <Setter Property="Background" Value="{DynamicResource Intent.Opinion.Approved.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Opinion.Approved.Accent}" />
  </Style>
  <Style Selector="Border.opinionMark.approved :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Opinion.Approved.Text}" />
  </Style>
  <Style Selector="Border.opinionMark.disapproved">
    <Setter Property="AutomationProperties.Name" Value="Disapproved" />
    <Setter Property="Background" Value="{DynamicResource Intent.Opinion.Disapproved.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Opinion.Disapproved.Accent}" />
  </Style>
  <Style Selector="Border.opinionMark.disapproved :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Opinion.Disapproved.Text}" />
  </Style>
  <Style Selector="Border.opinionMark.unknown">
    <Setter Property="AutomationProperties.Name" Value="Unknown" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.OpinionMark.UnknownRadius}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Opinion.Unknown.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Opinion.Unknown.Accent}" />
  </Style>
  <Style Selector="Border.opinionMark.unknown :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Opinion.Unknown.Text}" />
  </Style>
  <Style Selector="Border.opinionMark.none">
    <Setter Property="AutomationProperties.Name" Value="Not in FieldWorks" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.None}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Clear}" />
  </Style>
  <Style Selector="Border.opinionMark.none Rectangle.opinionDash">
    <Setter Property="Width" Value="{DynamicResource Component.OpinionMark.Size}" />
    <Setter Property="Height" Value="{DynamicResource Component.OpinionMark.Size}" />
    <Setter Property="Fill" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="Stroke" Value="{DynamicResource Intent.Opinion.None.Outline}" />
    <Setter Property="StrokeThickness" Value="{DynamicResource Component.OpinionMark.StrokeWidth}" />
    <Setter Property="StrokeDashArray" Value="{DynamicResource Component.OpinionMark.Dash}" />
  </Style>
</Styles>
