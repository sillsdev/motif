<!-- The TryWord resources, and the styles that controls outside TryWord reach. The rest are in TryWordScoped.axaml. -->
<!-- Shared sizing and diagnostic roles for the Try a Word page and recorded diagnostic. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <StaticResource x:Key="Component.TryWord.PageInset" ResourceKey="Primitive.Inset.8_4_8_4" />
    <StaticResource x:Key="Component.TryWord.ProgressWidth" ResourceKey="Primitive.Size.52" />
    <StaticResource x:Key="Component.TryWord.SmallInset" ResourceKey="Primitive.Inset.7_1_7_1" />
    <StaticResource x:Key="Component.TryWord.SmallRowInset" ResourceKey="Primitive.Inset.1_1_1_1" />
    <StaticResource x:Key="Component.TryWord.SmallBottomInset" ResourceKey="Primitive.Inset.0_0_4_4" />
    <StaticResource x:Key="Component.TryWord.ToolButtonInset" ResourceKey="Intent.Inset.Row" />
    <StaticResource x:Key="Component.TryWord.TraceNotationColumnMinWidth" ResourceKey="Primitive.Size.92" />
    <StaticResource x:Key="Component.TryWord.TraceOutcomeColumnMinWidth" ResourceKey="Primitive.Size.70" />
    <StaticResource x:Key="Component.TryWord.SidebarWidth" ResourceKey="Primitive.Size.280" />
    <StaticResource x:Key="Component.TryWord.NotationFont" ResourceKey="Primitive.Font.Mono" />
    <StaticResource x:Key="Component.TryWord.ToolsMaxHeight" ResourceKey="Primitive.Size.280" />
    <StaticResource x:Key="Component.TryWord.CompactControlHeight" ResourceKey="Primitive.Size.24" />
    <StaticResource x:Key="Component.TryWord.ColumnsBreakpoint" ResourceKey="Primitive.Size.600" />
  </Styles.Resources>
  <Style Selector=":is(TextBlock).status">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).failed">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Danger.Text}" />
  </Style>
  <Style Selector=":is(TextBlock).succeeded">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Success.Text}" />
  </Style>
  <Style Selector="Button.stopGroup TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Text}" />
  </Style>
  <Style Selector=":is(TextBlock).number">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Button.ruleRow TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Text}" />
  </Style>
  <Style Selector=":is(TextBlock).share">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Primary}" />
  </Style>
  <Style Selector="Border.bestPath TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Caption}" />
  </Style>
  <Style Selector="Button.traceToken TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
</Styles>
