<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.UnreadMark.Padding" ResourceKey="Primitive.Inset.4_2_4_2" />
  </Styles.Resources>
  <Style Selector="Border.unreadMark">
    <Setter Property="Background" Value="{DynamicResource Intent.Unread.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Unread.Text}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Intent.Radius.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Component.UnreadMark.Padding}" />
  </Style>
  <Style Selector="Border.unreadMark TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Unread.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="StackPanel.unreadMarkContent">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Snug}" />
  </Style>
  <Style Selector="Ellipse.unreadMarkDot">
    <Setter Property="Fill" Value="{DynamicResource Intent.Unread.Text}" />
    <Setter Property="Width" Value="{DynamicResource Intent.Space.Snug}" />
    <Setter Property="Height" Value="{DynamicResource Intent.Space.Snug}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
