<!-- Word cards group linguistic evidence while keeping its text selectable and its actions accessible. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.WordCard.HeaderPadding" ResourceKey="Primitive.Inset.8_3_8_3" />
    <StaticResource x:Key="Component.WordCard.HeadingType" ResourceKey="Primitive.Type.10" />
  </Styles.Resources>
  <Style Selector="Grid.wordPresentationCardGrid">
    <Setter Property="ColumnSpacing" Value="{DynamicResource Intent.Space.Related}" />
    <Setter Property="RowSpacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector="StackPanel.wordPresentationCardSection">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector=":is(TextBlock).wordPresentationCardLabel">
    <Setter Property="FontSize" Value="{DynamicResource Component.WordCard.HeadingType}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
  <Style Selector=":is(TextBlock).wordPresentationCardHeading">
    <Setter Property="FontSize" Value="{DynamicResource Component.WordCard.HeadingType}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
  <Style Selector="Button.wordPresentationCardAction">
    <Setter Property="Margin" Value="{DynamicResource Intent.Gap.CompactItem}" />
  </Style>
  <Style Selector="Border.wordPresentationCardHeader">
    <Setter Property="Background" Value="{DynamicResource Intent.Selected.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerBottom}" />
    <Setter Property="Padding" Value="{DynamicResource Component.WordCard.HeaderPadding}" />
  </Style>
  <Style Selector="Button.wordPresentationCardClose">
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.None}" />
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
</Styles>
