<!--
  The freshness line: green when current, amber when FieldWorks has saved since, blue while refreshing.
  Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.Freshness.DotSize" ResourceKey="Primitive.Size.8" />
  </Styles.Resources>
  <!-- A dock, not a stack: the detail fills what the bar's buttons leave and trims, rather than running under them. -->
  <Style Selector="DockPanel.freshness">
    <Setter Property="HorizontalSpacing" Value="{DynamicResource Intent.Space.Snug}" />
  </Style>
  <Style Selector="Ellipse.freshDot">
    <Setter Property="Width" Value="{DynamicResource Component.Freshness.DotSize}" />
    <Setter Property="Height" Value="{DynamicResource Component.Freshness.DotSize}" />
    <Setter Property="Fill" Value="{DynamicResource Intent.TextFaint}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.freshDot.current">
    <Setter Property="Fill" Value="{DynamicResource Intent.Success.Text}" />
  </Style>
  <Style Selector="Ellipse.freshDot.stale">
    <Setter Property="Fill" Value="{DynamicResource Intent.Warning.Text}" />
  </Style>
  <Style Selector="Ellipse.freshDot.busy">
    <Setter Property="Fill" Value="{DynamicResource Intent.Accent}" />
  </Style>
  <Style Selector="Ellipse.freshDot.refused">
    <Setter Property="Fill" Value="{DynamicResource Intent.Danger}" />
  </Style>
  <Style Selector=":is(TextBlock).freshLabel">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Status}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(TextBlock).freshLabel.current">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Success.Text}" />
  </Style>
  <Style Selector=":is(TextBlock).freshLabel.stale">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Warning.Text}" />
  </Style>
  <Style Selector=":is(TextBlock).freshLabel.busy">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Accent}" />
  </Style>
  <Style Selector=":is(TextBlock).freshLabel.refused">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Danger}" />
  </Style>
  <Style Selector=":is(TextBlock).freshDetail">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Status}" />
  </Style>
</Styles>
