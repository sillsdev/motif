<!--
  A card: a bordered, rounded box holding one thing on a page.
  Names Intent keys only.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.card">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Intent.Radius.Card}" />
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.Card}" />
  </Style>
</Styles>
