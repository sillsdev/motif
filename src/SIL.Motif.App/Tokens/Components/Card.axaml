<!--
  A card: a bordered grouping for one thing on a page.
  Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.Card.Padding" ResourceKey="Intent.Inset.Panel" />
    <StaticResource x:Key="Component.Card.Radius" ResourceKey="Intent.Radius.None" />
  </Styles.Resources>
  <Style Selector="Border.card">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Card.Radius}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Card.Padding}" />
  </Style>
</Styles>
