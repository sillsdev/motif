<!-- The Setup resources. Its styles are in SetupScoped.axaml, included by the views that use them. -->
<!-- The modal setup flow: token-sized layout, with color roles supplied by Intent. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <StaticResource x:Key="Component.Setup.DialogWidth" ResourceKey="Primitive.Size.780" />
    <StaticResource x:Key="Component.Setup.DialogHeightLimit" ResourceKey="Primitive.Size.600" />
    <StaticResource x:Key="Component.Setup.DialogRadius" ResourceKey="Intent.Radius.None" />
    <StaticResource x:Key="Component.Setup.DialogPadding" ResourceKey="Primitive.Inset.8_4_8_4" />
    <StaticResource x:Key="Component.Setup.DialogMargin" ResourceKey="Primitive.Inset.8_4_8_4" />
    <StaticResource x:Key="Component.Setup.AddedWordsHeight" ResourceKey="Primitive.Size.52" />
    <StaticResource x:Key="Component.Setup.AddedWordsMaxHeight" ResourceKey="Primitive.Size.140" />
    <StaticResource x:Key="Component.Setup.NumberWidth" ResourceKey="Primitive.Size.190" />
    <StaticResource x:Key="Component.Setup.MarkerSize" ResourceKey="Primitive.Size.8" />
    <StaticResource x:Key="Component.Setup.MarkerActiveWidth" ResourceKey="Primitive.Size.22" />
    <StaticResource x:Key="Component.Setup.TextRowPadding" ResourceKey="Primitive.Inset.8_2_8_2" />
    <StaticResource x:Key="Component.Setup.SummaryPadding" ResourceKey="Primitive.Inset.8_2_8_2" />
  </Styles.Resources>
</Styles>
