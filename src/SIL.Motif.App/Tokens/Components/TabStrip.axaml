<!--
  Tabs on a page: the active one underlined in the accent colour.
  Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.TabStrip.TabPadding" ResourceKey="Primitive.Inset.0_8_0_8" />
    <StaticResource x:Key="Component.TabStrip.TabMargin" ResourceKey="Primitive.Inset.0_0_20_0" />
  </Styles.Resources>
  <Style Selector="Button.tab">
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
    <Setter Property="Padding" Value="{DynamicResource Component.TabStrip.TabPadding}" />
    <Setter Property="Margin" Value="{DynamicResource Component.TabStrip.TabMargin}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Underline}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Intent.Radius.None}" />
  </Style>
  <Style Selector="Button.tab.active">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Accent}" />
  </Style>
</Styles>
