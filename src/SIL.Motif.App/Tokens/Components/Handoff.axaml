<!--
  The AI Handoff page: what goes in, the files written, and the steps to a chat.
  Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.Handoff.HeaderPadding" ResourceKey="Primitive.Inset.20_8_20_8" />
    <StaticResource x:Key="Component.Handoff.PageMargin" ResourceKey="Primitive.Inset.24_16_24_20" />
    <StaticResource x:Key="Component.Handoff.ColumnGap" ResourceKey="Primitive.Space.20" />
    <StaticResource x:Key="Component.Handoff.GuideWidth" ResourceKey="Primitive.Size.420" />
    <StaticResource x:Key="Component.Handoff.SectionGap" ResourceKey="Primitive.Space.14" />
    <StaticResource x:Key="Component.Handoff.CardGap" ResourceKey="Primitive.Space.10" />
    <StaticResource x:Key="Component.Handoff.LineGap" ResourceKey="Primitive.Space.1" />
    <StaticResource x:Key="Component.Handoff.TitleSize" ResourceKey="Primitive.Type.15" />
    <StaticResource x:Key="Component.Handoff.ActionMargin" ResourceKey="Primitive.Inset.10_0_0_0" />
    <StaticResource x:Key="Component.Handoff.GlyphMargin" ResourceKey="Primitive.Inset.0_0_10_0" />
    <StaticResource x:Key="Component.Handoff.PlannedNameWidth" ResourceKey="Primitive.Size.220" />
    <StaticResource x:Key="Component.Handoff.PlannedGap" ResourceKey="Primitive.Space.14" />
    <StaticResource x:Key="Component.Handoff.PlannedMargin" ResourceKey="Primitive.Inset.0_3_0_3" />
    <StaticResource x:Key="Component.Handoff.DragHeight" ResourceKey="Primitive.Size.56" />
    <StaticResource x:Key="Component.Handoff.FilePadding" ResourceKey="Primitive.Inset.0_8_0_8" />
    <StaticResource x:Key="Component.Handoff.FileEdge" ResourceKey="Primitive.Inset.0_1_0_0" />
    <StaticResource x:Key="Component.Handoff.KindMinWidth" ResourceKey="Primitive.Size.48" />
    <StaticResource x:Key="Component.Handoff.KindPadding" ResourceKey="Primitive.Inset.6_4_6_4" />
    <StaticResource x:Key="Component.Handoff.FirstStepMargin" ResourceKey="Primitive.Inset.0_8_0_0" />
    <StaticResource x:Key="Component.Handoff.StepMargin" ResourceKey="Primitive.Inset.0_10_0_0" />
    <StaticResource x:Key="Component.Handoff.AskMargin" ResourceKey="Primitive.Inset.0_16_0_0" />
    <StaticResource x:Key="Component.Handoff.QuestionInset" ResourceKey="Primitive.Inset.0_2_0_2" />
    <StaticResource x:Key="Component.Handoff.StepMarkSize" ResourceKey="Primitive.Size.24" />
    <StaticResource x:Key="Component.Handoff.StepMarkRadius" ResourceKey="Primitive.Radius.12" />
  </Styles.Resources>

  <Style Selector="Border.handoffHeader">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerBottom}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Handoff.HeaderPadding}" />
  </Style>

  <!-- A written file: a row under a hairline, led by a solid mark naming its kind. -->
  <Style Selector="Border.handoffFile">
    <Setter Property="Padding" Value="{DynamicResource Component.Handoff.FilePadding}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Component.Handoff.FileEdge}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
  </Style>
  <Style Selector="Border.handoffKind">
    <Setter Property="Background" Value="{DynamicResource Intent.Emphasis.Fill}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Intent.Radius.Control}" />
    <Setter Property="MinWidth" Value="{DynamicResource Component.Handoff.KindMinWidth}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Handoff.KindPadding}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.handoffKind :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Emphasis.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- A suggested question reads as a link: one click copies it for the chat. -->
  <Style Selector="Button.handoffQuestion">
    <Setter Property="ToolTip.Placement" Value="Top" />
    <Setter Property="ToolTip.VerticalOffset" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Handoff.QuestionInset}" />
    <Setter Property="Margin" Value="{DynamicResource Component.Handoff.QuestionInset}" />
  </Style>
  <Style Selector="Button.handoffQuestion TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Link}" />
  </Style>

  <Style Selector="Border.stepMark">
    <Setter Property="Width" Value="{DynamicResource Component.Handoff.StepMarkSize}" />
    <Setter Property="Height" Value="{DynamicResource Component.Handoff.StepMarkSize}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.Handoff.StepMarkRadius}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Emphasis.Fill}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.stepMark :is(TextBlock)">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Emphasis.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
