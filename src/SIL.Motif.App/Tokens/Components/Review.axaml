<!-- Review page spacing, reading outlines, and type roles use shared intent tokens. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.Review.PageMargin" ResourceKey="Primitive.Inset.16_12_16_0" />
    <StaticResource x:Key="Component.Review.CardMargin" ResourceKey="Primitive.Inset.0_0_8_0" />
    <StaticResource x:Key="Component.Review.ReadingPadding" ResourceKey="Primitive.Inset.10_7_10_7" />
    <StaticResource x:Key="Component.Review.MorphPadding" ResourceKey="Primitive.Inset.4_2_4_2" />
    <StaticResource x:Key="Component.Review.RightWidth" ResourceKey="Primitive.Size.280" />
    <StaticResource x:Key="Component.Review.ParserDash" ResourceKey="Primitive.Dash.3_2" />
  </Styles.Resources>
  <Style Selector="Grid.reviewLayout">
    <Setter Property="Margin" Value="{DynamicResource Component.Review.PageMargin}" />
    <Setter Property="ColumnSpacing" Value="{DynamicResource Intent.Space.Group}" />
  </Style>
  <Style Selector="StackPanel.reviewStack">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Group}" />
  </Style>
  <Style Selector="StackPanel.reviewRelated">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Related}" />
  </Style>
  <Style Selector="StackPanel.reviewCompact">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector="Border.reviewCard">
    <Setter Property="Margin" Value="{DynamicResource Component.Review.CardMargin}" />
  </Style>
  <Style Selector="StackPanel.reviewRight">
    <Setter Property="Width" Value="{DynamicResource Component.Review.RightWidth}" />
  </Style>
  <Style Selector="Border.reviewReading">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Intent.Radius.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Component.Review.ReadingPadding}" />
    <Setter Property="Margin" Value="{DynamicResource Intent.Gap.AfterRelated}" />
  </Style>
  <Style Selector="Border.reviewReading.parser">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.TextFaint}" />
  </Style>
  <Style Selector="Border.reviewReading.touched">
    <Setter Property="Background" Value="{DynamicResource Intent.Selected.Fill}" />
  </Style>
  <Style Selector="Border.reviewMorph">
    <Setter Property="Padding" Value="{DynamicResource Component.Review.MorphPadding}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerEnd}" />
  </Style>
  <Style Selector="Rectangle.reviewParserOutline">
    <Setter Property="Stroke" Value="{DynamicResource Intent.TextFaint}" />
    <Setter Property="StrokeThickness" Value="{DynamicResource Intent.Stroke.Icon}" />
    <Setter Property="StrokeDashArray" Value="{DynamicResource Component.Review.ParserDash}" />
    <Setter Property="Margin" Value="{DynamicResource Intent.Gap.AfterRelated}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector=":is(TextBlock).reviewWord">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Brand}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector=":is(TextBlock).reviewSmall">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
  <Style Selector=":is(TextBlock).reviewEmphasis">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="HyperlinkButton.reviewLink">
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
  </Style>
</Styles>
