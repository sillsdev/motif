<!--
  An outcome bar: a track of parts, each filled with its meaning's colour, over a legend of swatches and counts.
  Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.OutcomeBar.TrackHeight" ResourceKey="Primitive.Size.14" />
    <StaticResource x:Key="Component.OutcomeBar.CompactTrackHeight" ResourceKey="Primitive.Size.10" />
    <StaticResource x:Key="Component.OutcomeBar.PartRadius" ResourceKey="Primitive.Radius.3" />
    <StaticResource x:Key="Component.OutcomeBar.SwatchSize" ResourceKey="Primitive.Size.10" />
    <StaticResource x:Key="Component.OutcomeBar.SwatchRadius" ResourceKey="Primitive.Radius.2" />
    <StaticResource x:Key="Component.OutcomeBar.SwatchMargin" ResourceKey="Primitive.Inset.0_0_6_0" />
    <StaticResource x:Key="Component.OutcomeBar.LegendEntryMargin" ResourceKey="Primitive.Inset.0_0_18_0" />
    <StaticResource x:Key="Component.OutcomeBar.LegendTextMargin" ResourceKey="Primitive.Inset.0_0_4_0" />
    <StaticResource x:Key="Component.OutcomeBar.LegendLineHeight" ResourceKey="Primitive.Size.20" />
  </Styles.Resources>
  <Style Selector=":is(StackPanel).outcomeBar">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Related}" />
  </Style>
  <Style Selector="Grid.outcomeTrack">
    <Setter Property="Height" Value="{DynamicResource Component.OutcomeBar.TrackHeight}" />
    <Setter Property="ColumnSpacing" Value="{DynamicResource Intent.Space.Minimal}" />
  </Style>
  <Style Selector="Grid.outcomeTrack.compact">
    <Setter Property="Height" Value="{DynamicResource Component.OutcomeBar.CompactTrackHeight}" />
  </Style>
  <Style Selector="Grid.outcomeTrack > Border.outcomeSegment">
    <Setter Property="CornerRadius" Value="{DynamicResource Component.OutcomeBar.PartRadius}" />
  </Style>
  <Style Selector="Border.outcomeSegment.swatch">
    <Setter Property="Width" Value="{DynamicResource Component.OutcomeBar.SwatchSize}" />
    <Setter Property="Height" Value="{DynamicResource Component.OutcomeBar.SwatchSize}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.OutcomeBar.SwatchRadius}" />
    <Setter Property="Margin" Value="{DynamicResource Component.OutcomeBar.SwatchMargin}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.outcomeLegendEntry">
    <Setter Property="Margin" Value="{DynamicResource Component.OutcomeBar.LegendEntryMargin}" />
  </Style>
  <Style Selector="StackPanel.outcomeLegendEntry > :is(TextBlock).outcomeLegendText">
    <Setter Property="Margin" Value="{DynamicResource Component.OutcomeBar.LegendTextMargin}" />
  </Style>
  <Style Selector=":is(Button).outcomeLegendLink">
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Marking.Link}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.None}" />
  </Style>
  <Style Selector=":is(Button).outcomeLegendLink:pointerover :is(TextBlock)">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector=":is(StackPanel).outcomeLegendLabel">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Minimal}" />
  </Style>
  <Style Selector="StackPanel.outcomeLegendLabel > :is(TextBlock).outcomeLegendText">
    <Setter Property="MinHeight" Value="{DynamicResource Component.OutcomeBar.LegendLineHeight}" />
  </Style>
  <Style Selector="StackPanel.outcomeLegendLabel > :is(Decorator).markGlyphHost.inline">
    <Setter Property="MinHeight" Value="{DynamicResource Component.OutcomeBar.LegendLineHeight}" />
  </Style>
  <Style Selector=":is(TextBlock).outcomeLegendCount">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=":is(TextBlock).outcomeLegendLabelText">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
  </Style>
  <Style Selector="Border.outcomeSegment">
    <Setter Property="Background" Value="{DynamicResource Intent.TextFaint}" />
  </Style>
  <!-- A part takes its mark's colour: an outcome's, or for a meaning, a shade apart from a no-parse beside it. -->
  <Style Selector="Border.outcomeSegment.outcome.same">
    <Setter Property="Background" Value="{DynamicResource Intent.Outcome.Same}" />
  </Style>
  <Style Selector="Border.outcomeSegment.outcome.different">
    <Setter Property="Background" Value="{DynamicResource Intent.Outcome.Different}" />
  </Style>
  <Style Selector="Border.outcomeSegment.outcome.noParse">
    <Setter Property="Background" Value="{DynamicResource Intent.Outcome.NoParse}" />
  </Style>
  <Style Selector="Border.outcomeSegment.outcome.stopped">
    <Setter Property="Background" Value="{DynamicResource Intent.Outcome.Stopped}" />
  </Style>
  <Style Selector="Border.outcomeSegment.outcome.notParsed">
    <Setter Property="Background" Value="{DynamicResource Intent.Outcome.NotParsed}" />
  </Style>
  <Style Selector="Border.outcomeSegment.meaning.fine">
    <Setter Property="Background" Value="{DynamicResource Intent.Consequence.Fine}" />
  </Style>
  <Style Selector="Border.outcomeSegment.meaning.look">
    <Setter Property="Background" Value="{DynamicResource Intent.Consequence.Look.Edge}" />
  </Style>
  <Style Selector="Border.outcomeSegment.meaning.problem">
    <Setter Property="Background" Value="{DynamicResource Intent.Consequence.Problem.Edge}" />
  </Style>
</Styles>
