<!--
  Filter chips: one look for every page's chips.
  Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.FilterChip.Padding" ResourceKey="Primitive.Inset.9_3_9_3" />
    <StaticResource x:Key="Component.FilterChip.Radius" ResourceKey="Primitive.Radius.12" />
    <StaticResource x:Key="Component.FilterChip.Margin" ResourceKey="Primitive.Inset.0_0_4_4" />
    <StaticResource x:Key="Component.FilterChip.CompactPadding" ResourceKey="Primitive.Inset.5_1_5_1" />
    <StaticResource x:Key="Component.FilterChip.CompactMargin" ResourceKey="Primitive.Inset.0_0_2_0" />
    <StaticResource x:Key="Component.FilterChip.CompactHeight" ResourceKey="Primitive.Size.24" />
  </Styles.Resources>
  <Style Selector="Button.filterChip">
    <Setter Property="Padding" Value="{DynamicResource Component.FilterChip.Padding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.FilterChip.Radius}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
    <Setter Property="Margin" Value="{DynamicResource Component.FilterChip.Margin}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
  </Style>
  <!-- Semi repaints the face under the pointer and on a press; a chip keeps its outline, and a chosen one its fill. -->
  <Style Selector="Button.filterChip:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.filterChip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
  </Style>
  <Style Selector="Button.filterChip.active:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.filterChip.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Intent.Primary.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Primary}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Intent.Shadow.Hover}" />
  </Style>
  <!-- A chip that cannot be chosen yet stays a chip, outline and all, rather than a floating grey label. -->
  <Style Selector="Button.filterChip:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
  <Style Selector="Button.filterChip.compact">
    <Setter Property="Padding" Value="{DynamicResource Component.FilterChip.CompactPadding}" />
    <Setter Property="Margin" Value="{DynamicResource Component.FilterChip.CompactMargin}" />
    <Setter Property="MinHeight" Value="{DynamicResource Component.FilterChip.CompactHeight}" />
    <Setter Property="Height" Value="{DynamicResource Component.FilterChip.CompactHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
  </Style>
  <Style Selector="Button.filterChip.compact StackPanel.filterChipRow">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector="Button.filterChip.active">
    <Setter Property="Background" Value="{DynamicResource Intent.Primary.Fill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Primary}" />
  </Style>
  <Style Selector="StackPanel.filterChipRow">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Snug}" />
  </Style>
  <Style Selector="Button.filterChip TextBlock.chipCount">
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
  <Style Selector="Button.filterChip.active TextBlock.chipCount">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Primary}" />
  </Style>
</Styles>
