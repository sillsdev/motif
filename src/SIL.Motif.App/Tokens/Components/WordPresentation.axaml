<!-- The shared row and its evidence card own their stable geometry and interactive surface. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.WordPresentation.Padding" ResourceKey="Primitive.Inset.8_4_8_4" />
    <StaticResource x:Key="Component.WordPresentation.MinHeight" ResourceKey="Primitive.Size.40" />
    <StaticResource x:Key="Component.WordPresentation.CardPadding" ResourceKey="Primitive.Inset.36_4_8_8" />
    <StaticResource x:Key="Component.WordPresentation.Radius" ResourceKey="Primitive.Radius.3" />
    <StaticResource x:Key="Component.WordPresentation.TickSize" ResourceKey="Primitive.Size.18" />
    <StaticResource x:Key="Component.WordPresentation.HiddenOpacity" ResourceKey="Primitive.Opacity.0" />
    <StaticResource x:Key="Component.WordPresentation.VisibleOpacity" ResourceKey="Primitive.Opacity.100" />
  </Styles.Resources>
  <Style Selector="Border.wordPresentationFrame">
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{StaticResource Intent.Stroke.DividerBottom}" />
    <Setter Property="Padding" Value="{StaticResource Component.WordPresentation.Padding}" />
  </Style>
  <Style Selector="Border.wordPresentationFrame:pointerover">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Hover}" />
  </Style>
  <Style Selector="Border.wordPresentationFrame.open">
    <Setter Property="Background" Value="{DynamicResource Intent.Selected.Fill}" />
  </Style>
  <Style Selector="Grid.wordPresentationShell">
    <Setter Property="ColumnSpacing" Value="{StaticResource Intent.Space.Compact}" />
  </Style>
  <Style Selector="CheckBox.wordPresentationTick">
    <Setter Property="Padding" Value="{StaticResource Intent.Inset.None}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{StaticResource Intent.Stroke.Box}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="wordPresentationTickBox"
                Width="{StaticResource Component.WordPresentation.TickSize}"
                Height="{StaticResource Component.WordPresentation.TickSize}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <TextBlock Text="✓"
                     IsVisible="{TemplateBinding IsChecked}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{TemplateBinding Foreground}"
                     FontWeight="Bold" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{DynamicResource Intent.Accent}" />
  </Style>
  <Style Selector="CheckBox.wordPresentationTick:pointerover">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Hover}" />
  </Style>
  <Style Selector="CheckBox.wordPresentationTick:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Focus}" />
  </Style>
  <Style Selector="StackPanel.wordPresentationWord">
    <Setter Property="MinHeight" Value="{StaticResource Component.WordPresentation.MinHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(TextBlock).wordPresentationForm">
    <Setter Property="FontSize" Value="{StaticResource Intent.Type.Navigation}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
  </Style>
  <Style Selector=":is(TextBlock).wordPresentationGloss">
    <Setter Property="FontSize" Value="{StaticResource Intent.Type.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector=":is(TextBlock).wordPresentationStaged">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Change.Text}" />
  </Style>
  <Style Selector=":is(TextBlock).wordPresentationNote">
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
  <Style Selector="StackPanel.wordPresentationNotes">
    <Setter Property="Spacing" Value="{StaticResource Intent.Space.Compact}" />
  </Style>
  <Style Selector=":is(TextBlock).wordPresentationNumber">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource Intent.Type.Small}" />
  </Style>
  <Style Selector="WrapPanel.wordPresentationNext">
    <Setter Property="ItemSpacing" Value="{StaticResource Intent.Space.Related}" />
    <Setter Property="LineSpacing" Value="{StaticResource Intent.Space.Minimal}" />
  </Style>
  <Style Selector="Grid.wordPresentationNextHost">
    <Setter Property="MaxHeight" Value="{StaticResource Intent.Space.None}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.wordPresentationFrame:pointerover Grid.wordPresentationNextHost, Border.wordPresentationFrame:focus-within Grid.wordPresentationNextHost, Border.wordPresentationFrame.open Grid.wordPresentationNextHost">
    <Setter Property="MaxHeight" Value="{StaticResource Component.WordPresentation.MinHeight}" />
  </Style>
  <Style Selector="Button.wordPresentationAction">
    <Setter Property="Padding" Value="{StaticResource Intent.Inset.None}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextSecondary}" />
  </Style>
  <Style Selector="Button.wordPresentationNextAction">
    <Setter Property="FontSize" Value="{StaticResource Intent.Type.Small}" />
    <Setter Property="Opacity" Value="{DynamicResource Component.WordPresentation.HiddenOpacity}" />
  </Style>
  <Style Selector="Border.wordPresentationFrame:pointerover Button.wordPresentationNextAction, Border.wordPresentationFrame:focus-within Button.wordPresentationNextAction, Border.wordPresentationFrame.open Button.wordPresentationNextAction">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Accent}" />
    <Setter Property="Opacity" Value="{DynamicResource Component.WordPresentation.VisibleOpacity}" />
  </Style>
  <Style Selector="Button.wordPresentationNextAction:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextFaint}" />
  </Style>
  <Style Selector="Border.wordPresentationHeader">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{StaticResource Intent.Stroke.DividerBottom}" />
    <Setter Property="Padding" Value="{StaticResource Component.WordPresentation.Padding}" />
  </Style>
  <Style Selector=":is(TextBlock).wordPresentationHeading">
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.wordPresentationCardFrame">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Accent}" />
    <Setter Property="BorderThickness" Value="{StaticResource Intent.Stroke.Box}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Intent.Shadow.Raised}" />
    <Setter Property="CornerRadius" Value="{StaticResource Component.WordPresentation.Radius}" />
    <Setter Property="Padding" Value="{StaticResource Component.WordPresentation.CardPadding}" />
  </Style>
  <Style Selector="StackPanel.wordPresentationCardSections">
    <Setter Property="Spacing" Value="{StaticResource Intent.Space.Related}" />
  </Style>
  <Style Selector=":is(TextBlock).wordPresentationCardHeading">
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector=":is(TextBlock).wordPresentationCardFailure">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Danger}" />
  </Style>
</Styles>
