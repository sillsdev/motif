<!-- The Settings resources, and the styles that controls outside Settings reach. The rest are in SettingsScoped.axaml. -->
<!-- The Settings page, popup, section navigation, rows, key caps and controls use shared Intent colours and component sizes. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SIL.Motif.App">

  <Styles.Resources>
    <StaticResource x:Key="Component.Settings.Radius" ResourceKey="Intent.Radius.Control" />
    <StaticResource x:Key="Component.Settings.GearSize" ResourceKey="Primitive.Size.18" />
    <StaticResource x:Key="Component.Settings.ContentPadding" ResourceKey="Intent.Inset.Page" />
    <StaticResource x:Key="Component.Settings.HeaderPadding" ResourceKey="Intent.Inset.Panel" />
    <StaticResource x:Key="Component.Settings.LabelColumnWidth" ResourceKey="Primitive.Size.240" />
    <StaticResource x:Key="Component.Settings.CompactLabelMinWidth" ResourceKey="Primitive.Size.1" />
    <StaticResource x:Key="Component.Settings.AboutStackBreakpoint" ResourceKey="Primitive.Size.520" />
    <StaticResource x:Key="Component.Settings.KeyRadius" ResourceKey="Primitive.Radius.3" />
    <StaticResource x:Key="Component.Settings.KeyPadding" ResourceKey="Primitive.Inset.6_0_6_0" />
    <StaticResource x:Key="Component.Settings.StepperWidth" ResourceKey="Primitive.Size.110" />
    <StaticResource x:Key="Component.Settings.ValueFont" ResourceKey="Primitive.Font.Mono" />
    <StaticResource x:Key="Component.Settings.WsSampleWidth" ResourceKey="Primitive.Size.170" />
    <StaticResource x:Key="Component.Settings.WsLabelWidth" ResourceKey="Primitive.Size.90" />
    <StaticResource x:Key="Component.Settings.WsSampleMinHeight" ResourceKey="Primitive.Size.56" />
    <StaticResource x:Key="Component.Settings.WsSamplePadding" ResourceKey="Intent.Inset.Row" />
    <StaticResource x:Key="Component.Settings.WritingSystemsFooterPadding" ResourceKey="Intent.Inset.Panel" />
    <StaticResource x:Key="Component.Settings.PageInset" ResourceKey="Primitive.Inset.12_4_12_4" />
    <StaticResource x:Key="Component.Settings.RowInset" ResourceKey="Primitive.Inset.8_4_8_4" />
    <StaticResource x:Key="Component.Settings.PageStepperWidth" ResourceKey="Primitive.Size.90" />
  </Styles.Resources>
  <Style Selector="Button.settingsGear">
    <Setter Property="Width" Value="{DynamicResource Component.Menu.ButtonHeight}" />
    <Setter Property="Height" Value="{DynamicResource Component.Menu.ButtonHeight}" />
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
  </Style>
  <Style Selector="Button.settingsGear:pointerover">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Hover}" />
  </Style>
  <Style Selector="Button.settingsGear.open">
    <Setter Property="Background" Value="{DynamicResource Intent.Selected.Fill}" />
  </Style>
  <Style Selector="Path.settingsGearGlyph">
    <Setter Property="Width" Value="{DynamicResource Component.Settings.GearSize}" />
    <Setter Property="Height" Value="{DynamicResource Component.Settings.GearSize}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource Intent.TextSecondary}" />
    <Setter Property="Fill" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="StrokeThickness" Value="{DynamicResource Intent.Stroke.Icon}" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Button.settingsGear:pointerover Path.settingsGearGlyph">
    <Setter Property="Stroke" Value="{DynamicResource Intent.Text}" />
  </Style>
  <Style Selector="Button.settingsGear.open Path.settingsGearGlyph">
    <Setter Property="Stroke" Value="{DynamicResource Intent.Accent}" />
  </Style>
  <Style Selector=":is(TextBlock).settingsCaption">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextMuted}" />
  </Style>
  <Style Selector="Button.settingsLink">
    <Setter Property="Foreground" Value="{DynamicResource Intent.Link.Text}" />
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
  </Style>
  <Style Selector="Border.settingsKeyCap :is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextSecondary}" />
  </Style>
  <Style Selector="NumericUpDown.settingsNumber">
    <Setter Property="Width" Value="{DynamicResource Component.Settings.StepperWidth}" />
  </Style>
  <Style Selector="NumericUpDown.settingsNumber.refused">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Danger}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
  </Style>
  <Style Selector=":is(TextBlock).settingsRefusal">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Danger.Text}" />
  </Style>
  <Style Selector="Border.settingsWritingSystemAbbreviation :is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.TextSecondary}" />
  </Style>
</Styles>
