<!--
  An interlinear row: each morpheme's form, gloss and category, with a hairline between morphemes.
  Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.MorphemeRow.BlockPadding" ResourceKey="Primitive.Inset.0_0_12_0" />
    <StaticResource x:Key="Component.MorphemeRow.BlockMargin" ResourceKey="Primitive.Inset.0_0_12_4" />
    <StaticResource x:Key="Component.MorphemeRow.LastBlockMargin" ResourceKey="Primitive.Inset.0_0_0_4" />
  </Styles.Resources>
  <Style Selector="Border.morph">
    <Setter Property="Padding" Value="{DynamicResource Component.MorphemeRow.BlockPadding}" />
    <Setter Property="Margin" Value="{DynamicResource Component.MorphemeRow.BlockMargin}" />
  </Style>
  <Style Selector="Border.morph.last">
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
    <Setter Property="Margin" Value="{DynamicResource Component.MorphemeRow.LastBlockMargin}" />
  </Style>
  <Style Selector="Border.morphEdge">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.DividerEnd}" />
  </Style>
  <Style Selector=":is(TextBlock).morphForm">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Body}" />
  </Style>
  <Style Selector="HyperlinkButton.morphForm">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Body}" />
  </Style>
  <Style Selector="HyperlinkButton.morphFormLink">
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="StackPanel.morphFormLinkWords">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Minimal}" />
  </Style>
  <Style Selector=":is(TextBlock).morphLinkMark">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector=":is(TextBlock).morphGloss">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
  </Style>
  <Style Selector="HyperlinkButton.morphGloss">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Small}" />
  </Style>
  <Style Selector=":is(TextBlock).morphCategory">
    <Setter Property="FontSize" Value="{DynamicResource Intent.Type.Label}" />
  </Style>
</Styles>
