<!--
  The hairline between morphemes in an interlinear row.
  Colours come from Intent keys only; sizes and gaps from Intent keys or this file's own Component keys.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.morphEdge">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
  </Style>
</Styles>
