<!--
  The hairline between morphemes in an interlinear row.
  Names Intent keys only.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.morphEdge">
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Border}" />
  </Style>
</Styles>
