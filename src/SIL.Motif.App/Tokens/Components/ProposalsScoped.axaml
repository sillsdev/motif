<!-- Proposals styles that only its own views use. Those views include this file, so no other control tries these selectors. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="StackPanel.proposalsPage">
    <Setter Property="Margin" Value="{DynamicResource Component.Proposals.PageMargin}" />
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Section}" />
  </Style>
  <Style Selector="StackPanel.proposalTitleRow">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Related}" />
  </Style>
  <Style Selector="StackPanel.proposalsHeading">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector="StackPanel.proposalInspectorActions">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector="Border.proposalInspectorActionsFrame">
    <Setter Property="Padding" Value="{DynamicResource Component.Inspector.BodyPadding}" />
  </Style>
  <Style Selector="Button.proposalDelete">
    <Setter Property="Theme" Value="{DynamicResource OutlineButton}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Danger.Text}" />
    <Setter Property="Margin" Value="{DynamicResource Component.Proposals.DeleteSetApart}" />
  </Style>
  <Style Selector="WrapPanel.proposalInspectorActions">
    <Setter Property="ItemSpacing" Value="{DynamicResource Intent.Space.Compact}" />
  </Style>
  <Style Selector=":is(TextBlock).proposalNumber.moved">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector=":is(TextBlock).denseTableCell.unread">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="Image.proposalPicture">
    <Setter Property="MaxWidth" Value="{DynamicResource Component.Proposals.PictureThumbSize}" />
    <Setter Property="MaxHeight" Value="{DynamicResource Component.Proposals.PictureThumbSize}" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="StackPanel.proposalPictureItem">
    <Setter Property="Spacing" Value="{DynamicResource Intent.Space.Minimal}" />
    <Setter Property="MaxWidth" Value="{DynamicResource Component.Proposals.PictureThumbSize}" />
  </Style>
</Styles>
