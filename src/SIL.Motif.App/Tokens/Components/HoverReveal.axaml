<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StaticResource x:Key="Component.HoverReveal.HiddenOpacity" ResourceKey="Primitive.Opacity.0" />
    <StaticResource x:Key="Component.HoverReveal.VisibleOpacity" ResourceKey="Primitive.Opacity.100" />
    <StaticResource x:Key="Component.HoverReveal.Height" ResourceKey="Primitive.Size.15" />
    <StaticResource x:Key="Component.HoverReveal.ButtonType" ResourceKey="Primitive.Type.8p5" />
    <StaticResource x:Key="Component.HoverReveal.LinkType" ResourceKey="Primitive.Type.9p5" />
    <StaticResource x:Key="Component.HoverReveal.ButtonPadding" ResourceKey="Primitive.Inset.4_0_4_0" />
    <StaticResource x:Key="Component.HoverReveal.ButtonRadius" ResourceKey="Primitive.Radius.2" />
  </Styles.Resources>
  <Style Selector="Button.revealControl.revealButton">
    <Setter Property="Height" Value="{DynamicResource Component.HoverReveal.Height}" />
    <Setter Property="Padding" Value="{DynamicResource Component.HoverReveal.ButtonPadding}" />
    <Setter Property="FontSize" Value="{DynamicResource Component.HoverReveal.ButtonType}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Marking.Text}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Marking.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Marking.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Component.HoverReveal.ButtonRadius}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.revealControl.revealLink">
    <Setter Property="Height" Value="{DynamicResource Component.HoverReveal.Height}" />
    <Setter Property="Padding" Value="{DynamicResource Intent.Inset.None}" />
    <Setter Property="FontSize" Value="{DynamicResource Component.HoverReveal.LinkType}" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Marking.Link}" />
    <Setter Property="Background" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Clear}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.None}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.revealControl:focus-visible">
    <Setter Property="Background" Value="{DynamicResource Intent.Surface.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Intent.Focus}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Intent.Stroke.Box}" />
  </Style>
  <Style Selector="Border.hoverReveal Button.revealControl, Border.stagedStrip Button.revealControl">
    <Setter Property="Opacity" Value="{DynamicResource Component.HoverReveal.HiddenOpacity}" />
    <!-- Opacity-hidden actions cannot receive pointer hits until this region reveals them. -->
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Border.hoverReveal:pointerover Button.revealControl, Border.hoverReveal:focus-within Button.revealControl, Border.stagedStrip:pointerover Button.revealControl, Border.stagedStrip:focus-within Button.revealControl">
    <Setter Property="Opacity" Value="{DynamicResource Component.HoverReveal.VisibleOpacity}" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
</Styles>
