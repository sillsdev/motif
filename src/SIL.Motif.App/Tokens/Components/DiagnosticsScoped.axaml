<Styles xmlns="https://github.com/avaloniaui"
        xmlns:views="clr-namespace:SIL.Motif.App.Views">
  <Style Selector="views|WarningsTab">
    <Setter Property="ColumnsBreakpoint" Value="{StaticResource Primitive.Size.800}" />
  </Style>
  <Style Selector="ListBox.diagnosticRows ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Intent.Text}" />
  </Style>
</Styles>
