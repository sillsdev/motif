<!--
  Primitives: the raw values Motif's look is built from, named by value and carrying no meaning.

  Nothing outside Intent.axaml names a key here. A view or a component style that wants a colour, a gap or a
  size asks Intent for what it means; Intent picks the primitive. A primitive is theme-invariant: a colour
  that differs between light and dark is two primitives, and Intent's theme dictionaries choose between them.

  Where Semi.Avalonia's own scale holds the same value, the primitive aliases Semi's key, so the two
  scales cannot drift apart. Semi's colour ramp is not aliased: its light and dark palettes give one key
  two values, and a primitive has one.

  Key shapes: Primitive.Color.<Hue><Step>, Primitive.Space.<px>, Primitive.Inset.<left>_<top>_<right>_<bottom>,
  Primitive.Radius.<px>, Primitive.Type.<px>, Primitive.Size.<px>, Primitive.Stroke.<px>, Primitive.Opacity.<percent>.
  A decimal point in a value is written as p (13p5 is 13.5).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Cyan, after FieldWorks' approved-analysis colour RGB(150,255,255). -->
  <Color x:Key="Primitive.Color.Cyan50">#D2F6F7</Color>
  <Color x:Key="Primitive.Color.Cyan200">#8AE7EB</Color>
  <Color x:Key="Primitive.Color.Cyan400">#3CC6CD</Color>
  <Color x:Key="Primitive.Color.Cyan500">#1DB3BA</Color>
  <Color x:Key="Primitive.Color.Cyan800">#08666C</Color>
  <Color x:Key="Primitive.Color.Cyan900">#123E41</Color>

  <!-- Tan, after FieldWorks' machine-guess colour RGB(234,220,186). -->
  <Color x:Key="Primitive.Color.Tan50">#F3EAD4</Color>
  <Color x:Key="Primitive.Color.Tan200">#E8CF95</Color>
  <Color x:Key="Primitive.Color.Tan500">#C9A45A</Color>
  <Color x:Key="Primitive.Color.Tan800">#74531A</Color>
  <Color x:Key="Primitive.Color.Tan900">#43381F</Color>

  <Color x:Key="Primitive.Color.Blue50">#E8F1FF</Color>
  <Color x:Key="Primitive.Color.Blue200">#8DB8FF</Color>
  <Color x:Key="Primitive.Color.Blue500">#0064FA</Color>
  <Color x:Key="Primitive.Color.Blue600">#2468E0</Color>
  <Color x:Key="Primitive.Color.Blue700">#0B4FC4</Color>
  <Color x:Key="Primitive.Color.Blue900">#1D3354</Color>

  <Color x:Key="Primitive.Color.Green300">#6FCF87</Color>
  <Color x:Key="Primitive.Color.Green800">#1A6B2C</Color>

  <Color x:Key="Primitive.Color.Amber300">#E3B55E</Color>
  <Color x:Key="Primitive.Color.Amber800">#8A5A00</Color>

  <Color x:Key="Primitive.Color.Grey0">#FFFFFF</Color>
  <Color x:Key="Primitive.Color.Grey25">#FBFCFD</Color>
  <Color x:Key="Primitive.Color.Grey100">#ECEEF2</Color>
  <Color x:Key="Primitive.Color.Grey300">#C3C8D0</Color>
  <Color x:Key="Primitive.Color.Grey700">#454C57</Color>
  <Color x:Key="Primitive.Color.Grey800">#30353D</Color>
  <Color x:Key="Primitive.Color.Grey900">#1B1E23</Color>

  <StaticResource x:Key="Primitive.Space.0" ResourceKey="SemiSpacingNone" />
  <StaticResource x:Key="Primitive.Space.2" ResourceKey="SemiSpacingSuperTight" />
  <StaticResource x:Key="Primitive.Space.4" ResourceKey="SemiSpacingExtraTight" />
  <x:Double x:Key="Primitive.Space.6">6</x:Double>
  <StaticResource x:Key="Primitive.Space.8" ResourceKey="SemiSpacingTight" />
  <StaticResource x:Key="Primitive.Space.12" ResourceKey="SemiSpacingBaseTight" />
  <StaticResource x:Key="Primitive.Space.16" ResourceKey="SemiSpacingBase" />
  <StaticResource x:Key="Primitive.Space.20" ResourceKey="SemiSpacingBaseLoose" />

  <Thickness x:Key="Primitive.Inset.0_0_0_0">0</Thickness>
  <Thickness x:Key="Primitive.Inset.1_1_1_1">1</Thickness>
  <Thickness x:Key="Primitive.Inset.16_16_16_16">16</Thickness>
  <Thickness x:Key="Primitive.Inset.14_10_14_10">14,10</Thickness>
  <Thickness x:Key="Primitive.Inset.7_1_7_1">7,1</Thickness>
  <Thickness x:Key="Primitive.Inset.9_3_9_3">9,3</Thickness>
  <Thickness x:Key="Primitive.Inset.12_4_12_4">12,4</Thickness>
  <Thickness x:Key="Primitive.Inset.6_0_6_0">6,0</Thickness>
  <Thickness x:Key="Primitive.Inset.4_0_4_0">4,0</Thickness>
  <Thickness x:Key="Primitive.Inset.4_2_4_2">4,2</Thickness>
  <Thickness x:Key="Primitive.Inset.8_12_8_12">8,12</Thickness>
  <Thickness x:Key="Primitive.Inset.0_12_0_12">0,12</Thickness>
  <Thickness x:Key="Primitive.Inset.10_7_10_7">10,7</Thickness>
  <Thickness x:Key="Primitive.Inset.0_10_0_10">0,10</Thickness>
  <Thickness x:Key="Primitive.Inset.10_8_10_8">10,8</Thickness>
  <Thickness x:Key="Primitive.Inset.18_0_18_0">18,0</Thickness>
  <Thickness x:Key="Primitive.Inset.0_8_0_8">0,8</Thickness>
  <Thickness x:Key="Primitive.Inset.18_8_8_14">18,8,8,14</Thickness>
  <Thickness x:Key="Primitive.Inset.0_0_12_0">0,0,12,0</Thickness>
  <Thickness x:Key="Primitive.Inset.0_0_8_0">0,0,8,0</Thickness>
  <Thickness x:Key="Primitive.Inset.0_0_20_0">0,0,20,0</Thickness>
  <Thickness x:Key="Primitive.Inset.0_0_0_2">0,0,0,2</Thickness>
  <Thickness x:Key="Primitive.Inset.0_0_4_4">0,0,4,4</Thickness>
  <Thickness x:Key="Primitive.Inset.10_0_0_0">10,0,0,0</Thickness>
  <Thickness x:Key="Primitive.Inset.16_12_16_0">16,12,16,0</Thickness>
  <Thickness x:Key="Primitive.Inset.0_-4_-6_0">0,-4,-6,0</Thickness>
  <Thickness x:Key="Primitive.Inset.0_0_1_0">0,0,1,0</Thickness>
  <Thickness x:Key="Primitive.Inset.0_0_0_1">0,0,0,1</Thickness>
  <Thickness x:Key="Primitive.Inset.0_0_0_3">0,0,0,3</Thickness>
  <Thickness x:Key="Primitive.Inset.2_0_0_0">2,0,0,0</Thickness>

  <CornerRadius x:Key="Primitive.Radius.0">0</CornerRadius>
  <StaticResource x:Key="Primitive.Radius.6" ResourceKey="SemiBorderRadiusMedium" />
  <CornerRadius x:Key="Primitive.Radius.8">8</CornerRadius>
  <CornerRadius x:Key="Primitive.Radius.9">9</CornerRadius>
  <CornerRadius x:Key="Primitive.Radius.10">10</CornerRadius>
  <StaticResource x:Key="Primitive.Radius.12" ResourceKey="SemiBorderRadiusLarge" />
  <CornerRadius x:Key="Primitive.Radius.99">99</CornerRadius>

  <x:Double x:Key="Primitive.Type.10p5">10.5</x:Double>
  <x:Double x:Key="Primitive.Type.11">11</x:Double>
  <x:Double x:Key="Primitive.Type.11p5">11.5</x:Double>
  <StaticResource x:Key="Primitive.Type.12" ResourceKey="SemiFontSizeSmall" />
  <x:Double x:Key="Primitive.Type.12p5">12.5</x:Double>
  <x:Double x:Key="Primitive.Type.13">13</x:Double>
  <x:Double x:Key="Primitive.Type.13p5">13.5</x:Double>
  <x:Double x:Key="Primitive.Type.15">15</x:Double>
  <StaticResource x:Key="Primitive.Type.16" ResourceKey="SemiFontSizeHeader6" />
  <x:Double x:Key="Primitive.Type.22">22</x:Double>

  <x:Double x:Key="Primitive.Size.8">8</x:Double>
  <x:Double x:Key="Primitive.Size.18">18</x:Double>
  <x:Double x:Key="Primitive.Size.22">22</x:Double>
  <x:Double x:Key="Primitive.Size.52">52</x:Double>
  <x:Double x:Key="Primitive.Size.190">190</x:Double>
  <x:Double x:Key="Primitive.Size.204">204</x:Double>
  <x:Double x:Key="Primitive.Size.240">240</x:Double>
  <x:Double x:Key="Primitive.Size.280">280</x:Double>
  <x:Double x:Key="Primitive.Size.600">600</x:Double>
  <x:Double x:Key="Primitive.Size.780">780</x:Double>
  <x:Double x:Key="Primitive.Size.820">820</x:Double>
  <x:Double x:Key="Primitive.Size.1240">1240</x:Double>

  <x:Double x:Key="Primitive.Stroke.1p8">1.8</x:Double>

  <x:Double x:Key="Primitive.Opacity.35">0.35</x:Double>
</ResourceDictionary>
