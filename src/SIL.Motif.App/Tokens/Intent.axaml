      <SolidColorBrush x:Key="Intent.Opinion.Approved.Accent" Color="{StaticResource Primitive.Color.Teal950}" />
      <SolidColorBrush x:Key="Intent.Opinion.Disapproved.Text" Color="{StaticResource Primitive.Color.Rose950}" />
