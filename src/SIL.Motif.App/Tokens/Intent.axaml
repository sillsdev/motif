<!--
  Intent: what a value is for. The only keys a view or a component style names.

  Every key below is listed once here, so a page can be styled from this list without opening the file.
  Colours differ by theme and live in the Light and Dark dictionaries; always consume them with
  DynamicResource, which follows a theme change. Spacing, type, radius and size are the same in both themes.
  An Intent key refers only to a Primitive or to a Semi.Avalonia role, never to a literal.

  Colours (brushes, per theme):
    Intent.Surface                the window's own background (Semi's Background0)
    Intent.Surface.Subtle         a panel set just apart from the window, such as the sidebar
    Intent.Surface.Hover          what a row shows under the pointer (Semi's Fill0)
    Intent.Surface.Neutral        a chip or tag with no verdict of its own (Semi's Fill1)
    Intent.Text                   body text (Semi's Text0)
    Intent.TextSecondary          navigation labels and badge counts, quieter than body text
    Intent.TextMuted              supporting text: details, captions, counts (Semi's Text2)
    Intent.TextFaint              an unset or unknown state's mark (Semi's Text3)
    Intent.Border                 card edges, dividers and hairlines (Semi's Border)
    Intent.Focus                  keyboard focus (Semi's FocusBorder)
    Intent.Accent                 the chosen thing: selected page, active tab, work in progress
    Intent.Selected.Fill          behind the selected entry of a list
    Intent.Emphasis.Fill          a solid count or marker that must catch the eye
    Intent.Emphasis.Text          text on Intent.Emphasis.Fill
    Intent.Neutral.Fill           a quiet count badge
    Intent.Primary                a new reading, and an active filter (Semi's Primary)
    Intent.Primary.Fill           behind Intent.Primary (Semi's PrimaryLight)
    Intent.Link                   several readings (Semi's Link)
    Intent.Success                agrees: bars, underlines, glyphs (Semi's Success)
    Intent.Success.Fill           behind agreeing text (Semi's SuccessLight)
    Intent.Success.Text           small text saying all is well, such as "Current"
    Intent.Warning                no result, and heat (Semi's Warning)
    Intent.Warning.Fill           a notice, and behind no-result text (Semi's WarningLight)
    Intent.Warning.Text           small text saying something is out of date
    Intent.Danger                 differs, and errors (Semi's Danger)
    Intent.Danger.Fill            behind differing text (Semi's DangerLight)
    Intent.Approved.Fill          behind an approved analysis (FieldWorks' cyan)
    Intent.Approved.Text          an approved analysis's text
    Intent.Approved.Accent        an approved analysis's bar, underline or edge
    Intent.Candidate.Fill         behind a candidate analysis (FieldWorks' tan)
    Intent.Candidate.Text         a candidate analysis's text
    Intent.Candidate.Accent       a candidate analysis's bar, underline or edge

  Spacing (double, for Spacing, and for Width and Height of gaps):
    Intent.Space.None             0
    Intent.Space.Minimal          2, between lines of one item
    Intent.Space.Compact          4, inside a dense group
    Intent.Space.Snug             6, a dot beside its label
    Intent.Space.Related          8, between related controls
    Intent.Space.Group            12, between groups
    Intent.Space.Section          16, between sections
    Intent.Space.Page             20, around a page's content

  Insets (Thickness, for Padding):
    Intent.Inset.None             no padding
    Intent.Inset.Card             inside a card
    Intent.Inset.Notice           inside a notice
    Intent.Inset.Tag              inside a verdict chip
    Intent.Inset.Chip             inside a filter chip
    Intent.Inset.Pill             inside a pill-shaped button
    Intent.Inset.Badge            inside a count badge
    Intent.Inset.BadgeCompact     inside a count badge on the collapsed sidebar
    Intent.Inset.Word             around a word in a reader
    Intent.Inset.NavList          around the sidebar's list
    Intent.Inset.NavListCollapsed around the collapsed sidebar's list
    Intent.Inset.NavItem          inside a sidebar entry
    Intent.Inset.NavItemCollapsed inside a collapsed sidebar entry
    Intent.Inset.NavFooter        around the sidebar's footer
    Intent.Inset.MenuItem         inside a menu entry
    Intent.Inset.Bar              inside the top bar
    Intent.Inset.Tab              inside a tab

  Gaps (Thickness, for Margin):
    Intent.Gap.AfterGroup         after an item, before the next group
    Intent.Gap.AfterRelated       after an item, before a related one
    Intent.Gap.AfterTab           after a tab, before the next tab
    Intent.Gap.BelowMinimal       under a list entry
    Intent.Gap.Chip               after and under a chip that wraps
    Intent.Gap.BeforeLabel        between an icon and its label
    Intent.Gap.Banner             around a banner under the top bar
    Intent.Gap.CornerBadge        pulls a badge onto its icon's corner

  Strokes (Thickness for BorderThickness; double for StrokeThickness):
    Intent.Stroke.None            no border
    Intent.Stroke.Box             a border all round
    Intent.Stroke.DividerEnd      a divider on the trailing edge
    Intent.Stroke.DividerBottom   a divider along the bottom
    Intent.Stroke.Underline       an active tab's underline
    Intent.Stroke.UnderlineHeavy  a word's verdict underline
    Intent.Stroke.MarkerStart     a selection mark on the leading edge
    Intent.Stroke.Icon            the line weight of a page icon

  Radii (CornerRadius):
    Intent.Radius.None            square
    Intent.Radius.Control         a list entry or small control
    Intent.Radius.Notice          a notice
    Intent.Radius.Tag             a verdict chip
    Intent.Radius.Card            a card
    Intent.Radius.Chip            a filter chip
    Intent.Radius.Pill            fully rounded ends

  Type sizes (double, for FontSize):
    Intent.Type.Title             a page's title
    Intent.Type.Section           a section's heading
    Intent.Type.Brand             the Motif wordmark
    Intent.Type.Navigation        sidebar entries and menu entries
    Intent.Type.Body              ordinary control text
    Intent.Type.Status            the freshness line
    Intent.Type.Small             chips and filter chips
    Intent.Type.Caption           a menu entry's second line
    Intent.Type.Label             badges, compact chips, the sidebar footer, disclosure marks
    Intent.Type.Micro             a badge on the collapsed sidebar

  Sizes (double, for Width and Height):
    Intent.Size.Dot               a status dot
    Intent.Size.Icon              a page icon
    Intent.Size.IconLarge         a page icon on the collapsed sidebar, and the app's logo
    Intent.Size.Bar               the top bar's height
    Intent.Size.Rail              the collapsed sidebar's width
    Intent.Size.Sidebar           the sidebar's width
    Intent.Size.Menu              a flyout menu's width
    Intent.Size.MenuButtonMax     the widest a menu button grows
    Intent.Size.MenuLabelMax      the widest a menu button's label grows
    Intent.Size.WindowWidth       the window's opening width
    Intent.Size.WindowHeight      the window's opening height
    Intent.Size.WindowMinWidth    the narrowest the window goes
    Intent.Size.WindowMinHeight   the shortest the window goes

  Opacity (double):
    Intent.Opacity.Dimmed         something shown but set aside

  WCAG contrast for text, light then dark (AA needs 4.5:1):
    Approved.Text on Approved.Fill: 5.84:1 light, 8.21:1 dark
    Candidate.Text on Candidate.Fill: 5.85:1 light, 7.56:1 dark
    TextSecondary on Surface.Subtle: 8.43:1 light, 9.94:1 dark
    TextSecondary on Neutral.Fill: 7.46:1 light, 7.34:1 dark
    Accent on Selected.Fill: 6.30:1 light, 6.31:1 dark
    Accent on Surface: 7.17:1 light, 8.96:1 dark
    Accent on Candidate.Fill: 5.98:1 light, 5.72:1 dark
    Emphasis.Text on Emphasis.Fill: 5.00:1 light, 5.08:1 dark
    Success.Text on Surface: 6.60:1 light, 9.41:1 dark
    Warning.Text on Surface: 5.93:1 light, 9.48:1 dark
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StaticResource x:Key="Intent.Space.None" ResourceKey="Primitive.Space.0" />
  <StaticResource x:Key="Intent.Space.Minimal" ResourceKey="Primitive.Space.2" />
  <StaticResource x:Key="Intent.Space.Compact" ResourceKey="Primitive.Space.4" />
  <StaticResource x:Key="Intent.Space.Snug" ResourceKey="Primitive.Space.6" />
  <StaticResource x:Key="Intent.Space.Related" ResourceKey="Primitive.Space.8" />
  <StaticResource x:Key="Intent.Space.Group" ResourceKey="Primitive.Space.12" />
  <StaticResource x:Key="Intent.Space.Section" ResourceKey="Primitive.Space.16" />
  <StaticResource x:Key="Intent.Space.Page" ResourceKey="Primitive.Space.20" />

  <StaticResource x:Key="Intent.Inset.None" ResourceKey="Primitive.Inset.0_0_0_0" />
  <StaticResource x:Key="Intent.Inset.Card" ResourceKey="Primitive.Inset.16_16_16_16" />
  <StaticResource x:Key="Intent.Inset.Notice" ResourceKey="Primitive.Inset.14_10_14_10" />
  <StaticResource x:Key="Intent.Inset.Tag" ResourceKey="Primitive.Inset.7_1_7_1" />
  <StaticResource x:Key="Intent.Inset.Chip" ResourceKey="Primitive.Inset.9_3_9_3" />
  <StaticResource x:Key="Intent.Inset.Pill" ResourceKey="Primitive.Inset.12_4_12_4" />
  <StaticResource x:Key="Intent.Inset.Badge" ResourceKey="Primitive.Inset.6_0_6_0" />
  <StaticResource x:Key="Intent.Inset.BadgeCompact" ResourceKey="Primitive.Inset.4_0_4_0" />
  <StaticResource x:Key="Intent.Inset.Word" ResourceKey="Primitive.Inset.4_2_4_2" />
  <StaticResource x:Key="Intent.Inset.NavList" ResourceKey="Primitive.Inset.8_12_8_12" />
  <StaticResource x:Key="Intent.Inset.NavListCollapsed" ResourceKey="Primitive.Inset.0_12_0_12" />
  <StaticResource x:Key="Intent.Inset.NavItem" ResourceKey="Primitive.Inset.10_7_10_7" />
  <StaticResource x:Key="Intent.Inset.NavItemCollapsed" ResourceKey="Primitive.Inset.0_10_0_10" />
  <StaticResource x:Key="Intent.Inset.NavFooter" ResourceKey="Primitive.Inset.18_8_8_14" />
  <StaticResource x:Key="Intent.Inset.MenuItem" ResourceKey="Primitive.Inset.10_8_10_8" />
  <StaticResource x:Key="Intent.Inset.Bar" ResourceKey="Primitive.Inset.18_0_18_0" />
  <StaticResource x:Key="Intent.Inset.Tab" ResourceKey="Primitive.Inset.0_8_0_8" />

  <StaticResource x:Key="Intent.Gap.AfterGroup" ResourceKey="Primitive.Inset.0_0_12_0" />
  <StaticResource x:Key="Intent.Gap.AfterRelated" ResourceKey="Primitive.Inset.0_0_8_0" />
  <StaticResource x:Key="Intent.Gap.AfterTab" ResourceKey="Primitive.Inset.0_0_20_0" />
  <StaticResource x:Key="Intent.Gap.BelowMinimal" ResourceKey="Primitive.Inset.0_0_0_2" />
  <StaticResource x:Key="Intent.Gap.Chip" ResourceKey="Primitive.Inset.0_0_4_4" />
  <StaticResource x:Key="Intent.Gap.BeforeLabel" ResourceKey="Primitive.Inset.10_0_0_0" />
  <StaticResource x:Key="Intent.Gap.Banner" ResourceKey="Primitive.Inset.16_12_16_0" />
  <StaticResource x:Key="Intent.Gap.CornerBadge" ResourceKey="Primitive.Inset.0_-4_-6_0" />

  <StaticResource x:Key="Intent.Stroke.None" ResourceKey="Primitive.Inset.0_0_0_0" />
  <StaticResource x:Key="Intent.Stroke.Box" ResourceKey="Primitive.Inset.1_1_1_1" />
  <StaticResource x:Key="Intent.Stroke.DividerEnd" ResourceKey="Primitive.Inset.0_0_1_0" />
  <StaticResource x:Key="Intent.Stroke.DividerBottom" ResourceKey="Primitive.Inset.0_0_0_1" />
  <StaticResource x:Key="Intent.Stroke.Underline" ResourceKey="Primitive.Inset.0_0_0_2" />
  <StaticResource x:Key="Intent.Stroke.UnderlineHeavy" ResourceKey="Primitive.Inset.0_0_0_3" />
  <StaticResource x:Key="Intent.Stroke.MarkerStart" ResourceKey="Primitive.Inset.2_0_0_0" />
  <StaticResource x:Key="Intent.Stroke.Icon" ResourceKey="Primitive.Stroke.1p8" />

  <StaticResource x:Key="Intent.Radius.None" ResourceKey="Primitive.Radius.0" />
  <StaticResource x:Key="Intent.Radius.Control" ResourceKey="Primitive.Radius.6" />
  <StaticResource x:Key="Intent.Radius.Notice" ResourceKey="Primitive.Radius.8" />
  <StaticResource x:Key="Intent.Radius.Tag" ResourceKey="Primitive.Radius.9" />
  <StaticResource x:Key="Intent.Radius.Card" ResourceKey="Primitive.Radius.10" />
  <StaticResource x:Key="Intent.Radius.Chip" ResourceKey="Primitive.Radius.12" />
  <StaticResource x:Key="Intent.Radius.Pill" ResourceKey="Primitive.Radius.99" />

  <StaticResource x:Key="Intent.Type.Title" ResourceKey="Primitive.Type.22" />
  <StaticResource x:Key="Intent.Type.Section" ResourceKey="Primitive.Type.16" />
  <StaticResource x:Key="Intent.Type.Brand" ResourceKey="Primitive.Type.15" />
  <StaticResource x:Key="Intent.Type.Navigation" ResourceKey="Primitive.Type.13p5" />
  <StaticResource x:Key="Intent.Type.Body" ResourceKey="Primitive.Type.13" />
  <StaticResource x:Key="Intent.Type.Status" ResourceKey="Primitive.Type.12p5" />
  <StaticResource x:Key="Intent.Type.Small" ResourceKey="Primitive.Type.12" />
  <StaticResource x:Key="Intent.Type.Caption" ResourceKey="Primitive.Type.11p5" />
  <StaticResource x:Key="Intent.Type.Label" ResourceKey="Primitive.Type.11" />
  <StaticResource x:Key="Intent.Type.Micro" ResourceKey="Primitive.Type.10p5" />

  <StaticResource x:Key="Intent.Size.Dot" ResourceKey="Primitive.Size.8" />
  <StaticResource x:Key="Intent.Size.Icon" ResourceKey="Primitive.Size.18" />
  <StaticResource x:Key="Intent.Size.IconLarge" ResourceKey="Primitive.Size.22" />
  <StaticResource x:Key="Intent.Size.Bar" ResourceKey="Primitive.Size.52" />
  <StaticResource x:Key="Intent.Size.Rail" ResourceKey="Primitive.Size.52" />
  <StaticResource x:Key="Intent.Size.Sidebar" ResourceKey="Primitive.Size.204" />
  <StaticResource x:Key="Intent.Size.Menu" ResourceKey="Primitive.Size.280" />
  <StaticResource x:Key="Intent.Size.MenuButtonMax" ResourceKey="Primitive.Size.240" />
  <StaticResource x:Key="Intent.Size.MenuLabelMax" ResourceKey="Primitive.Size.190" />
  <StaticResource x:Key="Intent.Size.WindowWidth" ResourceKey="Primitive.Size.1240" />
  <StaticResource x:Key="Intent.Size.WindowHeight" ResourceKey="Primitive.Size.780" />
  <StaticResource x:Key="Intent.Size.WindowMinWidth" ResourceKey="Primitive.Size.820" />
  <StaticResource x:Key="Intent.Size.WindowMinHeight" ResourceKey="Primitive.Size.600" />

  <StaticResource x:Key="Intent.Opacity.Dimmed" ResourceKey="Primitive.Opacity.35" />

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <StaticResource x:Key="Intent.Surface" ResourceKey="SemiColorBackground0" />
      <SolidColorBrush x:Key="Intent.Surface.Subtle" Color="{StaticResource Primitive.Color.Grey25}" />
      <StaticResource x:Key="Intent.Surface.Hover" ResourceKey="SemiColorFill0" />
      <StaticResource x:Key="Intent.Surface.Neutral" ResourceKey="SemiColorFill1" />
      <StaticResource x:Key="Intent.Text" ResourceKey="SemiColorText0" />
      <SolidColorBrush x:Key="Intent.TextSecondary" Color="{StaticResource Primitive.Color.Grey700}" />
      <StaticResource x:Key="Intent.TextMuted" ResourceKey="SemiColorText2" />
      <StaticResource x:Key="Intent.TextFaint" ResourceKey="SemiColorText3" />
      <StaticResource x:Key="Intent.Border" ResourceKey="SemiColorBorder" />
      <StaticResource x:Key="Intent.Focus" ResourceKey="SemiColorFocusBorder" />
      <SolidColorBrush x:Key="Intent.Accent" Color="{StaticResource Primitive.Color.Blue700}" />
      <SolidColorBrush x:Key="Intent.Selected.Fill" Color="{StaticResource Primitive.Color.Blue50}" />
      <SolidColorBrush x:Key="Intent.Emphasis.Fill" Color="{StaticResource Primitive.Color.Blue500}" />
      <SolidColorBrush x:Key="Intent.Emphasis.Text" Color="{StaticResource Primitive.Color.Grey0}" />
      <SolidColorBrush x:Key="Intent.Neutral.Fill" Color="{StaticResource Primitive.Color.Grey100}" />
      <StaticResource x:Key="Intent.Primary" ResourceKey="SemiColorPrimary" />
      <StaticResource x:Key="Intent.Primary.Fill" ResourceKey="SemiColorPrimaryLight" />
      <StaticResource x:Key="Intent.Link" ResourceKey="SemiColorLink" />
      <StaticResource x:Key="Intent.Success" ResourceKey="SemiColorSuccess" />
      <StaticResource x:Key="Intent.Success.Fill" ResourceKey="SemiColorSuccessLight" />
      <SolidColorBrush x:Key="Intent.Success.Text" Color="{StaticResource Primitive.Color.Green800}" />
      <StaticResource x:Key="Intent.Warning" ResourceKey="SemiColorWarning" />
      <StaticResource x:Key="Intent.Warning.Fill" ResourceKey="SemiColorWarningLight" />
      <SolidColorBrush x:Key="Intent.Warning.Text" Color="{StaticResource Primitive.Color.Amber800}" />
      <StaticResource x:Key="Intent.Danger" ResourceKey="SemiColorDanger" />
      <StaticResource x:Key="Intent.Danger.Fill" ResourceKey="SemiColorDangerLight" />
      <SolidColorBrush x:Key="Intent.Approved.Fill" Color="{StaticResource Primitive.Color.Cyan50}" />
      <SolidColorBrush x:Key="Intent.Approved.Text" Color="{StaticResource Primitive.Color.Cyan800}" />
      <SolidColorBrush x:Key="Intent.Approved.Accent" Color="{StaticResource Primitive.Color.Cyan500}" />
      <SolidColorBrush x:Key="Intent.Candidate.Fill" Color="{StaticResource Primitive.Color.Tan50}" />
      <SolidColorBrush x:Key="Intent.Candidate.Text" Color="{StaticResource Primitive.Color.Tan800}" />
      <SolidColorBrush x:Key="Intent.Candidate.Accent" Color="{StaticResource Primitive.Color.Tan500}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <StaticResource x:Key="Intent.Surface" ResourceKey="SemiColorBackground0" />
      <SolidColorBrush x:Key="Intent.Surface.Subtle" Color="{StaticResource Primitive.Color.Grey900}" />
      <StaticResource x:Key="Intent.Surface.Hover" ResourceKey="SemiColorFill0" />
      <StaticResource x:Key="Intent.Surface.Neutral" ResourceKey="SemiColorFill1" />
      <StaticResource x:Key="Intent.Text" ResourceKey="SemiColorText0" />
      <SolidColorBrush x:Key="Intent.TextSecondary" Color="{StaticResource Primitive.Color.Grey300}" />
      <StaticResource x:Key="Intent.TextMuted" ResourceKey="SemiColorText2" />
      <StaticResource x:Key="Intent.TextFaint" ResourceKey="SemiColorText3" />
      <StaticResource x:Key="Intent.Border" ResourceKey="SemiColorBorder" />
      <StaticResource x:Key="Intent.Focus" ResourceKey="SemiColorFocusBorder" />
      <SolidColorBrush x:Key="Intent.Accent" Color="{StaticResource Primitive.Color.Blue200}" />
      <SolidColorBrush x:Key="Intent.Selected.Fill" Color="{StaticResource Primitive.Color.Blue900}" />
      <SolidColorBrush x:Key="Intent.Emphasis.Fill" Color="{StaticResource Primitive.Color.Blue600}" />
      <SolidColorBrush x:Key="Intent.Emphasis.Text" Color="{StaticResource Primitive.Color.Grey0}" />
      <SolidColorBrush x:Key="Intent.Neutral.Fill" Color="{StaticResource Primitive.Color.Grey800}" />
      <StaticResource x:Key="Intent.Primary" ResourceKey="SemiColorPrimary" />
      <StaticResource x:Key="Intent.Primary.Fill" ResourceKey="SemiColorPrimaryLight" />
      <StaticResource x:Key="Intent.Link" ResourceKey="SemiColorLink" />
      <StaticResource x:Key="Intent.Success" ResourceKey="SemiColorSuccess" />
      <StaticResource x:Key="Intent.Success.Fill" ResourceKey="SemiColorSuccessLight" />
      <SolidColorBrush x:Key="Intent.Success.Text" Color="{StaticResource Primitive.Color.Green300}" />
      <StaticResource x:Key="Intent.Warning" ResourceKey="SemiColorWarning" />
      <StaticResource x:Key="Intent.Warning.Fill" ResourceKey="SemiColorWarningLight" />
      <SolidColorBrush x:Key="Intent.Warning.Text" Color="{StaticResource Primitive.Color.Amber300}" />
      <StaticResource x:Key="Intent.Danger" ResourceKey="SemiColorDanger" />
      <StaticResource x:Key="Intent.Danger.Fill" ResourceKey="SemiColorDangerLight" />
      <SolidColorBrush x:Key="Intent.Approved.Fill" Color="{StaticResource Primitive.Color.Cyan900}" />
      <SolidColorBrush x:Key="Intent.Approved.Text" Color="{StaticResource Primitive.Color.Cyan200}" />
      <SolidColorBrush x:Key="Intent.Approved.Accent" Color="{StaticResource Primitive.Color.Cyan400}" />
      <SolidColorBrush x:Key="Intent.Candidate.Fill" Color="{StaticResource Primitive.Color.Tan900}" />
      <SolidColorBrush x:Key="Intent.Candidate.Text" Color="{StaticResource Primitive.Color.Tan200}" />
      <SolidColorBrush x:Key="Intent.Candidate.Accent" Color="{StaticResource Primitive.Color.Tan500}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
