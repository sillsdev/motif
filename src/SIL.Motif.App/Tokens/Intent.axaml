      <SolidColorBrush x:Key="Intent.Opinion.Approved.Fill" Color="{StaticResource Primitive.Color.Cyan900}" />
      <SolidColorBrush x:Key="Intent.Opinion.Approved.Accent" Color="{StaticResource Primitive.Color.Cyan400}" />
      <SolidColorBrush x:Key="Intent.Opinion.Disapproved.Text" Color="{StaticResource Primitive.Color.Rose200}" />
      <SolidColorBrush x:Key="Intent.Opinion.Disapproved.Fill" Color="{StaticResource Primitive.Color.Rose975}" />
