      <SolidColorBrush x:Key="Intent.Marking.Hover" Color="{StaticResource Primitive.Color.Slate50}" />
      <SolidColorBrush x:Key="Intent.Marking.Link" Color="{StaticResource Primitive.Color.Blue775}" />
      <SolidColorBrush x:Key="Intent.Opinion.Approved.Text" Color="{StaticResource Primitive.Color.Teal950}" />
