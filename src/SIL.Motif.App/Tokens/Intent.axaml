      <SolidColorBrush x:Key="Intent.Chart.Series3" Color="{StaticResource Primitive.Color.Green700}" />
      <SolidColorBrush x:Key="Intent.Chart.Series4" Color="{StaticResource Primitive.Color.Amber700}" />
