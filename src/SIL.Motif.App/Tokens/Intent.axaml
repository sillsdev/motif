      <SolidColorBrush x:Key="Intent.Opinion.Disapproved.Accent" Color="{StaticResource Primitive.Color.Rose950}" />
      <SolidColorBrush x:Key="Intent.Opinion.Unknown.Text" Color="{StaticResource Primitive.Color.Amber950}" />
      <SolidColorBrush x:Key="Intent.Opinion.Unknown.Fill" Color="{StaticResource Primitive.Color.Amber25}" />
      <SolidColorBrush x:Key="Intent.Opinion.Unknown.Accent" Color="{StaticResource Primitive.Color.Amber950}" />
      <SolidColorBrush x:Key="Intent.Opinion.None.Outline" Color="{StaticResource Primitive.Color.Slate200}" />
      <SolidColorBrush x:Key="Intent.Opinion.None.Text" Color="{StaticResource Primitive.Color.Slate600}" />
      <SolidColorBrush x:Key="Intent.Change.Action" Color="{StaticResource Primitive.Color.Blue650}" />
      <SolidColorBrush x:Key="Intent.Change.Text" Color="{StaticResource Primitive.Color.Blue750}" />
      <SolidColorBrush x:Key="Intent.Change.Fill" Color="{StaticResource Primitive.Color.Blue10}" />
      <SolidColorBrush x:Key="Intent.Change.Edge" Color="{StaticResource Primitive.Color.Blue650}" />
      <SolidColorBrush x:Key="Intent.Agreement.Agreeing" Color="{StaticResource Primitive.Color.Slate600}" />
      <SolidColorBrush x:Key="Intent.Agreement.Conflict" Color="{StaticResource Primitive.Color.Blue750}" />
      <SolidColorBrush x:Key="Intent.Agreement.Conflict.Fill" Color="{StaticResource Primitive.Color.Blue25}" />
      <SolidColorBrush x:Key="Intent.Agreement.Conflict.Edge" Color="{StaticResource Primitive.Color.Blue650}" />
      <StaticResource x:Key="Intent.Agreement.Conflict.Shadow" ResourceKey="Primitive.Shadow.Inset2.Blue650" />
      <SolidColorBrush x:Key="Intent.Agreement.Suggestion" Color="{StaticResource Primitive.Color.Blue750}" />
      <SolidColorBrush x:Key="Intent.Agreement.Suggestion.Edge" Color="{StaticResource Primitive.Color.Blue650}" />
      <SolidColorBrush x:Key="Intent.Parser.NoReading" Color="{StaticResource Primitive.Color.Rose950}" />
