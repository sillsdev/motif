{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motif.sil.org/contracts/affix-authoring/v1",
  "title": "Ordinary forms and affix feature authoring",
  "description": "Closed ordinary stem/affix form intents. Live ownership, decoded identity uniqueness and placement are checked against LibLCM. Restrictions are explicit per form. Feature structures use exact stem or inflectional MSA identity; feature values are optional. Duplicate JSON keys are refused by the runtime parsers.",
  "oneOf": [
    {
      "$ref": "#/$defs/AuthorLexicalEntry"
    },
    {
      "$ref": "#/$defs/AuthorAlternateForm"
    },
    {
      "$ref": "#/$defs/AlternateFormsPayload"
    },
    {
      "$ref": "#/$defs/AuthorFeatureStructure"
    },
    {
      "$ref": "#/$defs/AuthorFeatureValue"
    },
    {
      "$ref": "#/$defs/InflFeatsPayload"
    }
  ],
  "$defs": {
    "CanonicalId": {
      "type": "string",
      "pattern": "^[\\s\\S]*[A-Za-z0-9_-]{22}$",
      "description": "An optional prefix and 22-character suffix decoding to 128 bits. New authors emit the normalized unprefixed spelling and compare decoded GUIDs."
    },
    "IdentitySet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/CanonicalId"
      }
    },
    "Placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/CanonicalId"
        },
        "before": {
          "$ref": "#/$defs/CanonicalId"
        }
      },
      "required": [],
      "anyOf": [
        {
          "required": [
            "after"
          ]
        },
        {
          "required": [
            "before"
          ]
        }
      ]
    },
    "LexicalEntryMsa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "stem",
            "inflectional",
            "derivational",
            "unclassified"
          ]
        },
        "category": {
          "$ref": "#/$defs/CanonicalId"
        },
        "toCategory": {
          "$ref": "#/$defs/CanonicalId"
        },
        "slots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/CanonicalId"
          }
        },
        "inflectionClass": {
          "$ref": "#/$defs/CanonicalId"
        }
      },
      "required": [
        "kind",
        "category"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "derivational"
              }
            }
          },
          "then": {
            "required": [
              "toCategory"
            ]
          },
          "else": {
            "not": {
              "required": [
                "toCategory"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "inflectional"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "slots"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "stem"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "inflectionClass"
              ]
            }
          }
        }
      ]
    },
    "AuthorLexicalEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "form": {
          "type": "string"
        },
        "formWs": {
          "type": "string"
        },
        "morphType": {
          "$ref": "#/$defs/CanonicalId"
        },
        "gloss": {
          "type": "string"
        },
        "analysisWs": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "msa": {
          "$ref": "#/$defs/LexicalEntryMsa"
        },
        "environments": {
          "$ref": "#/$defs/IdentitySet"
        },
        "inflectionClasses": {
          "$ref": "#/$defs/IdentitySet"
        }
      },
      "required": [
        "form",
        "formWs",
        "morphType",
        "gloss",
        "analysisWs",
        "msa"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "msa": {
                "properties": {
                  "kind": {
                    "const": "stem"
                  }
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "inflectionClasses"
              ]
            }
          }
        }
      ]
    },
    "AuthorAlternateForm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "$ref": "#/$defs/CanonicalId"
        },
        "form": {
          "type": "string"
        },
        "formWs": {
          "type": "string"
        },
        "morphType": {
          "$ref": "#/$defs/CanonicalId"
        },
        "environments": {
          "$ref": "#/$defs/IdentitySet"
        },
        "inflectionClasses": {
          "$ref": "#/$defs/IdentitySet"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        }
      },
      "required": [
        "entry",
        "form",
        "formWs",
        "morphType"
      ]
    },
    "AlternateFormsPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "morphType": {
          "$ref": "#/$defs/CanonicalId"
        },
        "ws": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "morphType",
        "ws",
        "text"
      ]
    },
    "AuthorFeatureStructure": {
      "type": "object",
      "additionalProperties": false,
      "description": "Creates an empty MsFeatures or InflFeats structure on an exact stem or inflectional MSA with an empty owning slot.",
      "properties": {
        "msa": {
          "$ref": "#/$defs/CanonicalId"
        }
      },
      "required": [
        "msa"
      ]
    },
    "AuthorFeatureValue": {
      "type": "object",
      "additionalProperties": false,
      "description": "Adds a closed specification; value is optional. InflFeats selections require morphosyntactic definitions and exact feature-owned values.",
      "properties": {
        "featStruc": {
          "$ref": "#/$defs/CanonicalId"
        },
        "feature": {
          "$ref": "#/$defs/CanonicalId"
        },
        "value": {
          "$ref": "#/$defs/CanonicalId"
        }
      },
      "required": [
        "featStruc",
        "feature"
      ]
    },
    "InflFeatsPayload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Empty payload for grammar/moInflAffMsa/createInflFeats; target and nonzero entityId are required in the envelope. Placement and storage overrides are refused.",
      "properties": {},
      "required": []
    }
  }
}
