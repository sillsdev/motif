{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motif.sil.org/contracts/text-create/v1",
  "title": "Text create payload",
  "description": "The closed after payload of texts/langProject/createTexts: explicit Text, contents, paragraph, segment and Note identities, with wordform bindings. Optional paragraph text is parsed by LibLCM; beginOffset values must match its segments. Annotations require analysisWs. The parser also checks NFD text and identity uniqueness. Motif imposes no text size limit.",
  "$ref": "#/$defs/TextCreatePayload",
  "$defs": {
    "CanonicalId": {
      "type": "string",
      "pattern": "^[\\s\\S]*[A-Za-z0-9_-]{22}$"
    },
    "TextCreatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "contents",
        "paragraphs"
      ],
      "properties": {
        "name": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ws",
            "text"
          ],
          "properties": {
            "ws": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "contents": {
          "$ref": "#/$defs/CanonicalId"
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Paragraph"
          }
        },
        "analysisWs": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ws",
        "segments"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/CanonicalId"
        },
        "ws": {
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Segment"
          }
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "text"
            ]
          },
          "then": {
            "properties": {
              "segments": {
                "items": {
                  "required": [
                    "beginOffset"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "segments": {
                "items": {
                  "properties": {
                    "words": {
                      "minItems": 1
                    }
                  },
                  "not": {
                    "required": [
                      "beginOffset"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "Segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "words"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/CanonicalId"
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CanonicalId"
          }
        },
        "beginOffset": {
          "type": "integer",
          "minimum": 0
        },
        "freeTranslation": {
          "type": "string",
          "minLength": 1
        },
        "literalTranslation": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Note"
          }
        }
      }
    },
    "Note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/CanonicalId"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
