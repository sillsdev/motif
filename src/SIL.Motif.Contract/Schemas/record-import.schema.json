{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "record-import.schema.json",
  "description": "Record-file and record-folder import request and response, shared by the CLI import --file and --dir --json and the MCP motif_import_record tool. Null members are omitted. The serialized summary stays within 2048 bytes; the lists page.",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectPath"
      ],
      "properties": {
        "projectPath": {
          "type": "string",
          "minLength": 1
        },
        "filePath": {
          "type": "string",
          "minLength": 1
        },
        "draftName": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "strict": {
          "type": "boolean"
        },
        "dirPath": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "boolean"
        },
        "refusedOnly": {
          "type": "boolean"
        },
        "reportPath": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "maxLength": 200
        },
        "revision": {
          "type": "string",
          "maxLength": 200
        },
        "licence": {
          "type": "string",
          "maxLength": 200
        }
      },
      "oneOf": [
        {
          "required": [
            "filePath"
          ],
          "not": {
            "required": [
              "dirPath"
            ]
          }
        },
        {
          "required": [
            "dirPath"
          ],
          "not": {
            "required": [
              "filePath"
            ]
          }
        }
      ]
    },
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "kind"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string"
        }
      }
    },
    "Change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "field"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "object": {
          "type": "string"
        },
        "writingSystem": {
          "type": "string"
        },
        "old": {
          "type": "string"
        },
        "new": {
          "type": "string"
        },
        "status": {
          "enum": [
            "staged",
            "refused"
          ]
        },
        "refusalCode": {
          "type": "string"
        }
      }
    },
    "Refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "field",
        "reason"
      ],
      "properties": {
        "code": {
          "enum": [
            "record-import.change-refused",
            "record-import.field-uncovered",
            "record-import.shape-unsupported",
            "record-import.value-stale",
            "record-import.not-executable",
            "fs-notation.syntax",
            "fs-notation.unknown-feature",
            "fs-notation.unknown-value",
            "fs-notation.ambiguous-label",
            "fs-notation.repeated-feature",
            "fs-notation.unsupported-feature",
            "fs-notation.unrenderable",
            "rule-notation.read-only",
            "rule-notation.syntax",
            "rule-notation.bad-repeat",
            "rule-notation.unknown-phoneme",
            "rule-notation.unknown-natural-class",
            "rule-notation.ambiguous-label",
            "rule-notation.alpha-mismatch",
            "rule-notation.index-out-of-range",
            "rule-notation.dangling-index",
            "rule-notation.context-not-allowed",
            "rule-notation.limit-exceeded",
            "rule-notation.unsupported-class",
            "rule-notation.unrenderable",
            "rule-notation.shared-class",
            "rule-notation.context-has-data"
          ]
        },
        "class": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "object": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "maxLength": 90
        }
      }
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "baseVerdict",
        "changeCount",
        "operationCount",
        "refusalCount",
        "page",
        "pageCount",
        "operations",
        "refusals"
      ],
      "properties": {
        "mode": {
          "enum": [
            "dryRun",
            "draft"
          ]
        },
        "recordKind": {
          "type": "string"
        },
        "recordId": {
          "type": "string"
        },
        "baseVerdict": {
          "enum": [
            "fresh",
            "new",
            "unchanged",
            "not-checked"
          ]
        },
        "changeCount": {
          "type": "integer",
          "minimum": 0
        },
        "operationCount": {
          "type": "integer",
          "minimum": 0
        },
        "refusalCount": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1
        },
        "operations": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Operation"
          }
        },
        "refusals": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Refusal"
          }
        },
        "draftName": {
          "type": "string"
        },
        "proposalId": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Change"
          }
        },
        "dir": {
          "$ref": "#/$defs/DirSummary"
        },
        "files": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/FileRow"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "draft"
              }
            }
          },
          "then": {
            "required": [
              "draftName",
              "proposalId"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "draftName"
                  ]
                },
                {
                  "required": [
                    "proposalId"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "FileRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "baseVerdict",
        "changes",
        "operations",
        "refused"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "record": {
          "type": "string"
        },
        "status": {
          "enum": [
            "created",
            "updated",
            "unchanged",
            "refused"
          ]
        },
        "baseVerdict": {
          "enum": [
            "new",
            "fresh",
            "stale",
            "missing",
            "unchanged",
            "not-checked"
          ]
        },
        "changes": {
          "type": "integer",
          "minimum": 0
        },
        "operations": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z-]+\\.[a-z-]+$"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "DirSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "created",
        "updated",
        "unchanged",
        "refused",
        "ignored",
        "manifest",
        "firstRefused"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "created": {
          "type": "integer",
          "minimum": 0
        },
        "updated": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "ignored": {
          "type": "integer",
          "minimum": 0
        },
        "manifest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "firstRefused": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/FileRow"
          }
        },
        "source": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "licence": {
          "type": "string"
        }
      }
    }
  }
}
