<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SIL.Motif.Help</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SIL.Motif.Tests.Cli" />
    <InternalsVisibleTo Include="SIL.Motif.Mcp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIL.Motif.Contract\SIL.Motif.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Content\**\*">
      <LogicalName>help/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- One authored resource source serves the window and its shared Help projection. -->
    <EmbeddedResource Include="..\SIL.Motif.App\MotifAppStrings*.resx">
      <Link>WindowText\%(Filename)%(Extension)</Link>
      <ManifestResourceName>SIL.Motif.Help.WindowText.%(Filename)</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
