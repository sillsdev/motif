<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIL.Motif.Projection\SIL.Motif.Projection.csproj" />
    <!-- Explicit: BaselineScratchFactory wraps a DryRunScratch, reachable transitively via Projection too. -->
    <ProjectReference Include="..\SIL.Motif.Runner\SIL.Motif.Runner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SIL.LCModel" Version="$(SilLCModelPackageVersion)" />
    <PackageReference Include="icu.net" Version="$(IcuDotNetPackageVersion)" />
    <PackageReference Include="Icu4c.Win.Fw.Bin" Version="70.1.182" ExcludeAssets="runtime" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Icu4c.Win.Fw.Lib" Version="70.1.182" ExcludeAssets="runtime" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)/sil.lcmodel.core/$(SilLCModelPackageVersion)/contentFiles/IcuData/icudt70l/nfc_fw.nrm">
      <Link>IcuData/icudt70l/nfc_fw.nrm</Link>
      <TargetPath>IcuData/icudt70l/nfc_fw.nrm</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)/sil.lcmodel.core/$(SilLCModelPackageVersion)/contentFiles/IcuData/icudt70l/nfkc_fw.nrm">
      <Link>IcuData/icudt70l/nfkc_fw.nrm</Link>
      <TargetPath>IcuData/icudt70l/nfkc_fw.nrm</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)/sil.lcmodel.core/$(SilLCModelPackageVersion)/contentFiles/IcuData/data/UnicodeDataOverrides.txt">
      <Link>IcuData/data/UnicodeDataOverrides.txt</Link>
      <TargetPath>IcuData/data/UnicodeDataOverrides.txt</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="$(NuGetPackageRoot)/icu4c.win.fw.lib/70.1.182/runtimes/win-x64/native/icu*.dll">
      <Link>lib/win-x64/%(Filename)%(Extension)</Link>
      <TargetPath>lib/win-x64/%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Pins LibPalaso above SIL.LCModel's 17.x requests; only Core and WritingSystems use the local override. -->
  <ItemGroup>
    <PackageReference Include="SIL.WritingSystems" Version="$(SilLibPalasoVersion)" />
    <PackageReference Include="SIL.Core" Version="$(SilLibPalasoVersion)" />
    <PackageReference Include="SIL.Core.Desktop" Version="$(SilCoreDesktopVersion)" />
    <PackageReference Include="SIL.Lexicon" Version="$(SilLexiconVersion)" />
  </ItemGroup>

</Project>
