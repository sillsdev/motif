<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIL.Motif.Projection\SIL.Motif.Projection.csproj" />
    <!-- Explicit: BaselineScratchFactory wraps a DryRunScratch, reachable transitively via Projection too. -->
    <ProjectReference Include="..\SIL.Motif.Runner\SIL.Motif.Runner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SIL.LCModel" Version="$(SilLCModelPackageVersion)" />
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <!-- Pins LibPalaso above SIL.LCModel's 17.x requests; only Core and WritingSystems use the local override. -->
  <ItemGroup>
    <PackageReference Include="SIL.WritingSystems" Version="$(SilLibPalasoVersion)" />
    <PackageReference Include="SIL.Core" Version="$(SilLibPalasoVersion)" />
    <PackageReference Include="SIL.Core.Desktop" Version="$(SilCoreDesktopVersion)" />
    <PackageReference Include="SIL.Lexicon" Version="$(SilLexiconVersion)" />
  </ItemGroup>

</Project>
