<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <VersionPrefix>0.1.0</VersionPrefix>
    <IsPackable>true</IsPackable>
    <PackageId>SIL.ListCrdt</PackageId>
    <Product>SIL.ListCrdt</Product>
    <Description>Fugue list ordering with stable item identities and last-writer-wins moves.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SIL.Motif.Tests.ListCrdt" />
    <InternalsVisibleTo Include="SIL.Motif.Tests.ListCrdt.Loro" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Remove="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <None Include="README.md;NOTICE;../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
