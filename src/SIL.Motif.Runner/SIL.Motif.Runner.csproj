<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Single-targeted: a separate FieldWorks reaches Motif only by running the `motif` executable and
      reading its JSON (ADR 0043), so the Runner never needs to be loadable inside a `net48` host.
    -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIL.Motif.Contract\SIL.Motif.Contract.csproj" />
    <ProjectReference Include="..\SIL.Motif.Model\SIL.Motif.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Runner operates on an already-loaded LcmCache (it does not load or save projects; the
      Host does that — see src/SIL.Motif.Host/LcmUtils/FwDataProjectLoader.cs). It therefore may
      reference SIL.LCModel directly for the ICmObject/repository/unit-of-work surface, unlike
      SIL.Motif.Contract and SIL.Motif.Model, which stay LibLCM-free.
    -->
    <PackageReference Include="SIL.LCModel" Version="11.0.0-beta0150" />
  </ItemGroup>

  <!-- Pins libpalaso above what SIL.LCModel asks for (SilVersions.props), and lets a local override apply. -->
  <ItemGroup>
    <PackageReference Include="SIL.WritingSystems" Version="$(SilLibPalasoVersion)" />
    <PackageReference Include="SIL.Core" Version="$(SilLibPalasoVersion)" />
  </ItemGroup>

</Project>
