<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SIL.Motif.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="$(ModelContextProtocolVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIL.Motif.Commands\SIL.Motif.Commands.csproj" />
    <ProjectReference Include="..\SIL.Motif.Contract\SIL.Motif.Contract.csproj" />
    <ProjectReference Include="..\SIL.Motif.Host\SIL.Motif.Host.csproj" />
    <ProjectReference Include="..\SIL.Motif.Help\SIL.Motif.Help.csproj" />
    <ProjectReference Include="..\SIL.Motif.Runner\SIL.Motif.Runner.csproj" />
    <ProjectReference Include="..\SIL.Motif.Worker.Runtime\SIL.Motif.Worker.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SIL.Motif.Tests.Mcp" />
  </ItemGroup>

  <!-- The shipped profiles travel beside the assembly so a profile can be named without its path. -->
  <ItemGroup>
    <Content Include="..\..\profiles\*.json" Link="profiles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\encoding-guides\*.md">
      <LogicalName>motif-guides/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Tool descriptions quote request-field docs, so they ride inside this assembly rather than beside it. -->
  <Target Name="EmbedRequestFieldDocs" AfterTargets="ResolveAssemblyReferences" BeforeTargets="PrepareResources">
    <ItemGroup>
      <_RequestFieldDocs Include="@(ReferenceCopyLocalPaths)"
        Condition="'%(Extension)' == '.xml' and ('%(Filename)' == 'SIL.Motif.Contract' or '%(Filename)' == 'SIL.Motif.Commands')" />
      <EmbeddedResource Include="@(_RequestFieldDocs)" LogicalName="motif-field-docs/%(Filename)%(Extension)" />
    </ItemGroup>
    <Error Condition="'@(_RequestFieldDocs->Count())' != '2'"
      Text="The MCP tool descriptions need the Contract and Commands documentation files; found '@(_RequestFieldDocs)'." />
  </Target>

</Project>
