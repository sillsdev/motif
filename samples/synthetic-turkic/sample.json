  "teaches": [
    "noun suffix slots in order",
    "two-way and four-way vowel harmony",
    "conditioned case allomorphs",
    "verb past tense and first-person singular",
    "parser work and grammar ambiguity"
  ],
  "summary": "A synthetic parser exercise based on cited Turkish morphology forms demonstrates suffix order, harmony and how duplicated templates multiply parser work.",
  "disclaimer": "SYNTHETIC EXAMPLE. This language data was generated to demonstrate Motif. It is modelled loosely on Turkish, but it is not real Turkish, has not been checked by speakers, and must not be used as a description of any language.",
  "description": "SYNTHETIC EXAMPLE. This language data was generated to demonstrate Motif. It is modelled loosely on Turkish, but it is not real Turkish, has not been checked by speakers, and must not be used as a description of any language. The stems and selected inflected forms follow the cited sections of the Turkic research analysis. This compact FieldWorks grammar spells out conditioned allomorphs in natural-class environments, including the POSS.3SG linker n within the allomorph before case; it uses no phonological rules. Its constructed Texts are parser exercises, not example utterances.",
  "research": {
    "document": "docs/research/synthetic-samples/turkic.md",
    "sections": [
      { "part": "stems", "section": "§3.1" },
      { "part": "noun example forms", "section": "§3.2" },
      { "part": "verb example forms", "section": "§3.3" },
      { "part": "phoneme inventory and natural classes", "section": "§2.2" },
      { "part": "allomorphs and environments", "section": "§2.2" },
      { "part": "parts of speech and affix templates", "section": "§2.1" },
      { "part": "constructed Texts", "section": "§3.2 and §3.3" },
      { "part": "correctness bugs", "section": "§4" },
      { "part": "slow parsing bug", "section": "§4" }
    ]
  },
